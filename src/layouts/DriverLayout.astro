---
// File: src/layouts/DriverLayout.astro
import "../styles/global.css";
import { Image } from "astro:assets";
import riniLogo from "@assets/img/rini_trans_logo.png";
import FeedbackModal from "@components/ui/FeedbackModal.astro";
import ConfirmModal from "@components/ui/ConfirmModal.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Supir RTP</title>
    </head>
    <body
        class="bg-slate-50 font-main text-text-primary flex h-screen overflow-hidden"
    >
        <!-- Sidebar -->
        <aside
            class="w-72 bg-white border-r border-slate-100 flex flex-col justify-between h-full shadow-sm z-10 shrink-0"
        >
            <div class="flex flex-col">
                <div class="mb-10 px-6 pt-6">
                    <div>
                        <Image src={riniLogo} alt="Rini Trans Putri Logo" class="h-16 w-auto object-contain mb-2" />
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">
                            Panel Supir
                        </p>
                    </div>
                </div>

                <nav class="flex flex-col gap-2 p-6">
                    <a
                        href="/driver"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver" || pathname === "/driver/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Dashboard</span
                        >
                    </a>
                    <a
                        href="/driver/report"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver/report" || pathname === "/driver/report/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Kirim Laporan</span
                        >
                    </a>
                    <a
                        href="/driver/history"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver/history" || pathname === "/driver/history/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Riwayat Tugas</span
                        >
                    </a>
                    <a
                        href="/driver/report-history"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver/report-history" || pathname === "/driver/report-history/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Riwayat Laporan</span
                        >
                    </a>
                </nav>
            </div>

            <div class="p-6 border-t border-slate-100 mt-auto">
                <div class="bg-slate-50 p-4 rounded-2xl flex flex-col gap-3">
                    <div class="flex items-center gap-3">
                        <div id="driver-avatar-initial" class="w-10 h-10 rounded-full bg-[#044751] text-white font-black flex items-center justify-center shrink-0">
                            D
                        </div>
                        <div class="flex flex-col overflow-hidden">
                            <span id="driver-profile-name" class="font-bold text-slate-900 text-sm truncate">Supir RTP</span>
                            <span id="driver-profile-email" class="text-xs text-slate-400 truncate">Supir</span>
                        </div>
                    </div>
                    <button id="btn-logout-driver" class="w-full mt-1 py-2 px-4 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg text-xs font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                        </svg>
                        Keluar Akun
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8 overflow-y-auto w-full bg-slate-50 relative">
            <div class="w-full max-w-6xl pb-10">
                <slot />
            </div>
        </main>

        <FeedbackModal />
        <ConfirmModal />
    </body>
</html>

<script>
    import { authGuard } from "@utils/authGuard";

    // Proteksi Rute (Client-Side) - Hanya Supir yang boleh akses
    document.addEventListener("DOMContentLoaded", () => {
        authGuard.checkPermission(["driver", "supir"]);

        // Load Driver Profile from LocalStorage
        try {
            const savedDataString = localStorage.getItem("user_data");
            if (savedDataString) {
                const user = JSON.parse(savedDataString);
                const userName = user.name || user.nama || "Supir RTP";
                const initial = userName.charAt(0).toUpperCase();

                const avatarEl = document.getElementById("driver-avatar-initial");
                if (avatarEl) avatarEl.textContent = initial;

                const nameEl = document.getElementById("driver-profile-name");
                if (nameEl) nameEl.textContent = userName;

                const emailEl = document.getElementById("driver-profile-email");
                if (emailEl) emailEl.textContent = user.email || user.telp || "Driver";
            }
        } catch (error) {
            console.error("Gagal parse data supir:", error);
        }

        // Logout Handler
        const logoutBtn = document.getElementById("btn-logout-driver");
        if (logoutBtn) {
            logoutBtn.addEventListener("click", async () => {
                const confirmed = await (window as any).showConfirmModal("Konfirmasi Logout", "Apakah Anda yakin ingin keluar dari halaman Supir?");
                if (confirmed) {
                    localStorage.removeItem("jwt_token");
                    localStorage.removeItem("user_data");
                    document.cookie = "token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                    window.location.href = "/auth/login";
                }
            });
        }
    });
</script>
