---
// File: src/layouts/DriverLayout.astro
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | Supir RTP</title>
    </head>
    <body
        class="bg-slate-50 font-main text-text-primary flex h-screen overflow-hidden"
    >
        <!-- Sidebar -->
        <aside
            class="w-72 bg-white border-r border-slate-100 flex flex-col justify-between h-full shadow-sm z-10 shrink-0"
        >
            <div class="flex flex-col">
                <div
                    class="p-8 border-b border-slate-100 flex items-center gap-4"
                >
                    <div
                        class="w-12 h-12 rounded-full bg-[#044751] text-white flex items-center justify-center font-black text-lg shadow-md shadow-primary/20"
                    >
                        S
                    </div>
                    <div>
                        <h1
                            class="text-base font-black tracking-tight leading-none text-slate-900"
                        >
                            Panel Supir
                        </h1>
                        <p
                            class="text-[10px] text-slate-400 mt-1.5 font-black uppercase tracking-widest"
                        >
                            PT Rini Trans Putri
                        </p>
                    </div>
                </div>

                <nav class="flex flex-col gap-2 p-6">
                    <a
                        href="/driver"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver" || pathname === "/driver/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Dashboard</span
                        >
                    </a>
                    <a
                        href="/driver/report"
                        class={`flex items-center gap-4 px-4 py-4 rounded-xl transition-all ${pathname === "/driver/report" || pathname === "/driver/report/" ? "bg-[#044751] text-white shadow-md shadow-primary/20" : "hover:bg-slate-50 text-slate-500 hover:text-slate-800"}`}
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"
                            ></path></svg
                        >
                        <span
                            class="text-[11px] font-black uppercase tracking-widest"
                            >Kirim Laporan</span
                        >
                    </a>
                </nav>
            </div>

            <div class="p-6 border-t border-slate-100">
                <button
                    id="btn-logout-driver"
                    class="w-full flex items-center justify-center gap-3 px-4 py-4 rounded-xl text-rose-500 hover:bg-rose-50 transition-colors border border-transparent hover:border-rose-100"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"
                        ></path></svg
                    >
                    <span
                        class="text-[11px] font-black uppercase tracking-widest"
                        >Keluar</span
                    >
                </button>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-8 overflow-y-auto w-full bg-slate-50 relative">
            <div class="w-full max-w-6xl pb-10">
                <slot />
            </div>
        </main>
    </body>
</html>

<script>
    import { authGuard } from "@utils/authGuard";

    // Proteksi Rute (Client-Side) - Hanya Supir yang boleh akses
    document.addEventListener("DOMContentLoaded", () => {
        authGuard.checkPermission(["driver", "supir"]);
    });
</script>
