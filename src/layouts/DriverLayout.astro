---
// File: src/layouts/DriverLayout.astro
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Supir RTP</title>
	</head>
	<body class="bg-slate-50 font-main text-text-primary">
        <!-- Driver Mobile Header -->
        <header class="bg-primary text-white p-6 sticky top-0 z-50 shadow-lg rounded-b-[2rem]">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center font-black">S</div>
                    <div>
                        <h1 class="text-sm font-black tracking-tight leading-none">Panel Supir</h1>
                        <p class="text-[10px] text-white/70 mt-1 font-secondary uppercase tracking-widest">PT Rini Trans Putri</p>
                    </div>
                </div>
                <button id="btn-logout-driver" class="p-2 bg-white/10 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
                </button>
            </div>
        </header>

		<main class="p-6 pb-24 max-w-lg mx-auto">
		    <slot />
		</main>

        <!-- Driver Bottom Nav -->
        <nav class="fixed bottom-0 left-0 w-full bg-white border-t border-slate-100 px-6 py-4 flex items-center justify-around z-50 rounded-t-[2rem] shadow-[0_-10px_30px_-15px_rgba(0,0,0,0.1)]">
            <a href="/driver" class="flex flex-col items-center gap-1 text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                <span class="text-[10px] font-bold">Tugas</span>
            </a>
            <a href="/driver/package" class="flex flex-col items-center gap-1 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>
                <span class="text-[10px] font-bold">Paket</span>
            </a>
            <a href="/driver/report" class="flex flex-col items-center gap-1 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
                <span class="text-[10px] font-bold">Laporan</span>
            </a>
        </nav>
	</body>
</html>

<script>
    import { authGuard } from "@utils/authGuard";
    
    // Proteksi Rute (Client-Side) - Hanya Supir yang boleh akses
    document.addEventListener("DOMContentLoaded", () => {
        authGuard.checkPermission(['driver', 'supir']);
    });
</script>
