---
// File: src/layouts/AdminLayout.astro
import AdminSidebar from "@features/admin/shared/AdminSidebar.astro";
import FeedbackModal from "@components/ui/FeedbackModal.astro";
import ConfirmModal from "@components/ui/ConfirmModal.astro";
import riniLogo from "@assets/img/rini_trans_logo.png";
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Admin RTP</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="bg-slate-50 font-main">
        <div class="flex min-h-screen relative">
            <AdminSidebar />
            
            <main class="flex-1 w-full lg:w-[calc(100%-18rem)] overflow-x-hidden min-h-screen flex flex-col">
                <!-- Mobile Header -->
                <header class="lg:hidden flex items-center justify-between p-4 bg-white border-b border-slate-100 shrink-0 z-20">
                    <div class="flex items-center gap-3">
                        <img src={riniLogo.src} alt="Rini Trans Putri" class="h-8 w-auto" />
                        <span class="font-black text-sm text-slate-800 tracking-tight">Admin RTP</span>
                    </div>
                    <button id="admin-sidebar-toggle" class="p-2 text-slate-600 hover:bg-slate-50 rounded-lg transition-colors" aria-label="Toggle Sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                </header>
                
                <div class="p-6 md:p-12 w-full flex-1">
                    <slot />
                </div>
            </main>
        </div>

        <FeedbackModal />
        <ConfirmModal />
        <script>
    import { authGuard } from "@utils/authGuard";
    
    // Proteksi Rute (Client-Side) - Hanya Admin & Super Admin yang boleh akses
    document.addEventListener("DOMContentLoaded", () => {
        authGuard.checkPermission(['admin', 'superadmin', 'super_admin']);

        // Global Format Rupiah Setup
        const formatRupiah = (angka: string) => {
            let number_string = angka.replace(/[^,\d]/g, '').toString();
            let split = number_string.split(',');
            let sisa = split[0].length % 3;
            let rupiah = split[0].substr(0, sisa);
            let ribuan = split[0].substr(sisa).match(/\d{3}/gi);
            if (ribuan) {
                let separator = sisa ? '.' : '';
                rupiah += separator + ribuan.join('.');
            }
            return rupiah ? (split[1] != undefined ? rupiah + ',' + split[1] : rupiah) : '';
        };

        const setupCurrencyInputs = () => {
            document.querySelectorAll('.price-display-input').forEach(input => {
                input.addEventListener('input', function(this: HTMLInputElement) {
                    const container = this.closest('.relative') || this.parentElement;
                    const realInput = container?.querySelector('.real-price-input') as HTMLInputElement;
                    const cleanValue = this.value.replace(/\D/g, '');
                    if (realInput) {
                        realInput.value = cleanValue;
                    }
                    this.value = cleanValue ? formatRupiah(cleanValue) : '';
                });
            });
        };

        setupCurrencyInputs();
        // Setup observer to handle dynamically added elements
        const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
                if (mutation.addedNodes.length) {
                    setupCurrencyInputs();
                }
            });
        });
        observer.observe(document.body, { childList: true, subtree: true });
    });
</script>






