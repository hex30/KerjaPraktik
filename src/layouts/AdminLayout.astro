---
// File: src/layouts/AdminLayout.astro
import AdminSidebar from "@features/admin/shared/AdminSidebar.astro";
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Admin RTP</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="bg-slate-50 font-main">
        <div class="flex min-h-screen relative">
            <AdminSidebar />
            
            <main class="flex-1 w-full lg:w-[calc(100%-18rem)] p-6 md:p-12 overflow-x-hidden min-h-screen">
                <header class="mb-10 flex items-start gap-4">
                    <button id="admin-sidebar-toggle" class="lg:hidden p-2 -ml-2 text-slate-500 hover:bg-slate-100 rounded-lg transition-colors shrink-0 mt-1" aria-label="Toggle Sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25H12" />
                        </svg>
                    </button>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">{title}</h1>
                        <p class="text-xs md:text-sm text-slate-500 mt-1 font-secondary">Selamat datang di sistem manajemen Rini Trans Putri.</p>
                    </div>
                </header>
                
                <slot />
            </main>
        </div>
    </body>
</html>







