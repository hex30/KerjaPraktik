---
// File: src/layouts/AdminLayout.astro
import AdminSidebar from "@features/admin/shared/AdminSidebar.astro";
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} | Admin RTP</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    </head>
    <body class="bg-slate-50 font-main">
        <div class="flex min-h-screen">
            <AdminSidebar />
            <main class="flex-1 p-8 md:p-12 overflow-x-hidden">
                <header class="mb-10">
                    <h1 class="text-3xl font-black text-slate-900 tracking-tight">{title}</h1>
                    <p class="text-slate-500 mt-1 font-secondary">Selamat datang di sistem manajemen Rini Trans Putri.</p>
                </header>
                
                <slot />
            </main>
        </div>
    </body>
</html>







