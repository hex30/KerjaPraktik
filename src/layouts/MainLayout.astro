---
import "../styles/global.css";
import NavigationBar from "@components/shared/NavigationBar.astro";
import PageFooter from "@components/shared/PageFooter.astro";
import FeedbackModal from "@components/ui/FeedbackModal.astro";
import ConfirmModal from "@components/ui/ConfirmModal.astro";
import GlobalFleetAlert from "@components/ui/GlobalFleetAlert.astro";
import LegalModals from "@components/ui/LegalModals.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<NavigationBar />
		<slot />
		<PageFooter />
		<FeedbackModal />
		<ConfirmModal />
		<GlobalFleetAlert />
		<LegalModals />
		
		<script>
			// Global HTML5 Validation Override
			let isInvalidAlerting = false;
			document.addEventListener('invalid', (e) => {
				e.preventDefault(); // Mencegah tooltip bawaan browser
				
				if (isInvalidAlerting) return;
				isInvalidAlerting = true;
				setTimeout(() => { isInvalidAlerting = false; }, 1000); // Debounce untuk mencegah modal ganda
				
				const target = e.target as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
				
				// Mencari nama label untuk pesan yang lebih ramah pengguna
				let fieldName = target.getAttribute('placeholder') || target.name || 'Kolom input';
				if (target.id) {
					const label = document.querySelector(`label[for="${target.id}"]`);
					if (label) {
						fieldName = label.textContent?.trim() || fieldName;
					}
				}
				
				// Menentukan jenis pesan berdasarkan tipe error validasi
				let message = `Harap isi bagian "${fieldName}" yang masih kosong.`;
				if (target.validity?.typeMismatch) {
					message = `Format data tidak sesuai pada bagian "${fieldName}".`;
				} else if (target.validity?.tooShort) {
					message = `Isian pada bagian "${fieldName}" terlalu pendek.`;
				}
				
				// Memberi efek highlight merah sejenak pada input yang salah
				target.classList.add('ring-2', 'ring-red-500', 'bg-red-50');
				setTimeout(() => target.classList.remove('ring-2', 'ring-red-500', 'bg-red-50'), 3000);
				
				(window as any).showFeedbackModal('warning', 'Validasi Gagal', message);
				
				// Scroll otomatis ke area input yang bermasalah
				target.scrollIntoView({ behavior: 'smooth', block: 'center' });
				target.focus({ preventScroll: true });
			}, true); // Menggunakan capture phase karena event 'invalid' tidak bubble
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
