<script>
    document.addEventListener('DOMContentLoaded', () => {
        const faqToggles = document.querySelectorAll('.faq-toggle');

        faqToggles.forEach(toggle => {
            toggle.addEventListener('click', function() {
                const currentItem = this.parentElement;
                const currentContent = this.nextElementSibling;
                const currentIcon = this.querySelector('.faq-icon');
                const currentIconWrapper = this.querySelector('.faq-icon-wrapper');

                // Tutup item lain jika ada yang terbuka (Efek Single Accordion)
                document.querySelectorAll('.faq-item').forEach(item => {
                    if (item !== currentItem) {
                        const content = item.querySelector('.faq-content');
                        const icon = item.querySelector('.faq-icon');
                        const iconWrapper = item.querySelector('.faq-icon-wrapper');
                        
                        content.style.maxHeight = null;
                        item.classList.remove('border-primary/30', 'bg-slate-50/20');
                        if (icon) icon.classList.remove('rotate-180');
                        if (iconWrapper) {
                            iconWrapper.classList.remove('bg-primary', 'text-white');
                            iconWrapper.classList.add('bg-slate-50', 'text-slate-400');
                        }
                    }
                });

                // Toggle item yang sedang diklik
                if (currentContent.style.maxHeight) {
                    // Tutup
                    currentContent.style.maxHeight = null;
                    currentItem.classList.remove('border-primary/30', 'bg-slate-50/20');
                    currentIcon.classList.remove('rotate-180');
                    currentIconWrapper.classList.remove('bg-primary', 'text-white');
                    currentIconWrapper.classList.add('bg-slate-50', 'text-slate-400');
                } else {
                    // Buka (Menggunakan scrollHeight agar animasi dinamis dan smooth)
                    currentContent.style.maxHeight = currentContent.scrollHeight + "px";
                    currentItem.classList.add('border-primary/30', 'bg-slate-50/20');
                    currentIcon.classList.add('rotate-180');
                    currentIconWrapper.classList.remove('bg-slate-50', 'text-slate-400');
                    currentIconWrapper.classList.add('bg-primary', 'text-white');
                }
            });
        });
    });
</script>