---
// File: src/components/admin/ui/AdminBadge.astro
interface Props {
    status: "PENDING" | "WAITING_PAYMENT" | "APPROVED" | "REJECTED";
}

const { status } = Astro.props;

const variants = {
    PENDING: "bg-amber-50 text-amber-600 border-amber-100",
    WAITING_PAYMENT: "bg-sky-50 text-sky-600 border-sky-100",
    APPROVED: "bg-emerald-50 text-emerald-600 border-emerald-100",
    REJECTED: "bg-rose-50 text-rose-600 border-rose-100"
};

const labels = {
    PENDING: "Menunggu Verifikasi",
    WAITING_PAYMENT: "Menunggu Pembayaran",
    APPROVED: "Disetujui",
    REJECTED: "Ditolak"
};
---

<span class:list={["px-3 py-1 rounded-full text-[10px] font-bold border uppercase tracking-wider", variants[status]]}>
    {labels[status]}
</span>







