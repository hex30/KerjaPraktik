---
// src/components/ui/AlertCard.astro
// Komponen UI murni untuk merender kartu peringatan (contoh: Guest Overlay)

export interface Props {
    type?: 'success' | 'error' | 'warning' | 'info';
    title: string;
    message: string;
    actionText?: string;
    actionLink?: string;
    actionId?: string;
}

const { 
    type = 'warning', 
    title, 
    message, 
    actionText, 
    actionLink,
    actionId
} = Astro.props;

const styles = {
    success: { bg: 'bg-emerald-50', text: 'text-emerald-500', border: 'border-emerald-100', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 6L9 17l-5-5"></path>' },
    error: { bg: 'bg-red-50', text: 'text-red-500', border: 'border-red-100', icon: '<line x1="18" y1="6" x2="6" y2="18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line><line x1="6" y1="6" x2="18" y2="18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>' },
    warning: { bg: 'bg-amber-50', text: 'text-amber-500', border: 'border-amber-100', icon: '<rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>' },
    info: { bg: 'bg-blue-50', text: 'text-blue-500', border: 'border-blue-100', icon: '<circle cx="12" cy="12" r="10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></circle><line x1="12" y1="16" x2="12" y2="12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line><line x1="12" y1="8" x2="12.01" y2="8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>' }
};

const currentStyle = styles[type];
---

<div class="bg-white p-6 rounded-2xl shadow-xl border border-slate-100 max-w-sm text-center flex flex-col items-center gap-4 animate-fade-in mx-4">
    <div class={`w-12 h-12 rounded-full flex items-center justify-center shadow-sm border ${currentStyle.bg} ${currentStyle.text} ${currentStyle.border}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <Fragment set:html={currentStyle.icon} />
        </svg>
    </div>
    
    <div>
        <h4 class="font-bold text-primary mb-1">{title}</h4>
        <p class="text-xs text-slate-500 font-secondary leading-relaxed">{message}</p>
    </div>
    
    {actionText && actionLink && (
        <a href={actionLink} id={actionId} class="w-full py-2.5 px-4 bg-primary text-white font-bold rounded-xl text-sm hover:bg-opacity-90 transition-colors shadow-md shadow-primary/20">
            {actionText}
        </a>
    )}
    
    {actionText && !actionLink && (
        <button type="button" id={actionId} class="w-full py-2.5 px-4 bg-primary text-white font-bold rounded-xl text-sm hover:bg-opacity-90 transition-colors shadow-md shadow-primary/20">
            {actionText}
        </button>
    )}
</div>
