---
// File: src/components/ui/FAQItem.astro
interface Props {
    question: string;
}

const { question } = Astro.props;
---

<div class="faq-item bg-white border border-slate-100 shadow-sm rounded-2xl overflow-hidden hover:shadow-md hover:border-slate-200/60 transition-all duration-300">
    <button class="faq-toggle w-full text-left px-6 py-5 flex items-center justify-between gap-4 font-bold text-text-secondary hover:text-primary focus:outline-none group transition-colors duration-300">
        <span class="text-base md:text-lg">{question}</span>
        <div class="faq-icon-wrapper shrink-0 p-1.5 bg-slate-50 text-slate-400 group-hover:text-primary group-hover:bg-primary/5 rounded-xl transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 faq-icon transition-transform duration-300"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
        </div>
    </button>
    <div class="faq-content max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
        <div class="px-6 pb-6 text-sm md:text-base text-slate-500 leading-relaxed border-t border-slate-50 pt-4">
            <slot />
        </div>
    </div>
</div>







