---
// File: src/components/ui/SectionHeader.astro
interface Props {
    title: string;
    subtitle?: string;
    align?: "left" | "center";
    titleClass?: string;
    subtitleClass?: string;
}

const { 
    title, 
    subtitle, 
    align = "left",
    titleClass = "text-2xl md:text-3xl font-black text-primary mb-2",
    subtitleClass = "font-secondary text-sm text-text-secondary leading-relaxed"
} = Astro.props;
---

<header class:list={[align === "center" ? "text-center" : "text-left", "mb-8"]}>
    <h2 class={titleClass}>
        {title}
    </h2>
    {subtitle && (
        <p class={subtitleClass}>
            {subtitle}
        </p>
    )}
</header>
