---
// File: src/components/ui/Button.astro
interface Props {
    type?: "button" | "submit" | "reset";
    variant?: "primary" | "secondary" | "outline" | "ghost";
    size?: "sm" | "md" | "lg" | "xl";
    class?: string;
    id?: string;
    disabled?: boolean;
}

const { 
    type = "button", 
    variant = "primary", 
    size = "md", 
    class: className = "", 
    id,
    disabled = false
} = Astro.props;

const variants = {
    primary: "bg-btn-linear text-white shadow-md hover:shadow-lg transform hover:-translate-y-0.5",
    secondary: "bg-slate-100 text-primary hover:bg-slate-200",
    outline: "border-2 border-primary text-primary hover:bg-primary hover:text-white",
    ghost: "text-slate-500 hover:text-primary hover:bg-slate-50"
};

const sizes = {
    sm: "px-4 py-2 text-xs",
    md: "px-6 py-3 text-sm",
    lg: "px-8 py-4 text-base",
    xl: "px-10 py-5 text-lg"
};

const baseClass = "font-main font-bold rounded-xl transition-all inline-flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed";
---

<button 
    type={type} 
    id={id} 
    class:list={[baseClass, variants[variant], sizes[size], className]}
    disabled={disabled}
>
    <slot />
</button>
