---
// File: src/components/layanan/FormPaket.astro
import InputGroup from '../components/InputGroup.astro';

// 1. Panggil komponen grup alamat
import AlamatPaketGroup from '../components/PackageAdress.astro';
---

<article class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main">
    
    <div class="w-full lg:w-3/5 flex flex-col gap-8">
        
        <header>
            <h2 class="text-2xl md:text-3xl font-black text-primary font-main mb-2">Detail Pengiriman Paket</h2>
            <p class="font-secondary text-sm text-text-secondary leading-relaxed">
                Lengkapi data pengirim, penerima, dan detail barang dengan akurat.
            </p>
        </header>

        <form id="form-package-detail" class="flex flex-col gap-10">
            
            <AlamatPaketGroup title="1. Data Pengirim" type="pengirim" />

            <AlamatPaketGroup title="2. Data Penerima" type="penerima" />

            <fieldset class="flex flex-col gap-5 p-6 rounded-2xl bg-slate-50 border border-slate-100 relative">
                <legend class="px-3 bg-slate-50 text-sky-600 font-black text-sm uppercase tracking-wider rounded-lg border border-slate-100">
                    3. Detail Paket
                </legend>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <InputGroup label="Berat Barang (Kg)" id="berat_paket" name="berat_paket" type="number" placeholder="Contoh: 12" required={true} />
                    
                    <div class="flex flex-col gap-2 w-full">
                        <label for="dimensi_paket" class="font-secondary text-sm font-bold text-primary">Dimensi Kemasan</label>
                        <select name="dimensi_paket" id="dimensi_paket" required class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all appearance-none">
                            <option value="" disabled selected>Pilih Dimensi Paket Anda</option>
                            <option value="kecil">Kecil (Dokumen/Buku)</option>
                            <option value="sedang">Sedang (Kotak Sepatu/Pakaian)</option>
                            <option value="besar">Besar (Kardus Besar/Elektronik)</option>
                        </select>
                    </div>
                </div>
            </fieldset>

            <div class="pt-2">
                <button type="submit" class="w-full md:w-auto px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:opacity-90 transition-opacity">
                    Pesan Pengiriman Sekarang
                </button>
            </div>
            
        </form>
    </div>

    <aside class="w-full lg:w-2/5 hidden lg:block">
        <figure class="relative w-full h-full min-h-[500px] rounded-2xl overflow-hidden group sticky top-28">
            <img 
                src="/assets/images/contoh.jpg" 
                alt="Pengiriman Aman" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/20 to-transparent"></div>
            
            <figcaption class="absolute bottom-0 left-0 right-0 p-8">
                <h3 class="text-2xl font-black text-white font-main mb-2">Pengiriman Aman & Terlindungi</h3>
                <p class="font-secondary text-sm text-slate-200 leading-relaxed max-w-sm">
                    Setiap paket ditangani dengan standar profesional untuk memastikan barang Anda tiba di tujuan dengan utuh dan selamat.
                </p>
            </figcaption>
        </figure>
    </aside>

</article>

<script>
    const setupPackageListener = () => {
        const form = document.getElementById('form-package-detail');
        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const formData = new FormData(form as HTMLFormElement);
                const data = Object.fromEntries(formData.entries());
                
                console.log("Data Paket Berhasil Ditangkap:", data);
                alert(`Pesanan paket dari ${data.nama_pengirim} ke ${data.nama_penerima} berhasil dicatat.`);
            });
        }
    };
    document.addEventListener('DOMContentLoaded', setupPackageListener);
</script>