---
import InputGroup from "../InputGroup.astro";
---

<article
    class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
>
    <div class="w-full lg:w-3/5 flex flex-col gap-8">
        <header>
            <h2 class="text-2xl md:text-3xl font-black text-primary mb-2">
                Detail Pemesanan
            </h2>
            <p
                class="font-secondary text-sm text-text-secondary leading-relaxed"
            >
                Lengkapi rute, jadwal, dan data diri Anda untuk perjalanan
                nyaman.
            </p>
        </header>

        <form action="#" id="form-reservasi" class="flex flex-col gap-8">
            <section class="flex flex-col gap-5 border-b border-slate-100 pb-8">
                <h3 class="text-lg text-primary font-bold">
                    1. Rute dan Jadwal Perjalanan
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <label for="#" class="relative cursor-pointer group">
                        <input
                            type="radio"
                            name="rute"
                            value="jakarta_panawangan"
                            class="peer sr-only"
                            required
                        />
                        <div
                            class="p-4 rounded-xl border-2 border-slate-200 peer-checked:border-sky-50 peer-checked:bg-sky-50 hover:border-sky-300 transition-all"
                        >
                            <span class="block font-bold text-primary mb-1">
                                Jakarta ➔ Panawangan
                            </span>
                            <span
                                class="inline-block bg-slate-100 text-slate-600 text-xs px-2 py-1 rounded font-secondary"
                                >Senin, Rabu dan Minggu</span
                            >
                        </div>
                        <div
                            class="absolute top-4 right-4 text-sky-500 opacity-0 peer-checked:opacity-100 transition-opacity"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </label>

                    <label for="#" class="relative cursor-pointer group">
                        <input
                            type="radio"
                            name="rute"
                            value="panawangan_jakarta"
                            class="peer sr-only"
                        />
                        <div
                            class="p-4 rounded-xl border-2 border-slate-200 peer-checked:border-sky-500 peer-checked:bg-sky-50 hover:border-sky-300 transition-all"
                        >
                            <span class="block font-bold text-primary mb-1">
                                Panawangan ➔ Jakarta
                            </span>
                            <span
                                class="inline-block bg-slate-100 text-slate-600 text-xs px-2 py-1 rounded font-secondary"
                                >Selasa Kamis dan Juma'at</span
                            >
                        </div>
                        <div
                            class="absolute top-4 right-4 text-sky-500 opacity-0 peer-checked:opacity-100 transition-opacity"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </label>
                </div>

                <div class="flex flex-col gap-3 mt-2">
                    <label
                        for=""
                        class="font-secondary text-sm font-bold text-primary"
                        >Pilih tanggal keberangkatan anda</label
                    >
                    <div
                        id="date-container"
                        class="flex gap-3 overflow-x-auto pb-4 snap-x hide-scrollbar"
                    >
                        <div
                            class="w-full p-4 border border-dashed border-slate-300 rounded-xl bg-slate-50 text-center text-sm text-slate-400 font-secondary"
                        >
                            Silahkan Pilih Rute Terlebih Dahulu.
                        </div>
                    </div>
                    <input
                        type="hidden"
                        name="tanggal_keberangkatan"
                        id="tanggal_hidden"
                        required
                    />
                </div>
            </section>

            <section class="flex flex-col gap-5 border-b border-slate-100 pb-8">
                <h3 class="text-lg font-bold text-primary">
                    2. Detail Penumpang
                </h3>
                <div class="w-full">
                    <InputGroup
                        label="Nama Lengkap"
                        id="nama-lengkap"
                        name="nama_lengkap"
                        placeholder="Masukan Nama Lengkap Anda"
                        required={true}
                    />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <InputGroup
                        label="Kecamatan"
                        id="kecamatan"
                        name="Kecamatan"
                        placeholder="Contoh : Panawangan"
                        required={true}
                    />
                    <InputGroup
                        label="Desa"
                        id="desa"
                        name="Desa"
                        placeholder="Contoh : Nagarajaya"
                        required={true}
                    />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
                    <div class="md:col-span-6">
                        <InputGroup
                            label="Nama Dusun"
                            id="dusun"
                            name="Dusun"
                            placeholder="Contoh : Cikodang"
                            required={true}
                        />
                    </div>
                    <div class="md:col-span-3">
                        <InputGroup
                            label="RT"
                            id="rt"
                            name="RT"
                            placeholder="00"
                            required={true}
                        />
                    </div>
                    <div class="md:col-span-3">
                        <InputGroup
                            label="RW"
                            id="rw"
                            name="RW"
                            placeholder="00"
                            required={true}
                        />
                    </div>
                </div>
                <div class="flex flex-col gap-2 w-full">
                    <label
                        for="patokan"
                        class="font-secondary text-sm font-bold text-primary"
                    >
                        Patokan Bangunan
                    </label>
                    <textarea
                        name="patokan"
                        id="patokan"
                        rows="2"
                        placeholder="Contoh : Sebelah Masjid Aagung"
                        class="resize-none w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focos:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all placeholder:text-slate-400"
                    ></textarea>
                </div>
            </section>

            <section class="flex flex-col gap-5">
                <h3 class="text-lg font-bold text-primary">
                    3. Barang bawaan (Opsional)
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-2">
                        <label
                            for="ukuran_bagasi"
                            class="font-secondary text-sm font-bold text-primary"
                            >Ukuran dominan</label
                        >
                        <div class="relative">
                            <select
                                name="ukuran_bagasi"
                                id="ukuran_bagasi"
                                class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all appearance-none"
                            >
                                <option value="tidak_ada"
                                    >Hanya tas/Ransel</option
                                >
                                <option value="sedang"
                                    >Sedang (Kardus Mie)</option
                                >
                                <option value="besar"
                                    >Besar (Koper/Karung)</option
                                >
                            </select>
                            <div
                                class="absolute inset-y-0 rigth-0 flex items-center px-4 pointer-events-none text-slate-400"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            class="font-secondary text-sm font-bold text-primary"
                        >
                            Jumlah Barang (Pcs)
                        </label>
                        <div
                            class="flex items-center w-full bg-slate-50 border border-slate-200 rounded-lg h-[46px] overflow-hidden focus-within:border-sky-500 focus-within:ring-1 focus-within:ring-sky-500"
                        >
                            <button
                                type="button"
                                id="btn-kurang-bagasi"
                                class="px-5 h-full text-slate-500 hover:bg-slate-200 hover:text-primary transition-colors font-bold select-none"
                                >-</button
                            >
                            <input
                                type="number"
                                name="jumlah_bagasi"
                                id="jumlah_bagasi"
                                value="0"
                                min="0"
                                max="15"
                                readonly
                                class="flex-1 w-full text-center bg-transparent border-none focus:ring-0 text-sm font-bold text-primary p-0 outline-none select-none"
                            /><button
                                type="button"
                                id="btn-tambah-bagasi"
                                class="px-5 h-full text-slate-500 hover:bg-slate-200
                                hover:text-primary transition-colors font-bold select-none"
                                >+</button
                            >
                        </div>
                    </div>
                </div>
            </section>
            <div class="pt-6 mt-2">
                <button
                    type="submit"
                    class="w-full md:w-auto px-8 py-4 bg-sky-600 text-white
                 font-main font-bold rounded-xl shadow-md
                 hover:bg-sky-700 hover:shadow-lg transition-all
                 transform hover:-translate-y-0.5"
                >
                    Konfirmasi Reservasi
                </button>
            </div>
        </form>
    </div>
    
</article>
