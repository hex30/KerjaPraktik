---
import InputGroup from "../InputGroup.astro";
---

<article
    class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
>
    <div class="w-full lg:w-3/5 flex flex-col gap-8">
        <header>
            <h2 class="text-2xl md:text-3xl font-black text-primary mb-2">
                Detail Pemesanan
            </h2>
            <p
                class="font-secondary text-sm text-text-secondary leading-relaxed"
            >
                Lengkapi rute, jadwal, dan data diri Anda untuk perjalanan
                nyaman.
            </p>
        </header>

        <form action="#" id="form-reservasi" class="flex flex-col gap-8">
            <section class="flex flex-col gap-5 border-b border-slate-100 pb-8">
                <h3 class="text-lg text-primary font-bold">
                    1. Rute dan Jadwal Perjalanan
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <label for="#" class="relative cursor-pointer group">
                        <input
                            type="radio"
                            name="rute"
                            value="jakarta_panawangan"
                            class="peer sr-only"
                            required
                        />
                        <div
                            class="p-4 rounded-xl border-2 border-slate-200 peer-checked:border-sky-50 peer-checked:bg-sky-50 hover:border-sky-300 transition-all"
                        >
                            <span class="block font-bold text-primary mb-1">
                                Jakarta ➔ Panawangan
                            </span>
                            <span
                                class="inline-block bg-slate-100 text-slate-600 text-xs px-2 py-1 rounded font-secondary"
                                >Senin, Rabu dan Minggu</span
                            >
                        </div>
                        <div
                            class="absolute top-4 right-4 text-sky-500 opacity-0 peer-checked:opacity-100 transition-opacity"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </label>

                    <label for="#" class="relative cursor-pointer group">
                        <input
                            type="radio"
                            name="rute"
                            value="panawangan_jakarta"
                            class="peer sr-only"
                        />
                        <div
                            class="p-4 rounded-xl border-2 border-slate-200 peer-checked:border-sky-500 peer-checked:bg-sky-50 hover:border-sky-300 transition-all"
                        >
                            <span class="block font-bold text-primary mb-1">
                                Panawangan ➔ Jakarta
                            </span>
                            <span
                                class="inline-block bg-slate-100 text-slate-600 text-xs px-2 py-1 rounded font-secondary"
                                >Selasa Kamis dan Juma'at</span
                            >
                        </div>
                        <div
                            class="absolute top-4 right-4 text-sky-500 opacity-0 peer-checked:opacity-100 transition-opacity"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </label>
                </div>
            </section>
        </form>
    </div>
</article>
