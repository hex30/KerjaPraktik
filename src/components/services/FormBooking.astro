---
// File: src/components/layanan/FormBooking.astro
import InputGroup from "../InputGroup.astro";

// 1. Panggil komponen anak yang baru saja dibuat
import FleetCard from "./FleetCard.astro";

const fleetData = [
    {
        name: "Isuzu ELF Giga",
        capacity: "14-19 Kursi",
        description: "Cocok untuk rombongan menengah, nyaman dan tangguh.",
        price: "1.200.000",
        image: "/assets/images/contoh.jpg",
    },
    {
        name: "Toyota Hiace Commuter",
        capacity: "15 Kursi",
        description: "Eksekutif dan premium untuk perjalanan jarak jauh.",
        price: "1.500.000",
        image: "/assets/images/contoh.jpg",
    },
];
---

<article
    class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
>
    <section class="w-full lg:w-2/3 flex flex-col gap-6">
        <header>
            <h2 class="text-2-xl md:text-3xl font-black text-primary mb-2">
                Pilihan armada
            </h2>
            <p class="font-secondary text-sm text-text-secondary">
                Kendaraan terawat untuk kenyamanan maksimal perjalanan Anda.
            </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
                fleetData.map((unit) => (
                    <FleetCard
                        name={unit.name}
                        capacity={unit.capacity}
                        description={unit.description}
                        price={unit.price}
                        image={unit.image}
                    />
                ))
            }
        </div>
    </section>

    <aside class="w-full lg:w-1/3">
        <div
            class="bg-slate-50 border border-slate-100 rounded-2xl p-6 md:pd-8 sticky toop-28"
        >
            <header class="mb-6">
                <h2 class="text-xl font-black text-primary mb-1">
                    Detail Booking
                </h2>
                <p class="font-secondary text-xs text-text-secondary">
                    Pesan armada khusus (Charter) untuk Anda.
                </p>
            </header>

            <form
                action=""
                id="form-booking-travel"
                class="flex flex-col gap-5"
            >
                <div class="flex flex-col gap-2 w-full">
                    <label
                        for="jenis_armada"
                        class="font-secondary text-sm font-bold text-primary"
                        >Pilih Jenis Armada</label
                    >
                    <select
                        name="jenis_armada"
                        id="jenis_armada"
                        required
                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all appearance-none"
                    >
                        <option value="" disabled selected
                            >Pilih kendaraan...</option
                        >
                        <option value="elf">Isuzu ELF Giga</option>
                        <option value="hiace">Toyota Hiace Commuter</option>
                    </select>
                </div>

                <InputGroup
                    label="Tanggal Keberangkatan"
                    id="tanggal_sewa"
                    name="tanggal_sewa"
                    type="date"
                    required={true}
                />
                <InputGroup
                    label="Area Tujuan"
                    id="tujuan"
                    name="tujuan"
                    placeholder="Masukkan kota tujuan"
                    required={true}
                />

                <button
                    type="submit"
                    class="w-full mt-2 px-6 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:opacity-90 transition-opacity"
                >
                    Pesan Sekarang
                </button>

            </form>
        </div>
    </aside>
</article>

<script>
    const setupBookingListener = () => {
        const form = document.getElementById('form-booking-travel');
        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const formData = new FormData(form as HTMLFormElement);
                const data = Object.fromEntries(formData.entries());
                console.log("Data Booking:", data);
                alert(`Permintaan Booking ke ${data.tujuan} pada ${data.tanggal_sewa} telah di proses.`);
            });
        }
    };
    document.addEventListener('DOMContentLoaded', setupBookingListener);
</script>
