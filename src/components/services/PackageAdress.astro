---
// File: src/components/layanan/AlamatPaketGroup.astro
import InputGroup from '../../components/InputGroup.astro';

interface Props {
    title: string;
    // Tipe ini akan menentukan suffix id dan name secara otomatis (contoh: nama_pengirim atau nama_penerima)
    type: 'pengirim' | 'penerima';
}

const { title, type } = Astro.props;

// Logika dinamis untuk label dan placeholder
const labelNama = type === 'pengirim' ? 'Nama Pengirim' : 'Nama Penerima';
const placeholderNama = type === 'pengirim' ? 'Nama lengkap Anda' : 'Nama lengkap tujuan';
---

<fieldset class="flex flex-col gap-5 p-6 rounded-2xl bg-slate-50 border border-slate-100 relative">
    <legend class="px-3 bg-slate-50 text-sky-600 font-black text-sm uppercase tracking-wider rounded-lg border border-slate-100">
        {title}
    </legend>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <InputGroup label={labelNama} id={`nama_${type}`} name={`nama_${type}`} placeholder={placeholderNama} required={true} />
        <InputGroup label="No. Telepon" id={`telp_${type}`} name={`telp_${type}`} type="number" placeholder="Contoh: 08123456789" required={true} />
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
        <div class="md:col-span-6">
            <InputGroup label="Nama Dusun/Jalan" id={`dusun_${type}`} name={`dusun_${type}`} placeholder="Contoh: Sukamaju" required={true} />
        </div>
        <div class="md:col-span-3">
            <InputGroup label="RT" id={`rt_${type}`} name={`rt_${type}`} placeholder="00" />
        </div>
        <div class="md:col-span-3">
            <InputGroup label="RW" id={`rw_${type}`} name={`rw_${type}`} placeholder="00" />
        </div>
    </div>
</fieldset>