---
import NavLink from "../ui/NavLink.astro";
import Button from "../ui/Button.astro";
---

<nav class="w-full bg-white border-b border-slate-100 shadow-sm sticky top-0 z-50 font-main">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">
        
        <!-- Logo -->
        <a href="/" class="text-2xl font-black text-text-secondary tracking-tight flex items-center gap-2 hover:text-primary hover:scale-[1.02] transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-primary"><path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.651A1.125 1.125 0 003 6.657v11.13c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z" /></svg>
            <span>Rini Trans <span class="text-text-secondary hover:text-primary transition-colors">Putri</span></span>
        </a>

        <!-- Menu Utama Desktop -->
        <ul class="hidden md:flex items-center gap-8">
            <li>
                <NavLink href="/">
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
                    Beranda
                </NavLink>
            </li>
            <li>
                <NavLink href="/layanan">
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                    Layanan
                </NavLink>
            </li>
            <li>
                <NavLink href="/tentang-kami">
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.063.852l-.708 2.836a.75.75 0 001.063.852l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
                    Tentang Kami
                </NavLink>
            </li>
            <li id="nav-riwayat" class="hidden">
                <NavLink href="/user/riwayat">
                    <svg slot="icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-slate-400"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Riwayat Pesanan
                </NavLink>
            </li>
        </ul>

        <!-- Bagian Kanan Desktop -->
        <div class="hidden md:flex items-center relative">
            <a href="/auth/login" id="btn-login" class="px-6 py-2.5 border border-slate-200 text-text-secondary rounded-lg font-bold hover:text-primary hover:border-primary hover:bg-slate-50 hover:scale-105 transition-all duration-300 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
                Masuk
            </a>
            
            <div id="btn-profile-group" class="hidden items-center gap-4 relative">
                <a href="/notifikasi" id="btn-notif-desktop" class="p-2 text-text-secondary hover:text-primary transition-all relative">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-rose-500 rounded-full animate-pulse"></span>
                </a>

                <a href="/chat" id="btn-chat-desktop" class="p-2 text-text-secondary hover:text-primary transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501c1.153-.086 2.294-.213 3.423-.379 1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
                </a>

                <button id="btn-profile-avatar" class="w-10 h-10 rounded-full bg-slate-50 border-2 border-slate-200 text-text-secondary font-black flex items-center justify-center hover:text-primary hover:border-primary transition-all relative">
                    <span id="avatar-initial">U</span> 
                </button>

                <div id="profile-dropdown" class="hidden absolute right-0 top-14 w-64 bg-white border border-slate-100 shadow-xl rounded-2xl p-5 flex flex-col gap-3 z-50">
                    <div class="flex flex-col border-b border-slate-100 pb-4 mb-1">
                        <span id="dropdown-name" class="font-black text-text-secondary text-lg truncate">Nama Pengguna</span>
                        <span id="dropdown-email" class="font-secondary text-xs text-text-secondary truncate mt-0.5">email@domain.com</span>
                        <div class="flex items-center gap-1 mt-2 text-text-secondary font-secondary text-xs">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.08-7.074-6.96l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                            <span id="dropdown-phone">08xxxxxxxxx</span>
                        </div>
                    </div>
                    <Button id="btn-logout" variant="secondary" class="w-full text-rose-600 hover:bg-rose-50" size="sm">
                        Keluar Akun
                    </Button>
                </div>
            </div>
        </div>

        <button id="btn-hamburger" class="md:hidden text-text-secondary p-2 z-50">
            <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7 block"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7 hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>

    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="absolute top-20 left-0 w-full bg-white border-b border-slate-100 shadow-lg flex flex-col gap-4 p-6 hidden md:hidden transition-all transform origin-top duration-300">
        <ul class="flex flex-col gap-4">
            <li><NavLink href="/">Beranda</NavLink></li>
            <li><NavLink href="/layanan">Layanan</NavLink></li>
            <li><NavLink href="/tentang-kami">Tentang Kami</NavLink></li>
            <li id="mobile-nav-riwayat" class="hidden border-t border-slate-100 pt-4"><NavLink href="/user/riwayat">Riwayat Pesanan</NavLink></li>
            <li id="mobile-nav-notif" class="hidden border-t border-slate-100 pt-4"><NavLink href="/notifikasi">Notifikasi</NavLink></li>
            <li id="mobile-nav-chat" class="hidden border-t border-slate-100 pt-4"><NavLink href="/chat" class="text-primary font-bold">Chat Admin</NavLink></li>
        </ul>

        <div class="mt-4 pt-4 border-t border-slate-100">
            <a href="/auth/login" id="mobile-btn-login" class="w-full text-center px-6 py-3 border border-slate-200 text-text-secondary rounded-lg font-bold flex items-center justify-center gap-2">
                Masuk / Daftar
            </a>
            
            <div id="mobile-btn-profile-group" class="hidden flex-col gap-4">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-slate-100 text-text-secondary font-black flex items-center justify-center shrink-0">
                        <span id="mobile-avatar-initial">U</span>
                    </div>
                    <div class="flex flex-col overflow-hidden">
                        <span id="mobile-dropdown-name" class="font-bold text-text-secondary truncate text-sm">Nama</span>
                        <span id="mobile-dropdown-email" class="text-xs text-text-secondary truncate">email@domain.com</span>
                    </div>
                </div>
                <Button id="mobile-btn-logout" variant="secondary" class="w-full text-rose-600" size="md">
                    Keluar Akun
                </Button>
            </div>
        </div>
    </div>
</nav>

<script>
    const setupNavbar = () => {
        const isLoggedIn = localStorage.getItem('is_logged_in') === 'true';
        const savedDataString = localStorage.getItem('dummy_user_rini_trans');

        if (isLoggedIn) {
            ['nav-riwayat', 'mobile-nav-riwayat', 'mobile-nav-chat', 'mobile-nav-notif', 'btn-profile-group', 'mobile-btn-profile-group'].forEach(id => {
                document.getElementById(id)?.classList.remove('hidden');
                if (id.includes('group')) document.getElementById(id)?.classList.add('flex');
            });
            
            ['btn-login', 'mobile-btn-login'].forEach(id => document.getElementById(id)?.classList.add('hidden'));

            if (savedDataString) {
                const user = JSON.parse(savedDataString);
                const initial = user.nama ? user.nama.charAt(0).toUpperCase() : 'U';
                
                ['avatar-initial', 'mobile-avatar-initial'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = initial;
                });
                
                document.getElementById('dropdown-name')!.textContent = user.nama;
                document.getElementById('dropdown-email')!.textContent = user.email;
                document.getElementById('mobile-dropdown-name')!.textContent = user.nama;
                document.getElementById('mobile-dropdown-email')!.textContent = user.email;
            }
        }

        const btnAvatar = document.getElementById('btn-profile-avatar');
        const profileDropdown = document.getElementById('profile-dropdown');

        if (btnAvatar && profileDropdown) {
            btnAvatar.addEventListener('click', (e) => {
                e.stopPropagation();
                profileDropdown.classList.toggle('hidden');
            });

            window.addEventListener('click', (e) => {
                if (!profileDropdown.contains(e.target as Node) && !btnAvatar.contains(e.target as Node)) {
                    profileDropdown.classList.add('hidden');
                }
            });
        }

        const handleLogout = () => {
            localStorage.removeItem('is_logged_in');
            alert('Anda telah berhasil keluar.');
            window.location.reload();
        };

        document.getElementById('btn-logout')?.addEventListener('click', handleLogout);
        document.getElementById('mobile-btn-logout')?.addEventListener('click', handleLogout);

        const btnHamburger = document.getElementById('btn-hamburger');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconHamburger = document.getElementById('icon-hamburger');
        const iconClose = document.getElementById('icon-close');

        if (btnHamburger && mobileMenu && iconHamburger && iconClose) {
            btnHamburger.addEventListener('click', () => {
                const isHidden = mobileMenu.classList.toggle('hidden');
                iconHamburger.classList.toggle('hidden', !isHidden);
                iconClose.classList.toggle('hidden', isHidden);
            });
        }
    };

    document.addEventListener('DOMContentLoaded', setupNavbar);
    document.addEventListener('astro:page-load', setupNavbar);
</script>
