---
// File: src/components/layout/molecules/FooterNav.astro
interface Props {
    title: string;
    links: { label: string; href: string; class?: string; "data-modal-target"?: string }[];
}

const { title, links } = Astro.props;
---

<nav class="flex flex-col gap-4">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider font-main">
        {title}
    </h3>
    <ul class="flex flex-col gap-2.5 font-secondary text-sm">
        {links.map((link) => (
            <li>
                <a 
                    href={link.href} 
                    class={`hover:text-sky-400 transition-colors ${link.class || ""}`}
                    data-modal-target={link["data-modal-target"]}
                >
                    {link.label}
                </a>
            </li>
        ))}
    </ul>
</nav>







