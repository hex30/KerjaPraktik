---
// File: src/components/shared/NavigationBar.astro
import DesktopMenu from "./DesktopMenu.astro";
import UserProfile from "./UserProfile.astro";
import MobileMenu from "./MobileMenu.astro";
import { Image } from "astro:assets";
import riniLogo from "@assets/img/rini_trans_logo.png";
---

<nav
    class="w-full bg-white border-b border-slate-100 shadow-sm sticky top-0 z-50 font-main"
>
    <div
        class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative"
    >
        <!-- Logo -->
        <a
            href="/"
            class="flex items-center gap-2 hover:scale-[1.02] transition-transform duration-300"
        >
            <Image
                src={riniLogo}
                alt="Rini Trans Putri Logo"
                class="h-30 py-[10px] w-auto object-contain"
            />
        </a>

        <DesktopMenu />
        <UserProfile />

        <button
            id="btn-hamburger"
            class="md:hidden text-text-secondary p-2 z-50"
            aria-label="Toggle menu"
        >
            <svg
                id="icon-hamburger"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-7 h-7 block"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                ></path></svg
            >
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-7 h-7 hidden"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18L18 6M6 6l12 12"></path></svg
            >
        </button>
    </div>

    <MobileMenu />
</nav>

<script>
    const setupNavbar = () => {
        const token = localStorage.getItem("jwt_token");
        const savedDataString = localStorage.getItem("user_data");
        const isLoggedIn = !!token && !!savedDataString;

        if (isLoggedIn) {
            const authElements = [
                "nav-riwayat",
                "mobile-nav-riwayat",
                "mobile-nav-chat",
                "mobile-nav-notif",
                "btn-profile-group",
                "mobile-btn-profile-group",
            ];

            authElements.forEach((id) => {
                const el = document.getElementById(id);
                if (el) {
                    el.classList.remove("hidden");
                    if (id.includes("group")) el.classList.add("flex");
                }
            });

            ["btn-login", "mobile-btn-login"].forEach((id) =>
                document.getElementById(id)?.classList.add("hidden"),
            );

            try {
                const user = JSON.parse(savedDataString);
                const userName = user.name || user.nama || "User";
                const initial = userName.charAt(0).toUpperCase();

                ["avatar-initial", "mobile-avatar-initial"].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = initial;
                });

                const setContent = (id: string, text: string) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = text;
                };

                setContent("dropdown-name", userName);
                setContent("dropdown-email", user.email || "");
                setContent(
                    "dropdown-phone",
                    user.phone_number || user.telp || "-",
                );
                setContent("mobile-dropdown-name", userName);
                setContent("mobile-dropdown-email", user.email || "");
            } catch (error) {
                console.error("Gagal parse data user:", error);
            }
        }

        // Profile Dropdown Logic
        const btnAvatar = document.getElementById("btn-profile-avatar");
        const profileDropdown = document.getElementById("profile-dropdown");

        if (btnAvatar && profileDropdown) {
            btnAvatar.addEventListener("click", (e) => {
                e.stopPropagation();
                profileDropdown.classList.toggle("hidden");
            });

            window.addEventListener("click", (e) => {
                if (
                    !profileDropdown.contains(e.target as Node) &&
                    !btnAvatar.contains(e.target as Node)
                ) {
                    profileDropdown.classList.add("hidden");
                }
            });
        }

        // Logout Logic
        const handleLogout = async () => {
            const confirmed = await (window as any).showConfirmModal(
                "Konfirmasi Logout",
                "Apakah Anda yakin ingin keluar?",
            );
            if (!confirmed) return;

            localStorage.removeItem("jwt_token");
            localStorage.removeItem("user_data");
            if (
                typeof window !== "undefined" &&
                (window as any).showFeedbackModal
            ) {
                (window as any).showFeedbackModal(
                    "success",
                    "Berhasil",
                    "Anda telah berhasil keluar.",
                    "/",
                );
            } else {
                alert("Anda telah berhasil keluar.");
                window.location.href = "/";
            }
        };

        document
            .getElementById("btn-logout")
            ?.addEventListener("click", handleLogout);
        document
            .getElementById("mobile-btn-logout")
            ?.addEventListener("click", handleLogout);

        // Mobile Menu Toggle
        const btnHamburger = document.getElementById("btn-hamburger");
        const mobileMenu = document.getElementById("mobile-menu");
        const iconHamburger = document.getElementById("icon-hamburger");
        const iconClose = document.getElementById("icon-close");

        if (btnHamburger && mobileMenu && iconHamburger && iconClose) {
            btnHamburger.addEventListener("click", () => {
                const isHidden = mobileMenu.classList.toggle("hidden");
                iconHamburger.classList.toggle("hidden", !isHidden);
                iconClose.classList.toggle("hidden", isHidden);
            });
        }
    };

    document.addEventListener("DOMContentLoaded", setupNavbar);
    document.addEventListener("astro:page-load", setupNavbar);
</script>
