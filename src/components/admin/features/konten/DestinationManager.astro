---
// File: src/components/admin/features/konten/DestinationManager.astro
import Button from "../../../ui/Button.astro";

// Mock Data Destinasi
const destinations = [
    { id: 1, name: "Pantai Pangandaran", location: "Jawa Barat", image: "https://c1.wallpaperflare.com/preview/864/690/351/pantai-kuta-kuta-bali-indonesia.jpg", desc: "Pantai dengan pasir putih dan cagar alam." },
    { id: 2, name: "Green Canyon", location: "Pangandaran", image: "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&q=80&w=800", desc: "Ngarai hijau dengan sungai jernih." },
];
---

<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between px-2">
        <h3 class="text-lg font-black text-slate-900">Destinasi Favorit</h3>
        <button class="bg-primary text-white px-4 py-2 rounded-xl text-xs font-bold hover:scale-105 active:scale-95 transition-all">
            + Tambah Destinasi
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {destinations.map(dest => (
            <div class="bg-white p-4 rounded-[1.5rem] border border-slate-100 shadow-sm flex flex-col gap-4 group">
                <div class="relative h-32 rounded-xl overflow-hidden">
                    <img src={dest.image} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <div class="absolute inset-0 bg-black/20"></div>
                    <button class="absolute top-2 right-2 w-8 h-8 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white hover:bg-rose-500 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                </div>
                <div class="flex flex-col gap-1 px-1">
                    <h4 class="font-black text-slate-800">{dest.name}</h4>
                    <p class="text-xs text-slate-400 font-secondary flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.012 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        {dest.location}
                    </p>
                    <p class="text-[10px] text-slate-500 font-secondary leading-relaxed mt-2 line-clamp-2">{dest.desc}</p>
                </div>
                <div class="mt-auto pt-3 border-t border-slate-50 flex gap-2">
                    <button class="flex-1 bg-slate-50 text-slate-600 py-2 rounded-lg text-[10px] font-bold hover:bg-primary hover:text-white transition-colors">Edit Detail</button>
                </div>
            </div>
        ))}
    </div>
</div>
