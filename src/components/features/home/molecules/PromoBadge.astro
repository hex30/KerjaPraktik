---
// File: src/components/features/home/molecules/PromoBadge.astro
interface Props {
    discount: string;
    noteTitle: string;
    noteDesc: string;
}

const { discount, noteTitle, noteDesc } = Astro.props;
---

<div class="bg-slate-50 border border-slate-100 rounded-bg p-6 flex items-center justify-between shadow-xs">
    <div class="text-2xl md:text-3xl font-black text-sky-500 tracking-tight leading-none">
        {discount}
    </div>

    <div class="text-right font-secondary text-xs text-text-secondary leading-tight">
        <p class="font-bold text-primary">
            {noteTitle}
        </p>
        <p>
            {noteDesc}
        </p>
    </div>
</div>
