---
// File: src/components/DestinationCard.astro
interface Props {
    image: string;
    title: string;
    location: string;
    description: string; // Tambahan prop deskripsi
}

const { image, title, location, description } = Astro.props;
---

<div
    class="destination-card-trigger flex flex-col gap-[10px] group cursor-pointer transition-all duration-500 ease-out hover:-translate-y-3"
    data-title={title}
    data-location={location}
    data-image={image}
    data-description={description}
>
    <div
        class="relative w-full h-[220px] md:h-[280px] rounded-[15px] overflow-hidden shadow-md bg-slate-200 flex-shrink-0"
    >
        <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-110 group-hover:rotate-2"
        />
        <div
            class="absolute inset-0 bg-primary/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        >
        </div>
    </div>

    <div class="px-2 flex flex-col gap-2">
        <h3 class="font-main font-black text-xl text-primary md:text-slate-500 leading-tight group-hover:text-primary transition-colors line-clamp-1">
            {title}
        </h3>

        <p class="font-secondary text-xs text-black md:text-slate-500 group-hover:text-black transition-colors line-clamp-2 mt-1 leading-relaxed">
            {description}
        </p>

        <p class="font-secondary text-sm text-primary md:text-slate-500 group-hover:text-[#c29a5c] transition-colors flex items-center gap-1.5 font-medium line-clamp-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary md:text-slate-400 group-hover:text-[#c29a5c] transition-colors flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
            </svg>
            {location}
        </p>
    </div>
</div>
