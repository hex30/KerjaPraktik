---
// File: src/components/DestinationCard.astro
interface Props {
    image: string;
    title: string;
    location: string;
    description: string; // Tambahan prop deskripsi
}

const { image, title, location, description } = Astro.props;
---

<div
    class="destination-card-trigger flex flex-col gap-5 group cursor-pointer transition-all duration-500 ease-out hover:-translate-y-3"
    data-title={title}
    data-location={location}
    data-image={image}
    data-description={description}
>
    <div
        class="relative my-5 w-full h-[220px] md:h-[280px] rounded-[15px] overflow-hidden shadow-md bg-slate-200"
    >
        <img
            src={image}
            alt={title}
            class="w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-110 group-hover:rotate-2"
        />
        <div
            class="absolute inset-0 bg-primary/20 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        >
        </div>
    </div>

    <div class="px-1 space-y-2">
        <h3
            class="font-main font-black text-xl text-primary leading-tight transition-colors duration-300 group-hover:text-sky-500"
        >
            {title}
        </h3>

        <div class="flex items-center gap-2">
            <div
                class="w-6 h-[2px] bg-secondary transition-all duration-500 group-hover:w-10"
            >
            </div>
            <p
                class="font-secondary text-sm text-text-secondary flex items-center gap-1.5 font-medium"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-sky-500"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                >
                    <path
                        fill-rule="evenodd"
                        d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                        clip-rule="evenodd"></path>
                </svg>
                {location}
            </p>
        </div>
    </div>
</div>
