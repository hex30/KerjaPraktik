---
// File: src/components/features/home/molecules/DestinationDetail.astro
import Button from "../../../ui/Button.astro";
---

<div id="detail-section" class="hidden animate-fade-in w-full h-full bg-white">
    <button id="btn-back-carousel" class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
        </svg>
        Kembali ke Daftar Destinasi
    </button>

    <div class="flex flex-col lg:flex-row gap-10 items-start">
        <div class="w-full lg:w-[30%]">
            <div class="w-full h-[280px] rounded-[15px] overflow-hidden shadow-md mb-5">
                <img id="detail-image" src="" alt="Preview" class="w-full h-full object-cover" />
            </div>
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-sky-500" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <span id="detail-location" class="font-secondary text-sm font-bold text-text-secondary"></span>
            </div>
        </div>

        <div class="w-full lg:w-[70%] flex flex-col gap-6 pt-2">
            <h2 id="detail-title" class="text-3xl md:text-5xl font-black text-primary font-main leading-tight"></h2>
            <div class="w-16 h-1.5 bg-secondary rounded-full"></div>
            <p id="detail-desc" class="font-secondary text-base md:text-lg text-text-secondary leading-relaxed max-w-2xl"></p>
            <div class="pt-4">
                <a 
                    id="detail-cta" 
                    href="/services" 
                    class="inline-flex items-center justify-center px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 gap-2"
                >
                    Pesan Tiket Sekarang
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>







