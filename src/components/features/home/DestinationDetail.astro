---
// File: src/components/features/home/DestinationDetail.astro
// Komponen kartu detail destinasi untuk Astro, dibuat dengan Tailwind CSS 
// Mereplikasi desain 1:1 dari image_0.png dan diadaptasi untuk mobile responsif.

interface Props {
  label?: string; // Label "DESTINATION DETAIL"
}

const {
  label = "DESTINATION DETAIL",
} = Astro.props;
---

<div id="detail-section" class="hidden animate-fade-in w-full py-12 md:py-24">
  <div class="relative bg-white rounded-[2rem] p-8 md:p-12 lg:min-h-[38rem] shadow-xl font-main text-left flex flex-col md:block mt-16 md:mt-0">
    
    {/* Wadah lengkungan gambar yang tumpang tindih */}
    <div class="relative md:absolute -mt-32 md:mt-0 md:-top-12 md:-left-12 mx-auto md:mx-0 w-56 h-56 md:w-[34rem] md:h-[34rem] rounded-full border-[6px] md:border-8 border-[#063137] overflow-hidden z-10 shrink-0 bg-slate-100 shadow-xl">
      <img
        id="detail-image"
        src=""
        alt="Detail Destinasi"
        class="w-full h-full object-cover rounded-full transition-transform duration-700 hover:scale-110"
      />
    </div>

    {/* Tombol Kembali melingkar */}
    <button
      id="btn-back-carousel"
      class="absolute top-4 left-4 md:top-8 md:left-8 w-12 h-12 md:w-14 md:h-14 bg-white rounded-full shadow-lg flex items-center justify-center border border-gray-100 hover:scale-105 transition-transform z-20 text-[#063137]"
      aria-label="Kembali"
    >
      {/* Ikon panah kiri */}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 md:w-7 md:h-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
    </button>

    {/* Area Konten - digeser ke kanan untuk memberi ruang bagi lengkungan pada Desktop, di bawah pada Mobile */}
    <div class="md:pl-[36rem] flex flex-col items-center md:items-start justify-center h-full relative z-0 mt-8 md:mt-0 text-center md:text-left">
      
      {/* Label Cokelat */}
      <div class="flex items-center gap-2 mb-2">
        <span id="detail-location" class="text-xs md:text-sm font-bold text-[#B19B69] uppercase tracking-[0.2em]"></span>
        <span class="text-xs md:text-sm text-slate-300">|</span>
        <span class="text-xs md:text-sm font-bold text-[#B19B69] uppercase tracking-[0.2em]">{label}</span>
      </div>

      {/* Judul Besar Teal */}
      <h1 id="detail-title" class="text-4xl md:text-5xl lg:text-6xl font-black text-[#063137] leading-tight mb-4 tracking-tight"></h1>

      {/* Garis Pemisah Kuning-Emas */}
      <div class="h-1 w-16 bg-[#ECB93F] mb-6"></div>

      {/* Teks Deskripsi Abu-abu */}
      <p id="detail-desc" class="text-base md:text-lg text-gray-700 leading-relaxed max-w-prose font-secondary"></p>

      {/* Tombol Pesan Tiket */}
      <a
        id="detail-cta"
        href="#"
        class="mt-8 md:mt-12 px-8 md:px-10 py-4 md:py-5 bg-[#063137] text-white rounded-xl font-bold text-lg md:text-xl flex items-center gap-4 hover:bg-[#084149] transition-colors shadow-lg group"
      >
        <span>Pesan Tiket Sekarang</span>
        
        {/* Wadah melingkar di dalam tombol untuk ikon panah */}
        <div class="w-8 h-8 md:w-10 md:h-10 bg-[#063137] rounded-full flex items-center justify-center border border-white/20 group-hover:bg-white/10 transition-colors">
          {/* Ikon panah kanan */}
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </div>
      </a>
    </div>
  </div>
</div>