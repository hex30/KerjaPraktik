---
// File: src/components/DestinationFav.astro
import DestinationCard from "./DestinationCard.astro";

// Tambahkan deskripsi pada setiap data destinasi
const destinations = [
    {
        image: "https://c1.wallpaperflare.com/preview/864/690/351/pantai-kuta-kuta-bali-indonesia.jpg",
        title: "Pantai Pangandaran",
        location: "Jawa Barat, Indonesia",
        description:
            "Nikmati keindahan pantai pasir putih, deburan ombak yang cocok untuk berselancar, dan cagar alam menakjubkan di salah satu destinasi wisata terbaik di Jawa Barat.",
    },
    {
        image: "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&q=80&w=800",
        title: "Green Canyon",
        location: "Pangandaran, Indonesia",
        description:
            "Jelajahi keajaiban alam berupa ngarai hijau nan eksotis dengan aliran sungai jernih. Nikmati sensasi body rafting menembus gua dan stalaktit yang memukau.",
    },
    {
        image: "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&q=80&w=800",
        title: "Kawah Putih",
        location: "Bandung, Indonesia",
        description:
            "Saksikan pemandangan magis danau kawah vulkanik berwarna putih kehijauan yang diselimuti kabut tipis di kawasan pegunungan sejuk Ciwidey.",
    },
    // Tambahkan destinasi lain jika perlu...
];
---

<section class="max-w-7xl mx-auto px-6 py-16 relative min-h-[500px]">
    <div id="carousel-section" class="block animate-fade-in">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
        >
            <div class="space-y-2">
                <h2
                    class="text-3xl md:text-4xl font-black text-primary font-main"
                >
                    Popular Destinations
                </h2>
                <p class="font-secondary text-text-secondary">
                    Capai banyak destinasi wisata menarik yang bisa kamu
                    jelajahi bersama kami.
                </p>
            </div>

            <div class="flex gap-3">
                <button
                    id="dest-prev"
                    class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-text-secondary hover:bg-slate-200 transition-colors cursor-pointer select-none"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 19.5L8.25 12l7.5-7.5"></path></svg
                    >
                </button>
                <button
                    id="dest-next"
                    class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white shadow-md hover:opacity-90 transition-opacity cursor-pointer select-none"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M8.25 4.5l7.5 7.5-7.5 7.5"></path></svg
                    >
                </button>
            </div>
        </div>

        <div
            id="destination-container"
            class="flex gap-5 overflow-x-auto snap-x mandatory scroll-smooth pb-6 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
        >
            {
                destinations.map((dest) => (
                    <div class="w-full md:w-[calc(33.333%-22px)] flex-shrink-0 snap-start">
                        <DestinationCard
                            image={dest.image}
                            title={dest.title}
                            location={dest.location}
                            description={dest.description}
                        />
                    </div>
                ))
            }
        </div>
    </div>

    <div
        id="detail-section"
        class="hidden animate-fade-in w-full h-full bg-white"
    >
        <button
            id="btn-back-carousel"
            class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                viewBox="0 0 20 20"
                fill="currentColor"
            >
                <path
                    fill-rule="evenodd"
                    d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                    clip-rule="evenodd"></path>
            </svg>
            Kembali ke Daftar Destinasi
        </button>

        <div class="flex flex-col lg:flex-row gap-10 items-start">
            <div class="w-full lg:w-[30%]">
                <div
                    class="w-full h-[280px] rounded-[15px] overflow-hidden shadow-md mb-5"
                >
                    <img
                        id="detail-image"
                        src=""
                        alt="Preview"
                        class="w-full h-full object-cover"
                    />
                </div>
                <div class="flex items-center gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 text-sky-500"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <span
                        id="detail-location"
                        class="font-secondary text-sm font-bold text-text-secondary"
                    ></span>
                </div>
            </div>

            <div class="w-full lg:w-[70%] flex flex-col gap-6 pt-2">
                <h2
                    id="detail-title"
                    class="text-3xl md:text-5xl font-black text-primary font-main leading-tight"
                >
                </h2>

                <div class="w-16 h-1.5 bg-secondary rounded-full"></div>

                <p
                    id="detail-desc"
                    class="font-secondary text-base md:text-lg text-text-secondary leading-relaxed max-w-2xl"
                >
                </p>

                <div class="pt-4">
                    <a
                        id="detail-cta"
                        href="/layanan/booking"
                        class="inline-flex items-center justify-center px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 gap-2"
                    >
                        Pesan Tiket Sekarang
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2.5"
                            stroke="currentColor"
                            class="w-5 h-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    const initDestinationFeatures = () => {
        // --- 1. Logika Navigasi Carousel ---
        const container = document.getElementById("destination-container");
        const prevBtn = document.getElementById("dest-prev");
        const nextBtn = document.getElementById("dest-next");

        if (container && prevBtn && nextBtn) {
            const getScrollAmount = () => {
                const firstCard = container.querySelector(".flex-shrink-0");
                return firstCard ? firstCard.clientWidth + 20 : 300;
            };

            nextBtn.addEventListener(
                "click",
                () => (container.scrollLeft += getScrollAmount()),
            );
            prevBtn.addEventListener(
                "click",
                () => (container.scrollLeft -= getScrollAmount()),
            );
        }

        // --- 2. Logika Interaksi Card -> Detail View ---
        const cards = document.querySelectorAll(".destination-card-trigger");
        const carouselSection = document.getElementById("carousel-section");
        const detailSection = document.getElementById("detail-section");
        const backBtn = document.getElementById("btn-back-carousel");

        // Elemen-elemen di dalam detail view yang akan diubah datanya
        const detailImage = document.getElementById(
            "detail-image",
        ) as HTMLImageElement;
        const detailTitle = document.getElementById("detail-title");
        const detailLocation = document.getElementById("detail-location");
        const detailDesc = document.getElementById("detail-desc");
        const detailCta = document.getElementById(
            "detail-cta",
        ) as HTMLAnchorElement;

        cards.forEach((card) => {
            card.addEventListener("click", () => {
                // Ambil data dari atribut kartu yang diklik
                const title = card.getAttribute("data-title") || "";
                const location = card.getAttribute("data-location") || "";
                const image = card.getAttribute("data-image") || "";
                const desc = card.getAttribute("data-description") || "";

                // Suntikkan data ke dalam Detail View
                if (detailImage) detailImage.src = image;
                if (detailTitle) detailTitle.textContent = title;
                if (detailLocation) detailLocation.textContent = location;
                if (detailDesc) detailDesc.textContent = desc;

                // Memodifikasi URL pada tombol CTA dengan membawa Query Parameter tujuan
                // Sesuaikan 'path' /layanan/booking dengan struktur routing Anda
                if (detailCta) {
                    detailCta.href = `/layanan?tujuan=${encodeURIComponent(title)}#booking-component`;
                }

                // Sembunyikan Carousel, Tampilkan Detail
                if (carouselSection && detailSection) {
                    carouselSection.classList.add("hidden");
                    carouselSection.classList.remove("block");

                    detailSection.classList.remove("hidden");
                    detailSection.classList.add("block");
                }
            });
        });

        // Logika Tombol Kembali
        if (backBtn && carouselSection && detailSection) {
            backBtn.addEventListener("click", () => {
                detailSection.classList.add("hidden");
                detailSection.classList.remove("block");

                carouselSection.classList.remove("hidden");
                carouselSection.classList.add("block");
            });
        }
    };

    // Dukungan untuk transisi halaman Astro ViewTransitions
    document.addEventListener("DOMContentLoaded", initDestinationFeatures);
    document.addEventListener("astro:page-load", initDestinationFeatures);
</script>
