---
// File: src/components/features/home/FavoritDestination.astro
import DestinationCard from "./DestinationCard.astro";
import { adminContentService } from "@services/adminContentService";

// Tarik data destinasi dari BE
const destinations = await adminContentService.getDestinations();
---

<section class="max-w-7xl mx-auto px-6 py-16 relative font-main min-h-[500px]">
    <div id="carousel-section" class="block animate-fade-in">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-4"
        >
            <div class="space-y-2">
                <h2
                    class="text-3xl md:text-4xl font-black text-primary font-main"
                >
                    Popular Destinations
                </h2>
                <p class="font-secondary text-text-secondary">
                    Capai banyak destinasi wisata menarik yang bisa kamu
                    jelajahi bersama kami.
                </p>
            </div>
        </div>

        <div
            id="destination-container"
            class="flex gap-5 overflow-x-auto snap-x mandatory scroll-smooth pt-8 pb-6 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
        >
            {
                destinations.map((dest) => (
                    <div class="w-[85vw] sm:w-[45%] md:w-[28%] flex-shrink-0 snap-start">
                        <DestinationCard
                            image={dest.image_url || dest.image || ""}
                            title={dest.name || dest.title || ""}
                            location={dest.location || ""}
                            description={dest.description || ""}
                        />
                    </div>
                ))
            }
        </div>
    </div>

    <div id="detail-section" class="hidden animate-fade-in w-full h-full">
        <div
            class="flex flex-col md:flex-row items-center justify-center w-full py-8 md:py-12 max-w-5xl mx-auto"
        >
            <!-- KIRI: Circular Image + Back Button -->
            <div class="relative z-10 flex-shrink-0">
                <button
                    id="btn-back-carousel"
                    class="absolute top-[10%] -left-1 md:top-[12%] md:-left-6 z-20 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white shadow-[0_4px_15px_rgba(0,0,0,0.1)] border border-slate-100 flex items-center justify-center text-[#043e48] hover:bg-slate-50 transition-colors cursor-pointer"
                    aria-label="Kembali"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </button>

                <!-- Image Circle -->
                <div
                    class="w-[260px] h-[260px] sm:w-[320px] sm:h-[320px] md:w-[400px] md:h-[400px] rounded-full border-[6px] md:border-[8px] border-[#043e48] overflow-hidden shadow-2xl bg-slate-200"
                >
                    <img
                        id="detail-image"
                        src=""
                        alt="Destination Detail"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>

            <!-- KANAN: Text Card -->
            <div
                class="relative z-0 flex-1 bg-white rounded-[30px] md:rounded-[40px] border border-slate-200 shadow-[0_8px_30px_rgb(0,0,0,0.06)] p-6 md:p-12 pt-[150px] sm:pt-[180px] md:pt-12 md:pl-[240px] -mt-[130px] sm:-mt-[160px] md:mt-0 md:-ml-[200px] w-full max-w-[850px] flex flex-col justify-center min-h-[350px] md:min-h-[400px]"
            >
                <p
                    class="text-[#c29a5c] font-bold text-[10px] md:text-xs tracking-[0.25em] uppercase mb-3 font-secondary"
                >
                    Destination Detail
                </p>

                <h2
                    id="detail-title"
                    class="text-[#043e48] font-black text-4xl md:text-[3.5rem] mb-4 leading-tight font-main tracking-tight"
                >
                </h2>

                <div
                    class="w-16 md:w-20 h-1.5 md:h-2 bg-[#f0c24c] rounded-full mb-6"
                >
                </div>

                <p
                    id="detail-desc"
                    class="text-slate-500 font-secondary text-sm md:text-base leading-relaxed mb-8 md:mb-10 max-w-lg"
                >
                </p>

                <a
                    id="detail-cta"
                    href="/layanan/booking"
                    class="inline-flex items-center gap-3 px-6 py-3.5 bg-[#044b55] hover:bg-[#03343b] transition-colors rounded-xl text-white font-secondary font-semibold shadow-lg group w-max"
                >
                    Pesan Tiket Sekarang
                    <div
                        class="w-7 h-7 rounded-full bg-white/20 flex items-center justify-center group-hover:bg-white/30 transition-colors"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-3.5 w-3.5 md:h-4 md:w-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="3"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    const initDestinationFeatures = () => {
        // Interaksi Card ke Detail View
        const cards = document.querySelectorAll(".destination-card-trigger");
        const carouselSection = document.getElementById("carousel-section");
        const detailSection = document.getElementById("detail-section");
        const backBtn = document.getElementById("btn-back-carousel");

        const detailImage = document.getElementById(
            "detail-image",
        ) as HTMLImageElement;
        const detailTitle = document.getElementById("detail-title");
        const detailLocation = document.getElementById("detail-location");
        const detailDesc = document.getElementById("detail-desc");
        const detailCta = document.getElementById(
            "detail-cta",
        ) as HTMLAnchorElement;

        cards.forEach((card) => {
            card.addEventListener("click", () => {
                const title = card.getAttribute("data-title") || "";
                const location = card.getAttribute("data-location") || "";
                const image = card.getAttribute("data-image") || "";
                const desc = card.getAttribute("data-description") || "";

                if (detailImage) detailImage.src = image;
                if (detailTitle) detailTitle.textContent = title;
                if (detailLocation) detailLocation.textContent = location;
                if (detailDesc) detailDesc.textContent = desc;

                if (detailCta) {
                    detailCta.href = `/services?tujuan=${encodeURIComponent(title)}#booking-component`;
                }

                if (carouselSection && detailSection) {
                    carouselSection.classList.add("hidden");
                    carouselSection.classList.remove("block");
                    detailSection.classList.remove("hidden");
                    detailSection.classList.add("block");
                }
            });
        });

        // Tombol Kembali
        if (backBtn && carouselSection && detailSection) {
            backBtn.addEventListener("click", () => {
                detailSection.classList.add("hidden");
                detailSection.classList.remove("block");
                carouselSection.classList.remove("hidden");
                carouselSection.classList.add("block");
            });
        }
    };

    document.addEventListener("DOMContentLoaded", initDestinationFeatures);
    document.addEventListener("astro:page-load", initDestinationFeatures);
</script>
