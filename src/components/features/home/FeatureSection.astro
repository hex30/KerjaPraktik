---
import FeatureItems from "./FeatureItems.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

const features = [
    {
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
        title: "Beragam Layanan",
        desc: "Layanan antar jemput rutin untuk keberangkatan Ciamis-Jakarta, dengan penjemputan dari pintu ke pintu.",
    },
    {
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`,
        title: "Fasilitas Eksklusif",
        desc: "Armada kami dilengkapi AC dingin, kursi yang nyaman, dan dikemudikan oleh supir profesional demi keamanan Anda.",
    },
    {
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 9m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3" /></svg>`,
        title: "Harga Terjangkau",
        desc: "Nikmati perjalanan kelas premium via jalan tol dengan tarif yang sangat bersahabat untuk rute antar kota Anda.",
    },
];
---

<section class="max-w-7xl mx-auto px-6 py-20 font-main">
    <SectionHeader 
        title="Mengapa Memilih Kami"
        subtitle="Prioritas kami adalah memastikan setiap perjalanan Anda aman, nyaman, dan sampai di tujuan dengan senyuman."
        align="center"
        titleClass="text-3xl md:text-4xl lg:text-5xl font-black text-primary leading-tight mb-4"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-8">
        {
            features.map((feature) => (
                <FeatureItems
                    icon={feature.icon}
                    title={feature.title}
                    desc={feature.desc}
                />
            ))
        }
    </div>
</section>



