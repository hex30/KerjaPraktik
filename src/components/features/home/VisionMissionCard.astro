---
// File: src/components/features/home/molecules/VisionMissionCard.astro
interface Props {
    title: string;
    icon: string;
    variant?: "sky" | "blue";
}

const { title, icon, variant = "sky" } = Astro.props;

const variants = {
    sky: "bg-sky-50 text-sky-600",
    blue: "bg-blue-50 text-blue-600"
};
---

<div class="bg-white p-8 md:p-12 rounded-[2rem] shadow-sm border border-slate-100 hover:shadow-md transition-shadow h-full">
    <div class:list={["w-16 h-16 rounded-2xl flex items-center justify-center mb-6", variants[variant]]} set:html={icon} />
    <h3 class="text-2xl font-black text-primary mb-4">{title}</h3>
    <div class="font-secondary text-text-secondary leading-relaxed">
        <slot />
    </div>
</div>







