---
import PromoBadge from "./molecules/PromoBadge.astro";
import PromoTextRow from "./molecules/PromoTextRow.astro";

const promo = {
    image: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=800",
    discount: "10% OFF",
    noteTitle: "Khusus Minggu Ini",
    noteDesc: "Rute Ciamis - Jakarta",
    textRow1: "Nikmati",
    textDesc1: "Perjalanan rutin antar-jemput Ciamis - Jakarta dengan layanan premium, armada eksekutif, dan supir profesional.",
    textRow2: "Perjalanan Premium",
    textDesc2: "Dapatkan kenyamanan ekstra via jalan tol penuh dengan fasilitas AC, reclining seat, and ruang bagasi yang luas.",
    textRow3: "Bersama Kami",
    btnLink: "#booking",
    btnText: "Pesan Tiket Sekarang",
};
---

<section class="max-w-5xl mx-auto px-6 py-16 font-main">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        
        <div class="lg:col-span-4 flex flex-col gap-6">
            <div class="w-full h-[350px] md:h-[400px] rounded-bg overflow-hidden shadow-md">
                <img
                    src={promo.image}
                    alt="Promo Rini Trans Putri"
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                />
            </div>

            <PromoBadge 
                discount={promo.discount}
                noteTitle={promo.noteTitle}
                noteDesc={promo.noteDesc}
            />
        </div>

        <div class="lg:col-span-8 flex flex-col justify-between gap-8 py-2">
            
            <div class="flex flex-col gap-6">
                <PromoTextRow text={promo.textRow1} description={promo.textDesc1} />
                <PromoTextRow text={promo.textRow2} />
                <PromoTextRow text={promo.textRow3} description={promo.textDesc2} align="right" />
            </div>

            <a href={promo.btnLink}
                class="relative w-full py-6 rounded-bg overflow-hidden flex items-center justify-center gap-3 font-main font-bold text-lg text-white shadow-md group border border-sky-100/50"
            >
                <div class="absolute inset-0 z-0 bg-btn-linear">
                    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1534088568595-a066f410bcda?auto=format&fit=crop&q=80&w=600')] bg-cover bg-center opacity-10 mix-blend-overlay"></div>
                </div>
                <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-[-4px]">{promo.btnText}</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 relative z-10 text-white transition-transform duration-300 group-hover:translate-x-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
    </div>
</section>