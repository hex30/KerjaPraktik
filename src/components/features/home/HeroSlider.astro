---
// File: src/components/features/home/HeroSlider.astro

interface Slide {
  id: number;
  sub: string;
  title: string;
  desc: string;
  btnText: string;
  btnLink: string;
  bgImage: string;
}

interface Props {
  slides?: Slide[];
}

const { slides = [] } = Astro.props;

// Jika DB kosong, buat 1 slide kosong agar layout tetap muncul
const displaySlides =
  slides.length > 0
    ? slides
    : [
        {
          id: 0,
          sub: "",
          title: "Tidak ada data banner",
          desc: "",
          btnText: "",
          btnLink: "#",
          bgImage: "",
        },
      ];
---

<section class="relative max-w-7xl mx-auto px-6 py-6 font-main">
  <div
    class="relative w-full h-[500px] md:h-[600px] rounded-[2rem] overflow-hidden shadow-lg bg-slate-900 flex items-center justify-center text-slate-500"
  >
    {
      displaySlides.map((slide, index) => (
        <div
          class:list={[
            "hero-slide absolute inset-0 w-full h-full grid md:grid-cols-12 items-center p-8 md:p-16 transition-all duration-700 ease-in-out",
            index === 0 ? "opacity-100 z-10" : "opacity-0 z-0",
          ]}
          data-index={index}
        >
          <div class="absolute inset-0 z-0">
            <img
              src={slide.bgImage}
              alt={slide.title}
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-transparent" />
          </div>

          <div class="relative z-10 md:col-span-7 pl-20 md:pl-24 space-y-4 md:space-y-6">
            <span class="text-sm md:text-xl font-secondary font-bold text-secondary tracking-widest block uppercase">
              {slide.sub}
            </span>
            <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl xl:text-[70px] break-words whitespace-normal w-full max-w-[95%] lg:max-w-4xl font-black text-primary leading-tight uppercase">
              {slide.title}
            </h1>
            <p class="text-sm md:text-base text-text-secondary font-secondary font-normal max-w-xl leading-relaxed">
              {slide.desc}
            </p>
          </div>
        </div>
      ))
    }

    <!-- Indicators -->
    <div
      class="absolute left-6 md:left-12 top-1/2 -translate-y-1/2 z-20 flex flex-col gap-6 items-center"
    >
      <div class="absolute w-[2px] bg-primary/20 h-full -z-10"></div>
      {
        displaySlides.map((_, index) => (
          <button
            class:list={[
              "slide-indicator w-8 h-8 rounded-full flex items-center justify-center font-main font-bold text-xs border-2 transition-all duration-300 cursor-pointer",
              index === 0
                ? "bg-primary border-primary text-white scale-110 shadow-md"
                : "bg-white border-primary/20 text-text-secondary hover:border-primary",
            ]}
            data-target={index}
            aria-label={`Go to slide ${index + 1}`}
          >
            {index + 1}
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  const initSlider = () => {
    const slides = document.querySelectorAll(".hero-slide");
    const indicators = document.querySelectorAll(".slide-indicator");
    let currentIndex = 0;
    const slideInterval = 10000;

    const changeSlide = (nextIndex: number) => {
      // Remove active classes from current
      slides[currentIndex].classList.replace("opacity-100", "opacity-0");
      slides[currentIndex].classList.replace("z-10", "z-0");

      indicators[currentIndex].classList.remove(
        "bg-primary",
        "border-primary",
        "text-white",
        "scale-110",
        "shadow-md",
      );
      indicators[currentIndex].classList.add(
        "bg-white",
        "border-primary/20",
        "text-text-secondary",
      );

      // Add active classes to next
      slides[nextIndex].classList.replace("opacity-0", "opacity-100");
      slides[nextIndex].classList.replace("z-0", "z-10");

      indicators[nextIndex].classList.remove(
        "bg-white",
        "border-primary/20",
        "text-text-secondary",
      );
      indicators[nextIndex].classList.add(
        "bg-primary",
        "border-primary",
        "text-white",
        "scale-110",
        "shadow-md",
      );

      currentIndex = nextIndex;
    };

    const nextSlides = () => {
      let next = (currentIndex + 1) % slides.length;
      changeSlide(next);
    };

    let timer = setInterval(nextSlides, slideInterval);

    indicators.forEach((indicator) => {
      indicator.addEventListener("click", () => {
        clearInterval(timer);
        const targetIndex = parseInt(
          indicator.getAttribute("data-target") || "0",
        );
        if (targetIndex !== currentIndex) {
          changeSlide(targetIndex);
        }
        timer = setInterval(nextSlides, slideInterval);
      });
    });
  };

  document.addEventListener("DOMContentLoaded", initSlider);
  document.addEventListener("astro:page-load", initSlider);
</script>
