---
// File: src/components/admin/features/paket/PackageItem.astro
import AdminBadge from "../../../ui/AdminBadge.astro";
import Button from "../../../ui/Button.astro";

interface Props {
    pkg: any;
}

const { pkg } = Astro.props;
---

<div class="package-card bg-white border border-slate-100 rounded-[1.5rem] shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md group">
    <div class="p-6 md:p-8 cursor-pointer flex flex-col md:flex-row justify-between items-start md:items-center gap-6 toggle-trigger">
        <div class="flex flex-col gap-3 w-full md:w-auto">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-[10px] font-black font-main px-2.5 py-1 bg-sky-50 text-sky-600 rounded-md uppercase tracking-wider">
                    PAKET: #{pkg.id}
                </span>
                <span class="text-xs text-slate-400 font-secondary font-medium">
                    {pkg.origin} ➔ {pkg.destination}
                </span>
            </div>
            
            <div>
                <h2 class="text-lg md:text-xl font-black text-slate-800 tracking-tight group-hover:text-primary transition-colors">
                    {pkg.sender.name} <span class="text-slate-300 font-medium">to</span> {pkg.receiver.name}
                </h2>
                <div class="flex items-center gap-3 mt-1">
                    <p class="font-secondary text-sm text-text-secondary">
                        {pkg.type} | <span class="font-bold text-primary">{pkg.weight}</span>
                    </p>
                    {pkg.is_super_besar && (
                        <span class="px-2 py-0.5 bg-rose-100 text-rose-600 text-[9px] font-black uppercase rounded tracking-tighter">
                            Memakan 2 Kursi
                        </span>
                    )}
                </div>
            </div>
        </div>

        <div class="flex flex-row md:flex-col items-center md:items-end justify-between w-full md:w-auto gap-4 md:gap-2">
            <AdminBadge status={pkg.status} />
            <div class="flex items-center gap-2 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300 chevron-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>
    </div>

    <div class="expand-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out bg-slate-50/50">
        <div class="p-6 md:p-8 border-t border-slate-100 grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-xs">
                    <h4 class="text-[10px] font-black text-sky-500 uppercase tracking-widest mb-3">Detail Pengirim</h4>
                    <p class="text-sm font-bold text-slate-900 mb-1">{pkg.sender.name}</p>
                    <p class="text-xs text-slate-500 font-secondary mb-3">{pkg.sender.phone}</p>
                    <div class="pt-3 border-t border-slate-50">
                        <p class="text-[10px] text-slate-400 font-bold uppercase mb-1">Alamat Jemput</p>
                        <p class="text-xs text-slate-600 leading-relaxed">{pkg.sender.address || "Dusun Cikodang, RT 01/RW 02, Desa Nagarajaya"}</p>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-xs">
                    <h4 class="text-[10px] font-black text-amber-500 uppercase tracking-widest mb-3">Detail Penerima</h4>
                    <p class="text-sm font-bold text-slate-900 mb-1">{pkg.receiver.name}</p>
                    <p class="text-xs text-slate-500 font-secondary mb-3">{pkg.receiver.phone}</p>
                    <div class="pt-3 border-t border-slate-50">
                        <p class="text-[10px] text-slate-400 font-bold uppercase mb-1">Alamat Tujuan</p>
                        <p class="text-xs text-slate-600 leading-relaxed">{pkg.receiver.address || "Jl. Raya Jakarta No. 123, Kemang"}</p>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col gap-6">
                <h4 class="text-xs font-black text-slate-400 uppercase tracking-widest">Kelola Status & Biaya</h4>
                
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-500">Harga Ongkos Kirim (IDR)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm">Rp</span>
                            <input type="number" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-3 font-main font-bold text-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                        </div>
                    </div>
                    
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-500">Tugaskan Armada Kurir</label>
                        <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-medium focus:outline-none">
                            <option value="">Pilih Armada Antar Paket...</option>
                            <option value="k1">Kurir 1 - Motor</option>
                            <option value="k2">Mobil Box - L300</option>
                        </select>
                    </div>
                </div>

                <div class="mt-2 flex gap-3">
                    <Button class="flex-1" size="md">Verifikasi Paket</Button>
                    <button class="px-5 py-2.5 rounded-xl border border-rose-100 text-rose-500 font-bold text-sm hover:bg-rose-50 transition-all">Batalkan</button>
                </div>
            </div>
        </div>
    </div>
</div>







