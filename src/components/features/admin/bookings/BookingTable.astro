---
// File: src/components/features/admin/bookings/BookingTable.astro
import AdminBadge from "@ui/AdminBadge.astro";
import Button from "@ui/Button.astro";
import BookingRow from "./BookingRow.astro";
import PaymentPreviewModal from "./PaymentPreviewModal.astro";

/**
 * DATA CONTRACT: The expected structure for a booking item from the Back-End.
 */
export interface BookingUser {
    name: string;
    phone: string;
    seat_number?: number;
    luggage?: string;
    departure_date?: string;
    return_date?: string;
    address_detail: {
        kecamatan: string;
        desa: string;
        dusun: string;
        rt_rw: string;
        patokan: string;
    };
    destination_detail: {
        kecamatan: string;
        desa: string;
        rt_rw: string;
        patokan: string;
    };
}

export interface BookingItem {
    id: string | number;
    user: BookingUser;
    destination: string;
    date: string;
    time?: string;
    price?: number;
    fleet?: string;
    fleet_id?: string;
    driver_id?: string;
    driver_2_id?: string;
    booking_status: string;
    payment_proof_url?: string;
    payment_method?: string;
    schedule_id?: string;
}

interface Props {
    bookingType: "RUTE" | "CHARTER" | "PACKAGE";
    bookingData: BookingItem[];
    fleets?: any[];
    drivers?: any[];
}

const { bookingType, bookingData, fleets = [], drivers = [] } = Astro.props;

// PISAHKAN DATA BERDASARKAN KATEGORI
// Asumsi BE belum punya 'dalam_penjemputan'. Nanti isDone harusnya !== 'selesai' kl BE blm update.
// Tapi kita map 'selesai' sbg isPickupList kalau dia belum benar-benar finished.
// Jika status 'selesai_final' atau 'completed' itu benar2 selesai.
// Untuk sekarang, asumsikan 'selesai' kita simpan di tabel Selesai.
const activeBookings = bookingData.filter(item => !['selesai', 'selesai_final', 'completed', 'dibatalkan', 'ditolak', 'cancelled', 'received'].includes(item.booking_status.toLowerCase()));
const completedBookings = bookingData.filter(item => ['selesai', 'selesai_final', 'completed', 'received'].includes(item.booking_status.toLowerCase()));
const cancelledBookings = bookingData.filter(item => ['dibatalkan', 'ditolak', 'cancelled'].includes(item.booking_status.toLowerCase()));

---

<div class="flex flex-col gap-12 booking-container">
    
    <!-- BAGIAN 1: ANTRIAN AKTIF -->
    <div>
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-black text-slate-800 tracking-tight">Antrean Aktif</h3>
            <span class="px-3 py-1 bg-primary/10 text-primary font-bold text-[10px] rounded-full">{activeBookings.length} Pesanan</span>
        </div>
        
        {activeBookings.length === 0 ? (
            <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                <p class="text-slate-400 font-bold text-sm">Tidak ada pesanan aktif saat ini.</p>
            </div>
        ) : (
            <div class="booking-tbody">
                {activeBookings.map((item) => (
                    <BookingRow item={item} bookingType={bookingType} fleets={fleets} drivers={drivers} />
                ))}
            </div>
        )}
    </div>

    <!-- BAGIAN 2: PESANAN SELESAI -->
    <div>
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500 block"></span>
                Pesanan Selesai
            </h3>
            <span class="px-3 py-1 bg-emerald-50 text-emerald-600 font-bold text-[10px] rounded-full">{completedBookings.length} Riwayat</span>
        </div>

        {completedBookings.length === 0 ? (
            <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                <p class="text-slate-400 font-bold text-sm">Belum ada riwayat pesanan selesai.</p>
            </div>
        ) : (
            <div class="flex flex-col">
                {completedBookings.slice(0, 3).map((item) => (
                    <BookingRow item={item} bookingType={bookingType} fleets={fleets} drivers={drivers} />
                ))}
                
                {completedBookings.length > 3 && (
                    <div class="mt-4">
                        <a href={`/admin/history/completed?type=${bookingType}`} class="block w-full py-4 text-center bg-emerald-50 hover:bg-emerald-100 text-emerald-600 text-xs font-bold uppercase tracking-widest rounded-xl transition-colors">
                            Lihat Keseluruhan ({completedBookings.length} Data)
                        </a>
                    </div>
                )}
            </div>
        )}
    </div>

    <!-- BAGIAN 3: PESANAN DIBATALKAN -->
    <div>
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500 block"></span>
                Pesanan Dibatalkan
            </h3>
            <span class="px-3 py-1 bg-rose-50 text-rose-600 font-bold text-[10px] rounded-full">{cancelledBookings.length} Riwayat</span>
        </div>

        {cancelledBookings.length === 0 ? (
            <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                <p class="text-slate-400 font-bold text-sm">Belum ada riwayat pesanan dibatalkan.</p>
            </div>
        ) : (
            <div class="flex flex-col">
                {cancelledBookings.slice(0, 3).map((item) => (
                    <BookingRow item={item} bookingType={bookingType} fleets={fleets} drivers={drivers} />
                ))}
                
                {cancelledBookings.length > 3 && (
                    <div class="mt-4">
                        <a href={`/admin/history/cancelled?type=${bookingType}`} class="block w-full py-4 text-center bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold uppercase tracking-widest rounded-xl transition-colors">
                            Lihat Keseluruhan ({cancelledBookings.length} Data)
                        </a>
                    </div>
                )}
            </div>
        )}
    </div>

</div>

<!-- Render the Payment Preview Modal -->
<PaymentPreviewModal />

<script>
    import { apiFetch } from '../../../../services/api';
    const setupAccordion = () => {
        const mainRows = document.querySelectorAll('.booking-main-row');
        
        mainRows.forEach(row => {
            row.addEventListener('click', () => {
                const detailRow = row.nextElementSibling as HTMLElement;
                const chevron = row.querySelector('.chevron-icon');
                const isOpening = !detailRow.style.maxHeight;

                mainRows.forEach(otherRow => {
                    const otherDetail = otherRow.nextElementSibling as HTMLElement;
                    const otherChevron = otherRow.querySelector('.chevron-icon');
                    if (otherRow !== row) {
                        otherDetail.style.maxHeight = '';
                        otherChevron?.classList.remove('rotate-180');
                        otherRow.parentElement?.classList.remove('active-card');
                    }
                });

                if (isOpening) {
                    detailRow.style.maxHeight = detailRow.scrollHeight + 'px';
                    chevron?.classList.add('rotate-180');
                    row.parentElement?.classList.add('active-card');
                } else {
                    detailRow.style.maxHeight = '';
                    chevron?.classList.remove('rotate-180');
                    row.parentElement?.classList.remove('active-card');
                }
            });
        });
    };

    const setupActionForms = () => {
        const forms = document.querySelectorAll('.admin-action-form');
        forms.forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formEl = form as HTMLFormElement;
                const bookingId = formEl.dataset.bookingId;
                const scheduleId = formEl.dataset.scheduleId;
                const isCharter = formEl.dataset.bookingType === 'CHARTER';
                const currentState = formEl.dataset.currentState;
                const formData = new FormData(formEl);
                const payload = Object.fromEntries(formData.entries());
                
                const btn = formEl.querySelector('button[type="submit"]');
                const originalText = btn?.textContent;
                if(btn) { btn.textContent = 'Memproses...'; btn.classList.add('opacity-50', 'pointer-events-none'); }

                try {
                    const token = localStorage.getItem('jwt_token') || localStorage.getItem('token');
                    const headers = {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    };

                    if (!isCharter) {
                        if (currentState === 'isPickupList') {
                            const statusBody = { booking_status: 'selesai' };
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/status`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(statusBody)
                            });
                        } else if (currentState === 'isProofUploaded') {
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/verify`, {
                                method: 'PUT',
                                headers
                            });
                        } else if (currentState === 'isNew') {
                            const statusBody = {
                                booking_status: 'menunggu_pembayaran',
                                price: payload.price ? parseFloat((payload.price as string).replace(/\./g, '')) : undefined,
                                eta: payload.pickup_time || undefined
                            };
                            
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/status`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(statusBody)
                            });

                            if (scheduleId && payload.fleet_id && payload.driver_1) {
                                const assignBody = {
                                    fleet_id: payload.fleet_id,
                                    driver_id: payload.driver_1,
                                    driver_2_id: payload.driver_2 || undefined
                                };
                                await apiFetch(`/api/admin/master/schedules/${scheduleId}/assign`, {
                                    method: 'PUT',
                                    headers,
                                    body: JSON.stringify(assignBody)
                                });
                            }
                        }
                    } else if (isCharter) {
                        if (currentState === 'isPickupList') {
                            await apiFetch(`/api/charter/${bookingId}/status`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify({ status: 'selesai' })
                            });
                        } else {
                            const bodyData = {
                                fleet_id: payload.fleet_id || undefined,
                                driver_id: payload.driver_1 || undefined,
                                driver_2_id: payload.driver_2 || undefined,
                                offered_price: payload.price ? parseFloat((payload.price as string).replace(/\./g, '')) : undefined
                            };
                            await apiFetch(`/api/charter/${bookingId}/verify`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(bodyData)
                            });
                        }
                    } else if (bookingType === 'PACKAGE') {
                        // Package handling placeholder
                        if (currentState === 'isPickupList') {
                            await apiFetch(`/api/admin/master/package-shipments/${bookingId}`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify({ transaction_status: 'selesai' })
                            });
                        }
                    }

                    alert(currentState === 'isProofUploaded' ? 'Pembayaran berhasil dikonfirmasi dan armada telah ditugaskan!' : currentState === 'isPickupList' ? 'Pesanan berhasil diselesaikan dan masuk ke riwayat!' : 'Data pemesanan berhasil disimpan & dikirim ke Pelanggan!');
                    window.location.reload();

                } catch (error: any) {
                    console.error('Error submit form:', error);
                    alert(`Gagal: ${error.message}`);
                    if(btn) { btn.textContent = originalText || 'Simpan & Kirim Tagihan'; btn.classList.remove('opacity-50', 'pointer-events-none'); }
                }
            });
        });
    }

    setupAccordion();
    setupActionForms();
    document.addEventListener('astro:page-load', () => {
        setupAccordion();
        setupActionForms();
    });
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .booking-card { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
    .booking-card.active-card { box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.05), 10px 0 25px -5px rgba(0, 0, 0, 0.05), -10px 0 25px -5px rgba(0, 0, 0, 0.05); z-index: 10; border-color: #e2e8f0; }
</style>





