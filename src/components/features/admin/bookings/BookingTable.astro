---
// File: src/components/features/admin/bookings/BookingTable.astro
import AdminBadge from "@ui/AdminBadge.astro";
import Button from "@ui/Button.astro";
import BookingRow from "./BookingRow.astro";
import PaymentPreviewModal from "./PaymentPreviewModal.astro";

/**
 * DATA CONTRACT: The expected structure for a booking item from the Back-End.
 */
export interface BookingUser {
    name: string;
    phone: string;
    seat_number?: number | string;
    luggage?: string;
    departure_date?: string;
    return_date?: string;
    address_detail: {
        kecamatan: string;
        desa: string;
        dusun: string;
        rt_rw: string;
        patokan: string;
    };
    destination_detail: {
        kecamatan: string;
        desa: string;
        rt_rw: string;
        patokan: string;
    };
}

export interface BookingItem {
    id: string | number;
    user: BookingUser;
    origin?: string;
    destination: string;
    date: string;
    time?: string;
    price?: number | null;
    fleet?: string;
    fleet_id?: string;
    fleet_plate_number?: string;
    fleet_car_type?: string;
    driver_id?: string;
    driver_2_id?: string;
    booking_status: string;
    payment_proof_url?: string | null;
    payment_method?: string | null;
    schedule_id?: string;
}

interface Props {
    bookingType: "RUTE" | "CHARTER" | "PACKAGE";
    bookingData: BookingItem[];
    fleets?: any[];
    drivers?: any[];
}

const { bookingType, bookingData, fleets = [], drivers = [] } = Astro.props;

// (We rely on parent components like route.astro or charter.astro to pass the pre-filtered data)
const itemsPerPage = 8;
---

<div class="flex flex-col gap-8 booking-container">
    <div class="booking-tbody flex flex-col">
        {bookingData.map((item, index) => {
            const pageNum = Math.floor(index / itemsPerPage) + 1;
            const isHidden = pageNum > 1;
            return (
                <div class={`booking-page-item ${isHidden ? 'hidden' : ''}`} data-page={pageNum}>
                    <BookingRow item={item} bookingType={bookingType} fleets={fleets} drivers={drivers} />
                </div>
            );
        })}
    </div>

    {bookingData.length > itemsPerPage && (
        <div class="flex items-center justify-between border-t border-slate-100 pt-6 mt-4 pagination-controls flex-wrap gap-4">
            <button 
                type="button" 
                class="prev-page-btn px-4 py-2.5 border border-slate-200 hover:border-primary hover:text-primary rounded-xl text-xs font-bold text-slate-500 transition-colors disabled:opacity-40 disabled:hover:border-slate-200 disabled:hover:text-slate-500 disabled:cursor-not-allowed cursor-pointer"
                disabled
            >
                Sebelumnya
            </button>
            <div class="flex items-center gap-1.5 page-numbers-container">
                {Array.from({ length: Math.ceil(bookingData.length / itemsPerPage) }).map((_, i) => {
                    const pageNum = i + 1;
                    return (
                        <button 
                            type="button" 
                            class={`page-num-btn w-9 h-9 rounded-xl text-xs font-black transition-all cursor-pointer ${pageNum === 1 ? 'bg-primary text-white shadow-md shadow-primary/20' : 'bg-slate-50 hover:bg-slate-100 text-slate-600 border border-slate-200/40'}`}
                            data-target-page={pageNum}
                        >
                            {pageNum}
                        </button>
                    );
                })}
            </div>
            <button 
                type="button" 
                class="next-page-btn px-4 py-2.5 border border-slate-200 hover:border-primary hover:text-primary rounded-xl text-xs font-bold text-slate-500 transition-colors disabled:opacity-40 disabled:hover:border-slate-200 disabled:hover:text-slate-500 disabled:cursor-not-allowed cursor-pointer"
            >
                Selanjutnya
            </button>
        </div>
    )}
</div>

<!-- Render the Payment Preview Modal -->
<PaymentPreviewModal />

<script>
    import { apiFetch } from '@services/api';
    import { formatRupiahInput } from '@utils/formatters';
    const setupAccordion = () => {
        const mainRows = document.querySelectorAll('.booking-main-row');
        
        mainRows.forEach(row => {
            row.addEventListener('click', () => {
                const detailRow = row.nextElementSibling as HTMLElement;
                const chevron = row.querySelector('.chevron-icon');
                const isOpening = !detailRow.style.maxHeight;

                mainRows.forEach(otherRow => {
                    const otherDetail = otherRow.nextElementSibling as HTMLElement;
                    const otherChevron = otherRow.querySelector('.chevron-icon');
                    if (otherRow !== row) {
                        otherDetail.style.maxHeight = '';
                        otherChevron?.classList.remove('rotate-180');
                        otherRow.parentElement?.classList.remove('active-card');
                    }
                });

                if (isOpening) {
                    detailRow.style.maxHeight = detailRow.scrollHeight + 'px';
                    chevron?.classList.add('rotate-180');
                    row.parentElement?.classList.add('active-card');
                } else {
                    detailRow.style.maxHeight = '';
                    chevron?.classList.remove('rotate-180');
                    row.parentElement?.classList.remove('active-card');
                }
            });
        });
    };

    const setupActionForms = () => {
        const priceInputs = document.querySelectorAll('input[name="price"]');
        priceInputs.forEach(input => {
            input.addEventListener('input', function(this: HTMLInputElement) {
                const cleanValue = this.value.replace(/\D/g, '');
                this.value = cleanValue ? formatRupiahInput(cleanValue) : '';
            });
        });

        const forms = document.querySelectorAll('.admin-action-form');
        forms.forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formEl = form as HTMLFormElement;
                const bookingId = formEl.dataset.bookingId;
                const scheduleId = formEl.dataset.scheduleId;
                const isCharter = formEl.dataset.bookingType === 'CHARTER';
                const currentState = formEl.dataset.currentState;
                const formData = new FormData(formEl);
                const payload = Object.fromEntries(formData.entries());
                
                const btn = formEl.querySelector('button[type="submit"]');
                const originalText = btn?.textContent;
                if(btn) { btn.textContent = 'Memproses...'; btn.classList.add('opacity-50', 'pointer-events-none'); }

                try {
                    const token = localStorage.getItem('jwt_token') || localStorage.getItem('token');
                    const headers = {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    };

                    if (!isCharter && formEl.dataset.bookingType !== 'PACKAGE') {
                        if (currentState === 'isPickupList') {
                            const statusBody = { booking_status: 'selesai' };
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/status`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(statusBody)
                            });
                        } else if (currentState === 'isProofUploaded') {
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/verify`, {
                                method: 'PUT',
                                headers
                            });
                        } else if (currentState === 'isNew') {
                            const isCash = formEl.dataset.paymentMethod === 'cash';
                            const statusBody = {
                                booking_status: isCash ? 'dibayar' : 'menunggu_pembayaran',
                                price: payload.price ? parseFloat((payload.price as string).replace(/\./g, '')) : undefined
                            };
                            
                            await apiFetch(`/api/admin/master/travel-bookings/${bookingId}/status`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(statusBody)
                            });
                        }
                    } else if (isCharter) {
                        if (currentState === 'isPickupList') {
                            await apiFetch(`/api/charter/${bookingId}/verify`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify({ offered_price: undefined })
                            });
                        } else {
                            const bodyData = {
                                offered_price: payload.price ? parseFloat((payload.price as string).replace(/\./g, '')) : undefined
                            };
                            await apiFetch(`/api/charter/${bookingId}/verify`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify(bodyData)
                            });
                        }
                    } else if (formEl.dataset.bookingType === 'PACKAGE') {
                        if (currentState === 'isPickupList') {
                            await apiFetch(`/api/admin/master/package-shipments/${bookingId}`, {
                                method: 'PUT',
                                headers,
                                body: JSON.stringify({ status: 'delivered' })
                            });
                        }
                    }

                    const successMsg = currentState === 'isProofUploaded' ? 'Pembayaran berhasil dikonfirmasi dan armada telah ditugaskan!' : currentState === 'isPickupList' ? 'Pesanan berhasil diselesaikan dan masuk ke riwayat!' : 'Data pemesanan berhasil disimpan & dikirim ke Pelanggan!';
                    if (typeof window !== 'undefined' && (window as any).showFeedbackModal) {
                        (window as any).showFeedbackModal("success", "Berhasil", successMsg, window.location.href);
                    } else {
                        alert(successMsg);
                        window.location.reload();
                    }

                } catch (error: any) {
                    console.error('Error submit form:', error);
                    if (typeof window !== 'undefined' && (window as any).showFeedbackModal) {
                        (window as any).showFeedbackModal("error", "Gagal", `Gagal: ${error.message}`);
                    } else {
                        alert(`Gagal: ${error.message}`);
                    }
                    if(btn) { btn.textContent = originalText || 'Simpan & Kirim Tagihan'; btn.classList.remove('opacity-50', 'pointer-events-none'); }
                }
            });
        });
    }

    const setupPagination = () => {
        const containers = document.querySelectorAll('.booking-container');
        containers.forEach(container => {
            const tbody = container.querySelector('.booking-tbody');
            if (!tbody) return;

            const items = tbody.querySelectorAll('.booking-page-item');
            if (items.length <= 8) return;

            let currentPage = 1;
            const totalPages = Math.ceil(items.length / 8);

            const prevBtn = container.querySelector('.prev-page-btn') as HTMLButtonElement;
            const nextBtn = container.querySelector('.next-page-btn') as HTMLButtonElement;
            const pageBtns = container.querySelectorAll('.page-num-btn');

            const goToPage = (page: number) => {
                if (page < 1 || page > totalPages) return;
                currentPage = page;

                // Toggle items visibility
                items.forEach((item: any) => {
                    const itemPage = parseInt(item.getAttribute('data-page') || '1', 10);
                    if (itemPage === currentPage) {
                        item.classList.remove('hidden');
                    } else {
                        item.classList.add('hidden');
                    }
                });

                // Close any open details
                const mainRows = tbody.querySelectorAll('.booking-main-row');
                mainRows.forEach(row => {
                    const detailRow = row.nextElementSibling as HTMLElement;
                    const chevron = row.querySelector('.chevron-icon');
                    if (detailRow) {
                        detailRow.style.maxHeight = '';
                        chevron?.classList.remove('rotate-180');
                        row.parentElement?.classList.remove('active-card');
                    }
                });

                // Update page buttons active state
                pageBtns.forEach((btn: any) => {
                    const btnPage = parseInt(btn.getAttribute('data-target-page') || '1', 10);
                    if (btnPage === currentPage) {
                        btn.className = "page-num-btn w-9 h-9 rounded-xl text-xs font-black transition-all cursor-pointer bg-primary text-white shadow-md shadow-primary/20";
                    } else {
                        btn.className = "page-num-btn w-9 h-9 rounded-xl text-xs font-black transition-all cursor-pointer bg-slate-50 hover:bg-slate-100 text-slate-600 border border-slate-200/40";
                    }
                });

                // Update prev/next button disabled state
                if (prevBtn) prevBtn.disabled = currentPage === 1;
                if (nextBtn) nextBtn.disabled = currentPage === totalPages;
            };

            // Add event listeners
            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    goToPage(currentPage - 1);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    goToPage(currentPage + 1);
                });
            }

            pageBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const targetBtn = e.currentTarget as HTMLButtonElement;
                    const page = parseInt(targetBtn.getAttribute('data-target-page') || '1', 10);
                    goToPage(page);
                });
            });

            // Initial trigger to make sure nextBtn disabled state is correct on load
            if (nextBtn) nextBtn.disabled = currentPage === totalPages;
        });
    };

    setupAccordion();
    setupActionForms();
    setupPagination();
    document.addEventListener('astro:page-load', () => {
        setupAccordion();
        setupActionForms();
        setupPagination();
    });
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .booking-card { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
    .booking-card.active-card { box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.05), 10px 0 25px -5px rgba(0, 0, 0, 0.05), -10px 0 25px -5px rgba(0, 0, 0, 0.05); z-index: 10; border-color: #e2e8f0; }
</style>





