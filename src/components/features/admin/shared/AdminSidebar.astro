---
// File: src/components/features/admin/shared/AdminSidebar.astro
import AdminSidebarItem from "@features/admin/shared/AdminSidebarItem.astro";
import { Image } from "astro:assets";
import riniLogo from "@assets/img/rini_trans_logo.png";

const { pathname } = Astro.url;
const isActive = (path: string) =>
    pathname === path || pathname.startsWith(path + "/");

const menuItems = [
    {
        href: "/admin",
        label: "Dashboard",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`,
    },
    {
        href: "/admin/assignments",
        label: "Penugasan Armada",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>`,
    },
    {
        id: "menu-pemesanan",
        label: "Data Pemesanan",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-12v.75m0 3v.75m0 3v.75m0 3V18m-3-12h15c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H4.5c-.621 0-1.125-.504-1.125-1.125V7.125C3.375 6.504 3.879 6 4.5 6z" /></svg>`,
        subItems: [
            { href: "/admin/bookings/route", label: "Data Perjalanan Rute" },
            { href: "/admin/bookings/charter", label: "Data Sewa Charter" },
            { href: "/admin/packages", label: "Data Paket" },
        ],
    },
    {
        id: "menu-konten",
        label: "Kelola Konten",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>`,
        subItems: [
            { href: "/admin/content", label: "Kelola Promosi" },
            { href: "/admin/banner", label: "Kelola Banner Utama" },
            { href: "/admin/fleet", label: "Kelola Armada" },
            { href: "/admin/destinations", label: "Kelola Destinasi" },
        ],
    },
    {
        id: "menu-finance",
        label: "Laporan Keuangan",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        subItems: [
            { href: "/admin/finance", label: "Ringkasan Laporan" },
            { href: "/admin/finance/expenses", label: "Data Pengeluaran" },
        ],
    },
    {
        id: "menu-pengguna",
        label: "Kelola Pengguna",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
        subItems: [
            { href: "/admin/users?role=customer", label: "Pengguna" },
            { href: "/admin/users?role=driver", label: "Driver" },
        ],
    },
];

const isSubActive = (items: any[]) =>
    items.some((item) => pathname === item.href);
---

<>
    <!-- Overlay for Mobile Sidebar -->
    <div
        id="admin-sidebar-overlay"
        class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden lg:hidden transition-opacity opacity-0"
    >
    </div>

    <aside
        id="admin-sidebar"
        class="w-72 bg-white border-r border-slate-100 h-screen fixed lg:sticky top-0 left-0 flex flex-col p-6 overflow-y-auto z-50 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none"
    >
        <div class="mb-10 px-2 flex justify-between items-center">
            <div>
                <Image src={riniLogo} alt="Rini Trans Putri Logo" class="h-16 w-auto object-contain mb-2" />
                <p
                    class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1"
                >
                    Admin Panel
                </p>
            </div>
            <button
                id="close-admin-sidebar"
                class="lg:hidden p-2 text-slate-400 hover:text-rose-500 hover:bg-rose-50 rounded-lg transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="w-5 h-5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <nav class="flex flex-col gap-2 flex-grow">
            {
                menuItems.map((item) => (
                    <AdminSidebarItem
                        href={item.href}
                        id={item.id}
                        label={item.label}
                        icon={item.icon}
                        subItems={item.subItems}
                        active={
                            item.subItems
                                ? isSubActive(item.subItems)
                                : isActive(item.href!)
                        }
                    />
                ))
            }
        </nav>

        <div class="mt-auto pt-6 border-t border-slate-100">
            <div class="bg-slate-50 p-4 rounded-2xl flex flex-col gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary text-white font-black flex items-center justify-center shrink-0">
                        A
                    </div>
                    <div class="flex flex-col overflow-hidden">
                        <span class="font-bold text-slate-900 text-sm truncate">Administrator</span>
                        <span class="text-xs text-slate-400 truncate">admin@rinitrans.com</span>
                    </div>
                </div>
                <button id="btn-admin-logout" class="w-full mt-1 py-2 px-4 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg text-xs font-bold uppercase tracking-widest transition-colors flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                    </svg>
                    Keluar Akun
                </button>
            </div>
        </div>
    </aside>

    <script>
        const setupMobileSidebar = () => {
            const toggleBtn = document.getElementById("admin-sidebar-toggle");
            const closeBtn = document.getElementById("close-admin-sidebar");
            const sidebar = document.getElementById("admin-sidebar");
            const overlay = document.getElementById("admin-sidebar-overlay");

            const openSidebar = () => {
                if (!sidebar || !overlay) return;
                sidebar.classList.remove("-translate-x-full");
                overlay.classList.remove("hidden");
                // Small delay to ensure display:block applies before fading in opacity
                requestAnimationFrame(() => {
                    overlay.classList.remove("opacity-0");
                    overlay.classList.add("opacity-100");
                });
                document.body.style.overflow = "hidden"; // Prevent background scrolling
            };

            const closeSidebar = () => {
                if (!sidebar || !overlay) return;
                sidebar.classList.add("-translate-x-full");
                overlay.classList.remove("opacity-100");
                overlay.classList.add("opacity-0");

                // Wait for fade out animation before hiding
                setTimeout(() => {
                    overlay.classList.add("hidden");
                }, 300);
                document.body.style.overflow = "";
            };

            toggleBtn?.addEventListener("click", openSidebar);
            closeBtn?.addEventListener("click", closeSidebar);
            overlay?.addEventListener("click", closeSidebar);
            
            const logoutBtn = document.getElementById("btn-admin-logout");
            if (logoutBtn) {
                logoutBtn.addEventListener("click", () => {
                    if (confirm("Apakah Anda yakin ingin keluar dari halaman Admin?")) {
                        localStorage.removeItem("jwt_token");
                        localStorage.removeItem("user_data");
                        document.cookie = "token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
                        window.location.href = "/auth/login";
                    }
                });
            }
        };

        document.addEventListener("DOMContentLoaded", setupMobileSidebar);
        document.addEventListener("astro:page-load", setupMobileSidebar);
    </script>
</>
