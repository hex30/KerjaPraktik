---
// File: src/components/admin/features/booking/BookingItem.astro
import AdminBadge from "../../../ui/AdminBadge.astro";
import Button from "../../../ui/Button.astro";

interface Props {
    type: "RUTE" | "CHARTER";
    order: any;
}

const { type, order } = Astro.props;
---

<div class="booking-card bg-white border border-slate-100 rounded-[1.5rem] shadow-sm overflow-hidden transition-all duration-300 hover:shadow-md group">
    <!-- Visible Part -->
    <div class="p-6 md:p-8 cursor-pointer flex flex-col md:flex-row justify-between items-start md:items-center gap-6 toggle-trigger">
        <div class="flex flex-col gap-3 w-full md:w-auto">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-[10px] font-black font-main px-2.5 py-1 bg-slate-100 text-slate-500 rounded-md uppercase tracking-wider">
                    ID: #{order.id}
                </span>
                <span class="text-xs text-slate-400 font-secondary font-medium">
                    {order.date}
                </span>
            </div>
            
            <div>
                <h2 class="text-lg md:text-xl font-black text-primary tracking-tight group-hover:text-sky-500 transition-colors">
                    {order.user.name}
                </h2>
                <p class="font-secondary text-sm text-text-secondary flex items-center gap-2">
                    <span class="font-bold text-slate-700">{order.origin}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                    <span class="font-bold text-slate-700">{order.destination}</span>
                </p>
            </div>
        </div>

        <div class="flex flex-row md:flex-col items-center md:items-end justify-between w-full md:w-auto gap-4 md:gap-2">
            <AdminBadge status={order.status} />
            <div class="flex items-center gap-2 text-slate-400">
                <span class="text-[10px] font-bold uppercase tracking-widest hidden md:block">Klik Detail</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-300 chevron-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Expandable Content -->
    <div class="expand-content max-h-0 overflow-hidden transition-all duration-500 ease-in-out bg-slate-50/50">
        <div class="p-6 md:p-8 border-t border-slate-100 grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Left: Info -->
            <div class="flex flex-col gap-6">
                <div>
                    <h4 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Informasi Penjemputan</h4>
                    <div class="bg-white p-4 rounded-xl border border-slate-100 shadow-sm">
                        <p class="text-sm font-secondary text-slate-700 leading-relaxed">
                            {order.pickup_address || "Alamat lengkap penjemputan belum tersedia atau menggunakan titik kumpul standar."}
                        </p>
                        <div class="mt-4 flex items-center gap-4 border-t border-slate-50 pt-4">
                            <div class="flex flex-col">
                                <span class="text-[9px] text-slate-400 font-bold uppercase">Kontan Person</span>
                                <span class="text-sm font-bold text-primary">{order.user.phone}</span>
                            </div>
                        </div>
                    </div>
                </div>

                {type === "CHARTER" && (
                    <div>
                        <h4 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Armada Pilihan</h4>
                        <div class="bg-white p-4 rounded-xl border border-slate-100 flex items-center gap-4">
                            <div class="w-12 h-12 bg-sky-50 rounded-lg flex items-center justify-center text-sky-500">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-slate-900">{order.fleet}</p>
                                <p class="text-[10px] text-slate-400 font-secondary">Charter Full Unit</p>
                            </div>
                        </div>
                    </div>
                )}
            </div>

            <!-- Right: Actions -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col gap-6">
                <h4 class="text-xs font-black text-slate-400 uppercase tracking-widest">Alokasi & Verifikasi</h4>
                
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-500">Unit Armada (Assign Unit)</label>
                        <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-medium focus:outline-none focus:border-primary transition-all">
                            <option value="">Pilih Unit Armada...</option>
                            <option value="unit1">ELF Giga - B 1234 ABC</option>
                            <option value="unit2">Hiace - D 5678 XYZ</option>
                            <option value="unit3">Avanza - Z 9999 RT</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500">Supir Utama</label>
                            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none">
                                <option value="">Pilih Supir...</option>
                                <option value="s1">Budi</option>
                                <option value="s2">Agus</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="text-[10px] font-bold text-slate-500">Supir Cadangan (Ops)</label>
                            <select class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-medium focus:outline-none">
                                <option value="">Tanpa Cadangan</option>
                                <option value="s1">Budi</option>
                                <option value="s2">Agus</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                        <label class="text-[10px] font-bold text-slate-500">Tentukan Harga (IDR)</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm">Rp</span>
                            <input type="number" placeholder="0" class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-10 pr-4 py-3 font-main font-bold text-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                        </div>
                    </div>
                </div>

                <div class="mt-2 flex gap-3">
                    <Button class="flex-1" size="md">Simpan & Verifikasi</Button>
                    <button class="px-5 py-2.5 rounded-xl border border-rose-100 text-rose-500 font-bold text-sm hover:bg-rose-50 transition-all">Tolak</button>
                </div>
            </div>
        </div>
    </div>
</div>



