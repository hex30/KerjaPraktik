---
// File: src/components/features/admin/content/PromoManager.astro
import InputGroup from "@ui/InputGroup.astro";
import Button from "@ui/Button.astro";
---

<div class="flex flex-col gap-8 bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h3 class="text-xl font-black text-slate-900 tracking-tight">Formulir Promo Multi-Channel</h3>
            <p class="text-xs text-slate-400 font-secondary mt-1">Buat promo baru atau edit promo yang sudah ada untuk Landing Page.</p>
        </div>
        <button type="button" id="btn-new-promo" class="px-5 py-2.5 bg-primary/10 text-primary text-xs font-black rounded-xl hover:bg-primary hover:text-white transition-all">
            + Buat Promo Baru
        </button>
    </header>

    <form id="promo-form" class="flex flex-col gap-8">
        <input type="hidden" id="promo-id" name="id" value="" />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-5">
                <h4 class="text-[10px] font-black text-primary uppercase tracking-widest flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                    Payload Utama Promo
                </h4>
                
                <InputGroup label="Tagline Promo" id="tagline" name="tagline" placeholder="Contoh: Mudik Ceria 2026" required={true} />
                
                <div class="flex flex-col gap-2">
                    <label class="font-secondary text-sm font-bold text-primary">Deskripsi Promo</label>
                    <textarea id="description" name="description" rows="4" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-none" placeholder="Jelaskan detail promo Anda..."></textarea>
                </div>
            </div>

            <div class="flex flex-col gap-5">
                <h4 class="text-[10px] font-black text-amber-500 uppercase tracking-widest flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
                    Visual & Besaran
                </h4>

                <div class="grid grid-cols-2 gap-4">
                    <InputGroup label="Diskon (%)" id="discount" name="discount" type="number" placeholder="0" suffix="%" />
                    <InputGroup label="Max Potongan" id="max_discount" name="max_discount" type="number" placeholder="0" suffix="Rp" />
                </div>

                <div class="flex flex-col gap-2 relative">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Banner Promo</label>
                    <div class="relative w-full h-40 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 flex flex-col items-center justify-center gap-3 hover:border-primary hover:bg-primary/5 transition-all cursor-pointer group overflow-hidden">
                        <input type="file" name="image" id="promo_image" accept="image/png, image/jpeg, image/jpg" class="image-upload-input absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <span class="image-upload-text text-xs font-bold text-slate-400 group-hover:text-primary transition-colors px-4 text-center line-clamp-1">Pilih Gambar / Drag & Drop</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-6 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col gap-4">
            <h5 class="text-[10px] font-black text-slate-800 uppercase tracking-widest">Penempatan Promo</h5>
            <div class="flex flex-wrap gap-4">
                <label class="flex items-center gap-2 cursor-pointer group">
                    <input type="checkbox" id="is-active" name="is_active" class="w-4 h-4 rounded border-slate-300 text-primary focus:ring-primary">
                    <span class="text-xs font-bold text-slate-600 group-hover:text-primary transition-colors">Tampilkan sebagai Promo Aktif Utama</span>
                </label>
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-50">
            <button type="button" id="delete-promo-btn" class="px-8 py-3 rounded-xl font-bold text-sm text-red-500 hover:bg-red-50 transition-all hidden">Hapus Promo</button>
            <button type="reset" class="px-8 py-3 rounded-xl font-bold text-sm text-slate-400 hover:text-slate-600 transition-all">Reset</button>
            <Button id="submit-promo-btn" type="submit" size="lg" class="px-12">Simpan & Sync Promo</Button>
        </div>
    </form>
</div>

<script>
    import { adminContentService } from "@services/adminContentService";

    const setupPromoForm = () => {
        const form = document.getElementById('promo-form') as HTMLFormElement;
        const deleteBtn = document.getElementById('delete-promo-btn');
        const submitBtn = document.getElementById('submit-promo-btn');

        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                
                // Construct standard object or keep as FormData based on whether image is present
                const fileInput = form.querySelector('input[type="file"]') as HTMLInputElement;
                const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;

                try {
                    if (submitBtn) {
                        const originalText = submitBtn.textContent;
                        submitBtn.textContent = "Menyimpan...";
                        submitBtn.setAttribute('disabled', 'true');
                    }

                    if (hasFile) {
                        // Send as Multipart
                        formData.set('is_active', form.querySelector('input[name="is_active"]:checked') ? 'true' : 'false');
                        await adminContentService.savePromotion(formData);
                    } else {
                        // Send as JSON
                        const jsonPayload = {
                            id: formData.get('id'),
                            tagline: formData.get('tagline'),
                            description: formData.get('description'),
                            discount: formData.get('discount'),
                            max_discount: formData.get('max_discount'),
                            is_active: form.querySelector('input[name="is_active"]:checked') ? true : false
                        };
                        await adminContentService.savePromotion(jsonPayload);
                    }

                    alert("Promo berhasil disimpan dan disinkronisasi!");
                    window.location.reload();
                } catch (error: any) {
                    alert(error.message || "Gagal menyimpan promo");
                } finally {
                    if (submitBtn) {
                        submitBtn.textContent = "Simpan & Sync Promo";
                        submitBtn.removeAttribute('disabled');
                    }
                }
            });
        }

        if (deleteBtn) {
            deleteBtn.addEventListener('click', async () => {
                const id = document.getElementById('promo-id') as HTMLInputElement;
                if (id && id.value && confirm("Yakin ingin menghapus promo ini secara permanen?")) {
                    try {
                        const originalText = deleteBtn.textContent;
                        deleteBtn.textContent = "Menghapus...";
                        await adminContentService.deletePromotion(id.value);
                        alert("Promo berhasil dihapus!");
                        window.location.reload();
                    } catch (error: any) {
                        alert(error.message || "Gagal menghapus promo");
                        deleteBtn.textContent = "Hapus Promo";
                    }
                }
            });
        }

        // Handle Populate Form when Edit is clicked
        const editButtons = document.querySelectorAll('.edit-promo-btn');
        editButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const data = JSON.parse(btn.getAttribute('data-promo') || '{}');
                
                // Populate fields
                (document.getElementById('promo-id') as HTMLInputElement).value = data.id || '';
                (document.getElementById('tagline') as HTMLInputElement).value = data.tagline || '';
                (document.getElementById('description') as HTMLInputElement).value = data.description || '';
                (document.getElementById('discount') as HTMLInputElement).value = data.discount || '';
                (document.getElementById('max_discount') as HTMLInputElement).value = data.max_discount || '';
                (document.getElementById('is-active') as HTMLInputElement).checked = data.isActive === true || data.is_active === true;
                
                // Show delete button
                if (deleteBtn) deleteBtn.classList.remove('hidden');
                
                // Scroll to form
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        // Handle Buat Promo Baru
        const newPromoBtn = document.getElementById('btn-new-promo');
        if (newPromoBtn) {
            newPromoBtn.addEventListener('click', () => {
                form.reset();
                (document.getElementById('promo-id') as HTMLInputElement).value = '';
                if (deleteBtn) deleteBtn.classList.add('hidden');
                
                // Reset text file name
                const uploadText = form.querySelector('.image-upload-text');
                if (uploadText) {
                    uploadText.textContent = "Pilih Gambar / Drag & Drop";
                    uploadText.classList.remove('text-primary');
                }
                
                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        }

        // UI/UX Update Image Name
        const imageInput = form.querySelector('.image-upload-input') as HTMLInputElement;
        const uploadText = form.querySelector('.image-upload-text');
        if (imageInput && uploadText) {
            imageInput.addEventListener('change', (e) => {
                const target = e.target as HTMLInputElement;
                if (target.files && target.files.length > 0) {
                    uploadText.textContent = target.files[0].name;
                    uploadText.classList.add('text-primary');
                } else {
                    uploadText.textContent = "Pilih Gambar / Drag & Drop";
                    uploadText.classList.remove('text-primary');
                }
            });
        }
    };

    setupPromoForm();
    document.addEventListener('astro:page-load', setupPromoForm);
</script>
