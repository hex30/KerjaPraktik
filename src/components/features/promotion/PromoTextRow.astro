---
// File: src/components/features/home/molecules/PromoTextRow.astro
interface Props {
    text: string;
    description?: string;
    align?: "left" | "right";
}

const { text, description, align = "left" } = Astro.props;
---

<div class:list={["promo-text-row flex flex-col md:flex-row gap-3 md:gap-4 items-center overflow-hidden", align === "right" ? "md:flex-row-reverse" : ""]}>
    <h2 class:list={["promo-headline text-center text-primary uppercase tracking-tight leading-[0.9] break-words hyphens-auto", align === "right" ? "md:text-right" : "md:text-left"]} style="font-size: clamp(1.75rem, 5vw, 3.75rem); font-weight: 900;">
        {text}
    </h2>
    {description && (
        <p class:list={["promo-desc font-secondary text-[10px] sm:text-xs text-text-secondary text-center leading-tight md:leading-relaxed max-w-[220px] shrink-0", align === "right" ? "md:text-right" : "md:text-left"]}>
            {description}
        </p>
    )}
</div>







