---
// File: src/components/features/home/molecules/PromoTextRow.astro
interface Props {
    text: string;
    description?: string;
    align?: "left" | "right";
}

const { text, description, align = "left" } = Astro.props;
---

<div class:list={["flex flex-col md:flex-row gap-4 items-center", align === "right" ? "md:flex-row-reverse" : ""]}>
    <h2 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-primary uppercase tracking-tight leading-none whitespace-nowrap">
        {text}
    </h2>
    {description && (
        <p class="font-secondary text-[10px] sm:text-xs text-text-secondary leading-tight md:leading-relaxed max-w-xs">
            {description}
        </p>
    )}
</div>



