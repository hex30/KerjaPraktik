---
// File: src/components/features/user/molecules/OrderItem.astro
import type { UnifiedOrder } from "@services/userService";

interface Props {
    order: UnifiedOrder;
}

const { order } = Astro.props;
const { meta } = order;

// --- DYNAMIC DETAILS FORMATTING ---
let detailsText = "";
const getPaymentMethodText = (method: string) => {
    if (!method) return "Belum dipilih";
    return method === "cashless" ? "TRANSFER (QRIS)" : method.toUpperCase();
};

if (order.type === "travel") {
    detailsText = `Kursi: ${meta.seat_number || "Belum dipilih"} | Metode: ${getPaymentMethodText(meta.payment_method)}`;
} else if (order.type === "charter") {
    detailsText = `Metode: ${getPaymentMethodText(meta.payment_method)}`;
} else if (order.type === "package") {
    detailsText = `Resi: ${meta.waybill_number || "-"} | Metode: ${getPaymentMethodText(meta.payment_method)}`;
}

// --- 4-STEP PAYMENT FLOW STATUS LOGIC ---
let statusClass = "";
let statusText = "";
let showPayButton = false;
let showPaymentMethodSelection = false;
let showQrisButton = false;

const isNew = order.status === "menunggu_konfirmasi" && !meta.payment_proof_url && meta.payment_method !== "cash";
const isProofUploaded =
    order.status === "menunggu_konfirmasi" && !!meta.payment_proof_url;

const isCashWaitingAdmin = 

    order.status === "menunggu_konfirmasi" && 
    meta.payment_method === "cash";

const isAssigned =
    (order.type === "travel" || order.type === "package") &&
    (meta.schedule_status === "on_going" ||
        meta.schedule_status === "departed" ||
        order.status === "on_transit" ||
        order.status === "dalam_penjemputan");

const isFinalStatus =
    order.status === "dibatalkan" ||
    order.status === "ditolak" ||
    order.status === "REJECTED" ||
    order.status === "delivered" ||
    (order.type === "travel" && order.status === "selesai") ||
    (order.type === "charter" && order.status === "selesai") ||
    order.status === "COMPLETED";

const showCancelButton =
    (order.status === "selesai" ||
        order.status === "COMPLETED" ||
        order.status === "APPROVED" ||
        order.status === "dibayar" ||
        order.status === "received" ||
        order.status === "menunggu_konfirmasi" ||
        order.status === "menunggu_pembayaran") &&
    !isAssigned &&
    !isFinalStatus;
const showDeleteButton = isFinalStatus;

if (isNew) {
    statusClass = "bg-slate-100 text-slate-600 border-slate-200";
    statusText = "Menunggu Admin Menetapkan Harga";
} else if (isCashWaitingAdmin) {
    statusClass = "bg-sky-50 text-sky-600 border-sky-100";
    statusText = "Menunggu Persetujuan Admin"; 
    showPayButton = false;
} else if (order.status === "menunggu_pembayaran") {
    statusClass = "bg-amber-50 text-amber-600 border-amber-100";
    statusText = "Menunggu Pembayaran Anda";
    showPayButton = true;
    showPaymentMethodSelection = !meta.payment_method;
    showQrisButton = meta.payment_method === "cashless";
} else if (isProofUploaded) {
    statusClass = "bg-sky-50 text-sky-600 border-sky-100";
    statusText = "Menunggu Verifikasi Pembayaran";
} else if (
    order.status === "selesai" ||
    order.status === "COMPLETED" ||
    order.status === "APPROVED"
) {
    statusClass = "bg-emerald-50 text-emerald-600 border-emerald-100";
    statusText =
        order.type === "package"
            ? "Selesai / Lunas (Siap Dijemput)"
            : "Selesai / Sudah Sampai";
} else if (
    order.status === "dibatalkan" ||
    order.status === "ditolak" ||
    order.status === "REJECTED"
) {
    statusClass = "bg-rose-50 text-rose-600 border-rose-100";
    statusText = "Dibatalkan / Ditolak";
} else if (order.status === "dibayar") {
    statusClass = "bg-blue-50 text-blue-600 border-blue-100";
    statusText = "Menunggu Armada";
} else if (order.status === "dalam_penjemputan") {
    statusClass = "bg-amber-100 text-amber-700 border-amber-200";
    statusText = "Armada Menuju ke Alamat Anda";
} else if (order.status === "dalam_perjalanan") {
    statusClass = "bg-purple-50 text-purple-600 border-purple-100";
    statusText = "Dalam Perjalanan Ke Tujuan";
} else if (order.status === "on_transit") {
    statusClass = "bg-indigo-50 text-indigo-600 border-indigo-100";
    statusText = "Sedang Dikirim";
} else if (order.status === "menunggu_penjemputan") {
    statusClass = "bg-teal-50 text-teal-600 border-teal-100";
    statusText = "Menunggu Penjemputan";
} else if (order.status === "delivered") {
    statusClass = "bg-emerald-50 text-emerald-600 border-emerald-100";
    statusText = "Paket Telah Tiba";
} else {
    statusClass = "bg-slate-50 text-slate-500 border-slate-100";
    statusText = order.status
        ? order.status.toUpperCase()
        : "Status Tidak Diketahui";
}

// --- FORMATTING HARGA & EXTRA CHARGE ---
// Jika ada charge bagasi, kita pisahkan dari harga final dan harga awal untuk visualisasi UI
const extraCharge = meta.is_baggage_charge ? 250000 : 0;
const originalBasePrice = order.original_price
    ? order.original_price - extraCharge
    : 0;
const discountedBasePrice = order.price - extraCharge;
const hasPromo = originalBasePrice > discountedBasePrice;

const formatCurrency = (val: number) => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
    })
        .format(val)
        .replace(",00", "");
};

const displayId =
    order.id && order.id.length > 10
        ? `${order.type === "travel" ? "TRV" : order.type === "charter" ? "CHR" : "PKG"}-${order.id.substring(0, 8).toUpperCase()}`
        : `${order.id}`;
---

<div
    class="relative bg-white border border-slate-100 rounded-[1.5rem] shadow-xs pt-12 px-6 pb-6 md:pt-10 md:px-8 md:pb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-md transition-shadow overflow-hidden"
>
    <div
        class="absolute top-0 left-0 flex items-stretch z-10 shadow-sm rounded-br-[1rem] overflow-hidden"
    >
        <span
            class="bg-primary text-white text-[10px] font-bold font-secondary px-4 py-1.5 uppercase tracking-wider flex items-center justify-center"
        >
            {order.type}
        </span>
        <span
            class={`px-4 py-1.5 text-[10px] font-black tracking-wide border-y border-r ${statusClass} font-main flex items-center justify-center`}
        >
            {statusText}
        </span>
    </div>

    <div class="flex flex-col gap-3 w-full md:w-3/4 z-0">
        <div class="flex flex-wrap items-center gap-3">
            <span class="text-xs text-slate-400 font-secondary font-medium">
                ID: #{displayId}
            </span>
            <span
                class="text-xs text-slate-400 font-secondary font-medium hidden sm:inline"
            >
                • {
                    new Date(order.date).toLocaleDateString("id-ID", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                        hour: "2-digit",
                        minute: "2-digit",
                    })
                }
            </span>
        </div>

        <div>
            <h2 class="text-xl font-black text-primary mb-1 tracking-tight">
                {order.title}
            </h2>
            <p
                class="font-secondary text-sm text-text-secondary leading-relaxed font-mono bg-slate-50 p-2 rounded-lg inline-block mt-2 border border-slate-100"
            >
                {detailsText}
            </p>
        </div>
    </div>

    <div
        class="flex flex-col justify-between items-start md:items-end w-full md:w-1/4 border-t md:border-t-0 border-slate-100 pt-4 md:pt-0 gap-3"
    >
        <div
            class="text-left md:text-right w-full flex md:flex-col justify-between md:justify-end items-center md:items-end"
        >
            <span
                class="block text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-0.5"
                >Ringkasan Biaya</span
            >
            <div class="flex flex-col items-end">
                {
                    hasPromo && (
                        <span class="text-xs text-rose-500 line-through font-secondary mb-0.5">
                            {formatCurrency(originalBasePrice)}
                        </span>
                    )
                }
                <span class="text-xs font-secondary font-medium text-primary">
                    {formatCurrency(discountedBasePrice)}
                </span>
                {
                    meta.is_baggage_charge && (
                        <div class="flex flex-col items-end mt-1 text-amber-600">
                            <span class="text-xs font-secondary font-medium">
                                + Charge Bagasi
                            </span>
                            <span class="text-xs font-secondary font-medium">
                                {formatCurrency(extraCharge)}
                            </span>
                        </div>
                    )
                }
                {
                    meta.is_baggage_charge && (
                        <div class="w-full mt-2 pt-2 border-t border-slate-100 flex justify-between gap-4">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mt-1">
                                Total
                            </span>
                            <span class="text-lg font-black text-slate-800">
                                {formatCurrency(order.price)}
                            </span>
                        </div>
                    )
                }
            </div>
        </div>

        <div class="w-full flex flex-col gap-2">
            {
                showCancelButton && (
                    <>
                        <button
                            type="button"
                            class="btn-action-cancel w-full md:w-auto px-4 py-2 border border-rose-200 text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl text-xs font-bold transition-colors"
                            data-order-id={order.id}
                            data-order-type={order.type}
                        >
                            Batalkan Pesanan
                        </button>
                        {order.date && (
                            <p class="text-[10px] text-rose-500 font-secondary mt-1 text-center md:text-right">
                                *note: pembatalan dapat dilakukan sebelum pukul
                                12 Siang pada tanggal{" "}
                                {new Date(order.date).toLocaleDateString(
                                    "id-ID",
                                    { day: "numeric", month: "long" },
                                )}
                            </p>
                        )}
                    </>
                )
            }

            {
                showDeleteButton && (
                    <button
                        type="button"
                        class="btn-action-delete w-full md:w-auto px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition-colors shadow-sm shadow-rose-200"
                        data-order-id={order.id}
                        data-order-type={order.type}
                    >
                        Hapus Riwayat
                    </button>
                )
            }
        </div>

        {
            showPaymentMethodSelection && (
                <div class="w-full mt-2 grid grid-cols-2 gap-2">
                    <button
                        type="button"
                        onclick={`window.selectPaymentMethod('${order.id}', '${order.type}', 'cash')`}
                        class="w-full border-2 border-emerald-200 bg-emerald-50 hover:bg-emerald-100 rounded-xl py-3 flex flex-col items-center justify-center gap-1 transition-all group"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-emerald-600"
                        >
                            <>
                                <rect
                                    width="20"
                                    height="12"
                                    x="2"
                                    y="6"
                                    rx="2"
                                />
                                <circle cx="12" cy="12" r="2" />
                                <path d="M6 12h.01M18 12h.01" />
                            </>
                        </svg>
                        <span class="block text-[9px] font-bold text-emerald-700 uppercase tracking-wide">
                            Bayar Tunai
                        </span>
                    </button>
                    <button
                        type="button"
                        onclick={`window.selectPaymentMethod('${order.id}', '${order.type}', 'cashless')`}
                        class="w-full border-2 border-sky-200 bg-sky-50 hover:bg-sky-100 rounded-xl py-3 flex flex-col items-center justify-center gap-1 transition-all group"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-sky-600"
                        >
                            <>
                                <rect width="5" height="5" x="3" y="3" rx="1" />
                                <rect
                                    width="5"
                                    height="5"
                                    x="16"
                                    y="3"
                                    rx="1"
                                />
                                <rect
                                    width="5"
                                    height="5"
                                    x="3"
                                    y="16"
                                    rx="1"
                                />
                                <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
                                <path d="M21 21v.01" />
                                <path d="M12 7v3a2 2 0 0 1-2 2H7" />
                                <path d="M3 12h.01" />
                                <path d="M12 3h.01" />
                                <path d="M12 16v.01" />
                                <path d="M16 12h1" />
                                <path d="M21 12v.01" />
                                <path d="M12 21v-1" />
                            </>
                        </svg>
                        <span class="block text-[9px] font-bold text-sky-700 uppercase tracking-wide">
                            Transfer (QRIS)
                        </span>
                    </button>
                </div>
            )
        }

        {
            showQrisButton && (
                <div
                    class="w-full mt-2 border-2 border-dashed border-sky-200 bg-sky-50 rounded-xl p-3 flex flex-col items-center justify-center gap-2 transition-all hover:bg-sky-100 cursor-pointer group"
                    onclick={`window.openPaymentModal('${order.id}', '${order.type}')`}
                >
                    <div class="bg-white p-1.5 rounded-lg shadow-sm group-hover:scale-105 transition-transform">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-sky-600"
                        >
                            <>
                                <rect width="5" height="5" x="3" y="3" rx="1" />
                                <rect
                                    width="5"
                                    height="5"
                                    x="16"
                                    y="3"
                                    rx="1"
                                />
                                <rect
                                    width="5"
                                    height="5"
                                    x="3"
                                    y="16"
                                    rx="1"
                                />
                                <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
                                <path d="M21 21v.01" />
                                <path d="M12 7v3a2 2 0 0 1-2 2H7" />
                                <path d="M3 12h.01" />
                                <path d="M12 3h.01" />
                                <path d="M12 16v.01" />
                                <path d="M16 12h1" />
                                <path d="M21 12v.01" />
                                <path d="M12 21v-1" />
                            </>
                        </svg>
                    </div>
                    <div class="text-center">
                        <span class="block text-[10px] font-bold text-sky-700 uppercase tracking-wide">
                            Bayar via QRIS
                        </span>
                        <span class="block text-[9px] text-sky-500 font-secondary mt-0.5">
                            Klik untuk melihat kode QR
                        </span>
                    </div>
                </div>
            )
        }
    </div>
</div>

<style>
    .animate-pulse-slow {
        animation: pulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.85;
        }
    }
</style>
