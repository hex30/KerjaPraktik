---
// File: src/components/features/user/molecules/OrderItem.astro
import type { UnifiedOrder } from "@services/userService";

interface Props {
    order: UnifiedOrder;
}

const { order } = Astro.props;
const { meta } = order;

// --- DYNAMIC DETAILS FORMATTING ---
let detailsText = "";
const getPaymentMethodText = (method: string) => {
    if (!method) return 'Belum dipilih';
    return method === 'cashless' ? 'TRANSFER (QRIS)' : method.toUpperCase();
};

if (order.type === "travel") {
    detailsText = `Kursi: ${meta.seat_number || 'Belum dipilih'} | Metode: ${getPaymentMethodText(meta.payment_method)}`;
} else if (order.type === "charter") {
    detailsText = `Jemput: ${meta.pickup_address || '-'} | Metode: ${getPaymentMethodText(meta.payment_method)}`;
} else if (order.type === "package") {
    detailsText = `Resi: ${meta.waybill_number || '-'} | Metode: ${getPaymentMethodText(meta.payment_method)}`;
}

// --- 4-STEP PAYMENT FLOW STATUS LOGIC ---
let statusClass = "";
let statusText = "";
let showPayButton = false;
let showPaymentMethodSelection = false;
let showQrisButton = false;

const isNew = order.status === 'menunggu_konfirmasi' && !meta.payment_proof_url;
const isProofUploaded = order.status === 'menunggu_konfirmasi' && !!meta.payment_proof_url;

if (isNew) {
    statusClass = "bg-slate-100 text-slate-600 border-slate-200";
    statusText = "Menunggu Admin Menetapkan Harga";
} else if (order.status === 'menunggu_pembayaran') {
    statusClass = "bg-amber-50 text-amber-600 border-amber-100";
    statusText = "Menunggu Pembayaran Anda";
    showPayButton = true;
    showPaymentMethodSelection = !meta.payment_method;
    showQrisButton = meta.payment_method === 'cashless';
} else if (isProofUploaded) {
    statusClass = "bg-sky-50 text-sky-600 border-sky-100";
    statusText = "Menunggu Verifikasi Pembayaran";
} else if (order.status === 'selesai' || order.status === 'COMPLETED' || order.status === 'APPROVED') {
    statusClass = "bg-emerald-50 text-emerald-600 border-emerald-100";
    statusText = "Selesai / Lunas (Siap Dijemput)";
} else if (order.status === 'dibatalkan' || order.status === 'ditolak' || order.status === 'REJECTED') {
    statusClass = "bg-rose-50 text-rose-600 border-rose-100";
    statusText = "Dibatalkan / Ditolak";
} else {
    statusClass = "bg-slate-50 text-slate-500 border-slate-100";
    statusText = order.status ? order.status.toUpperCase() : "Status Tidak Diketahui";
}

// Format harga IDR
const formattedPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' })
    .format(order.price || 0)
    .replace(',00', '');

const hasPromo = order.original_price && order.original_price > order.price;
const formattedOriginalPrice = order.original_price 
    ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR' }).format(order.original_price).replace(',00', '')
    : '';

const displayId = order.id && order.id.length > 10 
    ? `${order.type === 'travel' ? 'TRV' : order.type === 'charter' ? 'CHR' : 'PKG'}-${order.id.substring(0, 8).toUpperCase()}`
    : `${order.id}`;
---

<div class="bg-white border border-slate-100 rounded-[1.5rem] shadow-xs p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-md transition-shadow">
    
    <div class="flex flex-col gap-3 w-full md:w-3/4">
        <div class="flex flex-wrap items-center gap-3">
            <span class="text-xs font-bold font-secondary px-3 py-1 bg-slate-100 text-slate-600 rounded-md uppercase tracking-wider">
                {order.type}
            </span>
            <span class="text-xs text-slate-400 font-secondary font-medium">
                ID: #{displayId}
            </span>
            <span class="text-xs text-slate-400 font-secondary font-medium hidden sm:inline">
                • {new Date(order.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
            </span>
        </div>
        
        <div>
            <h2 class="text-xl font-black text-primary mb-1 tracking-tight">
                {order.title}
            </h2>
            <p class="font-secondary text-sm text-text-secondary leading-relaxed font-mono bg-slate-50 p-2 rounded-lg inline-block mt-2 border border-slate-100">
                {detailsText}
            </p>
        </div>
    </div>

    <div class="flex flex-col justify-between items-start md:items-end w-full md:w-1/4 border-t md:border-t-0 border-slate-100 pt-4 md:pt-0 gap-3">
        <div class="text-left md:text-right w-full flex md:flex-col justify-between md:justify-end items-center md:items-end">
            <span class="block text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-0.5">Total Tagihan</span>
            <div class="flex flex-col items-end">
                {hasPromo && (
                    <span class="text-xs text-rose-500 line-through font-secondary mb-0.5">
                        {formattedOriginalPrice}
                    </span>
                )}
                <span class="font-main font-black text-primary text-xl">{formattedPrice}</span>
            </div>
        </div>
        
        <span class={`px-4 py-1.5 rounded-full text-[10px] font-black tracking-wide border ${statusClass} font-main text-center w-full md:w-auto`}>
            {statusText}
        </span>

        {showPaymentMethodSelection && (
            <div class="w-full mt-2 grid grid-cols-2 gap-2">
                <button type="button" onclick={`window.selectPaymentMethod('${order.id}', '${order.type}', 'cash')`} class="w-full border-2 border-emerald-200 bg-emerald-50 hover:bg-emerald-100 rounded-xl py-3 flex flex-col items-center justify-center gap-1 transition-all group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    <span class="block text-[9px] font-bold text-emerald-700 uppercase tracking-wide">Bayar Tunai</span>
                </button>
                <button type="button" onclick={`window.selectPaymentMethod('${order.id}', '${order.type}', 'cashless')`} class="w-full border-2 border-sky-200 bg-sky-50 hover:bg-sky-100 rounded-xl py-3 flex flex-col items-center justify-center gap-1 transition-all group">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-600"><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
                    <span class="block text-[9px] font-bold text-sky-700 uppercase tracking-wide">Transfer (QRIS)</span>
                </button>
            </div>
        )}

        {showQrisButton && (
            <div class="w-full mt-2 border-2 border-dashed border-sky-200 bg-sky-50 rounded-xl p-3 flex flex-col items-center justify-center gap-2 transition-all hover:bg-sky-100 cursor-pointer group" onclick={`window.openPaymentModal('${order.id}', '${order.type}')`}>
                <div class="bg-white p-1.5 rounded-lg shadow-sm group-hover:scale-105 transition-transform">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-600"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
                </div>
                <div class="text-center">
                    <span class="block text-[10px] font-bold text-sky-700 uppercase tracking-wide">Bayar via QRIS</span>
                    <span class="block text-[9px] text-sky-500 font-secondary mt-0.5">Klik untuk melihat kode QR</span>
                </div>
            </div>
        )}
    </div>
</div>

<style>
    .animate-pulse-slow {
        animation: pulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .85; }
    }
</style>







