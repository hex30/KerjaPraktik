---
// File: src/components/features/user/PaymentPopup.astro

// Static image placeholder for QRIS
const qrisImageUrl = "https://chart.googleapis.com/chart?chs=300x300&cht=qr&chl=BAYAR_KE_RINI_TRANS&choe=UTF-8";
---

<div id="payment-modal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="payment-modal-content">
        <!-- Header -->
        <div class="bg-slate-50 p-6 border-b border-slate-100 flex justify-between items-center relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-sky-400"></div>
            <div>
                <h3 class="font-black text-xl text-slate-800 tracking-tight">Pembayaran QRIS</h3>
                <p class="text-xs text-slate-500 mt-1 font-secondary">Silakan scan kode QR di bawah ini</p>
            </div>
            <button type="button" id="close-modal-btn" class="w-8 h-8 flex items-center justify-center rounded-full bg-slate-200 text-slate-500 hover:bg-slate-300 hover:text-slate-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </div>

        <!-- Body -->
        <div class="p-6">
            <div class="flex justify-center mb-6">
                <div class="p-4 bg-white border-2 border-slate-100 rounded-2xl shadow-sm">
                    <img src={qrisImageUrl} alt="QRIS Code" class="w-48 h-48 object-contain rounded-lg" />
                </div>
            </div>

            <form id="payment-proof-form" class="space-y-5">
                <input type="hidden" id="modal-order-id" name="orderId" />
                <input type="hidden" id="modal-order-type" name="orderType" />

                <div class="space-y-2">
                    <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">Unggah Bukti Pembayaran <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <input type="file" id="proof-image" name="proofImage" accept="image/*" required class="block w-full text-sm text-slate-500 file:mr-4 file:py-3 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-sky-50 file:text-sky-600 hover:file:bg-sky-100 transition-colors cursor-pointer border border-slate-200 rounded-xl bg-slate-50" />
                    </div>
                    <p class="text-[10px] text-slate-400 font-secondary mt-1">Format: JPG, PNG. Maksimal 2MB.</p>
                </div>

                <div class="pt-2">
                    <button type="submit" id="submit-proof-btn" class="w-full bg-primary hover:bg-primary/90 text-white font-black text-sm py-4 rounded-xl shadow-lg shadow-primary/20 transition-all active:scale-95 flex justify-center items-center gap-2">
                        <span>Konfirmasi Pembayaran</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    import { apiFetch } from '../../../services/api';

    let isSubmitting = false;

    // Fungsi global untuk membuka modal
    window.openPaymentModal = (orderId: string, orderType: string) => {
        const modal = document.getElementById('payment-modal');
        const content = document.getElementById('payment-modal-content');
        const idInput = document.getElementById('modal-order-id') as HTMLInputElement;
        const typeInput = document.getElementById('modal-order-type') as HTMLInputElement;

        if (modal && content && idInput && typeInput) {
            idInput.value = orderId;
            typeInput.value = orderType;
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            // Animasi masuk
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 10);
        }
    };

    // Fungsi global untuk menutup modal
    window.closePaymentModal = () => {
        const modal = document.getElementById('payment-modal');
        const content = document.getElementById('payment-modal-content');
        const form = document.getElementById('payment-proof-form') as HTMLFormElement;

        if (modal && content) {
            // Animasi keluar
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
                if (form) form.reset();
            }, 300);
        }
    };

    // Setup event listeners
    const initPaymentModal = () => {
        const closeBtn = document.getElementById('close-modal-btn');
        const form = document.getElementById('payment-proof-form');
        const modal = document.getElementById('payment-modal');

        if (closeBtn) {
            closeBtn.addEventListener('click', window.closePaymentModal);
        }

        // Tutup jika klik area luar modal
        if (modal) {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    window.closePaymentModal();
                }
            });
        }

        if (form) {
            // Remove previous listener to avoid duplicates if called multiple times
            const newForm = form.cloneNode(true);
            form.parentNode?.replaceChild(newForm, form);
            
            newForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (isSubmitting) return;

                const formEl = e.target as HTMLFormElement;
                const fileInput = document.getElementById('proof-image') as HTMLInputElement;
                const idInput = document.getElementById('modal-order-id') as HTMLInputElement;
                const typeInput = document.getElementById('modal-order-type') as HTMLInputElement;
                const submitBtn = document.getElementById('submit-proof-btn');

                if (!fileInput.files || fileInput.files.length === 0) {
                    alert('Harap pilih file gambar bukti pembayaran!');
                    return;
                }

                try {
                    isSubmitting = true;
                    if (submitBtn) {
                        submitBtn.innerHTML = '<span class="animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span> <span>Mengunggah...</span>';
                        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
                    }

                    // Buat FormData untuk mengirim file
                    const formData = new FormData();
                    formData.append('payment_proof', fileInput.files[0]);

                    const token = localStorage.getItem('jwt_token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
                    if (!token) throw new Error("Sesi telah habis, silakan login ulang");

                    const orderId = idInput.value;
                    const orderType = typeInput.value;

                    // Tembak endpoint berdasarkan tipe
                    let endpoint = "";
                    if (orderType === "travel") {
                        endpoint = `/api/travel/bookings/${orderId}/payment-proof`;
                    } else if (orderType === "charter") {
                        endpoint = `/api/charter/request/${orderId}/payment-proof`;
                    } else if (orderType === "package") {
                        endpoint = `/api/packages/shipments/${orderId}/payment-proof`;
                    }

                    const beHost = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';
                    const res = await fetch(`${beHost}${endpoint}`, {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${token}`
                        },
                        body: formData
                    });

                    if (!res.ok) {
                        const errData = await res.json();
                        throw new Error(errData.message || 'Gagal mengunggah bukti');
                    }

                    alert('Bukti pembayaran berhasil diunggah! Menunggu konfirmasi admin.');
                    window.location.reload();

                } catch (error: any) {
                    console.error('Upload Error:', error);
                    alert(`Gagal mengunggah bukti pembayaran: ${error.message}`);
                } finally {
                    isSubmitting = false;
                    if (submitBtn) {
                        submitBtn.innerHTML = '<span>Konfirmasi Pembayaran</span>';
                        submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                    }
                }
            });
        }
    };

    // Eksekusi inisialisasi
    initPaymentModal();
    document.addEventListener('astro:page-load', initPaymentModal);

    // Deklarasikan di window agar TS tidak error (opsional)
    declare global {
        interface Window {
            openPaymentModal: (id: string, type: string) => void;
            closePaymentModal: () => void;
        }
    }
</script>
