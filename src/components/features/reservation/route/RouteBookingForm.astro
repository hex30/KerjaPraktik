---
// File: src/components/features/reservation/route/RouteBookingForm.astro
import PassengerDataForm from "@features/reservation/shared/PassengerDataForm.astro";
import SeatMap from "@features/reservation/shared/SeatMap.astro";
import SectionHeader from "@ui/SectionHeader.astro";
import RouteSelectionItem from "./RouteSelectionItem.astro";
import InputGroup from "@ui/InputGroup.astro";
import KecamatanCombobox from "@ui/KecamatanCombobox.astro";
import QuantitySelector from "@ui/QuantitySelector.astro";
import Button from "@ui/Button.astro";
import HeroAside from "@ui/HeroAside.astro";
import AlertCard from "@ui/AlertCard.astro";
import { travelService } from "@services/travelService";

interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Detail Perjalanan Travel",
    subtitle = "Lengkapi rute, jadwal keberangkatan, dan bagasi Anda.",
} = Astro.props;

let routeData: any[] = [];
try {
    const routes = await travelService.getRoutes();
    routeData = Array.isArray(routes) ? routes : routes.data || [];
} catch (error) {
    console.error("Gagal memuat rute:", error);
}
---

<div class="w-full relative font-main">
    <article
        class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto"
    >
        <div class="w-full lg:w-3/5 flex flex-col gap-8">
            <!-- Step 1: Schedule & Route -->
            <div id="travel-step-1" class="block animate-fade-in">
                <SectionHeader title={title} subtitle={subtitle} />

                <form id="form-reservasi-travel" class="flex flex-col gap-8">
                    <section
                        class="flex flex-col gap-5 border-b border-slate-100 pb-8"
                    >
                        <h3
                            class="text-lg text-primary font-bold flex items-center gap-2"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm"
                                >1</span
                            >
                            Rute dan Jadwal Perjalanan
                        </h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                            {
                                routeData.map((route) => {
                                    // Logika hari hardcode sementara
                                    let days = "Setiap Hari";
                                    const originLower =
                                        route.origin.toLowerCase();
                                    if (originLower.includes("jakarta")) {
                                        days =
                                            "Selasa, Kamis, Sabtu dan Minggu";
                                    } else if (
                                        originLower.includes("panawangan")
                                    ) {
                                        days = "Senin, Rabu dan Jum'at";
                                    }

                                    return (
                                        <RouteSelectionItem
                                            value={route.id}
                                            label={`${route.origin} ➔ ${route.destination}`}
                                            days={days}
                                            data-origin={route.origin}
                                            data-base-price={route.base_price}
                                        />
                                    );
                                })
                            }
                        </div>

                        <div class="flex flex-col gap-3 mt-2">
                            <label
                                class="font-secondary text-sm font-bold text-primary"
                                >Pilih tanggal keberangkatan anda</label
                            >
                            <div
                                id="date-container-travel"
                                class="flex gap-4 overflow-x-auto pb-4 hide-scrollbar snap-x w-full"
                            >
                                <div
                                    class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 text-slate-400 text-sm font-medium"
                                >
                                    Pilih rute perjalanan terlebih dahulu
                                </div>
                            </div>
                            <input
                                type="hidden"
                                name="tanggal_keberangkatan"
                                id="tanggal_hidden_travel"
                                required
                            />
                        </div>
                    </section>

                    <!-- RESTRICTED AREA FOR GUEST -->
                    <div
                        id="restricted-area-route"
                        class="relative transition-all duration-300"
                    >
                        <!-- Guest Alert Overlay Backdrop (Transparent Catcher) -->
                        <div
                            id="guest-overlay-route"
                            class="absolute inset-0 z-40 bg-transparent cursor-pointer rounded-2xl"
                        >
                        </div>

                        <!-- Content yang dikunci secara fungsional (tidak diblur) -->
                        <div
                            id="restricted-content-route"
                            class="flex flex-col gap-6 pointer-events-none transition-all duration-500"
                        >
                            <section class="border-b border-slate-100 pb-8">
                                <h3
                                    class="text-lg text-primary font-bold flex items-center gap-2 mb-6"
                                >
                                    <span
                                        class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm"
                                        >2</span
                                    >
                                    Pilih Kursi
                                </h3>
                                <SeatMap />

                                <!-- Ringkasan Harga Tiket (Inline) -->
                                <div id="sticky-price-bar" class="hidden mt-6 p-6 rounded-2xl bg-slate-50 border border-slate-100/80 animate-fade-in">
                                    <div class="flex flex-col gap-4">
                                        <div class="flex justify-between items-center pb-3 border-b border-slate-200/60">
                                            <div>
                                                <h4 class="font-bold text-primary text-sm">Estimasi Biaya</h4>
                                                <p id="sticky-route-info" class="text-xs text-slate-400 font-secondary mt-0.5">Pilih rute & tanggal...</p>
                                            </div>
                                            <!-- Opsi Jumlah Kursi Manual (Tampil HANYA jika Guest) -->
                                            <div id="guest-qty-container" class="hidden items-center gap-2">
                                                <label class="text-xs text-slate-500 font-bold">Jumlah Kursi:</label>
                                                <select id="guest-qty-select" class="bg-white border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-primary focus:outline-none cursor-pointer shadow-sm">
                                                    <option value="1" selected>1 Kursi</option>
                                                    <option value="2">2 Kursi</option>
                                                    <option value="3">3 Kursi</option>
                                                    <option value="4">4 Kursi</option>
                                                </select>
                                            </div>
                                        </div>
                                        
                                        <div class="flex flex-col gap-2">
                                            <div id="promo-row" class="hidden justify-between items-center text-xs">
                                                <span id="sticky-promo-badge" class="font-bold text-green-700 bg-green-50 border border-green-200 px-2 py-0.5 rounded-full"></span>
                                                <span id="sticky-original-price" class="text-slate-400 line-through font-secondary"></span>
                                            </div>
                                            <div class="flex justify-between items-center">
                                                <span class="text-sm text-slate-600 font-bold">Total Pembayaran</span>
                                                <span id="sticky-total-price" class="text-lg font-black text-primary">Rp 0</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="flex flex-col gap-5">
                                <h3
                                    class="text-lg text-primary font-bold flex items-center gap-2"
                                >
                                    <span
                                        class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm"
                                        >3</span
                                    >
                                    Barang Bawaan (Opsional)
                                </h3>

                                <div
                                    class="p-6 rounded-2xl bg-slate-50 border border-slate-100 relative mt-2"
                                >
                                    <div
                                        class="grid grid-cols-1 md:grid-cols-2 gap-5"
                                    >
                                        <div class="flex flex-col gap-2 w-full">
                                            <label
                                                for="berat_bagasi"
                                                class="font-secondary text-sm font-bold text-primary"
                                            >
                                                Berat Bawaan
                                            </label>
                                            <div
                                                class="relative flex items-center w-full"
                                            >
                                                <input
                                                    type="number"
                                                    name="berat_bagasi"
                                                    id="berat_bagasi"
                                                    placeholder="Contoh: 15"
                                                    min="0"
                                                    class="w-full bg-slate-100 border border-slate-200 rounded-lg pl-4 pr-16 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
                                                />
                                                <div
                                                    class="absolute right-1 top-1 bottom-1 bg-white border border-slate-200 rounded-md px-3 flex items-center justify-center pointer-events-none shadow-sm"
                                                >
                                                    <span
                                                        class="font-black text-primary text-xs tracking-wider"
                                                        >Kg</span
                                                    >
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex flex-col gap-2 w-full">
                                            <label
                                                for="dimensi_bagasi"
                                                class="font-secondary text-sm font-bold text-primary"
                                                >Ukuran Dominan</label
                                            >
                                            <div class="relative">
                                                <select
                                                    name="dimensi_bagasi"
                                                    id="dimensi_bagasi"
                                                    class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all appearance-none cursor-pointer"
                                                >
                                                    <option
                                                        value="kecil"
                                                        selected
                                                        >Kecil (Dokumen/Buku)</option
                                                    >
                                                    <option value="sedang"
                                                        >Sedang (Kotak
                                                        Sepatu/Pakaian)</option
                                                    >
                                                    <option value="besar"
                                                        >Besar (Kardus
                                                        Besar/Elektronik)</option
                                                    >
                                                    <option value="super_besar"
                                                        >Super Besar
                                                        (Furnitur/Motor)</option
                                                    >
                                                </select>
                                                <div
                                                    class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400"
                                                >
                                                    <svg
                                                        class="w-4 h-4"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                        ><path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M19 9l-7 7-7-7"
                                                        ></path></svg
                                                    >
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic Luggage Alert Card -->
                                <div
                                    id="luggage-alert-card"
                                    class="hidden animate-fade-in"
                                >
                                    <div
                                        class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex gap-4 items-start shadow-sm"
                                    >
                                        <div
                                            class="bg-amber-100 text-amber-600 p-2 rounded-lg shrink-0"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-6 w-6"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <h4
                                                class="font-bold text-amber-800 text-sm"
                                            >
                                                Informasi Tambahan
                                            </h4>
                                            <p
                                                class="text-amber-700 text-xs font-secondary leading-relaxed"
                                            >
                                                Berat atau dimensi barang bawaan
                                                anda melebihi batas maximal dan
                                                akan di hitung sebagai 1 orang.
                                            </p>
                                </div>

                                <!-- Dynamic Payload Exceeded Alert Card -->
                                <div
                                    id="payload-alert-card"
                                    class="hidden animate-fade-in mt-4"
                                >
                                    <div
                                        class="bg-red-50 border border-red-200 rounded-xl p-4 flex gap-4 items-start shadow-sm"
                                    >
                                        <div
                                            class="bg-red-100 text-red-600 p-2 rounded-lg shrink-0"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-6 w-6"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                                ></path>
                                            </svg>
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <h4
                                                class="font-bold text-red-800 text-sm"
                                            >
                                                Kapasitas Beban Terlampaui
                                            </h4>
                                            <p
                                                id="payload-alert-text"
                                                class="text-red-700 text-xs font-secondary leading-relaxed"
                                            >
                                                Beban kargo armada sudah penuh untuk tanggal ini.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- START ALAMAT PENURUNAN -->
                            <div
                                class="flex flex-col gap-4 mt-6 pt-6 border-t border-slate-100"
                            >
                                <h3
                                    class="text-lg text-primary font-bold flex items-center gap-2 mb-2"
                                >
                                    <span
                                        class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm"
                                        >4</span
                                    >
                                    Detail Alamat Penurunan (Tujuan)
                                </h3>
                                <div
                                    class="grid grid-cols-1 md:grid-cols-2 gap-4"
                                >
                                    <KecamatanCombobox
                                        label="Kecamatan"
                                        id="tujuan_kecamatan"
                                        name="tujuan_kecamatan"
                                        placeholder="Contoh: Menteng"
                                        required={true}
                                    />
                                    <InputGroup
                                        label="Desa"
                                        id="tujuan_desa"
                                        name="tujuan_desa"
                                        placeholder="Contoh: Cikodang"
                                        required={true}
                                    />
                                    <InputGroup
                                        label="Dusun"
                                        id="tujuan_dusun"
                                        name="tujuan_dusun"
                                        placeholder="Contoh: Manis"
                                        required={true}
                                    />
                                    <div class="grid grid-cols-2 gap-4">
                                        <InputGroup
                                            label="RT"
                                            id="tujuan_rt"
                                            name="tujuan_rt"
                                            type="number"
                                            placeholder="00"
                                            required={true}
                                        />
                                        <InputGroup
                                            label="RW"
                                            id="tujuan_rw"
                                            name="tujuan_rw"
                                            type="number"
                                            placeholder="00"
                                            required={true}
                                        />
                                    </div>
                                    <div class="md:col-span-2 lg:col-span-2">
                                        <InputGroup
                                            label="Patokan Bangunan"
                                            id="tujuan_patokan"
                                            name="tujuan_patokan"
                                            placeholder="Contoh: Depan Masjid Agung"
                                            required={false}
                                        />
                                    </div>
                                </div>
                            </div>
                            <!-- END ALAMAT PENURUNAN -->

                            <div class="pt-2">
                                <Button
                                    type="submit"
                                    size="lg"
                                    class="w-full md:w-auto"
                                >
                                    Lanjutkan Isi Data Diri
                                </Button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Step 2: Passenger Data -->
            <div id="travel-step-2" class="hidden animate-fade-in w-full">
                <button
                    type="button"
                    id="btn-kembali-travel"
                    class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors group"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5 transition-transform group-hover:-translate-x-1"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Kembali ke Pilihan Jadwal
                </button>

                <form id="form-data-diri-travel" class="flex flex-col gap-8">
                    <PassengerDataForm />

                    <div id="additional-passengers-container" class="flex flex-col gap-6"></div>

                    <!-- Panel Warning Payload Step 2 (Grup) -->
                    <div id="payload-group-alert" class="hidden bg-red-50 border border-red-200 rounded-2xl p-4 flex gap-3 items-start shadow-sm">
                        <div class="bg-red-100 text-red-600 p-1.5 rounded-lg shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div class="flex flex-col gap-0.5">
                            <h4 class="font-bold text-red-800 text-sm">Kapasitas Kargo Terlampaui</h4>
                            <p id="payload-group-alert-text" class="text-red-700 text-xs font-secondary leading-tight"></p>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100">
                        <Button
                            type="submit"
                            size="lg"
                            class="w-full md:w-auto"
                        >
                            Selesaikan Pemesanan
                        </Button>
                    </div>
                </form>
            </div>
        </div>

        <HeroAside
            image="/assets/images/contoh.jpg"
            title="Perjalanan Nyaman & Aman"
            description="Armada premium kami dirancang dengan bagasi luas untuk kepuasan Anda."
        />
    </article>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<!-- FIXED GUEST ALERT CARD -->
<div
    id="guest-alert-card-route"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/40 backdrop-blur-sm px-4 opacity-0 transition-opacity duration-300"
>
    <div
        class="pointer-events-auto shadow-2xl rounded-2xl transform scale-95 transition-transform duration-300"
        id="guest-alert-card-inner-route"
    >
        <AlertCard
            type="warning"
            title="Login Diperlukan"
            message="Silakan masuk ke akun Anda untuk memilih kursi dan melanjutkan tahap pemesanan."
            actionText="Login Sekarang"
            actionLink="/auth/login"
        />
    </div>
</div>

<script>
    import { authGuard } from "@utils/authGuard";
    import { travelService } from "@services/travelService";

    let selectedScheduleId = ""; // (Deprecated, will be removed later)
    let selectedRouteId = "";
    let selectedRawDate = "";

    const formatters = {
        currency: new Intl.NumberFormat("id-ID", {
            style: "currency",
            currency: "IDR",
            maximumFractionDigits: 0,
        }),
        day: new Intl.DateTimeFormat("id-ID", { weekday: "long" }),
        shortDay: new Intl.DateTimeFormat("id-ID", { weekday: "short" }),
        date: new Intl.DateTimeFormat("id-ID", { day: "2-digit" }),
        month: new Intl.DateTimeFormat("id-ID", { month: "short" }),
    };

    const generateDates = async (routeId: string) => {
        try {
            const response =
                await travelService.getSchedulesAvailability(routeId);
            return Array.isArray(response.data) ? response.data : [];
        } catch (error) {
            console.error("Gagal mengambil jadwal:", error);
            return [];
        }
    };

    const createScheduleCard = (schedule: any) => {
        const dateObj = new Date(schedule.departure_time);
        const isFull = schedule.available_seats <= 0;

        if (isFull) {
            return "";
        }

        return `
            <label class="relative cursor-pointer snap-start shrink-0 group">
                <input type="radio" name="pilihan_jadwal" data-raw-date="${schedule.raw_date}" value="${schedule.id}" class="peer sr-only" ${isFull ? "disabled" : ""}>
                <div class="flex flex-col items-center justify-center min-w-[120px] p-4 border-2 border-slate-200 rounded-2xl text-primary transition-all peer-checked:text-black peer-checked:border-primary peer-checked:bg-primary/10 hover:border-primary hover:-translate-y-1 ${isFull ? "opacity-50 cursor-not-allowed grayscale" : ""}">
                    <span class="text-[12px] text-slate-500 font-secondary mb-1 uppercase tracking-wider font-bold">
                        ${formatters.day.format(dateObj)}
                    </span>
                    <span class="text-4xl font-black leading-none my-1">${formatters.date.format(dateObj)}</span>
                    <span class="text-sm text-slate-500 font-secondary mt-1 font-bold">${formatters.month.format(dateObj)}</span>
                    <span class="text-xs ${isFull ? "text-red-500" : "text-green-600"} font-bold mt-2 bg-white px-2 py-0.5 rounded-full border shadow-sm">
                        ${isFull ? "Penuh" : `Sisa ${schedule.sisa_kursi} Kursi`}
                    </span>
                </div>
            </label>
        `;
    };

    const setupTravelFlow = () => {
        const step1 = document.getElementById("travel-step-1");
        const step2 = document.getElementById("travel-step-2");
        const form1 = document.getElementById(
            "form-reservasi-travel",
        ) as HTMLFormElement;
        const form2 = document.getElementById(
            "form-data-diri-travel",
        ) as HTMLFormElement;
        const dateContainer = document.getElementById("date-container-travel");
        const hiddenDate = document.getElementById(
            "tanggal_hidden_travel",
        ) as HTMLInputElement;
        const ruteRadios = document.querySelectorAll('input[name="rute"]');
        const btnBack = document.getElementById("btn-kembali-travel");

        // UX: Guest Overlay Setup
        const guestOverlay = document.getElementById("guest-overlay-route");
        const guestAlertCard = document.getElementById(
            "guest-alert-card-route",
        );
        const restrictedContent = document.getElementById(
            "restricted-content-route",
        );

        // Pindahkan modal ke luar dari struktur DOM komponen agar 'fixed' benar-benar berada di window (terbebas dari parent CSS transform/filter)
        if (guestAlertCard && guestAlertCard.parentElement !== document.body) {
            document.body.appendChild(guestAlertCard);
        }

        const setupGuestOverlay = () => {
            if (authGuard.isLoggedIn()) {
                guestOverlay?.classList.add("hidden");
                guestAlertCard?.classList.add("hidden");
                restrictedContent?.classList.remove("pointer-events-none");
            } else {
                guestOverlay?.classList.remove("hidden");
                // Alert Card disembunyikan secara default
                guestAlertCard?.classList.add("hidden");
                guestAlertCard?.classList.remove("flex");
                restrictedContent?.classList.add("pointer-events-none");
            }
        };
        setupGuestOverlay();

        // Tampilkan modal alert hanya saat overlay diblur di-klik
        if (guestOverlay) {
            guestOverlay.addEventListener("click", () => {
                if (guestAlertCard) {
                    guestAlertCard.classList.remove("hidden");
                    guestAlertCard.classList.add("flex");
                    // Trigger animasi
                    void guestAlertCard.offsetWidth;
                    guestAlertCard.classList.remove("opacity-0");
                    const inner = document.getElementById(
                        "guest-alert-card-inner-route",
                    );
                    inner?.classList.remove("scale-95");
                }
            });
        }

        // Tutup modal jika klik di luar card (di area backdrop)
        if (guestAlertCard) {
            guestAlertCard.addEventListener("click", (e) => {
                if (e.target === guestAlertCard) {
                    guestAlertCard.classList.add("opacity-0");
                    const inner = document.getElementById(
                        "guest-alert-card-inner-route",
                    );
                    inner?.classList.add("scale-95");
                    setTimeout(() => {
                        guestAlertCard.classList.remove("flex");
                        guestAlertCard.classList.add("hidden");
                    }, 300);
                }
            });
        }

        if (!step1 || !step2 || !form1 || !form2) return;

        // Guest Interceptor on Form interaction
        const checkGuest = (e: Event) => {
            if (!authGuard.isLoggedIn()) {
                e.preventDefault();
                e.stopPropagation();
                authGuard.requireAuth();
                return true;
            }
            return false;
        };

        // Route Selection Logic
        ruteRadios.forEach((radio) => {
            radio.addEventListener("change", async (e) => {
                const target = e.target as HTMLInputElement;
                selectedRouteId = target.value;
                if (!dateContainer) return;

                dateContainer.innerHTML = `
                    <div class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 text-slate-400 text-sm font-medium animate-pulse">
                        Mengecek ketersediaan armada...
                    </div>
                `;

                // Cek armada global
                try {
                    const fleetCheck =
                        await travelService.checkFleetsAvailability();
                    if (
                        fleetCheck &&
                        fleetCheck.data &&
                        fleetCheck.data.available === false
                    ) {
                        if (
                            typeof (window as any).showGlobalFleetAlert ===
                            "function"
                        ) {
                            (window as any).showGlobalFleetAlert();
                        }
                        target.checked = false;
                        dateContainer.innerHTML = `
                            <div class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 text-slate-500 text-sm font-medium">
                                Silakan pilih rute untuk melihat ketersediaan armada.
                            </div>
                        `;
                        return;
                    }
                } catch (err) {
                    console.error("Gagal mengecek armada:", err);
                }

                dateContainer.innerHTML = `
                    <div class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 text-slate-400 text-sm font-medium animate-pulse">
                        Mencari jadwal tersedia...
                    </div>
                `;

                hiddenDate.value = "";
                selectedScheduleId = "";
                selectedRouteId = target.value;

                // Mendapatkan origin dari atribut data-origin radio button yang diklik
                const routeOrigin = target.getAttribute("data-origin") || "";

                // Route name format yang digunakan oleh generateDates: "panawangan_jakarta" atau "jakarta_panawangan"
                let routeNameValue = "";
                if (routeOrigin.toLowerCase().includes("panawangan")) {
                    routeNameValue = "panawangan_jakarta";
                } else {
                    routeNameValue = "jakarta_panawangan";
                }

                try {
                    const baseSchedules = await generateDates(target.value);

                    if (baseSchedules.length === 0) {
                        dateContainer.innerHTML = `
                            <div class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 text-slate-500 text-sm font-medium">
                                Maaf, tidak ada jadwal aktif untuk rute ini.
                            </div>
                        `;
                        return;
                    }

                    // Mapping backend properties to template usage
                    const formattedSchedules = baseSchedules.map((s: any) => ({
                        id: s.schedule_id || `NEW-${s.date}`,
                        raw_date: s.date,
                        departure_time: s.departure_time,
                        available_seats: s.sisa_kursi,
                        sisa_kursi: s.sisa_kursi,
                    }));

                    dateContainer.innerHTML = formattedSchedules
                        .map(createScheduleCard)
                        .join("");
                } catch (error) {
                    dateContainer.innerHTML = `
                        <div class="w-full flex items-center justify-center p-8 border-2 border-dashed border-slate-200 rounded-2xl bg-red-50 text-red-500 text-sm font-medium">
                            Gagal memuat jadwal. Silakan coba lagi.
                        </div>
                    `;
                }
            });
        });

        let selectedRawDate = "";
        let currentRouteWeight = 0;
        let currentRouteMaxPayload = 0;

        dateContainer?.addEventListener("change", async (e) => {
            const target = e.target as HTMLInputElement;
            if (target && target.name === "pilihan_jadwal") {
                hiddenDate.value = target.value;
                selectedScheduleId = target.value;
                selectedRawDate = target.getAttribute("data-raw-date") || "";

                // Reset kursi
                const hiddenInput = document.getElementById(
                    "input-selected-seats",
                ) as HTMLInputElement;
                if (hiddenInput) {
                    hiddenInput.value = "";
                    hiddenInput.dispatchEvent(
                        new Event("change", { bubbles: true }),
                    );
                }

                try {
                    // Panggil API riil ke backend
                    const response = await travelService.getSeatsOccupancy(
                        selectedRouteId,
                        selectedRawDate,
                    );
                    const seatInfo = response.data || {};
                    currentRouteWeight = seatInfo.total_weight || 0;
                    currentRouteMaxPayload = seatInfo.max_payload || 0;

                    // Trigger payload validation check
                    checkLuggageAlert();

                    const lockedSeats = Array.isArray(
                        seatInfo.occupied_seats_list,
                    )
                        ? seatInfo.occupied_seats_list
                        : [];
                    const maxCapacity = seatInfo.max_capacity || 0;

                    if (seatInfo.status === "full" || maxCapacity === 0) {
                        return (window as any).showFeedbackModal(
                            "error",
                            "Armada Penuh",
                            "Maaf, armada untuk jadwal ini sudah disewa penuh oleh layanan Charter/Paket atau sudah terisi penuh.",
                        );
                    }

                    // Kita bisa simpan status unit dari backend jika perlu untuk UI
                    // const unitName = seatInfo.unit;

                    const allSeats = document.querySelectorAll(".seat-btn");
                    allSeats.forEach((btn) => {
                        const btnEl = btn as HTMLButtonElement;
                        const seatNumber = parseInt(btnEl.textContent || "0");

                        // Bersihkan pilihan sebelumnya
                        btnEl.setAttribute("data-selected", "false");

                        // Jika kursi tersebut di luar maxCapacity unit yang dialokasikan (misal unit Luxio max 10, tapi ada seat 11-14 di UI)
                        if (seatNumber > maxCapacity) {
                            btnEl.setAttribute("disabled", "true");
                            btnEl.classList.add(
                                "opacity-20",
                                "grayscale",
                                "cursor-not-allowed",
                                "hidden",
                            );
                        } else {
                            btnEl.classList.remove("hidden");
                            if (lockedSeats.includes(seatNumber)) {
                                // Jika kursi sudah dipesan
                                btnEl.setAttribute("disabled", "true");
                                btnEl.classList.add(
                                    "opacity-40",
                                    "grayscale",
                                    "cursor-not-allowed",
                                );
                            } else {
                                // Jika kursi kosong
                                btnEl.removeAttribute("disabled");
                                btnEl.classList.remove(
                                    "opacity-40",
                                    "grayscale",
                                    "cursor-not-allowed",
                                );
                            }
                        }
                    });
                } catch (err) {
                    console.error("Gagal mengambil data kursi riil", err);
                }
            }
        });

        // Luggage Alert Logic
        const beratBagasiInput = document.getElementById(
            "berat_bagasi",
        ) as HTMLInputElement;
        const dimensiBagasiSelect = document.getElementById(
            "dimensi_bagasi",
        ) as HTMLSelectElement;
        const luggageAlertCard = document.getElementById("luggage-alert-card");

        const checkLuggageAlert = () => {
            if (!beratBagasiInput || !dimensiBagasiSelect || !luggageAlertCard)
                return;
            const weight = parseInt(beratBagasiInput.value) || 0;
            const dimension = dimensiBagasiSelect.value;

            // 1. Warning bagasi standar
            if (weight >= 60 || dimension === "super_besar") {
                luggageAlertCard.classList.remove("hidden");
            } else {
                luggageAlertCard.classList.add("hidden");
            }

            // 2. Warning payload kargo
            const payloadAlertCard = document.getElementById("payload-alert-card");
            const payloadAlertText = document.getElementById("payload-alert-text");

            if (payloadAlertCard && currentRouteMaxPayload > 0) {
                const extraSeats = (weight >= 60 || dimension === "super_besar") ? 1 : 0;
                const additionalWeight = (1 + extraSeats) * 110;
                const remainingPayload = currentRouteMaxPayload - currentRouteWeight;

                if (currentRouteWeight + additionalWeight > currentRouteMaxPayload) {
                    if (payloadAlertText) {
                        payloadAlertText.textContent = `Mohon maaf, sisa kapasitas kargo armada kami untuk tanggal ini adalah ${Math.max(0, remainingPayload)} kg. Berat bawaan Anda (dihitung ${additionalWeight} kg termasuk jatah kursi) melebihi batas kapasitas tersebut.`;
                    }
                    payloadAlertCard.classList.remove("hidden");
                } else {
                    payloadAlertCard.classList.add("hidden");
                }
            }
        };

        if (beratBagasiInput && dimensiBagasiSelect) {
            beratBagasiInput.addEventListener("input", checkLuggageAlert);
            dimensiBagasiSelect.addEventListener("change", checkLuggageAlert);
        }

        // 3. Warning payload kargo rombongan (Step 2)
        const checkGroupPayloadLimit = () => {
            const btnSubmit = form2.querySelector('button[type="submit"]') as HTMLButtonElement;
            const groupAlert = document.getElementById("payload-group-alert");
            const groupAlertText = document.getElementById("payload-group-alert-text");
            
            if (!groupAlert || !btnSubmit || currentRouteMaxPayload === 0) return;

            const seatValues = (document.getElementById("input-selected-seats") as HTMLInputElement)?.value || "";
            const seatsList = seatValues.split(",").map(s => s.trim()).filter(Boolean);

            let accumWeight = 0;

            // Passenger 1 (dari Input Step 1)
            const w1 = parseFloat(beratBagasiInput?.value || "0") || 0;
            const d1 = dimensiBagasiSelect?.value || "kecil";
            const extra1 = (w1 >= 60 || d1 === "super_besar") ? 1 : 0;
            accumWeight += (1 + extra1) * 110;

            // Penumpang tambahan
            for (let i = 1; i < seatsList.length; i++) {
                const seat = seatsList[i];
                const wInput = form2.querySelector(`[name="baggage_weight_${seat}"]`) as HTMLInputElement;
                const dSelect = form2.querySelector(`[name="baggage_dimension_${seat}"]`) as HTMLSelectElement;
                
                const w = parseFloat(wInput?.value || "0") || 0;
                const d = dSelect?.value || "kecil";
                const extra = (w >= 60 || d === "super_besar") ? 1 : 0;
                accumWeight += (1 + extra) * 110;
            }

            const remainingPayload = currentRouteMaxPayload - currentRouteWeight;

            if (currentRouteWeight + accumWeight > currentRouteMaxPayload) {
                if (groupAlertText) {
                    groupAlertText.textContent = `Mohon maaf, sisa kapasitas kargo armada kami untuk tanggal ini adalah ${Math.max(0, remainingPayload)} kg. Total beban kargo rombongan Anda (dihitung ${accumWeight} kg termasuk jatah kursi) melebihi batas kapasitas tersebut.`;
                }
                groupAlert.classList.remove("hidden");
                groupAlert.classList.add("flex");
                btnSubmit.disabled = true;
            } else {
                groupAlert.classList.add("hidden");
                groupAlert.classList.remove("flex");
                btnSubmit.disabled = false;
            }
        };

        // Navigation Logic
        form1.addEventListener("submit", (e) => {
            e.preventDefault();
            if (checkGuest(e)) return;
            if (!hiddenDate.value) {
                return (window as any).showFeedbackModal(
                    "warning",
                    "Pilih Jadwal",
                    "Silakan pilih rute dan tanggal keberangkatan terlebih dahulu.",
                );
            }

            const selectedSeats = (
                document.getElementById(
                    "input-selected-seats",
                ) as HTMLInputElement
            )?.value;
            if (!selectedSeats) {
                return (window as any).showFeedbackModal(
                    "warning",
                    "Pilih Kursi",
                    "Silakan pilih minimal 1 kursi yang tersedia untuk melanjutkan.",
                );
            }

            const seatsList = selectedSeats.split(",").map(s => s.trim()).filter(Boolean);

            // Cek batas kursi (maksimal 4)
            if (seatsList.length > 4) {
                return (window as any).showFeedbackModal(
                    "warning",
                    "Batas Pemesanan",
                    "Maksimal pemesanan tiket reguler dalam satu transaksi adalah 4 kursi. Untuk rombongan besar, silakan gunakan layanan Charter kami."
                );
            }

            // Cek apakah muatan payload terlampaui (Untuk Penumpang 1)
            if (currentRouteMaxPayload > 0) {
                const weight = parseInt(beratBagasiInput.value) || 0;
                const dimension = dimensiBagasiSelect.value;
                const extraSeats = (weight >= 60 || dimension === "super_besar") ? 1 : 0;
                const additionalWeight = (1 + extraSeats) * 110;
                if (currentRouteWeight + additionalWeight > currentRouteMaxPayload) {
                    return (window as any).showFeedbackModal(
                        "warning",
                        "Kapasitas Beban Terlampaui",
                        `Mohon maaf, sisa kapasitas kargo armada untuk jadwal ini tidak mencukupi untuk bagasi Anda.`
                    );
                }
            }

            // Update main passenger form title with seat number
            const mainFormHeader = document.querySelector("#form-data-diri-travel h3");
            if (mainFormHeader) {
                mainFormHeader.innerHTML = `<span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm">1</span>Data Diri Penumpang 1 (Kursi ${seatsList[0]})`;
            }

            // Generate additional passenger cards
            const additionalContainer = document.getElementById("additional-passengers-container");
            if (additionalContainer) {
                additionalContainer.innerHTML = "";
                
                for (let i = 1; i < seatsList.length; i++) {
                    const seat = seatsList[i];
                    const cardHTML = `
                        <div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col gap-6 font-main additional-passenger-card mt-6" data-seat="${seat}">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                                <h3 class="text-lg text-primary font-bold flex items-center gap-2">
                                    <span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm">${i + 1}</span>
                                    Data Diri Penumpang ${i + 1} (Kursi ${seat})
                                </h3>
                                <button type="button" class="btn-autofill-additional text-xs font-bold text-primary hover:underline hover:text-primary-dark transition-colors">
                                    Salin Data Pemesan
                                </button>
                            </div>

                            <div class="flex flex-col gap-5">
                                <div class="w-full relative">
                                    <label class="font-secondary text-sm font-bold text-primary mb-2 block">Nama Lengkap</label>
                                    <input type="text" name="passenger_name_${seat}" placeholder="Masukan Nama Lengkap Penumpang" required class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400" />
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                    <div class="flex flex-col gap-2 w-full">
                                        <label class="font-secondary text-sm font-bold text-primary">Berat Bawaan</label>
                                        <div class="relative flex items-center w-full">
                                            <input type="number" name="baggage_weight_${seat}" placeholder="Contoh: 15" min="0" required class="baggage-weight-input w-full bg-slate-100 border border-slate-200 rounded-lg pl-4 pr-16 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400" />
                                            <div class="absolute right-1 top-1 bottom-1 bg-white border border-slate-200 rounded-md px-3 flex items-center justify-center pointer-events-none shadow-sm">
                                                <span class="font-black text-primary text-xs tracking-wider">Kg</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-2 w-full">
                                        <label class="font-secondary text-sm font-bold text-primary">Ukuran Dominan</label>
                                        <div class="relative">
                                            <select name="baggage_dimension_${seat}" class="baggage-dimension-select w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all appearance-none cursor-pointer">
                                                <option value="kecil" selected>Kecil (Dokumen/Buku)</option>
                                                <option value="sedang">Sedang (Ransel/Tas Jinjing)</option>
                                                <option value="besar">Besar (Koper Sedang)</option>
                                                <option value="super_besar">Super Besar (Koper Jumbo > 60 kg)</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    additionalContainer.insertAdjacentHTML("beforeend", cardHTML);
                }

                // Add autofill behavior to new buttons
                additionalContainer.querySelectorAll(".btn-autofill-additional").forEach(btn => {
                    btn.addEventListener("click", (e) => {
                        const card = (e.target as HTMLElement).closest(".additional-passenger-card");
                        if (!card) return;
                        const nameInput = card.querySelector('input[type="text"]') as HTMLInputElement;
                        
                        const userDataStr = localStorage.getItem("user_data");
                        if (userDataStr && nameInput) {
                            try {
                                const user = JSON.parse(userDataStr);
                                nameInput.value = user.full_name || user.username || user.name || user.nama || "";
                            } catch (err) {
                                console.error(err);
                            }
                        }
                    });
                });

                // Add live change events to calculate accumulative payload warnings
                additionalContainer.querySelectorAll(".baggage-weight-input, .baggage-dimension-select").forEach(el => {
                    el.addEventListener("input", checkGroupPayloadLimit);
                    el.addEventListener("change", checkGroupPayloadLimit);
                });
            }

            // Initial calculation
            checkGroupPayloadLimit();

            step1.classList.add("hidden");
            step2.classList.remove("hidden");
            document.getElementById("sticky-price-bar")?.classList.add("hidden");
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        btnBack?.addEventListener("click", (e) => {
            if (checkGuest(e)) return;
            step2.classList.add("hidden");
            step1.classList.remove("hidden");
            // Call updatePriceSummary if it is defined (we'll check via window/locally)
            if (typeof (window as any).updatePriceSummary === "function") {
                (window as any).updatePriceSummary();
            }
        });

        // Final Submission
        form2.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (checkGuest(e)) return;

            const btnSubmit = form2.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement;
            const originalText = btnSubmit.textContent;

            btnSubmit.disabled = true;
            btnSubmit.textContent = "Sedang Memproses...";

            try {
                const formData1 = new FormData(form1);
                const data1 = Object.fromEntries(formData1.entries()) as Record<
                    string,
                    any
                >;

                const formData2 = new FormData(form2);
                const data2 = Object.fromEntries(formData2.entries()) as Record<
                    string,
                    any
                >;

                const seatValues =
                    (
                        document.getElementById(
                            "input-selected-seats",
                        ) as HTMLInputElement
                    )?.value || "";
                const seatsList = seatValues.split(",").map(s => s.trim()).filter(Boolean);

                // Build passengers array
                const passengersArray = [];
                
                // Passenger 1
                const w1 = parseFloat(beratBagasiInput?.value || "0") || 0;
                const d1 = dimensiBagasiSelect?.value || "kecil";
                const name1 = data2.full_name || "Penumpang Utama";
                passengersArray.push({
                    seat_number: parseInt(seatsList[0], 10),
                    passenger_name: name1,
                    baggage_weight: w1,
                    baggage_dimension: d1,
                    baggage_description: `Bagasi Kursi ${seatsList[0]}`
                });

                // Additional passengers
                for (let i = 1; i < seatsList.length; i++) {
                    const seat = seatsList[i];
                    const w = parseFloat(data2[`baggage_weight_${seat}`] || "0") || 0;
                    const d = data2[`baggage_dimension_${seat}`] || "kecil";
                    const name = data2[`passenger_name_${seat}`] || `Penumpang ${i + 1}`;
                    passengersArray.push({
                        seat_number: parseInt(seat, 10),
                        passenger_name: name,
                        baggage_weight: w,
                        baggage_dimension: d,
                        baggage_description: `Bagasi Kursi ${seat}`
                    });
                }

                const bookingPayload: any = {
                    route_id: selectedRouteId,
                    departure_date: selectedRawDate,
                    tujuan_kecamatan: data1.tujuan_kecamatan || "-",
                    pickup_address: JSON.stringify({
                        kecamatan: data2.sub_district || "-",
                        desa: data2.village || "-",
                        dusun: data2.hamlet || "-",
                        rt_rw: `${data2.rt || "-"}/${data2.rw || "-"}`,
                        patokan: data2.landmark || "-",
                    }),
                    dropoff_address: JSON.stringify({
                        kecamatan: data1.tujuan_kecamatan || "-",
                        desa: data1.tujuan_desa || "-",
                        dusun: data1.tujuan_dusun || "-",
                        rt_rw: `${data1.tujuan_rt || "-"}/${data1.tujuan_rw || "-"}`,
                        patokan: data1.tujuan_patokan || "-",
                    }),
                    payment_method: data1.payment_method || undefined,
                    promo_id: data1.promo_id || undefined,
                    passengers: passengersArray
                };

                const token = localStorage.getItem("jwt_token");
                if (!token)
                    throw new Error(
                        "Anda belum login (Token tidak ditemukan).",
                    );

                await travelService.createTravelBooking(bookingPayload, token);

                const successMessage = `
                    <div class="flex flex-col gap-3 text-left">
                        <p class="text-slate-600 text-sm mb-2 text-center">Pemesanan Anda telah berhasil dikirim ke sistem! Rombongan Anda telah mengunci kursi ini.</p>
                        
                        <!-- Alert Card 2: Payment Timeout -->
                        <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 flex gap-3 items-start shadow-sm mt-1">
                            <div class="bg-amber-100 text-amber-600 p-1.5 rounded-lg shrink-0 mt-0.5">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="flex flex-col gap-0.5">
                                <h4 class="font-bold text-amber-800 text-sm">Batas Waktu Pembayaran</h4>
                                <p class="text-amber-700 text-[11px] font-secondary leading-tight">
                                    Pesanan Anda harus segera dibayar dalam waktu <strong>10 menit</strong>. Jika melewati batas waktu, pesanan akan dibatalkan secara otomatis oleh sistem.
                                </p>
                            </div>
                        </div>
                    </div>
                `;

                (window as any).showFeedbackModal(
                    "success",
                    "Pemesanan Berhasil",
                    successMessage,
                    "/user/booking-history",
                );
            } catch (error: any) {
                (window as any).showFeedbackModal(
                    "error",
                    "Pemesanan Gagal",
                    error.message ||
                        "Terjadi kesalahan saat memproses pesanan Anda.",
                );
            } finally {
                btnSubmit.disabled = false;
                btnSubmit.textContent = originalText;
            }
        });

        // ================= PRICING SUMMARY CARD (INLINE) =================
        let activePromo: any = null;
        const stickyBar = document.getElementById("sticky-price-bar");
        const stickyRouteInfo = document.getElementById("sticky-route-info");
        const stickyPromoBadge = document.getElementById("sticky-promo-badge");
        const guestQtyContainer = document.getElementById("guest-qty-container");
        const guestQtySelect = document.getElementById("guest-qty-select") as HTMLSelectElement;
        const stickyOriginalPrice = document.getElementById("sticky-original-price");
        const stickyTotalPrice = document.getElementById("sticky-total-price");
        const selectedSeatsInput = document.getElementById("input-selected-seats") as HTMLInputElement;
        const promoRow = document.getElementById("promo-row");

        const loadActivePromo = async () => {
            try {
                const contentServiceModule = await import("@services/contentService");
                const res = await contentServiceModule.contentService.getPromotions();
                const promos = res?.data;
                if (promos) {
                    activePromo = promos.find((p: any) => 
                        p.is_active && (p.target_service.includes("all") || p.target_service.includes("travel"))
                    );
                }
                updatePriceSummary();
            } catch (err) {
                console.error("Gagal memuat promo:", err);
            }
        };

        const updatePriceSummary = () => {
            if (!stickyBar) return;

            const selectedRouteRadio = document.querySelector('input[name="rute"]:checked') as HTMLInputElement;
            if (!selectedRouteRadio) {
                stickyBar.classList.add("hidden");
                return;
            }

            const basePrice = parseFloat(selectedRouteRadio.getAttribute("data-base-price") || "0");
            const routeLabel = selectedRouteRadio.closest("label")?.querySelector("span")?.textContent || "Perjalanan Travel";

            const isLoggedIn = authGuard.isLoggedIn();
            let seatCount = 1;

            if (isLoggedIn) {
                guestQtyContainer?.classList.add("hidden");
                guestQtyContainer?.classList.remove("flex");

                const seatValues = selectedSeatsInput?.value || "";
                const seatsList = seatValues.split(",").map(s => s.trim()).filter(Boolean);
                seatCount = seatsList.length;
            } else {
                guestQtyContainer?.classList.remove("hidden");
                guestQtyContainer?.classList.add("flex");
                seatCount = parseInt(guestQtySelect?.value || "1", 10);
            }

            const originalPriceVal = basePrice * seatCount;
            let finalPriceVal = originalPriceVal;
            let discountAmount = 0;

            if (activePromo) {
                const discountPercentage = parseFloat(activePromo.discount_percentage || "0");
                let discount = originalPriceVal * (discountPercentage / 100);

                if (activePromo.max_discount && parseFloat(activePromo.max_discount) > 0) {
                    const maxDiscount = parseFloat(activePromo.max_discount);
                    if (discount > maxDiscount) {
                        discount = maxDiscount;
                    }
                }
                discountAmount = discount;
                finalPriceVal = originalPriceVal - discountAmount;
            }

            if (stickyRouteInfo) {
                stickyRouteInfo.textContent = `${routeLabel} (${seatCount} Kursi)`;
            }

            if (activePromo && discountAmount > 0) {
                if (stickyPromoBadge) {
                    stickyPromoBadge.textContent = `Promo Aktif: ${activePromo.tagline} (-${parseFloat(activePromo.discount_percentage)}%)`;
                }
                if (stickyOriginalPrice) {
                    stickyOriginalPrice.textContent = formatters.currency.format(originalPriceVal);
                }
                promoRow?.classList.remove("hidden");
                promoRow?.classList.add("flex");
            } else {
                promoRow?.classList.add("hidden");
                promoRow?.classList.remove("flex");
            }

            if (stickyTotalPrice) {
                stickyTotalPrice.textContent = formatters.currency.format(finalPriceVal);
            }

            stickyBar.classList.remove("hidden");
        };

        // Simpan ke window agar bisa diakses di luar lingkup fungsi ini
        (window as any).updatePriceSummary = updatePriceSummary;

        // Listeners
        ruteRadios.forEach((radio) => {
            radio.addEventListener("change", updatePriceSummary);
        });
        guestQtySelect?.addEventListener("change", updatePriceSummary);
        selectedSeatsInput?.addEventListener("change", updatePriceSummary);

        // Load Promo & Inisialisasi awal
        loadActivePromo();
    };

    document.addEventListener("DOMContentLoaded", setupTravelFlow);
    document.addEventListener("astro:page-load", setupTravelFlow);
</script>
