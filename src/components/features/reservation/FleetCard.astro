---
// File: src/components/layanan/FleetCard.astro
interface Props {
    name: string;
    capacity: string;
    description: string;
    price: string;
    image: string;
}

const { name, capacity, description, price, image } = Astro.props;
---

<div
    class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col h-full w-full"
>
    <figure class="relative h-48 overflow-hidden bg-slate-200">
        <span
            class="absolute top-4 left-4 z-10 bg-white/90 backdrop-blur-sm text-primary text-xs font-bold px-3 py-2 rounded-full shadow-sm"
        >
            {capacity}
        </span>
        <img
            src={image}
            alt={name}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
    </figure>

    <div class="p-5 flex flex-col flex-grow">
        <h3 class="text-lg font-black text-primary mb-1">{name}</h3>
        <p
            class="font-secondary text-xs text-text-secondary leading-relaxed mb-4 flex-grow"
        >
            {description}
        </p>
        <footer
            class="flex items-center justify-between border-t border-slate-100 pt-4 mt-auto"
        >
            <div>
                <span
                    class="block text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-0.5"
                >
                    Mulai Dari
                </span>
                <div class="font-main font-black text-primary">
                    Rp. {price}
                    <span class="text-xs font-medium text-slate-400">/Hari</span
                    >
                </div>
            </div>
        </footer>
    </div>
</div>



