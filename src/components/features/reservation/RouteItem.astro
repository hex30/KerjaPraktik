---
// File: src/components/features/reservation/molecules/RouteItem.astro
import RadioCard from "../../../ui/RadioCard.astro";
import Badge from "../../../ui/Badge.astro";

interface Props {
    value: string;
    label: string;
    days: string;
}

const { value, label, days } = Astro.props;
---

<RadioCard name="rute" value={value} required>
    <span class="block font-bold mb-1 text-primary group-peer-checked:text-black transition-colors">{label}</span>
    <Badge variant="info">{days}</Badge>
</RadioCard>



