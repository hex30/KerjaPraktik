---
// File: src/components/layanan/FormPackage.astro
import InputGroup from "@ui/InputGroup.astro";
import PackageAddressForm from "@features/reservation/package/PackageAddressForm.astro";
import SectionHeader from "@ui/SectionHeader.astro";
import Button from "@ui/Button.astro";
import HeroAside from "@ui/HeroAside.astro";
import AlertCard from "@components/ui/AlertCard.astro";
---

<article
    class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
>
    <div class="w-full lg:w-3/5 flex flex-col gap-8">
        <SectionHeader
            title="Detail Pengiriman Paket"
            subtitle="Lengkapi data pengirim, penerima, dan detail barang dengan akurat."
        />

        <!-- RESTRICTED AREA FOR GUEST -->
        <div
            id="restricted-area-package"
            class="relative transition-all duration-300"
        >
            <!-- Guest Alert Overlay Backdrop (Transparent Catcher) -->
            <div
                id="guest-overlay-package"
                class="absolute inset-0 z-40 bg-transparent cursor-pointer rounded-2xl -m-4"
            >
            </div>

            <div
                id="restricted-content-package"
                class="pointer-events-none transition-all duration-500"
            >
                <form id="form-package-detail" class="flex flex-col gap-10">
                    <PackageAddressForm
                        stepNumber="1"
                        title="Data Pengirim"
                        type="pengirim"
                    />

                    <PackageAddressForm
                        stepNumber="2"
                        title="Data Penerima"
                        type="penerima"
                    />

                    <section class="flex flex-col gap-5">
                        <h3
                            class="text-lg text-primary font-bold flex items-center gap-2"
                        >
                            <span
                                class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm"
                                >3</span
                            >
                            Detail Paket
                        </h3>

                        <div
                            class="flex flex-col gap-5 p-6 rounded-2xl bg-slate-50 border border-slate-100 relative"
                        >
                            <div class="flex flex-col gap-2 w-full">
                                <label
                                    for="deskripsi_paket"
                                    class="font-secondary text-sm font-bold text-primary"
                                    >Deskripsi Isi Paket</label
                                >
                                <input
                                    type="text"
                                    name="deskripsi_paket"
                                    id="deskripsi_paket"
                                    placeholder="Contoh: Dokumen penting, Pakaian, Makanan ringan"
                                    required
                                    minlength="3"
                                    class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
                                />
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <div class="flex flex-col gap-2 w-full">
                                    <label
                                        for="berat_paket"
                                        class="font-secondary text-sm font-bold text-primary"
                                    >
                                        Berat Barang
                                    </label>
                                    <div
                                        class="relative flex items-center w-full"
                                    >
                                        <input
                                            type="number"
                                            name="berat_paket"
                                            id="berat_paket"
                                            placeholder="Contoh: 12"
                                            required
                                            min="1"
                                            class="w-full bg-slate-100 border border-slate-200 rounded-lg pl-4 pr-16 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
                                        />
                                        <div
                                            class="absolute right-1 top-1 bottom-1 bg-white border border-slate-200 rounded-md px-3 flex items-center justify-center pointer-events-none shadow-sm"
                                        >
                                            <span
                                                class="font-black text-primary text-xs tracking-wider"
                                                >Kg</span
                                            >
                                        </div>
                                    </div>
                                </div>

                                <div class="flex flex-col gap-2 w-full">
                                    <label
                                        for="dimensi_paket"
                                        class="font-secondary text-sm font-bold text-primary"
                                        >Dimensi Kemasan</label
                                    >
                                    <select
                                        name="dimensi_paket"
                                        id="dimensi_paket"
                                        required
                                        class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all appearance-none cursor-pointer"
                                    >
                                        <option value="" disabled selected
                                            >Pilih Dimensi Paket Anda</option
                                        >
                                        <option value="kecil"
                                            >Kecil (Dokumen/Buku)</option
                                        >
                                        <option value="sedang"
                                            >Sedang (Kotak Sepatu/Pakaian)</option
                                        >
                                        <option value="besar"
                                            >Besar (Kardus Besar/Elektronik)</option
                                        >
                                        <option value="super_besar"
                                            >Super Besar (Furnitur/Motor)</option
                                        >
                                    </select>
                                </div>

                                <div class="md:col-span-2">
                                    <InputGroup
                                        label="Tanggal Pengiriman"
                                        id="departure_date"
                                        name="departure_date"
                                        type="date"
                                        required={true}
                                    />
                                </div>
                            </div>

                            <!-- Dynamic Luggage Alert Card -->
                            <div
                                id="luggage-alert-card-package"
                                class="hidden animate-fade-in mt-4"
                            >
                                <div
                                    class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex gap-4 items-start shadow-sm"
                                >
                                    <div
                                        class="bg-amber-100 text-amber-600 p-2 rounded-lg shrink-0"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-6 w-6"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                            stroke-width="2"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <h4
                                            class="font-bold text-amber-800 text-sm"
                                        >
                                            Informasi Tambahan
                                        </h4>
                                        <p
                                            class="text-amber-700 text-xs font-secondary leading-relaxed"
                                        >
                                            Berat atau dimensi barang bawaan
                                            anda melebihi batas maximal dan akan
                                            di hitung sebagai 1 orang.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ringkasan Estimasi Tarif Paket (Inline) -->
                        <div id="package-pricing-summary" class="hidden mt-4 p-4 rounded-xl bg-slate-100/60 border border-slate-200/40 animate-fade-in">
                            <div class="flex flex-col gap-3 font-main">
                                <div>
                                    <h4 class="font-bold text-primary text-xs">Estimasi Biaya Pengiriman</h4>
                                    <p id="package-summary-details" class="text-[10px] text-slate-400 font-secondary mt-0.5">Lengkapi data tujuan...</p>
                                </div>
                                <div class="flex flex-col gap-1.5 pt-2 border-t border-slate-200/60">
                                    <div id="package-promo-row" class="hidden justify-between items-center text-[11px]">
                                        <span id="package-promo-badge" class="font-bold text-green-700 bg-green-50 border border-green-200 px-1.5 py-0.5 rounded-full"></span>
                                        <span id="package-original-price" class="text-slate-400 line-through font-secondary"></span>
                                    </div>
                                    <div class="flex justify-between items-center text-xs">
                                        <span id="package-total-label" class="text-slate-500 font-bold">Total Pembayaran</span>
                                        <span id="package-total-price" class="text-sm font-black text-primary">Rp 0</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <Button type="submit" size="lg">
                                Pesan Pengiriman Sekarang
                            </Button>
                        </div>
                    </section>
                </form>
            </div>
        </div>
    </div>

    <HeroAside
        image="/assets/images/contoh.jpg"
        title="Pengiriman Aman & Terlindungi"
        description="Setiap paket ditangani dengan standar profesional untuk memastikan barang Anda tiba di tujuan dengan utuh dan selamat."
    />

    <!-- FIXED GUEST ALERT CARD -->
    <div
        id="guest-alert-card-package"
        class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/40 backdrop-blur-sm px-4 opacity-0 transition-opacity duration-300"
    >
        <div
            class="pointer-events-auto shadow-2xl rounded-2xl transform scale-95 transition-transform duration-300"
            id="guest-alert-card-inner-package"
        >
            <AlertCard
                type="warning"
                title="Login Diperlukan"
                message="Silakan masuk ke akun Anda untuk mengisi formulir pengiriman paket."
                actionText="Login Sekarang"
                actionLink="/auth/login"
            />
        </div>
    </div>

    <script>
        import { authGuard } from "@utils/authGuard";
        import { packageService } from "@services/packageService";
        import { travelService } from "@services/travelService";

        const setupPackageListener = async () => {
            // Cek armada global
            let isFleetAvailable = true;
            try {
                const fleetCheck =
                    await travelService.checkFleetsAvailability();
                if (
                    fleetCheck &&
                    fleetCheck.data &&
                    fleetCheck.data.available === false
                ) {
                    isFleetAvailable = false;
                    if (
                        typeof (window as any).showGlobalFleetAlert ===
                        "function"
                    ) {
                        (window as any).showGlobalFleetAlert();
                    }
                }
            } catch (err) {
                console.error("Gagal mengecek armada:", err);
            }

            const form = document.getElementById(
                "form-package-detail",
            ) as HTMLFormElement;
            const dimensionSelect = document.getElementById(
                "dimensi_paket",
            ) as HTMLSelectElement;
            const weightInput = document.getElementById(
                "berat_paket",
            ) as HTMLInputElement;

            if (!form) return;

            const dateInput = document.getElementById(
                "departure_date",
            ) as HTMLInputElement;
            if (dateInput) {
                const now = new Date();
                if (now.getHours() >= 14) {
                    now.setDate(now.getDate() + 1);
                }
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, "0");
                const day = String(now.getDate()).padStart(2, "0");
                const minDate = `${year}-${month}-${day}`;
                dateInput.min = minDate;
                if (!dateInput.value || dateInput.value < minDate) {
                    dateInput.value = minDate;
                }

                // VALIDASI KETERSEDIAAN KAPASITAS BEBAN DAN ARMADA
                const validateCargoCapacity = async () => {
                    if (!dateInput || !dateInput.value) return;
                    const weight = parseFloat(weightInput?.value || "0");

                    try {
                        const check = await packageService.checkAvailability(
                            dateInput.value,
                            weight
                        );
                        if (check && check.available === false) {
                            const errMsg = weight > 0
                                ? `Mohon maaf, kapasitas kargo armada pada tanggal ini sudah penuh atau tidak mencukupi untuk berat paket Anda (${weight} kg). Silakan sesuaikan berat paket atau pilih tanggal lain.`
                                : "Mohon maaf, armada pada tanggal ini sudah disewa sepenuhnya. Silakan pilih tanggal lain.";
                            
                            if (
                                typeof window !== "undefined" &&
                                (window as any).showFeedbackModal
                            ) {
                                (window as any).showFeedbackModal(
                                    "warning",
                                    "Kapasitas Penuh / Tidak Cukup",
                                    errMsg
                                );
                            } else {
                                alert(errMsg);
                            }
                            
                            if (weight > 0) {
                                weightInput.value = "";
                                weightInput.dispatchEvent(new Event("input"));
                            } else {
                                dateInput.value = "";
                            }
                        }
                    } catch (error) {
                        console.error(
                            "Gagal mengecek ketersediaan kargo:",
                            error,
                        );
                    }
                };

                dateInput.addEventListener("change", validateCargoCapacity);
                weightInput?.addEventListener("change", validateCargoCapacity);
            }

            // UX: Guest Overlay Setup
            const guestOverlay = document.getElementById(
                "guest-overlay-package",
            );
            const guestAlertCard = document.getElementById(
                "guest-alert-card-package",
            );
            const restrictedContent = document.getElementById(
                "restricted-content-package",
            );

            const luggageAlertCard = document.getElementById(
                "luggage-alert-card-package",
            );

            const checkLuggageAlert = () => {
                if (!weightInput || !dimensionSelect || !luggageAlertCard)
                    return;
                const weight = parseInt(weightInput.value) || 0;
                const dimension = dimensionSelect.value;

                const isLarge = dimension === "besar" || dimension === "super_besar";
                const isHeavy = weight >= 60;

                if (isHeavy || isLarge) {
                    luggageAlertCard.classList.remove("hidden");
                } else {
                    luggageAlertCard.classList.add("hidden");
                }
            };

            if (
                guestAlertCard &&
                guestAlertCard.parentElement !== document.body
            ) {
                document.body.appendChild(guestAlertCard);
            }

            const setupGuestOverlay = () => {
                if (authGuard.isLoggedIn() && isFleetAvailable) {
                    guestOverlay?.classList.add("hidden");
                    guestAlertCard?.classList.add("hidden");
                    restrictedContent?.classList.remove("pointer-events-none");
                } else {
                    guestOverlay?.classList.remove("hidden");
                    guestAlertCard?.classList.add("hidden");
                    guestAlertCard?.classList.remove("flex");
                    restrictedContent?.classList.add("pointer-events-none");
                }
            };
            setupGuestOverlay();

            if (guestOverlay) {
                guestOverlay.addEventListener("click", () => {
                    if (!authGuard.isLoggedIn()) {
                        if (guestAlertCard) {
                            guestAlertCard.classList.remove("hidden");
                            guestAlertCard.classList.add("flex");
                            void guestAlertCard.offsetWidth;
                            guestAlertCard.classList.remove("opacity-0");
                            const inner = document.getElementById(
                                "guest-alert-card-inner-package",
                            );
                            inner?.classList.remove("scale-95");
                        }
                    } else if (!isFleetAvailable) {
                        if (
                            typeof (window as any).showGlobalFleetAlert ===
                            "function"
                        ) {
                            (window as any).showGlobalFleetAlert();
                        }
                    }
                });
            }

            if (guestAlertCard) {
                guestAlertCard.addEventListener("click", (e) => {
                    if (e.target === guestAlertCard) {
                        guestAlertCard.classList.add("opacity-0");
                        const inner = document.getElementById(
                            "guest-alert-card-inner-package",
                        );
                        inner?.classList.add("scale-95");
                        setTimeout(() => {
                            guestAlertCard.classList.remove("flex");
                            guestAlertCard.classList.add("hidden");
                        }, 300);
                    }
                });
            }

            // Guest Interceptor (fallback)
            const checkGuest = (e: Event) => {
                if (!authGuard.isLoggedIn()) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (guestAlertCard) {
                        guestAlertCard.classList.remove("hidden");
                        guestAlertCard.classList.add("flex");
                        void guestAlertCard.offsetWidth;
                        guestAlertCard.classList.remove("opacity-0");
                        const inner = document.getElementById(
                            "guest-alert-card-inner-package",
                        );
                        inner?.classList.remove("scale-95");
                    }
                    return true;
                }
                if (!isFleetAvailable) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (
                        typeof (window as any).showGlobalFleetAlert ===
                        "function"
                    ) {
                        (window as any).showGlobalFleetAlert();
                    }
                    return true;
                }
                return false;
            };

            dimensionSelect?.addEventListener("change", (e) => {
                if (checkGuest(e)) {
                    dimensionSelect.value = "";
                    return;
                }
                checkLuggageAlert();
            });

            weightInput?.addEventListener("input", (e) => {
                if (checkGuest(e)) {
                    weightInput.value = "";
                    return;
                }
                checkLuggageAlert();
            });

            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                // Cek armada global saat submit (fallback)
                try {
                    const fleetCheck =
                        await travelService.checkFleetsAvailability();
                    if (
                        fleetCheck &&
                        fleetCheck.data &&
                        fleetCheck.data.available === false
                    ) {
                        if (
                            typeof (window as any).showGlobalFleetAlert ===
                            "function"
                        ) {
                            (window as any).showGlobalFleetAlert();
                        }
                        return; // Berhenti
                    }
                } catch (err) {
                    console.error("Gagal mengecek armada:", err);
                }

                if (checkGuest(e)) return;

                const submitBtn = form.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement | null;
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.textContent = "Memproses Pengiriman...";
                }

                try {
                    const formData = new FormData(form);
                    const data = Object.fromEntries(formData.entries());

                    const isDouble =
                        dimensionSelect.value === "besar" ||
                        dimensionSelect.value === "super_besar" ||
                        parseInt(weightInput.value) >= 60;

                    const payload = {
                        receiver_kecamatan: data.sub_district_penerima || "-",
                        sender_name: data.nama_pengirim as string,
                        sender_phone: data.telp_pengirim as string,
                        pickup_address: JSON.stringify({
                            kecamatan: data.sub_district_pengirim || "-",
                            desa: data.village_pengirim || "-",
                            dusun: data.pengirim_hamlet || "-",
                            rt_rw: `${data.pengirim_rt || "-"}/${data.pengirim_rw || "-"}`,
                            patokan: data.landmark_pengirim || "-",
                        }),
                        receiver_name: data.nama_penerima as string,
                        receiver_phone: data.telp_penerima as string,
                        receiver_address: JSON.stringify({
                            kecamatan: data.sub_district_penerima || "-",
                            desa: data.village_penerima || "-",
                            dusun: data.penerima_hamlet || "-",
                            rt_rw: `${data.penerima_rt || "-"}/${data.penerima_rw || "-"}`,
                            patokan: data.landmark_penerima || "-",
                        }),
                        package_description: data.deskripsi_paket as string,
                        weight: Number(data.berat_paket),
                        dimension: data.dimensi_paket as
                            "kecil" | "sedang" | "besar" | "super_besar",
                        seat_qty: isDouble ? 2 : 1,
                        departure_date: data.departure_date as string,
                    };

                    // dokumentasi: Mengirim payload pengiriman paket ke API Backend
                    await packageService.createPackageShipment(payload);

                    (window as any).showFeedbackModal(
                        "success",
                        "Pesanan Paket Berhasil",
                        `Pesanan paket berhasil dicatat. ${isDouble ? "Biaya tambahan (2 kursi) berlaku." : ""}`,
                        "/user/booking-history",
                    );
                } catch (error: any) {
                    console.error("Submit Package Error:", error);
                    (window as any).showFeedbackModal(
                        "error",
                        "Pesanan Gagal",
                        error.message ||
                            "Gagal mengirim pesanan paket. Server sedang gangguan.",
                    );
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = "Pesan Pengiriman Sekarang";
                    }
                }
            });

            // ================= ESTIMASI TARIF PAKET =================
            const JABODETABEK_KECAMATAN = new Set([
                "cempaka putih","gambir","johar baru","kemayoran","menteng","sawah besar","senen","tanah abang","cilincing","kelapa gading","koja","pademangan","penjaringan","tanjung priok","cengkareng","grogol petamburan","taman sari","tambora","kebon jeruk","kalideres","palmerah","kembangan","cilandak","jagakarsa","kebayoran baru","kebayoran lama","mampang prapatan","pancoran","pasar minggu","pesanggrahan","setiabudi","tebet","cakung","cipayung","ciracas","duren sawit","jatinegara","kramat jati","makasar","matraman","pasar rebo","pulo gadung","kepulauan seribu utara","kepulauan seribu selatan","bogor barat","bogor selatan","bogor tengah","bogor timur","bogor utara","tanah sareal","babakan madang","bojonggede","caringin","cariu","ciampea","ciawi","cibinong","cibungbulang","cigombong","cigudeg","cijeruk","cileungsi","ciomas","cisarua","ciseeng","citeureup","dramaga","gunung putri","gunung sindur","jasinga","jonggol","kemang","klapanunggal","leuwiliang","leuwisadeng","megamendung","nanggung","pamijahan","parung","parung panjang","ranca bungur","rumpin","sukajaya","sukamakmur","sukaraja","tajur halang","tamansari","tenjo","tenjolaya","tanjungsari","beji","bojongsari","cilodong","cimanggis","cinere","cipayung","limo","pancoran mas","sawangan","sukmajaya","tapos","batuceper","benda","cibodas","ciledug","cipondoh","jatiuwang","karangtengah","karawaci","larangan","neglasari","periuk","pinang","tangerang","ciputat","ciputat timur","pamulang","pondok aren","serpong","serpong utara","setu","balaraja","cikupa","cisauk","cisoka","curug","gunungkaler","jambe","jayanti","kelapa dua","kemiri","kosambi","kresek","kronjo","legok","mauk","mekarbaru","pagedangan","pakuhaji","panongan","pasar kemis","rajeg","sepatan","sepatan timur","sindang jaya","solear","sukadiri","sukamulya","teluknaga","tigaraksa","bantar gebang","bekasi barat","bekasi selatan","bekasi timur","bekasi utara","jatiasih","jatisampurna","medan satria","mustika jaya","pondok gede","pondok melati","rawalumbu","babelan","bojongmangu","cabangbungin","cibarusah","cibitung","cikarang barat","cikarang pusat","cikarang selatan","cikarang utara","cikarang timur","kedungwaringin","karangbahagia","muaragembong","pebayuran","serang baru","setu","sukakarya","sukawangi","sukatani","tarumajaya","tambun selatan","tambun utara","tambelang"
            ]);

            let activePromo: any = null;
            const summaryCard = document.getElementById("package-pricing-summary");
            const summaryDetails = document.getElementById("package-summary-details");
            const promoRow = document.getElementById("package-promo-row");
            const promoBadge = document.getElementById("package-promo-badge");
            const originalPrice = document.getElementById("package-original-price");
            const totalPrice = document.getElementById("package-total-price");
            const totalLabel = document.getElementById("package-total-label");
            const receiverKecamatanInput = document.getElementById("kecamatan_penerima") as HTMLInputElement;

            const currencyFormatter = new Intl.NumberFormat("id-ID", {
                style: "currency",
                currency: "IDR",
                maximumFractionDigits: 0,
            });

            const loadActivePromo = async () => {
                try {
                    const contentServiceModule = await import("@services/contentService");
                    const res = await contentServiceModule.contentService.getPromotions();
                    const promos = res?.data;
                    if (promos) {
                        activePromo = promos.find((p: any) => 
                            p.is_active && (p.target_service.includes("all") || p.target_service.includes("package"))
                        );
                    }
                    updatePackagePrice();
                } catch (err) {
                    console.error("Gagal memuat promo paket:", err);
                }
            };

            const updatePackagePrice = () => {
                if (!summaryCard) return;

                const kecamatan = receiverKecamatanInput?.value?.trim()?.toLowerCase() || "";
                
                if (!kecamatan) {
                    summaryCard.classList.add("hidden");
                    return;
                }

                const isJabodetabek = JABODETABEK_KECAMATAN.has(kecamatan);

                if (isJabodetabek) {
                    const weight = parseFloat(weightInput?.value || "0") || 0;
                    const dimension = dimensionSelect?.value || "";
                    const isDouble = dimension === "besar" || dimension === "super_besar" || weight >= 60;
                    const multiplier = isDouble ? 2 : 1;

                    const basePriceVal = 250000 * multiplier;
                    let finalPriceVal = basePriceVal;
                    let discountAmount = 0;

                    if (activePromo) {
                        const discountPercentage = parseFloat(activePromo.discount_percentage || "0");
                        let discount = basePriceVal * (discountPercentage / 100);

                        if (activePromo.max_discount && parseFloat(activePromo.max_discount) > 0) {
                            const maxDiscount = parseFloat(activePromo.max_discount);
                            if (discount > maxDiscount) {
                                discount = maxDiscount;
                            }
                        }
                        discountAmount = discount;
                        finalPriceVal = basePriceVal - discountAmount;
                    }

                    if (summaryDetails) {
                        summaryDetails.textContent = `Tujuan: ${receiverKecamatanInput.value} (Wilayah Jabodetabek - ${multiplier} Kursi Bagasi)`;
                    }

                    if (activePromo && discountAmount > 0) {
                        if (promoBadge) {
                            let maxDiscountText = "";
                            if (activePromo.max_discount && parseFloat(activePromo.max_discount) > 0) {
                                maxDiscountText = `, Maks ${currencyFormatter.format(parseFloat(activePromo.max_discount))}`;
                            }
                            promoBadge.textContent = `Promo Aktif: ${activePromo.tagline} (-${parseFloat(activePromo.discount_percentage)}%${maxDiscountText})`;
                        }
                        if (originalPrice) {
                            originalPrice.textContent = currencyFormatter.format(basePriceVal);
                            originalPrice.classList.remove("hidden");
                        }
                        promoRow?.classList.remove("hidden");
                        promoRow?.classList.add("flex");
                    } else {
                        promoRow?.classList.add("hidden");
                        promoRow?.classList.remove("flex");
                    }

                    if (totalLabel) {
                        totalLabel.textContent = "Total Pembayaran";
                    }
                    if (totalPrice) {
                        totalPrice.textContent = currencyFormatter.format(finalPriceVal);
                    }
                } else {
                    if (summaryDetails) {
                        summaryDetails.textContent = `Tujuan: ${receiverKecamatanInput.value} (Luar Jabodetabek)`;
                    }
                    
                    promoRow?.classList.add("hidden");
                    promoRow?.classList.remove("flex");

                    if (totalLabel) {
                        totalLabel.textContent = "Status Tarif";
                    }
                    if (totalPrice) {
                        totalPrice.textContent = "Menunggu Konfirmasi Admin";
                    }
                }

                summaryCard.classList.remove("hidden");
            };

            // Listeners
            receiverKecamatanInput?.addEventListener("change", updatePackagePrice);
            weightInput?.addEventListener("input", updatePackagePrice);
            weightInput?.addEventListener("change", updatePackagePrice);
            dimensionSelect?.addEventListener("change", updatePackagePrice);
            
            // Load Promo & Initial Call
            loadActivePromo();
        };

        document.addEventListener("DOMContentLoaded", setupPackageListener);
        document.addEventListener("astro:page-load", setupPackageListener);
    </script>
</article>
