---
// File: src/components/layanan/PackageAdress.astro
import InputGroup from "@ui/InputGroup.astro";
import AddressGrid from '@features/reservation/shared/AddressGrid.astro';

interface Props {
    title: string;
    stepNumber: string;
    // Tipe ini akan menentukan suffix id dan name secara otomatis
    type: 'pengirim' | 'penerima';
}

const { title, stepNumber, type } = Astro.props;

const isPengirim = type === 'pengirim';
const labelNama = isPengirim ? 'Nama Pengirim' : 'Nama Penerima';
const placeholderNama = isPengirim ? 'Nama lengkap Anda' : 'Nama lengkap tujuan';
---

<section class="flex flex-col gap-5">
    <h3 class="text-lg text-primary font-bold flex items-center gap-2">
        <span class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center text-sm">{stepNumber}</span>
        {title}
    </h3>
    
    <div class="flex flex-col gap-5 p-6 rounded-2xl bg-slate-50 border border-slate-100 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="relative w-full">
            <InputGroup 
                label={labelNama} 
                id={`nama_${type}`} 
                name={`nama_${type}`} 
                placeholder={placeholderNama} 
                required={true} 
            />
        </div>
        
        <div class="relative w-full">
            <InputGroup 
                label="No. Telepon" 
                id={`telp_${type}`} 
                name={`telp_${type}`} 
                type="tel" 
                placeholder="Contoh: 08123456789" 
                required={true} 
            />
        </div>
    </div>
    
    <AddressGrid type={type} dusunLabel="Nama Dusun/Jalan" />
    </div>
</section>

<script define:vars={{ type, isPengirim }}>
{
    const setupPackageAutofill = () => {
        if (!isPengirim) return;
        
        const inputNama = document.getElementById(`nama_${type}`);
        const inputTelp = document.getElementById(`telp_${type}`);
        
        const userDataStr = localStorage.getItem("user_data");
        if (userDataStr) {
            try {
                const user = JSON.parse(userDataStr);
                if ((user.name || user.nama) && inputNama) {
                    inputNama.value = user.name || user.nama;
                }
                if ((user.phone_number || user.telp) && inputTelp) {
                    inputTelp.value = user.phone_number || user.telp;
                }
            } catch (e) {}
        }
    };
    
    document.addEventListener("DOMContentLoaded", setupPackageAutofill);
    document.addEventListener("astro:page-load", setupPackageAutofill);
}
</script>






