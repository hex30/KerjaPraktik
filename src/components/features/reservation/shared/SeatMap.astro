---
// SeatSelection.astro

// SESUAIKAN PATH INI DENGAN LOKASI FILE SVG LOKAL ANDA
// Gunakan path relatif atau URL statis yang sesuai dengan struktur Astro Anda
const seatIconSrc = "./src/assets/icons/seat.svg";

// ARRAY DINAMIS: Anda bisa me-replace array ini dengan data hasil fetch dari Database
// Urutan array menentukan letak pada Grid (mengisi ke bawah dulu, lalu ke kolom kanan)
const seatLayoutData = [
  // Kolom 1 (Area Depan Bus)
  { id: "driver", type: "driver", label: "Supir" }, // Supir di Kanan (Baris Atas)
  { id: "engine_gap", type: "empty" }, // Mesin (Baris Tengah)
  { id: "1", type: "seat", status: "available", label: "1" }, // Kursi sebelah supir (Baris Bawah - Kiri)

  // Kolom 2
  { id: "2", type: "seat", status: "available", label: "2" },
  { id: "3", type: "seat", status: "available", label: "3" },
  { id: "4", type: "seat", status: "available", label: "4" },

  // Kolom 3
  { id: "5", type: "seat", status: "available", label: "5" },
  { id: "6", type: "seat", status: "available", label: "6" },
  { id: "door1", type: "door", label: "Pintu" },

  // Kolom 4
  { id: "7", type: "seat", status: "available", label: "7" },
  { id: "8", type: "seat", status: "available", label: "8" },
  { id: "9", type: "seat", status: "available", label: "9" },

  // Kolom 5
  { id: "10", type: "seat", status: "available", label: "10" },
  { id: "11", type: "seat", status: "available", label: "11" },
  { id: "12", type: "seat", status: "available", label: "12" },

  // Kolom 6 (Area Belakang Bus)
  { id: "13", type: "seat", status: "available", label: "13" },
  { id: "14", type: "seat", status: "available", label: "14" },
  { id: "15", type: "seat", status: "available", label: "15" },
];

// Base ukuran container agar simetris
const boxClassBase =
  "relative w-14 h-14 max-h-[4rem] max-w-[4rem] flex flex-col items-center justify-center select-none";
---

<section
  class="flex flex-col gap-6 mt-4 font-main w-full"
  id="seat-selection-section"
>
  <div
    class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
  >
    <h3 class="text-lg font-bold text-primary">3. Pilih Kursi Anda</h3>

    <div
      class="flex flex-wrap gap-4 text-[10px] md:text-xs font-secondary font-bold uppercase tracking-wider"
    >
      <div class="flex items-center gap-1.5">
        <div class="w-8 h-8 flex items-center justify-center">
          <img
            src={seatIconSrc}
            alt="Tersedia"
            class="w-6 h-6 object-contain"
          />
        </div>
        <span class="text-text-secondary">Tersedia</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div
          class="w-8 h-8 flex items-center justify-center rounded-lg bg-primary/20 ring-2 ring-primary"
        >
          <img
            src={seatIconSrc}
            alt="Terpilih"
            class="w-6 h-6 object-contain"
          />
        </div>
        <span class="text-primary">Terpilih</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div
          class="w-8 h-8 flex items-center justify-center opacity-40 grayscale"
        >
          <img src={seatIconSrc} alt="Terisi" class="w-6 h-6 object-contain" />
        </div>
        <span class="text-text-secondary">Terisi</span>
      </div>
    </div>
  </div>

  <div
    class="w-full bg-white border border-slate-100 rounded-[var(--radius-bg)] p-5 md:p-8 shadow-sm overflow-x-auto relative [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
  >
    <div
      class="absolute left-4 md:left-6 top-1/2 -translate-y-1/2 flex flex-col items-center opacity-30 pointer-events-none"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-primary mb-1 -rotate-90"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
      <span
        class="text-[10px] font-bold uppercase tracking-widest text-primary rotate-180 [writing-mode:vertical-rl]"
        >Depan</span
      >
    </div>

    <div
      class="grid grid-rows-3 grid-flow-col gap-3 md:gap-4 w-fit mx-auto pl-10 md:pl-12"
    >
      {
        seatLayoutData.map((item) => {
          /* LORONG / MESIN */
          if (item.type === "empty") {
            return <div class={boxClassBase} />;
          }

          /* PINTU */
          if (item.type === "door") {
            return (
              <div
                class={`${boxClassBase} text-[8px] text-slate-300 font-secondary font-bold uppercase tracking-widest pointer-events-none border border-dashed border-slate-200 rounded-xl`}
              >
                {item.label}
              </div>
            );
          }

          /* SUPIR (Ikon Setir Kanan) */
          if (item.type === "driver") {
            return (
              <div class={`${boxClassBase} opacity-70`} title="Supir">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="w-8 h-8 text-text-secondary"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 14v8" />
                  <path d="m10.5 11-8-5" />
                  <path d="m13.5 11 8-5" />
                  <circle cx="12" cy="12" r="2" />
                </svg>
                <span class="absolute bottom-0 text-[8px] font-bold font-secondary text-text-secondary uppercase">
                  {item.label}
                </span>
              </div>
            );
          }

          /* KURSI PENUMPANG */
          if (item.type === "seat") {
            /* KONDISI: KURSI SUDAH DIPESAN */
            if (item.status === "booked") {
              return (
                <div
                  class={`${boxClassBase} opacity-40 grayscale cursor-not-allowed`}
                  title="Kursi Terisi"
                >
                  <img
                    src={seatIconSrc}
                    alt={`Kursi ${item.label}`}
                    class="w-10 h-10 object-contain"
                  />
                  <span class="absolute top-0.5 left-1 z-10 font-black font-secondary text-[11px] text-slate-800 drop-shadow-sm">
                    {item.label}
                  </span>
                </div>
              );
            }

            /* KONDISI: KURSI TERSEDIA (BISA DIPILIH) */
            return (
              <button
                type="button"
                class={`group ${boxClassBase} seat-btn outline-none active:scale-95 transition-transform`}
                data-seat={item.id}
                data-selected="false"
              >
                <div class="absolute inset-0 rounded-lg group-data-[selected=true]:bg-primary/20 group-data-[selected=true]:ring-1 group-data-[selected=true]:ring-primary transition-all duration-300" />

                <img
                  src={seatIconSrc}
                  alt={`Kursi ${item.label}`}
                  class="w-10 h-10 object-contain relative z-10 group-data-[selected=true]:drop-shadow-md transition-all duration-300"
                />

                <span class="absolute top-0.5 left-2 z-20 font-black font-secondary text-[11px] text-slate-700 group-data-[selected=true]:text-primary transition-colors">
                  {item.label}
                </span>
              </button>
            );
          }
        })
      }
    </div>
  </div>

  <input
    type="hidden"
    name="seat_number"
    id="input-selected-seats"
    required
  />
</section>

<script>
  import { authGuard } from "@utils/authGuard";

  const setupSeatSelection = () => {
    const section = document.getElementById("seat-selection-section");

    if (!section) return;

    let selectedSeat: string | null = null;

    // Remove old listener if exists to prevent duplicates on view transitions
    const newSection = section.cloneNode(true) as HTMLElement;
    section.parentNode?.replaceChild(newSection, section);

    newSection.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest(".seat-btn") as HTMLButtonElement;
        
        if (!target || target.hasAttribute("disabled")) return;

        // AUTH GUARD CHECK
        if (!authGuard.isLoggedIn()) {
            e.preventDefault();
            e.stopPropagation();
            authGuard.requireAuth();
            return;
        }

        const seatNum = target.getAttribute("data-seat");
        if (!seatNum) return;

        if (selectedSeat === seatNum) {
            selectedSeat = null;
            target.setAttribute("data-selected", "false");
        } else {
            if (selectedSeat) {
                const prevBtn = newSection.querySelector(`.seat-btn[data-seat="${selectedSeat}"]`);
                if (prevBtn) prevBtn.setAttribute("data-selected", "false");
            }
            selectedSeat = seatNum;
            target.setAttribute("data-selected", "true");
        }

        updateUI();
    });

    const updateUI = () => {
      const activeHiddenInput = document.getElementById("input-selected-seats") as HTMLInputElement;
      if (activeHiddenInput) {
        activeHiddenInput.value = selectedSeat || "";
        activeHiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
      }
    };
  };

  document.addEventListener("DOMContentLoaded", setupSeatSelection);
  document.addEventListener("astro:page-load", setupSeatSelection);
</script>







