---
// File: src/components/layanan/FormData.astro
import InputGroup from "@ui/InputGroup.astro";
import AddressGrid from "@features/reservation/shared/AddressGrid.astro";
import SectionHeader from "@ui/SectionHeader.astro";

interface Props {
    formId?: string;
}

const { formId } = Astro.props;

---

<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col gap-8 font-main">
    <SectionHeader 
        title="Data Diri Penumpang"
        subtitle="Mohon isi detail alamat untuk mempermudah proses penjemputan."
        titleClass="text-2xl font-black text-primary mb-2"
    />

    <section class="flex flex-col gap-5">
        <div class="w-full relative">
            <InputGroup
                label="Nama Lengkap"
                id="nama-lengkap"
                name="full_name"
                placeholder="Masukan Nama Lengkap Anda"
                required={true}
            />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <InputGroup
                label="Kecamatan"
                id="kecamatan"
                name="sub_district"
                placeholder="Contoh : Panawangan"
                required={true}
            />
            <InputGroup
                label="Desa"
                id="desa"
                name="village"
                placeholder="Contoh : Nagarajaya"
                required={true}
            />
        </div>

        <AddressGrid />

        <div class="flex flex-col gap-2 w-full">
            <label
                for="patokan"
                class="font-secondary text-sm font-bold text-primary"
            >
                Patokan Bangunan
            </label>
            <textarea
                name="landmark"
                id="patokan"
                rows="3"
                placeholder="Contoh : Sebelah Masjid Agung"
                class="resize-none w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
            ></textarea>
        </div>
    </section>
</div>

<script>
    const setupPassengerAutofill = () => {
        const inputNamas = document.querySelectorAll('input[name="full_name"]');
        
        const userDataStr = localStorage.getItem("user_data");
        if (userDataStr && inputNamas.length > 0) {
            try {
                const user = JSON.parse(userDataStr);
                const userName = user.full_name || user.username || user.name || user.nama;
                if (userName) {
                    inputNamas.forEach((input) => {
                        const inputEl = input as HTMLInputElement;
                        if (!inputEl.value) {
                            inputEl.value = userName;
                        }
                    });
                }
            } catch (e) {
                console.error("Gagal membaca user_data", e);
            }
        }
    };
    
    document.addEventListener("DOMContentLoaded", setupPassengerAutofill);
    document.addEventListener("astro:page-load", setupPassengerAutofill);
</script>






