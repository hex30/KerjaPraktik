---
// File: src/components/features/reservation/molecules/AddressGrid.astro
import InputGroup from "../../../ui/InputGroup.astro";

interface Props {
    type?: string;
    dusunLabel?: string;
    required?: boolean;
}

const { 
    type = "", 
    dusunLabel = "Nama Dusun",
    required = true 
} = Astro.props;

const prefix = type ? `${type}_` : "";
const idPrefix = type ? `${type}-` : "";
---

<div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
    <div class="md:col-span-6">
        <InputGroup
            label={dusunLabel}
            id={`${idPrefix}dusun`}
            name={`${prefix}hamlet`}
            placeholder="Contoh : Cikodang"
            required={required}
        />
    </div>
    <div class="md:col-span-3">
        <InputGroup
            label="RT"
            id={`${idPrefix}rt`}
            name={`${prefix}rt`}
            type="number"
            placeholder="00"
            required={required}
        />
    </div>
    <div class="md:col-span-3">
        <InputGroup
            label="RW"
            id={`${idPrefix}rw`}
            name={`${prefix}rw`}
            type="number"
            placeholder="00"
            required={required}
        />
    </div>
</div>







