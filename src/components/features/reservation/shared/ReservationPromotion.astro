---
// File: src/components/features/reservation/shared/ReservationPromotion.astro

/**
 * Sync with Home Page Promotion (PromotionSection.astro default)
 */
const promoData = {
    image: "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=1200",
    discount: "10% OFF",
    tagline: "Nikmati Perjalanan Premium Bersama Kami"
};
---

<section class="max-w-7xl mx-auto px-6 mt-8 font-main">
    <div
        class="relative w-full h-64 md:h-80 rounded-[2.5rem] overflow-hidden shadow-2xl group border-4 border-white"
    >
        <img
            src={promoData.image}
            alt={promoData.tagline}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />

        <div
            class="absolute inset-0 bg-gradient-to-r from-slate-900/95 via-slate-900/40 to-transparent flex flex-col justify-center px-8 md:px-20"
        >
            <div class="flex flex-col gap-2">
                <span class="text-sky-400 font-black text-sm md:text-lg uppercase tracking-[0.2em] animate-pulse">
                    Promo: {promoData.discount}
                </span>
                <h1
                    class="text-3xl md:text-5xl lg:text-6xl font-black text-white max-w-2xl leading-tight tracking-tighter"
                >
                    {promoData.tagline}
                </h1>
            </div>
        </div>
        
        <!-- Glassmorphism Accent -->
        <div class="absolute top-0 right-0 w-1/3 h-full bg-white/5 backdrop-blur-sm -skew-x-12 translate-x-1/2 pointer-events-none"></div>
    </div>
</section>







