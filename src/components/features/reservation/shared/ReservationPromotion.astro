---
// File: src/components/features/reservation/shared/ReservationPromotion.astro

export interface Props {
    image?: string;
    tagline?: string;
    diskon?: string;
}

/**
 * Sync with Home Page Promotion payload structure
 */
const {
    image = "https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&q=80&w=1200",
    tagline = "Nikmati Perjalanan Premium Bersama Kami",
    diskon = "10% OFF"
} = Astro.props;
---

<section class="max-w-7xl mx-auto px-6 mt-8 font-main">
    <div class="relative w-full h-64 md:h-80 rounded-[2rem] overflow-hidden shadow-xl group">
        <img
            src={image}
            alt={tagline}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
        />

        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px] flex flex-col justify-center px-8 md:px-16 transition-all duration-500">
            <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8 max-w-4xl relative z-10">
                <div class="flex-shrink-0">
                    <span class="text-sky-500 font-black text-5xl md:text-7xl lg:text-8xl tracking-tighter drop-shadow-md">
                        {diskon}
                    </span>
                </div>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-snug tracking-tight">
                    {tagline}
                </h1>
            </div>
        </div>
        
        <!-- Modern accent light -->
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-sky-500/20 to-transparent pointer-events-none mix-blend-overlay"></div>
    </div>
</section>







