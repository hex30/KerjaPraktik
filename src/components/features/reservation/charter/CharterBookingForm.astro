---
import InputGroup from "@ui/InputGroup.astro";
import PassengerDataForm from "@features/reservation/shared/PassengerDataForm.astro";
import Button from "@ui/Button.astro";
import SectionHeader from "@ui/SectionHeader.astro";
import FleetSelectionItem from "./FleetSelectionItem.astro";
import PreviewSeatMap from "./PreviewSeatMap.astro";
import BookingSummary from "@features/reservation/shared/BookingSummary.astro";
import AlertCard from "@components/ui/AlertCard.astro";
import { charterService } from "@services/charterService";

let fleetData: any[] = [];
try {
    const allFleets = await charterService.getFleets();

    fleetData = allFleets.map((fleet: any) => ({
        ...fleet,
        totalUnits: fleet.total_units || 0,
        availableUnits: fleet.available_units || 0,
    }));
} catch (error) {
    console.error("Gagal memuat katalog armada charter:", error);
    fleetData = [];
}
---

<div id="booking-component" class="w-full relative">
    <article
        class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
    >
        <aside class="w-full lg:w-1/3">
            <div id="left-step-1" class="block animate-fade-in">
                <div
                    class="bg-slate-50 border border-slate-100 rounded-2xl p-6 md:p-8 sticky top-28"
                >
                    <header class="mb-6">
                        <h2 class="text-xl font-black text-primary mb-1">
                            Detail Booking
                        </h2>
                        <p class="font-secondary text-xs text-text-secondary">
                            Pesan armada khusus (Charter) untuk Anda.
                        </p>
                    </header>

                    <form
                        action=""
                        id="form-booking-travel"
                        class="flex flex-col gap-5"
                    >
                        <InputGroup
                            label="Area Tujuan"
                            id="tujuan"
                            name="tujuan"
                            placeholder="Masukkan kota tujuan"
                            required={true}
                        />

                        <!-- RESTRICTED AREA FOR GUEST -->
                        <div
                            id="restricted-area-charter"
                            class="relative transition-all duration-300"
                        >
                            <!-- Guest Alert Overlay Backdrop (Transparent Catcher) -->
                            <div
                                id="guest-overlay-charter"
                                class="absolute inset-0 z-40 bg-transparent cursor-pointer rounded-2xl -mx-2 -my-2"
                            >
                            </div>

                            <div
                                id="restricted-content-charter"
                                class="flex flex-col gap-5 pointer-events-none transition-all duration-500"
                            >
                                <div class="flex flex-col gap-2 w-full">
                                    <label
                                        for="jenis_armada"
                                        class="font-secondary text-sm font-bold text-primary"
                                        >Pilih Jenis Armada</label
                                    >
                                    <select
                                        name="jenis_armada"
                                        id="jenis_armada"
                                        required
                                        class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer appearance-none"
                                    >
                                        <option value="" disabled selected
                                            >Pilih kendaraan...</option
                                        >
                                        {
                                            fleetData.map((unit) => (
                                                <option
                                                    value={unit.car_type}
                                                    disabled={
                                                        unit.availableUnits ===
                                                        0
                                                    }
                                                >
                                                    {unit.car_type}{" "}
                                                    {unit.availableUnits === 0
                                                        ? "(Tidak Tersedia)"
                                                        : ""}
                                                </option>
                                            ))
                                        }
                                    </select>
                                </div>

                                <InputGroup
                                    label="Tanggal Keberangkatan"
                                    id="tanggal_sewa"
                                    name="tanggal_sewa"
                                    type="date"
                                    required={true}
                                />
                                <InputGroup
                                    label="Tanggal Kepulangan"
                                    id="tanggal_kepulangan"
                                    name="tanggal_kepulangan"
                                    type="date"
                                    required={false}
                                />

                                <Button
                                    type="submit"
                                    class="w-full mt-2"
                                    size="lg"
                                >
                                    Lanjutkan Isi Data Diri
                                </Button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div id="left-step-2" class="hidden animate-fade-in">
                <button
                    type="button"
                    id="btn-kembali-booking"
                    class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Kembali Ubah Pesanan
                </button>

                <BookingSummary />
            </div>
        </aside>

        <section class="w-full lg:w-2/3">
            <div id="right-step-1" class="flex flex-col gap-6 animate-fade-in">
                <SectionHeader
                    title="Pilihan Armada"
                    subtitle="Pilih kendaraan terawat kami dengan mengklik kartu di bawah untuk kenyamanan maksimal perjalanan Anda."
                />

                <div
                    class="grid grid-cols-1 md:grid-cols-2 gap-6"
                    id="armada-grid-container"
                >
                    {
                        fleetData.length > 0 ? (
                            fleetData.map((unit, index) => (
                                <FleetSelectionItem
                                    {...unit}
                                    value={unit.car_type}
                                    image={unit.image_url}
                                    price={unit.base_price}
                                    isHidden={index > 1}
                                    isAvailable={unit.availableUnits > 0}
                                />
                            ))
                        ) : (
                            <div class="col-span-full py-10 text-center bg-slate-50 border border-slate-200 rounded-2xl">
                                <p class="font-secondary font-bold text-slate-500 mb-2">
                                    Mohon Maaf, Layanan Sedang Terganggu
                                </p>
                                <p class="font-secondary text-xs text-slate-400">
                                    Saat ini data armada tidak dapat dimuat dari
                                    server. Silakan coba beberapa saat lagi.
                                </p>
                            </div>
                        )
                    }
                </div>

                {
                    fleetData.length > 0 && (
                        <div
                            id="preview-seatmap-container"
                            class="w-full hidden animate-fade-in mt-2"
                        >
                            {fleetData.map((unit) => (
                                <div
                                    class="seatmap-wrapper hidden"
                                    data-type={unit.car_type}
                                >
                                    <PreviewSeatMap
                                        type={unit.car_type as "Elf" | "Luxio"}
                                    />
                                </div>
                            ))}
                        </div>
                    )
                }
            </div>

            <div id="right-step-2" class="hidden animate-fade-in w-full">
                <form id="form-data-diri-booking" class="flex flex-col gap-8">
                    <PassengerDataForm />

                    <div class="pt-4 border-t border-slate-100">
                        <Button
                            type="submit"
                            size="lg"
                            class="w-full md:w-auto"
                        >
                            Selesaikan Pemesanan
                        </Button>
                    </div>
                </form>
            </div>
        </section>
    </article>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- FIXED GUEST ALERT CARD -->
<div
    id="guest-alert-card-charter"
    class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/40 backdrop-blur-sm px-4 opacity-0 transition-opacity duration-300"
>
    <div
        class="pointer-events-auto shadow-2xl rounded-2xl transform scale-95 transition-transform duration-300"
        id="guest-alert-card-inner-charter"
    >
        <AlertCard
            type="warning"
            title="Login Diperlukan"
            message="Silakan masuk ke akun Anda untuk melanjutkan proses pemesanan armada Charter."
            actionText="Login Sekarang"
            actionLink="/auth/login"
        />
    </div>
</div>

<script>
    import { setupBookingForm } from "./charterBookingLogic";

    document.addEventListener("DOMContentLoaded", setupBookingForm);
    document.addEventListener("astro:page-load", setupBookingForm);
</script>
