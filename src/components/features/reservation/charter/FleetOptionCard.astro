---
// File: src/components/layanan/FleetCard.astro
interface Props {
    name: string;
    capacity: string;
    description: string;
    price: string;
    image: string;
    isAvailable?: boolean;
}

const { name, capacity, description, price, image, isAvailable = true } = Astro.props;
---

<div
    class="bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col h-full w-full"
>
    <figure class="relative h-48 overflow-hidden bg-slate-200">
        <div class="absolute top-4 left-4 z-10 flex gap-2">
            <span
                class="bg-white/90 backdrop-blur-sm text-primary text-xs font-bold px-3 py-2 rounded-full shadow-sm"
            >
                {capacity}
            </span>
            {isAvailable ? (
                <span
                    class="badge-ketersediaan bg-emerald-500/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-2 rounded-full shadow-sm"
                >
                    Tersedia
                </span>
            ) : (
                <span
                    class="badge-ketersediaan bg-red-500/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-2 rounded-full shadow-sm"
                >
                    Sedang Disewa
                </span>
            )}
        </div>
        <img
            src={image}
            alt={name}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
    </figure>

    <div class="p-5 flex flex-col flex-grow">
        <h3 class="text-lg font-black text-primary mb-1">{name}</h3>
        <div class="overflow-y-auto max-h-24 pr-2 custom-scrollbar mb-4 flex-grow">
            <p class="font-secondary text-xs text-text-secondary leading-relaxed break-words whitespace-pre-wrap">
                {description || 'Tidak ada deskripsi.'}
            </p>
        </div>
        <footer
            class="flex items-center justify-between border-t border-slate-100 pt-4 mt-auto"
        >
            <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">
                    Mulai Dari
                </span>
                <div class="font-main font-black text-primary">
                    Rp {Number(price).toLocaleString('id-ID')}
                    <span class="text-xs font-medium text-slate-400">/Hari</span
                    >
                </div>
            </div>
        </footer>
    </div>
</div>







