---
// File: src/components/layanan/FormBooking.astro
import InputGroup from "../../ui/InputGroup.astro";
import FleetCard from "./FleetCard.astro";
import FormDataDiriPenumpang from "./FormData.astro"; // Pastikan path import benar

const fleetData = [
    {
        name: "Isuzu ELF Giga",
        capacity: "14-19 Kursi",
        description: "Cocok untuk rombongan menengah, nyaman dan tangguh.",
        price: "1.200.000",
        image: "/assets/images/contoh.jpg",
    },
    {
        name: "Toyota Hiace Commuter",
        capacity: "15 Kursi",
        description: "Eksekutif dan premium untuk perjalanan jarak jauh.",
        price: "1.500.000",
        image: "/assets/images/contoh.jpg",
    },
];
---

<div class="w-full relative">
    <article
        class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
    >
        <aside class="w-full lg:w-1/3">
            <div id="left-step-1" class="block animate-fade-in">
                <div
                    class="bg-slate-50 border border-slate-100 rounded-2xl p-6 md:p-8 sticky top-28"
                >
                    <header class="mb-6">
                        <h2 class="text-xl font-black text-primary mb-1">
                            Detail Booking
                        </h2>
                        <p class="font-secondary text-xs text-text-secondary">
                            Pesan armada khusus (Charter) untuk Anda.
                        </p>
                    </header>

                    <form
                        action=""
                        id="form-booking-travel"
                        class="flex flex-col gap-5"
                    >
                        <div class="flex flex-col gap-2 w-full">
                            <label
                                for="jenis_armada"
                                class="font-secondary text-sm font-bold text-primary"
                            >
                                Pilih Jenis Armada
                            </label>
                            <select
                                name="jenis_armada"
                                id="jenis_armada"
                                required
                                class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all appearance-none"
                            >
                                <option value="" disabled selected
                                    >Pilih kendaraan...</option
                                >
                                <option value="elf">Isuzu ELF Giga</option>
                                <option value="hiace"
                                    >Toyota Hiace Commuter</option
                                >
                            </select>
                        </div>

                        <InputGroup
                            label="Tanggal Keberangkatan"
                            id="tanggal_sewa"
                            name="tanggal_sewa"
                            type="date"
                            required={true}
                        />
                        <InputGroup
                            label="Area Tujuan"
                            id="tujuan"
                            name="tujuan"
                            placeholder="Masukkan kota tujuan"
                            required={true}
                        />

                        <button
                            type="submit"
                            class="w-full md:w-auto px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
                            > Lanjutkan Isi Data Diri
                        </button>
                    </form>
                </div>
            </div>

            <div id="left-step-2" class="hidden animate-fade-in">
                <button
                    type="button"
                    id="btn-kembali-booking"
                    class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Kembali Ubah Pesanan
                </button>

                <div
                    class="bg-slate-50 rounded-2xl border border-slate-100 p-6 md:p-8 sticky top-28"
                >
                    <h3 class="text-xl font-black text-primary mb-5">
                        Ringkasan Pesanan
                    </h3>

                    <div class="flex flex-col gap-4">
                        <div class="pb-4 border-b border-slate-200">
                            <p
                                class="font-secondary text-xs text-slate-500 mb-1"
                            >
                                Armada Terpilih
                            </p>
                            <p
                                id="summary-armada"
                                class="font-bold text-slate-800"
                            >
                                -
                            </p>
                        </div>
                        <div class="pb-4 border-b border-slate-200">
                            <p
                                class="font-secondary text-xs text-slate-500 mb-1"
                            >
                                Tanggal Keberangkatan
                            </p>
                            <p
                                id="summary-tanggal"
                                class="font-bold text-slate-800"
                            >
                                -
                            </p>
                        </div>
                        <div>
                            <p
                                class="font-secondary text-xs text-slate-500 mb-1"
                            >
                                Area Tujuan
                            </p>
                            <p
                                id="summary-tujuan"
                                class="font-bold text-slate-800"
                            >
                                -
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <section class="w-full lg:w-2/3">
            <div id="right-step-1" class="flex flex-col gap-6 animate-fade-in">
                <header>
                    <h2
                        class="text-2xl md:text-3xl font-black text-primary mb-2"
                    >
                        Pilihan Armada
                    </h2>
                    <p class="font-secondary text-sm text-text-secondary">
                        Kendaraan terawat untuk kenyamanan maksimal perjalanan
                        Anda.
                    </p>
                </header>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {
                        fleetData.map((unit) => (
                            <FleetCard
                                name={unit.name}
                                capacity={unit.capacity}
                                description={unit.description}
                                price={unit.price}
                                image={unit.image}
                            />
                        ))
                    }
                </div>
            </div>

            <div id="right-step-2" class="hidden animate-fade-in w-full">
                <FormDataDiriPenumpang formId="form-data-diri-booking" />
            </div>
        </section>
    </article>
</div>
