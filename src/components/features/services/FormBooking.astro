---
// File: src/components/layanan/FormBooking.astro
import InputGroup from "../../ui/InputGroup.astro";
import FormDataDiriPenumpang from "./FormData.astro";
import Button from "../../ui/Button.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import FleetSelectionItem from "./molecules/FleetSelectionItem.astro";
import BookingSummary from "./organisms/BookingSummary.astro";

const fleetData = [
    {
        name: "Isuzu ELF Giga",
        value: "elf", 
        capacity: "14-19 Kursi",
        description: "Cocok untuk rombongan menengah, nyaman dan tangguh.",
        price: "1.200.000",
        image: "/assets/images/contoh.jpg",
    },
    {
        name: "Toyota Hiace Commuter",
        value: "hiace",
        capacity: "15 Kursi",
        description: "Eksekutif dan premium untuk perjalanan jarak jauh.",
        price: "1.500.000",
        image: "/assets/images/contoh.jpg",
    },
    {
        name: "Toyota Avanza",
        value: "avanza",
        capacity: "6 Kursi",
        description: "Pilihan ekonomis untuk perjalanan keluarga kecil.",
        price: "600.000",
        image: "/assets/images/contoh.jpg",
    },
    {
        name: "Toyota Innova Reborn",
        value: "innova",
        capacity: "7 Kursi",
        description: "Kenyamanan ekstra dengan kabin yang luas dan senyap.",
        price: "850.000",
        image: "/assets/images/contoh.jpg",
    },
];
---

<div id="booking-component" class="w-full relative">
    <article class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main">
        
        <aside class="w-full lg:w-1/3">
            <div id="left-step-1" class="block animate-fade-in">
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-6 md:p-8 sticky top-28">
                    <header class="mb-6">
                        <h2 class="text-xl font-black text-primary mb-1">Detail Booking</h2>
                        <p class="font-secondary text-xs text-text-secondary">Pesan armada khusus (Charter) untuk Anda.</p>
                    </header>

                    <form action="" id="form-booking-travel" class="flex flex-col gap-5">
                        <div class="flex flex-col gap-2 w-full">
                            <label for="jenis_armada" class="font-secondary text-sm font-bold text-primary">Pilih Jenis Armada</label>
                            <select
                                name="jenis_armada"
                                id="jenis_armada"
                                required
                                class="w-full bg-white border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer appearance-none"
                            >
                                <option value="" disabled selected>Pilih kendaraan...</option>
                                {fleetData.map((unit) => (
                                    <option value={unit.value}>{unit.name}</option>
                                ))}
                            </select>
                        </div>

                        <InputGroup label="Tanggal Keberangkatan" id="tanggal_sewa" name="tanggal_sewa" type="date" required={true} />
                        <InputGroup label="Tanggal Kepulangan" id="tanggal_kepulangan" name="tanggal_kepulangan" type="date" required={false} />
                        <InputGroup label="Area Tujuan" id="tujuan" name="tujuan" placeholder="Masukkan kota tujuan" required={true} />

                        <Button type="submit" class="w-full mt-2" size="lg">
                            Lanjutkan Isi Data Diri
                        </Button>
                    </form>
                </div>
            </div>

            <div id="left-step-2" class="hidden animate-fade-in">
                <button type="button" id="btn-kembali-booking" class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
                    </svg>
                    Kembali Ubah Pesanan
                </button>

                <BookingSummary />
            </div>
        </aside>

        <section class="w-full lg:w-2/3">
            <div id="right-step-1" class="flex flex-col gap-6 animate-fade-in">
                <SectionHeader 
                    title="Pilihan Armada"
                    subtitle="Pilih kendaraan terawat kami dengan mengklik kartu di bawah untuk kenyamanan maksimal perjalanan Anda."
                />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="armada-grid-container">
                    {fleetData.map((unit, index) => (
                        <FleetSelectionItem 
                            {...unit}
                            isHidden={index > 1}
                        />
                    ))}
                </div>

                {fleetData.length > 2 && (
                    <div class="flex flex-col w-full mt-2">
                        <div id="btn-expand-armada" class="w-full py-5 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/50 hover:bg-card-bg-sc hover:border-primary/50 cursor-pointer flex items-center justify-center gap-3 group transition-all duration-300">
                            <span class="font-secondary font-bold text-sm text-slate-500 group-hover:text-primary transition-colors">Tampilkan {fleetData.length - 2} Armada Lainnya</span>
                            <div class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center group-hover:border-primary/50 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-slate-400 group-hover:text-primary group-hover:translate-y-0.5 transition-all"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg></div>
                        </div>
                        <div id="btn-collapse-armada" class="hidden w-full py-5 rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/50 hover:bg-card-bg-sc hover:border-primary/50 cursor-pointer items-center justify-center gap-3 group transition-all duration-300">
                            <span class="font-secondary font-bold text-sm text-slate-500 group-hover:text-primary transition-colors">Tutup Pilihan Armada</span>
                            <div class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center group-hover:border-primary/50 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-slate-400 group-hover:text-primary group-hover:-translate-y-0.5 transition-all"><path fill-rule="evenodd" d="M14.78 11.78a.75.75 0 0 1-1.06 0L10 8.06l-3.72 3.72a.75.75 0 1 1-1.06-1.06l4.25-4.25a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06Z" clip-rule="evenodd" /></svg></div>
                        </div>
                    </div>
                )}
            </div>

            <div id="right-step-2" class="hidden animate-fade-in w-full">
                <FormDataDiriPenumpang formId="form-data-diri-booking" />
            </div>
        </section>
    </article>
</div>

<style>
  .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
    const setupBookingForm = () => {
        const formStep1 = document.getElementById("form-booking-travel");
        const selectArmada = document.getElementById("jenis_armada") as HTMLSelectElement;
        
        const fleetCards = document.querySelectorAll(".fleet-card-wrapper");
        const btnExpand = document.getElementById("btn-expand-armada");
        const btnCollapse = document.getElementById("btn-collapse-armada");
        const extraCards = document.querySelectorAll(".extra-card");

        const inputTanggalSewa = document.getElementById("tanggal_sewa") as HTMLInputElement;
        const inputTanggalKepulangan = document.getElementById("tanggal_kepulangan") as HTMLInputElement;
        const inputTujuan = document.getElementById("tujuan") as HTMLInputElement;

        const leftStep1 = document.getElementById("left-step-1");
        const leftStep2 = document.getElementById("left-step-2");
        const rightStep1 = document.getElementById("right-step-1");
        const rightStep2 = document.getElementById("right-step-2");
        const btnKembali = document.getElementById("btn-kembali-booking");

        const summaryArmada = document.getElementById("summary-armada");
        const summaryTanggal = document.getElementById("summary-tanggal");
        const summaryTujuan = document.getElementById("summary-tujuan");

        if (!formStep1 || !selectArmada) return;

        // 1. LOGIKA PILIH KARTU ARMADA
        fleetCards.forEach(card => {
            card.addEventListener("click", () => {
                const value = card.getAttribute("data-value");
                if(!value) return;

                fleetCards.forEach(c => {
                    const ring = c.querySelector('.selected-ring');
                    const check = c.querySelector('.selected-check');
                    if(ring) {
                        ring.classList.remove('ring-4', 'border-primary', 'bg-primary/5');
                        ring.classList.add('border-transparent');
                    }
                    if(check) {
                        check.classList.remove('opacity-100', 'scale-100');
                        check.classList.add('opacity-0', 'scale-50');
                    }
                });

                const activeRing = card.querySelector('.selected-ring');
                const activeCheck = card.querySelector('.selected-check');
                if(activeRing) {
                    activeRing.classList.remove('border-transparent');
                    activeRing.classList.add('ring-4', 'border-primary', 'bg-primary/5');
                }
                if(activeCheck) {
                    activeCheck.classList.remove('opacity-0', 'scale-50');
                    activeCheck.classList.add('opacity-100', 'scale-100');
                }

                selectArmada.value = value;
            });
        });

        selectArmada.addEventListener("change", (e) => {
            const target = e.target as HTMLSelectElement;
            const matchedCard = Array.from(fleetCards).find(c => c.getAttribute("data-value") === target.value) as HTMLElement;
            if(matchedCard) {
                if(matchedCard.classList.contains("hidden") && btnExpand) btnExpand.click();
                matchedCard.click();
            }
        });

        // 2. LOGIKA CTA EXPAND & COLLAPSE
        if (extraCards.length > 0) {
            if(btnExpand && btnCollapse) {
                btnExpand.addEventListener("click", () => {
                    extraCards.forEach(card => {
                        card.classList.remove("hidden");
                        card.classList.add("animate-fade-in");
                    });
                    btnExpand.classList.add("hidden");
                    btnExpand.classList.remove("flex");
                    btnCollapse.classList.remove("hidden");
                    btnCollapse.classList.add("flex");
                });

                btnCollapse.addEventListener("click", () => {
                    extraCards.forEach(card => {
                        card.classList.add("hidden");
                        card.classList.remove("animate-fade-in");
                    });
                    btnCollapse.classList.add("hidden");
                    btnCollapse.classList.remove("flex");
                    btnExpand.classList.remove("hidden");
                    btnExpand.classList.add("flex");
                    document.getElementById("right-step-1")?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }
        }

        // 3. LOGIKA VALIDASI TANGGAL
        if (inputTanggalSewa && inputTanggalKepulangan) {
            const today = new Date().toISOString().split('T')[0];
            inputTanggalSewa.min = today;
            inputTanggalSewa.addEventListener("change", (e) => {
                const target = e.target as HTMLInputElement;
                const dateBerangkat = target.value;
                inputTanggalKepulangan.min = dateBerangkat;
                if (inputTanggalKepulangan.value && inputTanggalKepulangan.value < dateBerangkat) {
                    inputTanggalKepulangan.value = "";
                }
            });
        }

        // 4. LOGIKA SUBMIT STEP 1 -> STEP 2
        formStep1.addEventListener("submit", (e) => {
            e.preventDefault();
            const formData = new FormData(formStep1 as HTMLFormElement);
            const data = Object.fromEntries(formData.entries());

            if(summaryArmada) summaryArmada.textContent = selectArmada.options[selectArmada.selectedIndex].text;
            if(summaryTanggal) summaryTanggal.textContent = data.tanggal_sewa as string;
            if(summaryTujuan) summaryTujuan.textContent = data.tujuan as string;

            if(leftStep1 && leftStep2 && rightStep1 && rightStep2) {
                leftStep1.classList.add("hidden");
                leftStep1.classList.remove("block");
                rightStep1.classList.add("hidden");
                leftStep2.classList.remove("hidden");
                rightStep2.classList.remove("hidden");
                rightStep2.classList.add("block");
            }
            window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // 5. LOGIKA TOMBOL KEMBALI
        if (btnKembali) {
            btnKembali.addEventListener("click", () => {
                if(leftStep1 && leftStep2 && rightStep1 && rightStep2) {
                    leftStep2.classList.add("hidden");
                    rightStep2.classList.remove("block");
                    rightStep2.classList.add("hidden");
                    leftStep1.classList.remove("hidden");
                    leftStep1.classList.add("block");
                    rightStep1.classList.remove("hidden");
                }
            });
        }

        // ========================================================
        // 6. LOGIKA AUTO-FILL & AUTO-SCROLL UNTUK TAB
        // ========================================================
        const params = new URLSearchParams(window.location.search);
        const tujuanDariURL = params.get('tujuan');
        const hashTarget = window.location.hash;

        // A. Isi Input Tujuan jika ada data dari URL
        if (inputTujuan && tujuanDariURL) {
            inputTujuan.value = tujuanDariURL;
            // Highlight visual sesaat
            inputTujuan.classList.add("ring-2", "ring-emerald-400", "bg-emerald-50");
            setTimeout(() => {
                inputTujuan.classList.remove("ring-2", "ring-emerald-400", "bg-emerald-50");
            }, 1500);
        }

        // B. Logika cerdas untuk Scroll meskipun elemen ada di dalam Tab yang tersembunyi
        if (hashTarget === "#booking-component") {
            const targetElement = document.getElementById("booking-component");
            
            if (targetElement) {
                // Membuka tab booking (Ganti 'tab-btn-booking' jika ID tombol tab Anda berbeda)
                const tabBooking = document.getElementById("tab-btn-booking");
                if (tabBooking) tabBooking.click();

                // Observer memantau kapan form booking tidak lagi 'hidden'
                const observer = new MutationObserver((mutations, obs) => {
                    if (targetElement.offsetParent !== null) { 
                        targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
                        obs.disconnect(); // Selesai memantau
                    }
                });

                observer.observe(targetElement, { attributes: true, attributeFilter: ['class'] });
                
                // Fallback (jaga-jaga jika tab sudah terbuka sejak awal)
                setTimeout(() => {
                    targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
                    observer.disconnect();
                }, 800);
            }
        }
    };

    document.addEventListener("DOMContentLoaded", setupBookingForm);
    document.addEventListener("astro:page-load", setupBookingForm);
</script>