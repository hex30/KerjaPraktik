---
import FormDataDiriPenumpang from "./FormData.astro";
import Seat from "./seat.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import RouteItem from "./molecules/RouteItem.astro";
import QuantitySelector from "../../ui/QuantitySelector.astro";
import Button from "../../ui/Button.astro";
import HeroAside from "../../ui/HeroAside.astro";
---

<div class="w-full relative">
    <article
        class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main"
    >
        <div class="w-full lg:w-3/5 flex flex-col gap-8">
            <div id="travel-step-1" class="block animate-fade-in">
                <SectionHeader 
                    title="Detail Perjalanan Travel" 
                    subtitle="Lengkapi rute, jadwal keberangkatan, dan bagasi Anda."
                />

                <form
                    action="#"
                    id="form-reservasi-travel"
                    class="flex flex-col gap-8"
                >
                    <section
                        class="flex flex-col gap-5 border-b border-slate-100 pb-8"
                    >
                        <h3 class="text-lg text-primary font-bold">
                            1. Rute dan Jadwal Perjalanan
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <RouteItem 
                                value="jakarta_panawangan" 
                                label="Jakarta ➔ Panawangan" 
                                days="Senin, Rabu dan Minggu"
                            />
                            <RouteItem 
                                value="panawangan_jakarta" 
                                label="Panawangan ➔ Jakarta" 
                                days="Selasa Kamis dan Juma'at"
                            />
                        </div>

                        <div class="flex flex-col gap-3 mt-2">
                            <label
                                class="font-secondary text-sm font-bold text-primary"
                                >Pilih tanggal keberangkatan anda</label
                            >
                            <div
                                id="date-container-travel"
                                class="flex gap-3 overflow-x-auto pb-4 snap-x hide-scrollbar"
                            >
                                <div
                                    class="w-full p-4 border border-dashed border-slate-300 rounded-xl bg-slate-50 text-center text-sm text-slate-400 font-secondary"
                                >
                                    Silahkan Pilih Rute Terlebih Dahulu.
                                </div>
                            </div>
                            <input
                                type="hidden"
                                name="tanggal_keberangkatan"
                                id="tanggal_hidden_travel"
                                required
                            />
                        </div>
                    </section>

                    <section>
                        <Seat />
                    </section>

                    <section class="flex flex-col gap-5">
                        <h3 class="text-lg font-bold text-primary">
                            2. Barang bawaan (Opsional)
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div class="flex flex-col gap-2">
                                <label
                                    for="ukuran_bagasi"
                                    class="font-secondary text-sm font-bold text-primary"
                                    >Ukuran dominan</label
                                >
                                <div class="relative">
                                    <select
                                        name="ukuran_bagasi"
                                        id="ukuran_bagasi"
                                        class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all appearance-none"
                                    >
                                        <option value="tidak_ada"
                                            >Hanya tas/Ransel</option
                                        >
                                        <option value="sedang"
                                            >Sedang (Kardus Mie)</option
                                        >
                                        <option value="besar"
                                            >Besar (Koper/Karung)</option
                                        >
                                    </select>
                                    <div
                                        class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-400"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <QuantitySelector 
                                id="jumlah_bagasi" 
                                name="jumlah_bagasi" 
                                label="Jumlah Barang (Pcs)" 
                                max={15}
                            />
                        </div>
                    </section>

                    <div class="pt-6 mt-2">
                        <Button type="submit" size="lg">
                            Lanjutkan Isi Data Diri
                        </Button>
                    </div>
                </form>
            </div>

            <div id="travel-step-2" class="hidden animate-fade-in w-full">
                <button
                    type="button"
                    id="btn-kembali-travel"
                    class="mb-6 flex items-center gap-2 text-slate-500 hover:text-primary font-secondary font-bold transition-colors"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Kembali ke Pilihan Jadwal
                </button>

                <form id="form-data-diri-travel">
                    <FormDataDiriPenumpang />

                    <div class="pt-4 border-t border-slate-100">
                        <Button type="submit" size="lg">
                            Selesaikan Pemesanan
                        </Button>
                    </div>
                </form>
            </div>
        </div>

        <HeroAside 
            image="/assets/images/contoh.jpg"
            title="Perjalanan Nyaman & Aman"
            description="Armada premium kami dirancang dengan bagasi luas untuk kepuasan Anda."
        />
    </article>
</div>

<script>
    import { apiFetch } from "../../../services/api";

    // =================================================================
    // VARIABEL GLOBAL & ALAT BANTU (Ditulis di luar agar tidak dibuat berulang kali)
    // =================================================================

    // Menyimpan ID jadwal yang dipilih user
    let selectedScheduleId = "";

    // Membuat alat format tanggal dan uang di luar loop.
    // Kenapa di luar? Agar browser tidak capek membuat ulang alat ini
    // setiap kali menampilkan jadwal baru (Lebih cepat & efisien).
    const formatUang = new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        maximumFractionDigits: 0,
    });
    const formatHari = new Intl.DateTimeFormat("id-ID", { weekday: "short" });
    const formatTanggal = new Intl.DateTimeFormat("id-ID", { day: "2-digit" });
    const formatBulan = new Intl.DateTimeFormat("id-ID", { month: "short" });
    const formatJam = new Intl.DateTimeFormat("id-ID", {
        hour: "2-digit",
        minute: "2-digit",
    });

    // Fungsi khusus untuk merakit desain kotak/kartu jadwal.
    // Dipisah ke sini agar logika utama di bawah tidak dipenuhi oleh teks HTML yang panjang.
    const buatCardJadwal = (schedule: any) => {
        const dateObj = new Date(schedule.departure_time);
        return `
            <label class="relative cursor-pointer snap-start shrink-0 group">
                <input type="radio" name="pilihan_jadwal" value="${schedule.id}" class="peer sr-only">
                <div class="flex flex-col items-center justify-center min-w-[120px] p-3 mt-3 rounded-xl border-2 border-slate-200 text-primary peer-checked:text-black peer-checked:border-primary peer-checked:bg-primary/20 hover:border-primary hover:-translate-y-2 transition-all">
                    <span class="text-[10px] text-slate-500 font-secondary mb-1 uppercase tracking-wider">${formatHari.format(dateObj)}, ${formatJam.format(dateObj)} WIB</span>
                    <span class="text-2xl font-black leading-none">${formatTanggal.format(dateObj)}</span>
                    <span class="text-xs text-slate-500 font-secondary mt-1">${formatBulan.format(dateObj)}</span>
                    <span class="text-[9px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full mt-2 font-bold whitespace-nowrap">Sisa ${schedule.available_seats} Kursi</span>
                    <span class="text-[10px] text-slate-400 mt-1 font-bold">${formatUang.format(schedule.base_price)}</span>
                </div>
            </label>
        `;
    };

    // =================================================================
    // FUNGSI UTAMA (Dijalankan saat halaman selesai dimuat)
    // =================================================================
    const setupAlurTravel = () => {
        // 1. Ambil Semua Elemen dari HTML yang akan dikendalikan
        const wrapperStep1 = document.getElementById("travel-step-1");
        const wrapperStep2 = document.getElementById("travel-step-2");
        const formStep1 = document.getElementById(
            "form-reservasi-travel",
        ) as HTMLFormElement;
        const formStep2 = document.getElementById(
            "form-data-diri-travel",
        ) as HTMLFormElement;

        const containerTanggal = document.getElementById(
            "date-container-travel",
        );
        const hiddenInputTanggal = document.getElementById(
            "tanggal_hidden_travel",
        ) as HTMLInputElement;
        const ruteRadios = formStep1?.querySelectorAll('input[name="rute"]');
        const btnKembali = document.getElementById("btn-kembali-travel");

        // Jika salah satu elemen penting tidak ada di halaman, hentikan proses (mencegah error)
        if (!wrapperStep1 || !wrapperStep2 || !formStep1 || !formStep2) return;

        // =================================================================
        // FITUR A: PENCARIAN JADWAL BERDASARKAN RUTE
        // =================================================================
        if (ruteRadios && containerTanggal && hiddenInputTanggal) {
            // Pantau setiap radio button rute (jika ditekan)
            ruteRadios.forEach((radio) => {
                radio.addEventListener("change", async (e) => {
                    const target = e.target as HTMLInputElement;

                    // Munculkan teks loading
                    containerTanggal.innerHTML =
                        '<div class="w-full p-4 border border-dashed border-slate-300 rounded-xl bg-slate-50 text-center animate-pulse text-sm text-slate-400">Sedang mencari jadwal...</div>';

                    // Reset pilihan sebelumnya
                    hiddenInputTanggal.value = "";
                    selectedScheduleId = "";

                    // Tentukan kota Asal dan Tujuan (Cara ini sangat ramah pemula & jelas)
                    let origin = "";
                    let destination = "";
                    if (target.value === "jakarta_panawangan") {
                        origin = "Jakarta";
                        destination = "Panawangan";
                    } else if (target.value === "panawangan_jakarta") {
                        origin = "Panawangan";
                        destination = "Jakarta";
                    }

                    // Hubungi server Backend
                    try {
                        const response = await apiFetch(
                            `/api/travel/schedules?origin=${origin}&destination=${destination}`,
                        );
                        const schedules = response.data;

                        // Jika jadwal kosong
                        if (!schedules || schedules.length === 0) {
                            containerTanggal.innerHTML =
                                '<div class="w-full p-4 border border-red-200 rounded-xl bg-red-50 text-center text-sm text-red-500">Maaf, jadwal tidak tersedia.</div>';
                            return;
                        }

                        // Jika ada jadwal, rakit semua HTML Card menggunakan fungsi di atas
                        // lalu tampilkan ke dalam layar (.join("") untuk menggabungkan tanpa koma)
                        containerTanggal.innerHTML = schedules
                            .map(buatCardJadwal)
                            .join("");
                    } catch (error) {
                        console.error(error);
                        containerTanggal.innerHTML =
                            '<div class="w-full p-4 border border-red-200 rounded-xl bg-red-50 text-center text-sm text-red-500">Gagal menghubungi server.</div>';
                    }
                });
            });

            // Menyimpan ID jadwal ketika user klik/memilih salah satu kartu jadwal
            containerTanggal.addEventListener("change", (e) => {
                const target = e.target as HTMLInputElement;
                if (target && target.name === "pilihan_jadwal") {
                    hiddenInputTanggal.value = target.value;
                    selectedScheduleId = target.value;
                }
            });
        }

        // =================================================================
        // FITUR B: TRANSISI (PINDAH) ANTARA STEP 1 DAN STEP 2
        // =================================================================

        // Fungsi pembantu agar kode transisi lebih rapi (tidak diulang-ulang)
        const pindahKeStep2 = () => {
            wrapperStep1.classList.add("hidden");
            wrapperStep1.classList.remove("block");
            wrapperStep2.classList.remove("hidden");
            wrapperStep2.classList.add("block");
            window.scrollTo({ top: 0, behavior: "smooth" }); // Gulir ke atas
        };

        const kembaliKeStep1 = () => {
            wrapperStep2.classList.add("hidden");
            wrapperStep2.classList.remove("block");
            wrapperStep1.classList.remove("hidden");
            wrapperStep1.classList.add("block");
        };

        // Saat tombol "Lanjutkan Isi Data Diri" ditekan
        formStep1.addEventListener("submit", (e) => {
            e.preventDefault();

            // Cek apakah jadwal sudah dipilih
            if (!hiddenInputTanggal.value) {
                alert("Mohon pilih jadwal keberangkatan terlebih dahulu.");
                return;
            }

            // Cek apakah kursi sudah dipilih
            const inputKursiElement = document.getElementById(
                "input-selected-seats",
            ) as HTMLInputElement;
            if (!inputKursiElement || !inputKursiElement.value) {
                alert("Mohon pilih satu kursi pada denah yang tersedia.");
                return;
            }

            // Jika lulus semua pengecekan, pindah halaman
            pindahKeStep2();
        });

        // Saat tombol "Kembali" di Step 2 ditekan
        if (btnKembali) {
            btnKembali.addEventListener("click", kembaliKeStep1);
        }

        // =================================================================
        // FITUR C: PENGIRIMAN DATA KE SERVER (FINAL SUBMIT)
        // =================================================================
        formStep2.addEventListener("submit", async (e) => {
            e.preventDefault();

            // 1. Cek Token Login
            const token = localStorage.getItem("jwt_token");
            if (!token) {
                alert("Sesi Anda telah habis. Silakan login kembali.");
                window.location.href = "/login";
                return;
            }

            // 2. Ubah Teks Tombol (Visual Feedback)
            const btnSubmit = formStep2.querySelector(
                'button[type="submit"]',
            ) as HTMLButtonElement | null;
            const originalText = btnSubmit
                ? btnSubmit.textContent
                : "Selesaikan Pemesanan";
            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.textContent = "Memproses Pesanan...";
            }

            // 3. Mengumpulkan Semua Data
            // (Ingat: Gunakan window.FormData untuk mencegah error TypeScript)
            const formData2 = new window.FormData(formStep2 as HTMLFormElement);
            const dataDiri = Object.fromEntries(formData2.entries());

            // Merangkai alamat menjadi satu kalimat panjang
            const alamatLengkap = `${dataDiri.hamlet}, RT ${dataDiri.rt}/RW ${dataDiri.rw}, Desa ${dataDiri.village}, Kec. ${dataDiri.sub_district}. Patokan: ${dataDiri.landmark}`;

            // Mengambil angka kursi
            const inputKursiElement = document.getElementById(
                "input-selected-seats",
            ) as HTMLInputElement;
            const nomorKursi = inputKursiElement
                ? parseInt(inputKursiElement.value)
                : 0;

            // 4. Membungkus Payload (Data Akhir untuk Backend)
            const payloadFinal = {
                schedule_id: selectedScheduleId,
                seat_number: nomorKursi,
                pickup_address: alamatLengkap, // <- Ini sudah ejaan yang benar
            };

            // 5. Eksekusi Kirim ke Backend
            try {
                const response = await apiFetch("/api/travel/bookings", {
                    method: "POST",
                    headers: { Authorization: `Bearer ${token}` },
                    body: JSON.stringify(payloadFinal),
                });

                console.log("Response sukses:", response);
                alert("Booking berhasil! " + response.message);

                // Opsional: Pindah ke halaman riwayat setelah sukses
                // window.location.href = "/history";
            } catch (error: any) {
                console.error("Gagal booking:", error);
                alert(error.message || "Pemesanan gagal. Silakan coba lagi.");
            } finally {
                // Kembalikan kondisi tombol seperti semula (aktif)
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.textContent = originalText;
                }
            }
        });
    };

    // Jalankan kode setelah halaman selesai dimuat sepenuhnya
    document.addEventListener("DOMContentLoaded", setupAlurTravel);
    document.addEventListener("astro:page-load", setupAlurTravel);
</script>
