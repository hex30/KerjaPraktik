---
import InputGroup from "../../ui/InputGroup.astro"; // Sesuaikan path

interface Props {
    formId?: string; 
}
// Tangkap formId dari pemanggil, defaultnya "form-penumpang"
const { formId = "form-penumpang" } = Astro.props;
---

<form 
id={formId} 
    class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col gap-8 font-main"
>
    <header>
        <h2 class="text-2xl font-black text-primary mb-2">
            Data Diri Penumpang
        </h2>
        <p class="font-secondary text-sm text-text-secondary">
            Mohon isi detail alamat untuk mempermudah proses penjemputan.
        </p>
    </header>

    <section class="flex flex-col gap-5">
        <div class="w-full">
            <InputGroup
                label="Nama Lengkap"
                id="nama-lengkap"
                name="nama_lengkap"
                placeholder="Masukan Nama Lengkap Anda"
                required={true}
            />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <InputGroup
                label="Kecamatan"
                id="kecamatan"
                name="Kecamatan"
                placeholder="Contoh : Panawangan"
                required={true}
            />
            <InputGroup
                label="Desa"
                id="desa"
                name="Desa"
                placeholder="Contoh : Nagarajaya"
                required={true}
            />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
            <div class="md:col-span-6">
                <InputGroup
                    label="Nama Dusun"
                    id="dusun"
                    name="Dusun"
                    placeholder="Contoh : Cikodang"
                    required={true}
                />
            </div>
            <div class="md:col-span-3">
                <InputGroup
                    label="RT"
                    id="rt"
                    name="RT"
                    placeholder="00"
                    required={true}
                />
            </div>
            <div class="md:col-span-3">
                <InputGroup
                    label="RW"
                    id="rw"
                    name="RW"
                    placeholder="00"
                    required={true}
                />
            </div>
        </div>

        <div class="flex flex-col gap-2 w-full">
            <label
                for="patokan"
                class="font-secondary text-sm font-bold text-primary"
            >
                Patokan Bangunan
            </label>
            <textarea
                name="patokan"
                id="patokan"
                rows="3"
                placeholder="Contoh : Sebelah Masjid Agung"
                class="resize-none w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
            ></textarea>
        </div>
    </section>

    <div class="pt-4 border-t border-slate-100">
        <button
            type="submit"
            class="w-full md:w-auto px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md  hover:shadow-lg transition-all transform hover:-translate-y-0.5"
        >
            Selesaikan Pemesanan
        </button>
    </div>
</form>