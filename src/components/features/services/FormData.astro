---
// File: src/components/layanan/FormData.astro
import InputGroup from "../../ui/InputGroup.astro"; // Sesuaikan path

// ==========================================
// SIMULASI AUTENTIKASI & DATA USER
// ==========================================
const session = {
    isLoggedIn: true,
    user: {
        fullName: "Febi Yulianti", 
    }
};

// Menentukan default value untuk nama lengkap
const defaultName = session.isLoggedIn ? session.user.fullName : "";
---

<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col gap-8 font-main">
    <header>
        <h2 class="text-2xl font-black text-primary mb-2">
            Data Diri Penumpang
        </h2>
        <p class="font-secondary text-sm text-text-secondary">
            Mohon isi detail alamat untuk mempermudah proses penjemputan.
        </p>
    </header>

    <section class="flex flex-col gap-5">
        <div class="w-full relative">
            <InputGroup
                label="Nama Lengkap"
                id="nama-lengkap"
                name="full_name"
                placeholder="Masukan Nama Lengkap Anda"
                required={true}
                value={defaultName} 
            />
            
            {session.isLoggedIn && (
                <span class="absolute right-4 top-10 text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md border border-emerald-200 pointer-events-none">
                    Sesuai Profil
                </span>
            )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <InputGroup
                label="Kecamatan"
                id="kecamatan"
                name="sub_district"
                placeholder="Contoh : Panawangan"
                required={true}
            />
            <InputGroup
                label="Desa"
                id="desa"
                name="village"
                placeholder="Contoh : Nagarajaya"
                required={true}
            />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
            <div class="md:col-span-6">
                <InputGroup
                    label="Nama Dusun"
                    id="dusun"
                    name="hamlet"
                    placeholder="Contoh : Cikodang"
                    required={true}
                />
            </div>
            <div class="md:col-span-3">
                <InputGroup
                    label="RT"
                    id="rt"
                    name="rt"
                    type="number"
                    placeholder="00"
                    required={true}
                />
            </div>
            <div class="md:col-span-3">
                <InputGroup
                    label="RW"
                    id="rw"
                    name="rw"
                    type="number"
                    placeholder="00"
                    required={true}
                />
            </div>
        </div>

        <div class="flex flex-col gap-2 w-full">
            <label
                for="patokan"
                class="font-secondary text-sm font-bold text-primary"
            >
                Patokan Bangunan
            </label>
            <textarea
                name="landmark"
                id="patokan"
                rows="3"
                placeholder="Contoh : Sebelah Masjid Agung"
                class="resize-none w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all placeholder:text-slate-400"
            ></textarea>
        </div>
    </section>
</div>