---
import InputGroup from './InputGroup.astro';
---

<article class="bg-white rounded-[2rem] shadow-sm border border-slate-100 p-6 md:p-10 flex flex-col lg:flex-row gap-10 max-w-7xl mx-auto font-main">
    
    <div class="w-full lg:w-3/5 flex flex-col gap-8">
        
        <header>
            <h2 class="text-2xl md:text-3xl font-black text-primary font-main mb-2">Detail Penumpang</h2>
            <p class="font-secondary text-sm text-text-secondary leading-relaxed">
                Lengkapi Data Diri Anda Untuk Perjalanan Yang Nyaman
            </p>
        </header>

        <form id="form-rute" class="flex flex-col gap-6">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <InputGroup label="Nama Depan" id="first-name" name="first_name" placeholder="Masukan Nama Depan Anda" required={true} />
                <InputGroup label="Nama Belakang" id="last-name" name="last_name" placeholder="Masukan Nama Belakang Anda" required={true} />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <InputGroup label="Kecamatan" id="kecamatan" name="kecamatan" placeholder="Contoh: Panawangan" required={true} />
                <InputGroup label="Desa" id="desa" name="desa" placeholder="Contoh: Nagarajaya" required={true} />
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-end">
                <div class="md:col-span-6">
                    <InputGroup label="Nama Dusun" id="dusun" name="dusun" placeholder="Contoh: Cikondang" />
                </div>
                <div class="md:col-span-3">
                    <InputGroup label="RT" id="rt" name="rt" placeholder="00" />
                </div>
                <div class="md:col-span-3">
                    <InputGroup label="RW" id="rw" name="rw" placeholder="00" />
                </div>
            </div>

            <div class="flex flex-col gap-2 w-full">
                <label for="patokan" class="font-secondary text-sm font-bold text-primary">Patokan Bangunan</label>
                <textarea 
                    name="patokan" 
                    id="patokan" 
                    rows="3" 
                    placeholder="Contoh: Sebelah masjid agung" 
                    class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all placeholder:text-slate-400"
                ></textarea>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full md:w-auto px-8 py-4 bg-btn-linear text-white font-main font-bold rounded-xl shadow-md hover:opacity-90 transition-opacity">
                    Lanjut ke Pembayaran
                </button>
            </div>
            
        </form>
    </div>

    <aside class="w-full lg:w-2/5 hidden lg:block">
        <figure class="relative w-full h-full min-h-[400px] rounded-2xl overflow-hidden group">
            <img 
                src="/assets/images/contoh.jpg" 
                alt="Visual Rute" 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/20 to-transparent"></div>
            
            <figcaption class="absolute bottom-0 left-0 right-0 p-8">
                <h3 class="text-2xl font-black text-white font-main mb-2">Kenyamanan Ekstra</h3>
                <p class="font-secondary text-sm text-slate-200 leading-relaxed max-w-sm">
                    Armada premium kami dirancang untuk memastikan perjalanan Anda sangat nyaman hingga sampai di tujuan.
                </p>
            </figcaption>
        </figure>
    </aside>

</article>

<script>
    const setupRuteListener = () => {
        const form = document.getElementById('form-rute');
        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const formData = new FormData(form as HTMLFormElement);
                const data = Object.fromEntries(formData.entries());
                
                console.log("Data Rute Berhasil Disimpan:", data);
                alert(`Terima kasih ${data.first_name}, data rute perjalanan Anda telah direkam sistem.`);
            });
        }
    };

    document.addEventListener('DOMContentLoaded', setupRuteListener);
</script>