---
import AdminLayout from "@layouts/AdminLayout.astro";
import AdminPageHeader from "@features/admin/shared/AdminPageHeader.astro";
import { adminBookingService } from "@services/adminBookingService";

const token = Astro.cookies.get("token")?.value;
const activeTab = Astro.url.searchParams.get("phase") || "pending";

const [rawAssignments, drivers, fleets] = await Promise.all([
    adminBookingService.getAssignments(activeTab, token),
    adminBookingService.getMasterDrivers(token),
    adminBookingService.getMasterFleets(token),
]);

const assignments = rawAssignments.filter((item: any) => {
    if (item.type === "CHARTER") return true;
    return item.total_passengers > 0 || item.total_packages > 0;
});

const currentPage = parseInt(Astro.url.searchParams.get("page") || "1", 10);
const itemsPerPage = 8;

let paginatedAssignments = assignments;
let totalPages = 1;

if (activeTab === "completed") {
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;
    paginatedAssignments = assignments.slice(startIndex, endIndex);
    totalPages = Math.ceil(assignments.length / itemsPerPage);
}

const formatDate = (dateString: string) => {
    if (!dateString) return "-";
    const date = new Date(dateString);
    return date.toLocaleDateString("id-ID", {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
    });
};

const formatCurrency = (amount: number) => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0,
    }).format(amount);
};

const getDriverName = (driverId: string) => {
    if (!driverId) return "-";
    const driver = drivers.find((d: any) => d.id === driverId);
    return driver ? driver.name : "Tanpa Nama";
};
---

<AdminLayout title="Penugasan Armada - Admin Panel">
    <AdminPageHeader 
        title="Penugasan Armada"
        description="Kelola penugasan supir, pantau armada yang sedang bertugas, dan tinjau riwayat tugas selesai."
    />

    <!-- Phase Tabs -->
    <div class="flex gap-2 overflow-x-auto pb-4 mb-6 hide-scrollbar">
        <a
            href="/admin/assignments?phase=pending"
            class={`px-6 py-3 rounded-2xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === "pending" ? "bg-primary text-white shadow-md" : "bg-white text-slate-500 hover:bg-slate-50 border border-slate-100"}`}
        >
            Butuh Penugasan
        </a>
        <a
            href="/admin/assignments?phase=assigned"
            class={`px-6 py-3 rounded-2xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === "assigned" ? "bg-indigo-500 text-white shadow-md" : "bg-white text-slate-500 hover:bg-slate-50 border border-slate-100"}`}
        >
            Sudah Ditugaskan
        </a>
        <a
            href="/admin/assignments?phase=active"
            class={`px-6 py-3 rounded-2xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === "active" ? "bg-sky-500 text-white shadow-md" : "bg-white text-slate-500 hover:bg-slate-50 border border-slate-100"}`}
        >
            Sedang Bertugas
        </a>
        <a
            href="/admin/assignments?phase=completed"
            class={`px-6 py-3 rounded-2xl font-bold text-sm whitespace-nowrap transition-all ${activeTab === "completed" ? "bg-emerald-500 text-white shadow-md" : "bg-white text-slate-500 hover:bg-slate-50 border border-slate-100"}`}
        >
            Selesai
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {
            paginatedAssignments.length > 0 ? (
                paginatedAssignments.map((item) => (
                    <div class="bg-white rounded-[1.5rem] border border-slate-100 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-shadow duration-300 relative group">
                        <div class="bg-primary/5 p-5 border-b border-primary/10">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <span
                                        class={`inline-block px-3 py-1 rounded-full text-[10px] font-black tracking-widest uppercase mb-3 ${item.type === "RUTE" ? "bg-primary text-white" : "bg-amber-500 text-white"}`}
                                    >
                                        {item.type}
                                    </span>
                                    <h3 class="text-base font-black text-slate-800 leading-tight">
                                        {item.title}
                                    </h3>
                                    {item.type === "CHARTER" &&
                                        item.customer_name && (
                                            <p class="text-xs font-bold text-slate-500 mt-1">
                                                Pemesan:{" "}
                                                <span class="text-primary">
                                                    {item.customer_name}
                                                </span>
                                            </p>
                                        )}
                                </div>
                                {activeTab === "completed" && (
                                    <button
                                        type="button"
                                        class="btn-archive p-2 bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white rounded-xl transition-colors shrink-0"
                                        data-id={item.id}
                                        data-type={item.type}
                                        title="Hapus dari daftar riwayat"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5"
                                            viewBox="0 0 20 20"
                                            fill="currentColor"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </button>
                                )}
                            </div>
                        </div>

                        <div class="p-5 flex-grow space-y-5">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">
                                        Tgl Berangkat
                                    </span>
                                    <span class="text-xs font-bold text-slate-700">
                                        {formatDate(item.departure_date)}
                                    </span>
                                </div>
                                <div>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">
                                        Total Penumpang
                                    </span>
                                    <span class="text-xs font-black text-primary bg-primary/10 px-2 py-1 rounded-md">
                                        {item.total_passengers} Orang
                                    </span>
                                </div>
                                <div>
                                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-1">
                                        Total Paket
                                    </span>
                                    <span class="text-xs font-black text-amber-600 bg-amber-50 px-2 py-1 rounded-md">
                                        {item.total_packages || 0} Paket
                                    </span>
                                </div>
                                <div>
                                    <span class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest block mb-1">
                                        Total Pendapatan
                                    </span>
                                    <span class="text-sm font-black text-emerald-600">
                                        {formatCurrency(
                                            item.total_revenue || 0,
                                        )}
                                    </span>
                                </div>
                            </div>

                            {item.max_payload && (
                                <div class="space-y-1.5 bg-slate-50/50 p-3.5 rounded-xl border border-slate-100">
                                    <div class="flex justify-between items-center text-[10px] font-bold">
                                        <span class="text-slate-400 uppercase tracking-widest">Beban Kargo</span>
                                        <span class={item.total_weight >= item.max_payload ? "text-red-500 font-black" : (item.total_weight >= item.max_payload * 0.8 ? "text-amber-500 font-black" : "text-slate-600 font-bold")}>
                                            {item.total_weight || 0} / {item.max_payload} kg
                                        </span>
                                    </div>
                                    <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                        <div 
                                            class:list={[
                                                "h-full rounded-full transition-all duration-500",
                                                item.total_weight >= item.max_payload ? "bg-red-500" : (item.total_weight >= item.max_payload * 0.8 ? "bg-amber-500" : "bg-primary")
                                            ]}
                                            style={`width: ${Math.min(100, ((item.total_weight || 0) / item.max_payload) * 100)}%`}
                                        ></div>
                                    </div>
                                    <div class="text-[9px] font-bold text-slate-400 text-right">
                                        Sisa: {Math.max(0, item.max_payload - (item.total_weight || 0))} kg
                                    </div>
                                </div>
                            )}

                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2">
                                    Unit & Supir
                                </span>
                                {activeTab === "pending" ||
                                activeTab === "assigned" ? (
                                    <form
                                        class="assignment-form flex flex-col gap-3"
                                        data-id={item.id}
                                        data-type={item.type}
                                    >
                                        <div>
                                            <label class="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                                                Pilih Unit Armada (Opsional
                                                Ganti)
                                            </label>
                                            <select
                                                name="fleet_id"
                                                class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                            >
                                                <option
                                                    value={item.fleet_id || ""}
                                                >
                                                    {item.fleet_plate_number
                                                        ? `${item.fleet_plate_number} - ${item.fleet_car_type} (Saat Ini)`
                                                        : "Pilih Unit..."}
                                                </option>
                                                {fleets.map(
                                                    (f) =>
                                                        f.id !==
                                                            item.fleet_id && (
                                                            <option
                                                                value={f.id}
                                                            >
                                                                {f.plate_number}{" "}
                                                                - {f.car_type}{" "}
                                                                (Kapasitas:{" "}
                                                                {
                                                                    f.seat_capacity
                                                                }
                                                                )
                                                            </option>
                                                        ),
                                                )}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                                                Supir Utama (Wajib)
                                            </label>
                                            <select
                                                name="driver_id"
                                                class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                                required
                                            >
                                                <option value="">
                                                    Pilih Supir...
                                                </option>
                                                {drivers.map((d) => (
                                                    <option
                                                        value={d.id}
                                                        selected={
                                                            d.id ===
                                                            item.driver_id
                                                        }
                                                    >
                                                        {d.name}
                                                    </option>
                                                ))}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                                                Supir Cadangan (Opsional)
                                            </label>
                                            <select
                                                name="driver_2_id"
                                                class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                            >
                                                <option value="">
                                                    Tanpa Cadangan
                                                </option>
                                                {drivers.map((d) => (
                                                    <option
                                                        value={d.id}
                                                        selected={
                                                            d.id ===
                                                            item.driver_2_id
                                                        }
                                                    >
                                                        {d.name}
                                                    </option>
                                                ))}
                                            </select>
                                        </div>
                                        {item.type === "RUTE" &&
                                            (activeTab === "pending" ||
                                                activeTab === "assigned") && (
                                                <div>
                                                    <label class="text-[10px] font-bold text-slate-500 uppercase block mb-1">
                                                        Jam Keberangkatan / Est.
                                                        Jemput
                                                    </label>
                                                    <input
                                                        type="time"
                                                        name="pickup_time"
                                                        class="w-full bg-white border border-slate-200 rounded-xl px-3 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all"
                                                    />
                                                </div>
                                            )}

                                        <div class="flex flex-col gap-2 mt-2">
                                            {activeTab === "pending" && (
                                                <div class="flex w-full gap-2">
                                                    <button
                                                        type="button"
                                                        class="btn-reject flex-1 border border-rose-200 text-rose-500 hover:bg-rose-50 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors flex items-center justify-center"
                                                        data-id={item.id}
                                                        data-type={item.type}
                                                    >
                                                        Tolak
                                                    </button>
                                                    <button
                                                        type="submit"
                                                        class="flex-[2] bg-primary hover:bg-[#003540] text-white py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors flex items-center justify-center gap-2 group disabled:opacity-70 disabled:cursor-not-allowed"
                                                    >
                                                        <span>
                                                            Tugaskan Supir
                                                        </span>
                                                    </button>
                                                </div>
                                            )}

                                            {activeTab === "assigned" && (
                                                <div class="flex w-full gap-2">
                                                    <button
                                                        type="button"
                                                        class="btn-unassign flex-1 border border-rose-200 text-rose-500 hover:bg-rose-50 py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors flex items-center justify-center text-center"
                                                        data-id={item.id}
                                                        data-type={item.type}
                                                    >
                                                        Batalkan
                                                    </button>
                                                    <button
                                                        type="submit"
                                                        class="flex-1 bg-primary hover:bg-[#003540] text-white py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors flex items-center justify-center gap-2 group disabled:opacity-70 disabled:cursor-not-allowed"
                                                    >
                                                        <span>
                                                            Update Penugasan
                                                        </span>
                                                    </button>
                                                </div>
                                            )}

                                            {activeTab === "assigned" && (
                                                <button
                                                    type="button"
                                                    class="btn-force-active w-full bg-indigo-500 hover:bg-indigo-600 text-white py-3 rounded-xl text-[10px] font-black uppercase tracking-widest transition-colors flex items-center justify-center gap-2"
                                                    data-id={item.id}
                                                    data-type={item.type}
                                                >
                                                    <span>Mulai Bertugas</span>
                                                </button>
                                            )}
                                        </div>
                                    </form>
                                ) : (
                                    <div class="flex flex-col gap-4 mt-2">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-5 w-5 text-emerald-500"
                                                    viewBox="0 0 20 20"
                                                    fill="currentColor"
                                                >
                                                    <path
                                                        fill-rule="evenodd"
                                                        d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.642 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.358-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z"
                                                        clip-rule="evenodd"
                                                    />
                                                </svg>
                                            </div>
                                            <div>
                                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-0.5">Armada</span>
                                                <div class="text-sm font-black text-slate-800">
                                                    {item.fleet_car_type || "TBD"}
                                                </div>
                                                <div class="text-xs font-bold text-slate-500">
                                                    {item.fleet_plate_number || "Menunggu Alokasi"}
                                                </div>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
                                            <div class="w-10 h-10 rounded-full bg-sky-50 border border-sky-100 flex items-center justify-center shrink-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                            </div>
                                            <div>
                                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-0.5">Supir Bertugas</span>
                                                <div class="text-sm font-black text-slate-800">
                                                    {getDriverName(item.driver_id)}
                                                </div>
                                                {item.driver_2_id && (
                                                    <div class="text-xs font-bold text-slate-500 mt-0.5">
                                                        Cad. {getDriverName(item.driver_2_id)}
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            ) : (
                <div class="col-span-full py-16 bg-white rounded-3xl border border-slate-100 flex flex-col items-center justify-center text-center">
                    <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-4">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-10 w-10 text-slate-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-slate-800">
                        Tidak ada penugasan di fase ini
                    </h3>
                    <p class="text-sm text-slate-500 max-w-md mt-2">
                        Daftar penugasan armada kosong atau sudah beralih ke
                        fase selanjutnya.
                    </p>
                </div>
            )
        }
        {
            activeTab === "completed" && totalPages > 1 && (
                <div class="col-span-full flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-100 pt-6 mt-6">
                    <span class="text-xs font-bold text-slate-400">
                        Menampilkan {Math.min((currentPage - 1) * itemsPerPage + 1, assignments.length)}-{Math.min(currentPage * itemsPerPage, assignments.length)} dari {assignments.length} penugasan selesai
                    </span>
                    <div class="flex items-center gap-2">
                        <a
                            href={`/admin/assignments?phase=completed&page=${currentPage - 1}`}
                            class={`px-4 py-2 border border-slate-200 hover:border-slate-300 rounded-xl text-xs font-black text-slate-600 hover:text-slate-800 transition-all ${currentPage === 1 ? "opacity-50 pointer-events-none" : ""}`}
                        >
                            SEBELUMNYA
                        </a>
                        <div class="flex items-center gap-1.5">
                            {Array.from({ length: totalPages }).map((_, idx) => {
                                const pageNum = idx + 1;
                                return (
                                    <a
                                        href={`/admin/assignments?phase=completed&page=${pageNum}`}
                                        class={`w-8 h-8 rounded-xl flex items-center justify-center text-xs font-black transition-all ${currentPage === pageNum ? "bg-emerald-500 text-white shadow-sm" : "border border-slate-100 bg-white text-slate-500 hover:bg-slate-50"}`}
                                    >
                                        {pageNum}
                                    </a>
                                );
                            })}
                        </div>
                        <a
                            href={`/admin/assignments?phase=completed&page=${currentPage + 1}`}
                            class={`px-4 py-2 border border-slate-200 hover:border-slate-300 rounded-xl text-xs font-black text-slate-600 hover:text-slate-800 transition-all ${currentPage === totalPages ? "opacity-50 pointer-events-none" : ""}`}
                        >
                            SELANJUTNYA
                        </a>
                    </div>
                </div>
            )
        }
    </div>
</AdminLayout>

<script>
    import { apiFetch } from "../../../services/api";

    document.addEventListener("DOMContentLoaded", () => {
        const forms = document.querySelectorAll(".assignment-form");

        forms.forEach((form) => {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const f = e.target as HTMLFormElement;
                const id = f.dataset.id;
                const type = f.dataset.type;

                const formData = new FormData(f);
                const data = Object.fromEntries(formData.entries());

                const btn = f.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                const originalText = btn.innerHTML;
                btn.innerHTML = `<svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memproses...`;
                btn.disabled = true;

                try {
                    // Cek jika fleet_id diganti
                    const originalFleetId = f
                        .querySelector('select[name="fleet_id"]')
                        ?.querySelector("option")?.value;
                    if (data.fleet_id && data.fleet_id !== originalFleetId) {
                        const fleetRes = await apiFetch(
                            `/api/admin/assignments/${type}/${id}/change-fleet`,
                            {
                                method: "PUT",
                                body: JSON.stringify({
                                    fleet_id: data.fleet_id,
                                }),
                            },
                        );
                        if (fleetRes?.status !== "success") {
                            throw new Error(
                                fleetRes?.message || "Gagal mengganti armada",
                            );
                        }
                    }

                    // Assign Driver
                    const response = await apiFetch(
                        `/api/admin/assignments/${type}/${id}/assign`,
                        {
                            method: "PUT",
                            body: JSON.stringify(data),
                        },
                    );

                    if (response?.status === "success") {
                        (window as any).showFeedbackModal(
                            "success",
                            "Berhasil",
                            "Penugasan berhasil disimpan!",
                            window.location.href,
                        );
                    } else {
                        throw new Error(
                            response?.message || "Gagal menugaskan supir",
                        );
                    }
                } catch (error: any) {
                    (window as any).showFeedbackModal(
                        "error",
                        "Gagal",
                        error.message || "Terjadi kesalahan sistem.",
                    );
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            });
        });

        // Reject Button
        const rejectBtns = document.querySelectorAll(".btn-reject");
        rejectBtns.forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const id = button.dataset.id;
                const type = button.dataset.type;

                const confirmed = await (window as any).showConfirmModal(
                    "Konfirmasi Penolakan",
                    "Yakin ingin MENOLAK penugasan ini? Semua pesanan penumpang dan paket di dalamnya akan otomatis DIBATALKAN.",
                    "danger",
                );

                if (confirmed) {
                    const originalText = button.innerHTML;
                    button.innerHTML = "Memproses...";
                    button.disabled = true;

                    try {
                        const response = await apiFetch(
                            `/api/admin/assignments/${type}/${id}/reject`,
                            {
                                method: "PUT",
                            },
                        );

                        if (response?.status === "success") {
                            (window as any).showFeedbackModal(
                                "success",
                                "Berhasil",
                                "Penugasan berhasil ditolak dan dibatalkan.",
                                window.location.href,
                            );
                        } else {
                            throw new Error(
                                response?.message || "Gagal menolak penugasan",
                            );
                        }
                    } catch (error: any) {
                        (window as any).showFeedbackModal(
                            "error",
                            "Gagal",
                            error.message || "Terjadi kesalahan sistem.",
                        );
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                }
            });
        });

        // Unassign Button (Batalkan Penugasan)
        const unassignBtns = document.querySelectorAll(".btn-unassign");
        unassignBtns.forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const id = button.dataset.id;
                const type = button.dataset.type;

                const confirmed = await (window as any).showConfirmModal(
                    "Konfirmasi Pembatalan Supir",
                    "Yakin ingin membatalkan supir dari penugasan ini? Status jadwal akan dikembalikan menjadi 'Butuh Penugasan' tanpa membatalkan tiket penumpang.",
                    "danger",
                );

                if (confirmed) {
                    const originalText = button.innerHTML;
                    button.innerHTML = "Memproses...";
                    button.disabled = true;

                    try {
                        const response = await apiFetch(
                            `/api/admin/assignments/${type}/${id}/unassign`,
                            { method: "PUT" },
                        );

                        if (response?.status === "success") {
                            (window as any).showFeedbackModal(
                                "success",
                                "Berhasil",
                                "Supir berhasil dihapus dari penugasan.",
                                window.location.href,
                            );
                        } else {
                            throw new Error(
                                response?.message || "Gagal membatalkan supir",
                            );
                        }
                    } catch (error: any) {
                        (window as any).showFeedbackModal(
                            "error",
                            "Gagal",
                            error.message || "Terjadi kesalahan sistem.",
                        );
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                }
            });
        });

        // Force Active Button (Mulai Bertugas)
        const forceActiveBtns = document.querySelectorAll(".btn-force-active");
        forceActiveBtns.forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const id = button.dataset.id;
                const type = button.dataset.type;
                const form = button.closest("form") as HTMLFormElement;

                const confirmed = await (window as any).showConfirmModal(
                    "Konfirmasi Mulai Bertugas",
                    "Yakin ingin menandai armada ini sebagai 'Sedang Bertugas' sekarang? Ketersediaan jadwal akan ditutup untuk pesanan baru.",
                );

                if (confirmed) {
                    const formData = new FormData(form);
                    const data = Object.fromEntries(formData.entries());
                    data.force_active = "true";

                    const originalText = button.innerHTML;
                    button.innerHTML = "Memproses...";
                    button.disabled = true;

                    try {
                        const response = await apiFetch(
                            `/api/admin/assignments/${type}/${id}/assign`,
                            {
                                method: "PUT",
                                body: JSON.stringify(data),
                            },
                        );

                        if (response?.status === "success") {
                            (window as any).showFeedbackModal(
                                "success",
                                "Berhasil",
                                "Status berhasil diubah menjadi Sedang Bertugas!",
                                window.location.href,
                            );
                        } else {
                            throw new Error(
                                response?.message || "Gagal mengubah status",
                            );
                        }
                    } catch (error: any) {
                        (window as any).showFeedbackModal(
                            "error",
                            "Gagal",
                            error.message || "Terjadi kesalahan sistem.",
                        );
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }
                }
            });
        });

        // Archive / Trash Button
        const archiveBtns = document.querySelectorAll(".btn-archive");
        archiveBtns.forEach((btn) => {
            btn.addEventListener("click", async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const id = button.dataset.id;
                const type = button.dataset.type;

                const confirmed = await (window as any).showConfirmModal(
                    "Konfirmasi Hapus",
                    "Yakin ingin menghapus tugas ini dari riwayat daftar? (Tenang saja, data pendapatan dan laporan tidak akan terhapus dari sistem database)",
                    "danger",
                );
                if (confirmed) {
                    const originalHtml = button.innerHTML;
                    button.innerHTML = `<svg class="animate-spin h-5 w-5 text-rose-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
                    button.disabled = true;

                    try {
                        const response = await apiFetch(
                            `/api/admin/assignments/${type}/${id}`,
                            { method: "DELETE" },
                        );

                        if (response?.status === "success") {
                            window.location.reload();
                        } else {
                            throw new Error(
                                response?.message ||
                                    "Gagal menghapus tugas dari daftar",
                            );
                        }
                    } catch (error: any) {
                        (window as any).showFeedbackModal(
                            "error",
                            "Gagal",
                            error.message || "Terjadi kesalahan sistem.",
                        );
                        button.innerHTML = originalHtml;
                        button.disabled = false;
                    }
                }
            });
        });
    });
</script>

