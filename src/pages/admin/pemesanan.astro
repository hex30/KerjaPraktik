---
// File: src/pages/admin/pemesanan.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import BookingTable from "../../components/admin/features/booking/BookingTable.astro";

// Mock Data
const ruteData = [
    {
        id: "R-001",
        user: { name: "Fahri Ramdhani", phone: "0812-3456-7890" },
        origin: "Ciamis",
        destination: "Jakarta",
        date: "25 Juni 2026",
        time: "09:00 WIB",
        status: "PENDING"
    },
    {
        id: "R-002",
        user: { name: "Siti Aminah", phone: "0852-1122-3344" },
        origin: "Jakarta",
        destination: "Panawangan",
        date: "26 Juni 2026",
        time: "20:00 WIB",
        status: "WAITING_PAYMENT"
    }
];

const charterData = [
    {
        id: "C-001",
        user: { name: "PT Global Tech", phone: "021-998877" },
        origin: "Ciamis",
        destination: "Bandung (City Tour)",
        date: "30 Juni 2026",
        fleet: "Toyota Hiace Commuter",
        status: "PENDING"
    }
];
---

<AdminLayout title="Manajemen Pemesanan">
    <div class="flex flex-col gap-12">
        
        <!-- Bagian Rute -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Tiket Perjalanan Rute</h2>
                    <p class="text-xs text-slate-400 font-secondary mt-1">Daftar pemesanan tiket antar kota rutin.</p>
                </div>
                <div class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-[10px] font-bold text-slate-400">
                    TOTAL: {ruteData.length} Antrean
                </div>
            </div>
            
            <BookingTable type="RUTE" data={ruteData} />
        </section>

        <!-- Bagian Booking/Charter -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Booking Armada (Charter)</h2>
                    <p class="text-xs text-slate-400 font-secondary mt-1">Daftar pemesanan sewa satu unit mobil utuh.</p>
                </div>
                <div class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-[10px] font-bold text-slate-400">
                    TOTAL: {charterData.length} Antrean
                </div>
            </div>
            
            <BookingTable type="CHARTER" data={charterData} />
        </section>

    </div>
</AdminLayout>
