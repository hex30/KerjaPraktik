---
// File: src/pages/admin/finance.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import StatCard from "@features/admin/dashboard/StatCard.astro";

import AdminPageHeader from "@features/admin/shared/AdminPageHeader.astro";

// Data Keuangan Dinamis (Server-Side)
const token = Astro.cookies.get("token")?.value;
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:5000";
const headers = { Authorization: `Bearer ${token}` };

let summary = {
    total_income: 0,
    today_income: 0,
    last_month_income: 0,
    last_month_expense: 0,
    driver_salary: 0,
    total_expense: 0,
    today_expense: 0,
    this_year_income: 0,
    this_year_expense: 0,
};
let transactions = [];

try {
    const [sumRes, txRes] = await Promise.all([
        fetch(`${API_BASE}/api/admin/cashflow/summary?filter=monthly`, {
            headers,
        }),
        fetch(`${API_BASE}/api/admin/cashflow/transactions?limit=200`, {
            headers,
        }),
    ]);

    if (sumRes.ok) summary = (await sumRes.json()).data;
    if (txRes.ok) {
        const allTx = (await txRes.json()).data || [];
        transactions = allTx.filter((t: any) => t.type === "income");
    }
} catch (e) {
    console.error("Failed to load finance data:", e);
}

// Formatting Helper
const mockExpenseLastMonth = summary.last_month_expense || 0;

// Hitung growth
let growth = 0;
if (summary.last_month_income > 0) {
    growth =
        ((summary.total_income - summary.last_month_income) /
            summary.last_month_income) *
        100;
}
---

<AdminLayout title="Ringkasan Laporan">
    <div
        id="finance-summary-data"
        data-summary={JSON.stringify(summary)}
        class="hidden"
    >
    </div>
    <div class="flex flex-col gap-10">
        <!-- HEADER PAGE -->
        <AdminPageHeader 
            title="Ringkasan Laporan"
            description="Informasi menyeluruh performa keuangan dan alokasi hasil supir."
        >

            <!-- Download Button Dropdown Container -->
            <div
                class="relative inline-block text-left"
                id="download-dropdown-container"
            >
                <button
                    type="button"
                    id="download-report-btn"
                    class="inline-flex items-center gap-2 bg-[#044751] hover:bg-[#03363e] text-white px-6 py-3.5 rounded-2xl font-black text-xs uppercase tracking-widest shadow-lg shadow-[#044751]/20 active:scale-95 transition-all"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                        ></path>
                    </svg>
                    Download Laporan
                </button>

                <!-- Dropdown Menu Options -->
                <div
                    id="download-options-menu"
                    class="hidden absolute right-0 mt-3 w-56 rounded-2xl bg-white border border-slate-100 shadow-xl overflow-hidden z-30 transform origin-top-right scale-95 opacity-0 transition-all duration-200"
                >
                    <div class="py-1 divide-y divide-slate-50">
                        <button
                            type="button"
                            data-format="pdf"
                            class="download-option-btn w-full flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-[#044751] transition-all"
                        >
                            <span class="p-1 bg-red-50 text-red-500 rounded-lg">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </span>
                            Dokumen PDF (.pdf)
                        </button>
                        <button
                            type="button"
                            data-format="excel"
                            class="download-option-btn w-full flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-[#044751] transition-all"
                        >
                            <span
                                class="p-1 bg-emerald-50 text-emerald-500 rounded-lg"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-4 w-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                    ></path>
                                </svg>
                            </span>
                            Spreadsheet Excel (.xlsx)
                        </button>
                    </div>
                </div>
            </div>
        </AdminPageHeader>

        <!-- PANEL FILTER PERIODE -->
        <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row items-end md:items-center justify-between gap-4 max-w-6xl">
            <div class="flex flex-col md:flex-row items-center gap-4 w-full md:w-auto">
                <div class="flex flex-col gap-1 w-full md:w-48">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Pilih Rentang Waktu</label>
                    <select
                        id="dashboard-filter-preset"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer w-full"
                    >
                        <option value="monthly">Bulan Ini</option>
                        <option value="today">Hari Ini</option>
                        <option value="weekly">Minggu Ini</option>
                        <option value="yearly">Tahun Ini</option>
                        <option value="specific-date">Tanggal Tertentu</option>
                        <option value="custom-range">Rentang Tanggal</option>
                    </select>
                </div>

                <!-- Input Tanggal Tertentu (Sembunyikan default) -->
                <div id="wrapper-specific-date" class="hidden flex-col gap-1 w-full md:w-48">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Pilih Tanggal</label>
                    <input
                        type="date"
                        id="filter-single-date"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer w-full"
                    />
                </div>

                <!-- Input Rentang Tanggal (Sembunyikan default) -->
                <div id="wrapper-range-date-start" class="hidden flex-col gap-1 w-full md:w-48">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Tanggal Mulai</label>
                    <input
                        type="date"
                        id="filter-start-date"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer w-full"
                    />
                </div>
                <div id="wrapper-range-date-end" class="hidden flex-col gap-1 w-full md:w-48">
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Tanggal Selesai</label>
                    <input
                        type="date"
                        id="filter-end-date"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2 text-xs font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer w-full"
                    />
                </div>
            </div>

            <div class="w-full md:w-auto">
                <button
                    type="button"
                    id="btn-apply-period-filter"
                    class="bg-[#044751] hover:bg-[#03363e] text-white px-6 py-3 rounded-xl font-black text-xs uppercase tracking-widest shadow-md shadow-primary/10 active:scale-95 transition-all w-full md:w-auto"
                >
                    Terapkan Filter
                </button>
            </div>
        </div>

        <!-- SUMMARY STATS -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-6xl">
            <!-- 1. Gaji Supir Hari Ini (2x2) -->
            <div
                class="bg-primary p-8 rounded-2xl text-white flex flex-col justify-between shadow-lg shadow-primary/20 md:col-span-2 md:row-span-2 h-full min-h-[280px]"
            >
                <div>
                    <span
                        class="text-[9px] font-black uppercase tracking-widest text-white/60"
                        >Estimasi Alokasi</span
                    >
                    <h3 class="text-lg font-black mt-1" id="stat-driver-salary-title">
                        Gaji Supir Bulan Ini (40%)
                    </h3>
                </div>
                <div class="mt-4">
                    <span class="text-2xl font-black" id="stat-driver-salary"
                        >Rp {
                            (summary.total_income * 0.4).toLocaleString("id-ID")
                        }</span
                    >
                    <p class="text-[10px] text-white/70 mt-1">
                        * 40% dari total pendapatan armada periode ini
                    </p>
                </div>
            </div>

            <!-- 2. Pemasukan Bulan Ini (1x1) -->
            <div class="h-full" id="card-current-income">
                <StatCard
                    title="Pemasukan Bulan Ini"
                    value={`Rp ${summary.total_income.toLocaleString("id-ID")}`}
                    icon={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`}
                    color="emerald"
                    trend={{
                        value: `${Math.abs(growth).toFixed(1)}%`,
                        isUp: growth >= 0,
                    }}
                />
            </div>

            <!-- 3. Pemasukan Bulan Lalu (1x1) -->
            <div class="h-full" id="card-last-income">
                <StatCard
                    title="Pemasukan Bulan Lalu"
                    value={`Rp ${summary.last_month_income.toLocaleString("id-ID")}`}
                    icon={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`}
                    color="amber"
                />
            </div>

            <!-- 4. Pengeluaran Bulan Ini (1x1) -->
            <div class="h-full" id="card-current-expense">
                <StatCard
                    title="Pengeluaran Bulan Ini"
                    value={`Rp ${summary.total_expense.toLocaleString("id-ID")}`}
                    icon={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`}
                    color="rose"
                />
            </div>

            <!-- 5. Pengeluaran Bulan Lalu (1x1) -->
            <div class="h-full" id="card-last-expense">
                <StatCard
                    title="Pengeluaran Bulan Lalu"
                    value={`Rp ${mockExpenseLastMonth.toLocaleString("id-ID")}`}
                    icon={`<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`}
                    color="rose"
                />
            </div>
        </section>

        <!-- RIWAYAT TRANSAKSI -->
        <section
            class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col gap-6"
        >
            <div
                class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6"
            >
                <div>
                    <h2 class="text-xl font-black text-slate-900">
                        Riwayat Transaksi
                    </h2>
                    <p class="text-xs text-slate-400 mt-1">
                        Menampilkan catatan kas masuk dan kas keluar
                        operasional.
                    </p>
                </div>

                <!-- Filter Section -->
                <div class="flex flex-wrap items-center gap-3">
                    <select
                        id="tx-filter-service"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer"
                    >
                        <option value="ALL">Semua Layanan</option>
                        <option value="Travel Reguler">Travel Reguler</option>
                        <option value="Sewa Charter">Sewa Charter</option>
                        <option value="Pengiriman Paket"
                            >Pengiriman Paket</option
                        >
                    </select>
                    <input
                        type="date"
                        id="tx-filter-date"
                        class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer"
                    />
                    <button
                        type="button"
                        id="tx-btn-apply"
                        class="bg-[#044751] hover:bg-[#03363e] text-white px-5 py-2.5 rounded-xl font-black text-xs uppercase tracking-widest shadow-md shadow-primary/20 hover:scale-105 active:scale-95 transition-all"
                    >
                        Terapkan
                    </button>
                    <button
                        type="button"
                        id="tx-btn-reset"
                        class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-5 py-2.5 rounded-xl font-black text-xs uppercase tracking-widest transition-all"
                    >
                        Reset
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[750px]">
                    <thead>
                        <tr
                            class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-100 pb-4 whitespace-nowrap"
                        >
                            <th class="pb-4 px-4">ID Transaksi</th>
                            <th class="pb-4 px-4">Tanggal</th>
                            <th class="pb-4 px-4">Metode Pembayaran</th>
                            <th class="pb-4 px-4">Jenis Layanan</th>
                            <th class="pb-4 px-4">Keterangan</th>
                            <th class="pb-4 px-4 text-right">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50" id="tx-table-body">
                        {
                            transactions.length === 0 ? (
                                <tr class="text-center py-10">
                                    <td
                                        colspan="6"
                                        class="py-10 text-slate-400 text-sm font-secondary"
                                    >
                                        Belum ada transaksi.
                                    </td>
                                </tr>
                            ) : (
                                transactions.map((tx: any, index: number) => {
                                    // Determine Service Type / Kategori Layanan
                                    let serviceType = "Operasional";
                                    const categoryLower =
                                        (tx.category || "").toLowerCase();
                                    if (
                                        categoryLower.includes("charter") ||
                                        categoryLower.includes("sewa")
                                    ) {
                                        serviceType = "Sewa Charter";
                                    } else if (
                                        categoryLower.includes("travel") ||
                                        categoryLower.includes("rute") ||
                                        categoryLower.includes("ticket")
                                    ) {
                                        serviceType = "Travel Reguler";
                                    } else if (
                                        categoryLower.includes("package") ||
                                        categoryLower.includes("shipment") ||
                                        categoryLower.includes("paket")
                                    ) {
                                        serviceType = "Pengiriman Paket";
                                    } else if (
                                        categoryLower.includes("expense") ||
                                        categoryLower.includes("pengeluaran")
                                    ) {
                                        serviceType = "Operasional";
                                    }

                                    return (
                                        <tr
                                            class={`group hover:bg-slate-50/50 transition-all duration-300 whitespace-nowrap md:whitespace-normal tx-row ${index >= 5 ? "hidden opacity-0 max-h-0" : "opacity-100"}`}
                                            data-service-type={serviceType}
                                            data-date={tx.created_at || ""}
                                        >
                                            <td class="py-4 px-4 font-bold text-slate-900 text-sm">
                                                #
                                                {tx.id
                                                    .substring(0, 8)
                                                    .toUpperCase()}
                                            </td>
                                            <td class="py-4 px-4 text-xs text-slate-500">
                                                {new Date(
                                                    tx.created_at,
                                                ).toLocaleDateString("id-ID", {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric",
                                                })}
                                            </td>
                                            <td class="py-4 px-4">
                                                <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-700 font-bold rounded-lg text-[10px] uppercase">
                                                    {tx.payment_method
                                                        ? tx.payment_method.toUpperCase()
                                                        : "TRANSFER"}
                                                </span>
                                            </td>
                                            <td class="py-4 px-4">
                                                <span
                                                    class={`inline-flex px-2.5 py-1 font-bold rounded-lg text-[10px] uppercase ${
                                                        serviceType ===
                                                        "Travel Reguler"
                                                            ? "bg-sky-50 text-sky-600"
                                                            : serviceType ===
                                                                "Sewa Charter"
                                                              ? "bg-indigo-50 text-indigo-600"
                                                              : serviceType ===
                                                                  "Pengiriman Paket"
                                                                ? "bg-amber-50 text-amber-600"
                                                                : "bg-slate-100 text-slate-600"
                                                    }`}
                                                >
                                                    {serviceType}
                                                </span>
                                            </td>
                                            <td
                                                class="py-4 px-4 text-sm font-medium text-slate-700 max-w-xs truncate"
                                                title={tx.description}
                                            >
                                                {tx.description || "-"}
                                            </td>
                                            <td
                                                class={`py-4 px-4 text-right font-main font-black ${tx.type === "income" ? "text-emerald-600" : "text-rose-600"}`}
                                            >
                                                {tx.type === "income"
                                                    ? "+"
                                                    : "-"}{" "}
                                                Rp{" "}
                                                {Number(
                                                    tx.amount,
                                                ).toLocaleString("id-ID")}
                                            </td>
                                        </tr>
                                    );
                                })
                            )
                        }
                    </tbody>
                </table>
            </div>

            {
                transactions.length > 5 && (
                    <div class="mt-6 flex justify-center border-t border-slate-50 pt-6">
                        <button
                            id="toggle-tx-expand"
                            class="text-xs font-black uppercase tracking-widest text-primary bg-primary/5 px-8 py-3.5 rounded-xl hover:bg-primary hover:text-white active:scale-95 transition-all shadow-sm"
                        >
                            Lihat Seluruh Data Bulan Ini
                        </button>
                    </div>
                )
            }
        </section>
    </div>
</AdminLayout>

<script>
    let activeStartDate = "";
    let activeEndDate = "";

    const serviceTypeMap = (category: string) => {
        let serviceType = "Operasional";
        const categoryLower = (category || "").toLowerCase();
        if (
            categoryLower.includes("charter") ||
            categoryLower.includes("sewa")
        ) {
            serviceType = "Sewa Charter";
        } else if (
            categoryLower.includes("travel") ||
            categoryLower.includes("rute") ||
            categoryLower.includes("ticket")
        ) {
            serviceType = "Travel Reguler";
        } else if (
            categoryLower.includes("package") ||
            categoryLower.includes("shipment") ||
            categoryLower.includes("paket")
        ) {
            serviceType = "Pengiriman Paket";
        } else if (
            categoryLower.includes("expense") ||
            categoryLower.includes("pengeluaran")
        ) {
            serviceType = "Operasional";
        }
        return serviceType;
    };

    const updateTransactionTable = (txList: any[]) => {
        const tableBody = document.getElementById("tx-table-body");
        if (!tableBody) return;

        // Filter type === 'income' to match original SSR table behavior
        const incomes = txList.filter((t: any) => t.type === "income");

        if (incomes.length === 0) {
            tableBody.innerHTML = `
                <tr class="text-center py-10">
                    <td colspan="6" class="py-10 text-slate-400 text-sm font-secondary">
                        Belum ada transaksi pada periode ini.
                    </td>
                </tr>
            `;
            // Hide expand button
            const toggleBtn = document.getElementById("toggle-tx-expand");
            if (toggleBtn) toggleBtn.style.display = "none";
            return;
        }

        let rowsHtml = "";
        incomes.forEach((tx: any, index: number) => {
            const serviceType = serviceTypeMap(tx.category);
            const txId = "#" + tx.id.substring(0, 8).toUpperCase();
            const txDate = new Date(tx.created_at).toLocaleDateString("id-ID", {
                day: "numeric",
                month: "short",
                year: "numeric",
            });
            const method = (tx.payment_method || "TRANSFER").toUpperCase();
            const amountFormatted = Number(tx.amount).toLocaleString("id-ID");
            const isHidden = index >= 5 ? "hidden opacity-0 max-h-0" : "opacity-100";

            let serviceBadgeClass = "bg-slate-100 text-slate-600";
            if (serviceType === "Travel Reguler") {
                serviceBadgeClass = "bg-sky-50 text-sky-600";
            } else if (serviceType === "Sewa Charter") {
                serviceBadgeClass = "bg-indigo-50 text-indigo-600";
            } else if (serviceType === "Pengiriman Paket") {
                serviceBadgeClass = "bg-amber-50 text-amber-600";
            }

            rowsHtml += `
                <tr
                    class="group hover:bg-slate-50/50 transition-all duration-300 whitespace-nowrap md:whitespace-normal tx-row ${isHidden}"
                    data-service-type="${serviceType}"
                    data-date="${tx.created_at || ""}"
                >
                    <td class="py-4 px-4 font-bold text-slate-900 text-sm">
                        ${txId}
                    </td>
                    <td class="py-4 px-4 text-xs text-slate-500">
                        ${txDate}
                    </td>
                    <td class="py-4 px-4">
                        <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-700 font-bold rounded-lg text-[10px] uppercase">
                            ${method}
                        </span>
                    </td>
                    <td class="py-4 px-4">
                        <span class="inline-flex px-2.5 py-1 font-bold rounded-lg text-[10px] uppercase ${serviceBadgeClass}">
                            ${serviceType}
                        </span>
                    </td>
                    <td class="py-4 px-4 text-sm font-medium text-slate-700 max-w-xs truncate" title="${tx.description || ""}">
                        ${tx.description || "-"}
                    </td>
                    <td class="py-4 px-4 text-right font-main font-black text-emerald-600">
                        + Rp ${amountFormatted}
                    </td>
                </tr>
            `;
        });

        tableBody.innerHTML = rowsHtml;

        // Show or hide expand button depending on count
        const toggleBtn = document.getElementById("toggle-tx-expand");
        if (toggleBtn) {
            if (incomes.length > 5) {
                toggleBtn.style.display = "flex";
                toggleBtn.textContent = "Lihat Seluruh Data Periode Ini";
            } else {
                toggleBtn.style.display = "none";
            }
        }
    };

    const setupDashboardPeriodFilter = () => {
        const presetSelect = document.getElementById("dashboard-filter-preset") as HTMLSelectElement;
        const btnApply = document.getElementById("btn-apply-period-filter");
        
        const wrapperSpecific = document.getElementById("wrapper-specific-date");
        const wrapperRangeStart = document.getElementById("wrapper-range-date-start");
        const wrapperRangeEnd = document.getElementById("wrapper-range-date-end");

        const inputSingle = document.getElementById("filter-single-date") as HTMLInputElement;
        const inputStart = document.getElementById("filter-start-date") as HTMLInputElement;
        const inputEnd = document.getElementById("filter-end-date") as HTMLInputElement;

        if (!presetSelect || !btnApply) return;

        presetSelect.addEventListener("change", () => {
            const val = presetSelect.value;
            if (val === "specific-date") {
                wrapperSpecific?.classList.remove("hidden");
                wrapperSpecific?.classList.add("flex");
                wrapperRangeStart?.classList.add("hidden");
                wrapperRangeStart?.classList.remove("flex");
                wrapperRangeEnd?.classList.add("hidden");
                wrapperRangeEnd?.classList.remove("flex");
            } else if (val === "custom-range") {
                wrapperSpecific?.classList.add("hidden");
                wrapperSpecific?.classList.remove("flex");
                wrapperRangeStart?.classList.remove("hidden");
                wrapperRangeStart?.classList.add("flex");
                wrapperRangeEnd?.classList.remove("hidden");
                wrapperRangeEnd?.classList.add("flex");
            } else {
                wrapperSpecific?.classList.add("hidden");
                wrapperSpecific?.classList.remove("flex");
                wrapperRangeStart?.classList.add("hidden");
                wrapperRangeStart?.classList.remove("flex");
                wrapperRangeEnd?.classList.add("hidden");
                wrapperRangeEnd?.classList.remove("flex");
            }
        });

        // Set default dates for single and range inputs
        const todayStr = new Date().toISOString().slice(0, 10);
        if (inputSingle) inputSingle.value = todayStr;
        if (inputStart) inputStart.value = todayStr;
        if (inputEnd) inputEnd.value = todayStr;

        btnApply.addEventListener("click", async () => {
            const token = document.cookie
                .split("; ")
                .find((row) => row.startsWith("token="))
                ?.split("=")[1];
            const API_BASE =
                import.meta.env.PUBLIC_API_URL || "http://localhost:5000";

            const preset = presetSelect.value;
            let startDate = "";
            let endDate = "";

            const formatDate = (date: Date) => {
                return date.getFullYear() + '-' + 
                    String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                    String(date.getDate()).padStart(2, '0');
            };

            if (preset === "specific-date") {
                if (!inputSingle.value) {
                    alert("Pilih tanggal terlebih dahulu!");
                    return;
                }
                startDate = inputSingle.value;
                endDate = startDate;
            } else if (preset === "custom-range") {
                if (!inputStart.value || !inputEnd.value) {
                    alert("Pilih tanggal mulai dan selesai terlebih dahulu!");
                    return;
                }
                if (new Date(inputStart.value) > new Date(inputEnd.value)) {
                    alert("Tanggal mulai tidak boleh melebihi tanggal selesai!");
                    return;
                }
                startDate = inputStart.value;
                endDate = inputEnd.value;
            } else {
                // Preset today, weekly, monthly, yearly
                const today = new Date();
                endDate = formatDate(today);

                if (preset === "today") {
                    startDate = endDate;
                } else if (preset === "weekly") {
                    const start = new Date(today);
                    start.setDate(today.getDate() - 6);
                    startDate = formatDate(start);
                } else if (preset === "monthly") {
                    const start = new Date(today.getFullYear(), today.getMonth(), 1);
                    startDate = formatDate(start);
                    const end = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                    endDate = formatDate(end);
                } else if (preset === "yearly") {
                    const start = new Date(today.getFullYear(), 0, 1);
                    startDate = formatDate(start);
                    const end = new Date(today.getFullYear(), 11, 31);
                    endDate = formatDate(end);
                }
            }

            // Save active range
            activeStartDate = startDate;
            activeEndDate = endDate;

            try {
                btnApply.setAttribute("disabled", "true");
                btnApply.textContent = "Loading...";

                // Fetch new summary and transactions
                const [sumRes, txRes] = await Promise.all([
                    fetch(`${API_BASE}/api/admin/cashflow/summary?startDate=${startDate}&endDate=${endDate}`, {
                        headers: { Authorization: `Bearer ${token}` }
                    }),
                    fetch(`${API_BASE}/api/admin/cashflow/transactions?limit=1000&startDate=${startDate}&endDate=${endDate}`, {
                        headers: { Authorization: `Bearer ${token}` }
                    })
                ]);

                if (!sumRes.ok || !txRes.ok) {
                    throw new Error("Gagal mengambil data dari server");
                }

                const sumData = (await sumRes.json()).data;
                const txData = (await txRes.json()).data || [];

                // 1. Update finance-summary-data element attribute
                const summaryEl = document.getElementById("finance-summary-data");
                if (summaryEl) {
                    summaryEl.setAttribute("data-summary", JSON.stringify(sumData));
                }

                // 2. Update Stats Cards titles and values
                let periodTitle = "Bulan Ini";
                let prevPeriodTitle = "Bulan Lalu";
                if (preset === "today") {
                    periodTitle = "Hari Ini";
                    prevPeriodTitle = "Kemarin";
                } else if (preset === "weekly") {
                    periodTitle = "Minggu Ini";
                    prevPeriodTitle = "Minggu Lalu";
                } else if (preset === "yearly") {
                    periodTitle = "Tahun Ini";
                    prevPeriodTitle = "Tahun Lalu";
                } else if (preset === "specific-date" || preset === "custom-range") {
                    periodTitle = "Periode Ini";
                    prevPeriodTitle = "Periode Lalu";
                }

                // Update Driver Salary Card
                const driverSalaryVal = sumData.total_income * 0.4;
                const driverSalaryTitleEl = document.getElementById("stat-driver-salary-title");
                if (driverSalaryTitleEl) {
                    driverSalaryTitleEl.textContent = `Gaji Supir ${periodTitle} (40%)`;
                }
                const driverSalaryValEl = document.getElementById("stat-driver-salary");
                if (driverSalaryValEl) {
                    driverSalaryValEl.textContent = `Rp ${driverSalaryVal.toLocaleString("id-ID")}`;
                }

                // Helper to update card value and title
                const updateCard = (cardId: string, title: string, val: number) => {
                    const card = document.getElementById(cardId);
                    if (card) {
                        const titleEl = card.querySelector("p");
                        const valEl = card.querySelector("h3");
                        if (titleEl) titleEl.textContent = title;
                        if (valEl) valEl.textContent = `Rp ${val.toLocaleString("id-ID")}`;
                    }
                };

                updateCard("card-current-income", `Pemasukan ${periodTitle}`, sumData.total_income);
                updateCard("card-last-income", `Pemasukan ${prevPeriodTitle}`, sumData.last_month_income);
                updateCard("card-current-expense", `Pengeluaran ${periodTitle}`, sumData.total_expense);
                updateCard("card-last-expense", `Pengeluaran ${prevPeriodTitle}`, sumData.last_month_expense);

                // Update Trend growth percentage in Current Income Card
                const trendSpan = document.querySelector("#card-current-income span.text-xs");
                if (trendSpan) {
                    let growth = 0;
                    if (sumData.last_month_income > 0) {
                        growth = ((sumData.total_income - sumData.last_month_income) / sumData.last_month_income) * 100;
                    }
                    trendSpan.className = `text-xs font-bold px-2 py-1 rounded-full ${growth >= 0 ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600"}`;
                    trendSpan.innerHTML = `${growth >= 0 ? "↑" : "↓"} ${Math.abs(growth).toFixed(1)}%`;
                }

                // 3. Update Transaction Table
                updateTransactionTable(txData);

            } catch (error: any) {
                (window as any).showFeedbackModal(
                    "error",
                    "Gagal",
                    "Gagal memproses filter: " + error.message
                );
            } finally {
                btnApply.removeAttribute("disabled");
                btnApply.textContent = "Terapkan Filter";
            }
        });
    };

    const setupTransactionToggle = () => {
        const toggleBtn = document.getElementById("toggle-tx-expand");
        let isExpanded = false;

        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                isExpanded = !isExpanded;
                const rows = document.querySelectorAll(".tx-row");

                rows.forEach((row, index) => {
                    if (index >= 5) {
                        if (isExpanded) {
                            row.classList.remove("hidden");
                            setTimeout(() => {
                                row.classList.remove("opacity-0", "max-h-0");
                                row.classList.add("opacity-100");
                            }, 50);
                        } else {
                            row.classList.add("opacity-0", "max-h-0");
                            setTimeout(() => {
                                row.classList.add("hidden");
                            }, 300);
                        }
                    }
                });

                toggleBtn.textContent = isExpanded
                    ? "Tutup Data Lengkap"
                    : "Lihat Seluruh Data Periode Ini";
            });
        }
    };

    const setupDownloadDropdown = () => {
        const btn = document.getElementById("download-report-btn");
        const menu = document.getElementById("download-options-menu");

        if (btn && menu) {
            const toggleMenu = (show: boolean) => {
                if (show) {
                    menu.classList.remove("hidden");
                    setTimeout(() => {
                        menu.classList.remove("scale-95", "opacity-0");
                        menu.classList.add("scale-100", "opacity-100");
                    }, 10);
                } else {
                    menu.classList.remove("scale-100", "opacity-100");
                    menu.classList.add("scale-95", "opacity-0");
                    setTimeout(() => {
                        menu.classList.add("hidden");
                    }, 150);
                }
            };

            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                const isHidden = menu.classList.contains("hidden");
                toggleMenu(isHidden);
            });

            document.addEventListener("click", () => {
                if (!menu.classList.contains("hidden")) {
                    toggleMenu(false);
                }
            });

            menu.addEventListener("click", (e) => {
                e.stopPropagation();
            });

            const downloadReport = async (format: string) => {
                const token = document.cookie
                    .split("; ")
                    .find((row) => row.startsWith("token="))
                    ?.split("=")[1];
                const API_BASE =
                    import.meta.env.PUBLIC_API_URL || "http://localhost:5000";
                const downloadBtn = document.getElementById(
                    "download-report-btn",
                );
                const originalContent = downloadBtn?.innerHTML;

                try {
                    if (downloadBtn) {
                        downloadBtn.setAttribute("disabled", "true");
                        downloadBtn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Memproses...`;
                    }

                    // Ambil seluruh data transaksi sesuai filter aktif
                    let url = `${API_BASE}/api/admin/cashflow/transactions?limit=1000`;
                    if (activeStartDate && activeEndDate) {
                        url += `&startDate=${activeStartDate}&endDate=${activeEndDate}`;
                    }
                    const txRes = await fetch(url, {
                        headers: { Authorization: `Bearer ${token}` },
                    });

                    if (!txRes.ok)
                        throw new Error("Gagal mengambil data transaksi");
                    const allTx = (await txRes.json()).data || [];

                    // Ambil summary dari DOM
                    const summaryDataEl = document.getElementById(
                        "finance-summary-data",
                    );
                    const summary = summaryDataEl
                        ? JSON.parse(
                              summaryDataEl.getAttribute("data-summary") ||
                                  "{}",
                          )
                        : {};

                    if (format === "excel") {
                        // EXPORT EXCEL (CSV)
                        let csvContent = "\uFEFF"; // UTF-8 BOM
                        csvContent +=
                            "ID Transaksi,Tanggal,Metode Pembayaran,Jenis Layanan,Keterangan,Tipe,Jumlah (IDR)\n";

                        allTx.forEach((tx: any) => {
                            const serviceType = serviceTypeMap(tx.category);
                            const txId =
                                "#" + tx.id.substring(0, 8).toUpperCase();
                            const txDate = new Date(
                                tx.created_at,
                            ).toLocaleDateString("id-ID", {
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                            });
                            const method = (
                                tx.payment_method || "TRANSFER"
                            ).toUpperCase();
                            const desc = (tx.description || "-").replace(
                                /"/g,
                                '""',
                            );
                            const type =
                                tx.type === "income"
                                    ? "Pemasukan (+)"
                                    : "Pengeluaran (-)";
                            const amount = tx.amount;

                            csvContent += `"${txId}","${txDate}","${method}","${serviceType}","${desc}","${type}",${amount}\n`;
                        });

                        const blob = new Blob([csvContent], {
                            type: "text/csv;charset=utf-8;",
                        });
                        const url = URL.createObjectURL(blob);
                        const link = document.createElement("a");
                        link.setAttribute("href", url);

                        let filename = "laporan_keuangan";
                        if (activeStartDate && activeEndDate) {
                            filename += `_${activeStartDate}_ke_${activeEndDate}`;
                        } else {
                            filename += `_${new Date().toISOString().slice(0, 10)}`;
                        }

                        link.setAttribute(
                            "download",
                            `${filename}.csv`,
                        );
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    } else if (format === "pdf") {
                        // EXPORT PDF
                        const loadScript = (url: string) => {
                            return new Promise((resolve, reject) => {
                                const script = document.createElement("script");
                                script.src = url;
                                script.onload = resolve;
                                script.onerror = reject;
                                document.body.appendChild(script);
                            });
                        };

                        if (!(window as any).jspdf) {
                            await loadScript(
                                "https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js",
                            );
                        }
                        if (!(window as any).jspdf.plugin?.autotable) {
                            await loadScript(
                                "https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js",
                            );
                        }

                        const { jsPDF } = (window as any).jspdf;
                        const doc = new jsPDF();

                        doc.setFont("Helvetica", "bold");
                        doc.setFontSize(20);
                        doc.setTextColor(4, 71, 81); // Brand Primary
                        doc.text("LAPORAN KEUANGAN OPERASIONAL", 14, 22);

                        doc.setFontSize(12);
                        doc.setTextColor(100, 116, 139);
                        doc.text("PT. Rini Trans Putri", 14, 28);

                        // Format period text
                        let periodText = "Bulan Ini";
                        if (activeStartDate && activeEndDate) {
                            const formatIndo = (dStr: string) => {
                                const d = new Date(dStr);
                                return d.toLocaleDateString("id-ID", {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric"
                                });
                            };
                            periodText = `${formatIndo(activeStartDate)} s.d. ${formatIndo(activeEndDate)}`;
                        } else {
                            const today = new Date();
                            const start = new Date(today.getFullYear(), today.getMonth(), 1);
                            const formatIndo = (d: Date) => {
                                return d.toLocaleDateString("id-ID", {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric"
                                });
                            };
                            periodText = `${formatIndo(start)} s.d. ${formatIndo(today)}`;
                        }

                        doc.setFont("Helvetica", "normal");
                        doc.setFontSize(8);
                        doc.text(
                            `Periode: ${periodText} | Dicetak pada: ${new Date().toLocaleString("id-ID")}`,
                            14,
                            34,
                        );

                        doc.setDrawColor(226, 232, 240);
                        doc.line(14, 38, 196, 38);

                        doc.setFont("Helvetica", "bold");
                        doc.setFontSize(10);
                        doc.setTextColor(15, 23, 42);
                        doc.text("RINGKASAN PERIODE INI:", 14, 46);

                        doc.setFont("Helvetica", "normal");
                        doc.setFontSize(9);
                        doc.text(
                            `Total Pendapatan: Rp ${(summary.total_income || 0).toLocaleString("id-ID")}`,
                            14,
                            52,
                        );
                        doc.text(
                            `Total Pengeluaran: Rp ${(summary.total_expense || 0).toLocaleString("id-ID")}`,
                            14,
                            57,
                        );

                        const netProfit =
                            (summary.total_income || 0) -
                            (summary.total_expense || 0);
                        doc.setFont("Helvetica", "bold");
                        doc.text(
                            `Laba Bersih (Net Profit): Rp ${netProfit.toLocaleString("id-ID")}`,
                            14,
                            63,
                        );

                        const tableRows = allTx.map((tx: any) => {
                            const serviceType = serviceTypeMap(tx.category);
                            const txId =
                                "#" + tx.id.substring(0, 8).toUpperCase();
                            const txDate = new Date(
                                tx.created_at,
                            ).toLocaleDateString("id-ID", {
                                day: "numeric",
                                month: "short",
                                year: "numeric",
                            });
                            const method = (
                                tx.payment_method || "TRANSFER"
                            ).toUpperCase();
                            const amountFormatted = `Rp ${Number(tx.amount).toLocaleString("id-ID")}`;
                            const displayAmount =
                                tx.type === "income"
                                    ? `+ ${amountFormatted}`
                                    : `- ${amountFormatted}`;

                            return [
                                txId,
                                txDate,
                                method,
                                serviceType,
                                tx.description || "-",
                                displayAmount,
                            ];
                        });

                        (doc as any).autoTable({
                            startY: 70,
                            head: [
                                [
                                    "ID Transaksi",
                                    "Tanggal",
                                    "Metode",
                                    "Layanan",
                                    "Keterangan",
                                    "Jumlah",
                                ],
                            ],
                            body: tableRows,
                            theme: "striped",
                            headStyles: { fillColor: [4, 71, 81] },
                            styles: { fontSize: 8, font: "Helvetica" },
                            columnStyles: { 5: { halign: "right" } },
                        });

                        let pdfFilename = "laporan_keuangan";
                        if (activeStartDate && activeEndDate) {
                            pdfFilename += `_${activeStartDate}_ke_${activeEndDate}`;
                        } else {
                            pdfFilename += `_${new Date().toISOString().slice(0, 10)}`;
                        }

                        doc.save(
                            `${pdfFilename}.pdf`,
                        );
                    }

                    if (downloadBtn && originalContent) {
                        downloadBtn.removeAttribute("disabled");
                        downloadBtn.innerHTML = originalContent;
                    }
                } catch (error: any) {
                    (window as any).showFeedbackModal(
                        "error",
                        "Gagal",
                        "Gagal mengunduh laporan: " + error.message,
                    );
                    if (downloadBtn && originalContent) {
                        downloadBtn.removeAttribute("disabled");
                        downloadBtn.innerHTML = originalContent;
                    }
                }
            };

            document
                .querySelectorAll(".download-option-btn")
                .forEach((option) => {
                    option.addEventListener("click", (e) => {
                        const format = (e.currentTarget as HTMLButtonElement)
                            .dataset.format;
                        if (format) downloadReport(format);
                        toggleMenu(false);
                    });
                });
        }
    };

    const setupTransactionFilter = () => {
        const btnApply = document.getElementById("tx-btn-apply");
        const btnReset = document.getElementById("tx-btn-reset");
        const selectService = document.getElementById(
            "tx-filter-service",
        ) as HTMLSelectElement;
        const inputDate = document.getElementById(
            "tx-filter-date",
        ) as HTMLInputElement;
        const toggleBtn = document.getElementById("toggle-tx-expand");
        const toggleText = document.getElementById("toggle-tx-text");
        const toggleIcon = document.getElementById("toggle-tx-icon");

        if (!btnApply || !btnReset) return;

        btnApply.addEventListener("click", () => {
            const svc = selectService.value;
            const dt = inputDate.value;
            const txRows = document.querySelectorAll(".tx-row");

            // Sembunyikan tombol toggle karena sedang mode pencarian (tampilkan semua match)
            if (toggleBtn) toggleBtn.style.display = "none";

            txRows.forEach((row) => {
                const rowSvc = row.getAttribute("data-service-type");
                const rawDt = row.getAttribute("data-date");

                let match = true;
                const normalizedSvc = svc.trim().toLowerCase();
                const normalizedRowSvc = (rowSvc || "").trim().toLowerCase();

                if (svc !== "ALL" && normalizedRowSvc !== normalizedSvc)
                    match = false;

                if (dt && rawDt) {
                    try {
                        const d = new Date(rawDt);
                        const localRowDt = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
                        if (localRowDt !== dt) match = false;
                    } catch (e) {
                        if (!rawDt.includes(dt)) match = false;
                    }
                } else if (dt && !rawDt) {
                    match = false;
                }

                if (match) {
                    row.classList.remove("hidden", "opacity-0", "max-h-0");
                    row.classList.add("opacity-100");
                } else {
                    row.classList.add("hidden", "opacity-0", "max-h-0");
                    row.classList.remove("opacity-100");
                }
            });
        });

        btnReset.addEventListener("click", () => {
            selectService.value = "ALL";
            inputDate.value = "";
            const txRows = document.querySelectorAll(".tx-row");

            if (toggleBtn) {
                toggleBtn.style.display = "flex";
                if (toggleText)
                    toggleText.textContent = "Lihat Semua Transaksi";
                if (toggleIcon) toggleIcon.classList.remove("rotate-180");
            }

            txRows.forEach((row, idx) => {
                if (idx < 5) {
                    row.classList.remove("hidden", "opacity-0", "max-h-0");
                    row.classList.add("opacity-100");
                } else {
                    row.classList.add("hidden", "opacity-0", "max-h-0");
                    row.classList.remove("opacity-100");
                }
            });
        });
    };

    setupTransactionToggle();
    setupDownloadDropdown();
    setupTransactionFilter();
    setupDashboardPeriodFilter();

    document.addEventListener("astro:page-load", () => {
        setupTransactionToggle();
        setupDownloadDropdown();
        setupTransactionFilter();
        setupDashboardPeriodFilter();
    });
</script>
