---
// File: src/pages/admin/finance.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import StatCard from "../../components/features/admin/dashboard/StatCard.astro";

// Mock Data Keuangan
const financialSummary = [
    {
        title: "Total Pendapatan (Bulan Ini)",
        value: "Rp 124.500.000",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        trend: { value: "15%", isUp: true },
        color: "emerald" as const
    },
    {
        title: "Pendapatan Hari Ini",
        value: "Rp 4.500.000",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75m0 3v.75m0 3v.75m0 3V15m15 0v.75m0 3v.75m0 3V18.75M6.75 4.5v.75m0 3v.75m0 3v.75m0 3V15m15 0v.75m0 3v.75m0 3V18.75m-15-15h15c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H4.5c-.621 0-1.125-.504-1.125-1.125V5.625c0-.621.504-1.125 1.125-1.125z" /></svg>`,
        color: "sky" as const
    }
];

const transactions = [
    { id: "TX-9901", date: "24 Mei 2026", user: "Fahri Ramdhani", category: "RUTE", amount: "250.000", method: "QRIS" },
    { id: "TX-9902", date: "24 Mei 2026", user: "PT Global Tech", category: "CHARTER", amount: "1.500.000", method: "VA MANDIRI" },
    { id: "TX-9903", date: "23 Mei 2026", user: "Febi Yulianti", category: "PAKET", amount: "85.000", method: "CASH" },
];
---

<AdminLayout title="Laporan Keuangan">
    <div class="flex flex-col gap-10">
        
        <!-- Filter & Actions -->
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex p-1 bg-slate-100 rounded-xl w-fit">
                {['Mingguan', 'Bulanan', 'Tahunan'].map(filter => (
                    <button class="px-6 py-2 rounded-lg text-xs font-bold transition-all hover:bg-white hover:shadow-sm focus:bg-white focus:shadow-sm">
                        {filter}
                    </button>
                ))}
            </div>
            <button class="text-xs font-bold text-primary bg-primary/5 px-6 py-3 rounded-xl hover:bg-primary hover:text-white transition-all">
                Download Laporan (PDF)
            </button>
        </div>

        <!-- Summary Cards -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {financialSummary.map(stat => (
                <StatCard {...stat} />
            ))}
            <!-- 40% Driver Salary Indicator -->
            <div class="bg-primary p-6 rounded-2xl text-white flex flex-col justify-between shadow-lg shadow-primary/20">
                <div>
                    <span class="text-[9px] font-black uppercase tracking-widest text-white/60">Estimasi Alokasi</span>
                    <h3 class="text-lg font-black mt-1">Gaji Supir (40%)</h3>
                </div>
                <div class="mt-4">
                    <span class="text-2xl font-black">Rp 49.800.000</span>
                    <p class="text-[10px] text-white/70 mt-1">* 40% dari total pendapatan armada</p>
                </div>
            </div>
            <!-- Projections -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                <div class="space-y-4">
                    <div class="flex flex-col gap-1">
                        <span class="text-[9px] font-black uppercase text-slate-400">Pajak Kendaraan (+1 Thn)</span>
                        <span class="text-xs font-bold text-rose-600">Jatuh Tempo: 12 Des 2026</span>
                    </div>
                    <div class="flex flex-col gap-1 border-t border-slate-50 pt-3">
                        <span class="text-[9px] font-black uppercase text-slate-400">Travel NIB (+5 Thn)</span>
                        <span class="text-xs font-bold text-sky-600">Perpanjang: Juni 2031</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Driver Expense Verification -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Verifikasi Pengeluaran Supir</h2>
                    <p class="text-xs text-slate-400 mt-1">ACC atau Tolak nota pengeluaran operasional supir.</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4 px-4">Supir</th>
                            <th class="pb-4 px-4">Item Pengeluaran</th>
                            <th class="pb-4 px-4">Jumlah</th>
                            <th class="pb-4 px-4">Nota</th>
                            <th class="pb-4 px-4 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {[
                            { name: "Agus Setiawan", item: "Bensin & Tol (Jakarta)", amount: "450.000", date: "24 Mei" },
                            { name: "Budi Santoso", item: "Ganti Oli & Service Ringan", amount: "850.000", date: "23 Mei" },
                        ].map((exp) => (
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="py-5 px-4 font-bold text-slate-900 text-sm">{exp.name}</td>
                                <td class="py-5 px-4 text-xs text-slate-600">
                                    {exp.item}
                                    <span class="block text-[10px] text-slate-400 mt-1">{exp.date}</span>
                                </td>
                                <td class="py-5 px-4 font-main font-black text-slate-900">Rp {exp.amount}</td>
                                <td class="py-5 px-4">
                                    <button class="text-[10px] font-bold text-primary underline">Lihat Foto</button>
                                </td>
                                <td class="py-5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button class="px-4 py-2 bg-emerald-500 text-white rounded-lg text-[10px] font-bold hover:bg-emerald-600 transition-all">ACC</button>
                                        <button class="px-4 py-2 bg-rose-100 text-rose-600 rounded-lg text-[10px] font-bold hover:bg-rose-200 transition-all">Tolak</button>
                                    </div>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Transaction Table -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-xl font-black text-slate-900">Riwayat Transaksi</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4 px-4">ID Transaksi</th>
                            <th class="pb-4 px-4">Tanggal</th>
                            <th class="pb-4 px-4">Pelanggan</th>
                            <th class="pb-4 px-4">Kategori</th>
                            <th class="pb-4 px-4">Metode</th>
                            <th class="pb-4 px-4 text-right">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {transactions.map((tx) => (
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-4 font-bold text-slate-900 text-sm">{tx.id}</td>
                                <td class="py-4 px-4 text-xs text-slate-500">{tx.date}</td>
                                <td class="py-4 px-4 text-sm font-medium text-slate-700">{tx.user}</td>
                                <td class="py-4 px-4">
                                    <span class="text-[9px] font-black px-2 py-0.5 rounded bg-slate-100 text-slate-500 uppercase">{tx.category}</span>
                                </td>
                                <td class="py-4 px-4 text-xs font-bold text-sky-600">{tx.method}</td>
                                <td class="py-4 px-4 text-right font-main font-black text-primary">Rp {tx.amount}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</AdminLayout>






