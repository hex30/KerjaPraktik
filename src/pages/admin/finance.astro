---
// File: src/pages/admin/finance.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import StatCard from "@features/admin/dashboard/StatCard.astro";
import InputGroup from "@ui/InputGroup.astro";

// Mock Data Keuangan
const financialSummary = [
    {
        title: "Total Pendapatan (Bulan Ini)",
        value: "Rp 124.500.000",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        trend: { value: "15%", isUp: true },
        color: "emerald" as const
    },
    {
        title: "Pendapatan Hari Ini",
        value: "Rp 4.500.000",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75m0 3v.75m0 3v.75m0 3V15m15 0v.75m0 3v.75m0 3V18.75M6.75 4.5v.75m0 3v.75m0 3v.75m0 3V15m15 0v.75m0 3v.75m0 3V18.75m-15-15h15c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125H4.5c-.621 0-1.125-.504-1.125-1.125V5.625c0-.621.504-1.125 1.125-1.125z" /></svg>`,
        color: "sky" as const
    }
];

const transactions = [
    { id: "TX-9901", date: "24 Mei 2026", user: "Fahri Ramdhani", category: "RUTE", amount: "250.000", method: "QRIS" },
    { id: "TX-9902", date: "24 Mei 2026", user: "PT Global Tech", category: "CHARTER", amount: "1.500.000", method: "VA MANDIRI" },
    { id: "TX-9903", date: "23 Mei 2026", user: "Febi Yulianti", category: "PAKET", amount: "85.000", method: "CASH" },
];
---

<AdminLayout title="Laporan Keuangan">
    <div class="flex flex-col gap-10">
        
        <!-- Filter & Actions -->
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex p-1 bg-slate-100 rounded-xl w-fit">
                {['Mingguan', 'Bulanan', 'Tahunan'].map(filter => (
                    <button class="px-6 py-2 rounded-lg text-xs font-bold transition-all hover:bg-white hover:shadow-sm focus:bg-white focus:shadow-sm">
                        {filter}
                    </button>
                ))}
            </div>
            <button class="text-xs font-bold text-primary bg-primary/5 px-6 py-3 rounded-xl hover:bg-primary hover:text-white transition-all">
                Download Laporan (PDF)
            </button>
        </div>

        <!-- Summary Cards -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {financialSummary.map(stat => (
                <StatCard {...stat} />
            ))}
            <!-- 40% Driver Salary Indicator -->
            <div class="bg-primary p-6 rounded-2xl text-white flex flex-col justify-between shadow-lg shadow-primary/20">
                <div>
                    <span class="text-[9px] font-black uppercase tracking-widest text-white/60">Estimasi Alokasi</span>
                    <h3 class="text-lg font-black mt-1">Gaji Supir (40%)</h3>
                </div>
                <div class="mt-4">
                    <span class="text-2xl font-black">Rp 49.800.000</span>
                    <p class="text-[10px] text-white/70 mt-1">* 40% dari total pendapatan armada</p>
                </div>
            </div>
            <!-- Projections -->
            <div class="bg-white p-6 rounded-2xl border border-slate-100 flex flex-col justify-between shadow-sm">
                <div class="space-y-4">
                    <div class="flex flex-col gap-1">
                        <span class="text-[9px] font-black uppercase text-slate-400">Pajak Kendaraan (+1 Thn)</span>
                        <span class="text-xs font-bold text-rose-600">Jatuh Tempo: 12 Des 2026</span>
                    </div>
                    <div class="flex flex-col gap-1 border-t border-slate-50 pt-3">
                        <span class="text-[9px] font-black uppercase text-slate-400">Travel NIB (+5 Thn)</span>
                        <span class="text-xs font-bold text-sky-600">Perpanjang: Juni 2031</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Driver Expense Verification -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Verifikasi Pengeluaran Supir</h2>
                    <p class="text-xs text-slate-400 mt-1">ACC atau Tolak nota pengeluaran operasional supir.</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4 px-4">Supir</th>
                            <th class="pb-4 px-4">Item Pengeluaran</th>
                            <th class="pb-4 px-4">Jumlah</th>
                            <th class="pb-4 px-4">Nota</th>
                            <th class="pb-4 px-4 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {[
                            { name: "Agus Setiawan", item: "Bensin & Tol (Jakarta)", amount: "450.000", date: "24 Mei" },
                            { name: "Budi Santoso", item: "Ganti Oli & Service Ringan", amount: "850.000", date: "23 Mei" },
                        ].map((exp) => (
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="py-5 px-4 font-bold text-slate-900 text-sm">{exp.name}</td>
                                <td class="py-5 px-4 text-xs text-slate-600">
                                    {exp.item}
                                    <span class="block text-[10px] text-slate-400 mt-1">{exp.date}</span>
                                </td>
                                <td class="py-5 px-4 font-main font-black text-slate-900">Rp {exp.amount}</td>
                                <td class="py-5 px-4">
                                    <button class="text-[10px] font-bold text-primary underline">Lihat Foto</button>
                                </td>
                                <td class="py-5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button class="px-4 py-2 bg-emerald-500 text-white rounded-lg text-[10px] font-bold hover:bg-emerald-600 transition-all">ACC</button>
                                        <button class="px-4 py-2 bg-rose-100 text-rose-600 rounded-lg text-[10px] font-bold hover:bg-rose-200 transition-all">Tolak</button>
                                    </div>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Masukan Data Pengeluaran Form -->
        <section id="input-expense" class="bg-white p-10 rounded-[2.5rem] border border-slate-100 shadow-sm scroll-mt-28">
            <header class="mb-10">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Masukan Data Pengeluaran</h2>
                <p class="text-sm text-slate-400 mt-2 font-secondary">Catat pengeluaran operasional kantor dan pemeliharaan secara mandiri.</p>
            </header>

            <form id="expense-form" class="flex flex-col gap-10">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                    <!-- Block 1: Utama -->
                    <div class="flex flex-col gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="font-secondary text-sm font-bold text-primary">Jenis Pengeluaran</label>
                            <select name="type" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/10 transition-all">
                                <option value="Perawatan Kendaraan">🔧 Perawatan Kendaraan</option>
                                <option value="Pajak Kendaraan">📄 Pajak Kendaraan</option>
                                <option value="Pajak Izin Berusaha">🏢 Pajak Izin Berusaha</option>
                            </select>
                        </div>
                        <InputGroup label="Penanggung Jawab" id="expense_pic" name="pic" placeholder="Nama Lengkap..." required={true} />
                    </div>

                    <!-- Block 2: Transaksi -->
                    <div class="flex flex-col gap-6">
                        <InputGroup label="Tanggal Transaksi" id="expense_date" name="date" type="date" required={true} />
                        <InputGroup label="Nominal Transaksi (Rp)" id="expense_amount" name="amount" type="number" placeholder="0" required={true} />
                    </div>

                    <!-- Block 3: Bukti & Detail -->
                    <div class="flex flex-col gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="font-secondary text-sm font-bold text-primary">Upload Bukti Transaksi</label>
                            <div class="relative w-full border-2 border-dashed border-slate-200 rounded-xl bg-slate-50 p-4 flex flex-col items-center justify-center gap-2 hover:border-primary transition-all cursor-pointer group overflow-hidden">
                                <input type="file" name="file" class="absolute inset-0 opacity-0 cursor-pointer z-10" />
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                <span class="font-secondary text-[10px] font-bold text-slate-400">Pilih Nota/Kuitansi</span>
                            </div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-secondary text-sm font-bold text-primary">Detail Tambahan</label>
                            <textarea name="detail" rows="2" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/10 transition-all resize-none" placeholder="Catatan opsional..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-4 border-t border-slate-50">
                    <button type="submit" class="bg-primary text-white px-12 py-4 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all">
                        Simpan & Update Laporan
                    </button>
                </div>
            </form>
        </section>

        <!-- Expenditure History Table -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <h2 class="text-xl font-black text-slate-900 mb-8">Riwayat Pengeluaran</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4 px-4">Tanggal</th>
                            <th class="pb-4 px-4">PIC / Penanggung Jawab</th>
                            <th class="pb-4 px-4">Kategori</th>
                            <th class="pb-4 px-4">Detail</th>
                            <th class="pb-4 px-4 text-right">Nominal</th>
                        </tr>
                    </thead>
                    <tbody id="expense-tbody" class="divide-y divide-slate-50">
                        <tr class="text-center py-10" id="no-expense-row">
                            <td colspan="5" class="py-10 text-slate-400 text-sm font-secondary">Belum ada pengeluaran yang dicatat.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

<script>
    const setupExpenseTracker = () => {
        const form = document.getElementById('expense-form') as HTMLFormElement;
        const tbody = document.getElementById('expense-tbody');
        const emptyRow = document.getElementById('no-expense-row');

        if (!form || !tbody) return;

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            // Remove empty row if exists
            if (emptyRow) emptyRow.remove();

            // Create new row
            const row = document.createElement('tr');
            row.className = 'group hover:bg-slate-50/50 transition-colors animate-fade-in';
            row.innerHTML = `
                <td class="py-4 px-4 text-xs text-slate-500 font-bold">${data.date}</td>
                <td class="py-4 px-4 text-sm font-black text-slate-900">${data.pic}</td>
                <td class="py-4 px-4">
                    <span class="text-[9px] font-black px-2 py-0.5 rounded bg-primary/10 text-primary uppercase">${data.type}</span>
                </td>
                <td class="py-4 px-4 text-xs text-slate-500 max-w-xs truncate">${data.detail || '-'}</td>
                <td class="py-4 px-4 text-right font-main font-black text-rose-600">Rp ${Number(data.amount).toLocaleString('id-ID')}</td>
            `;

            tbody.prepend(row);
            form.reset();
            alert('Data pengeluaran berhasil disimpan dan diperbarui ke laporan!');
        });
    }

    setupExpenseTracker();
    document.addEventListener('astro:page-load', setupExpenseTracker);
</script>

        <!-- Transaction Table -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-xl font-black text-slate-900">Riwayat Transaksi</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50">
                            <th class="pb-4 px-4">ID Transaksi</th>
                            <th class="pb-4 px-4">Tanggal</th>
                            <th class="pb-4 px-4">Pelanggan</th>
                            <th class="pb-4 px-4">Kategori</th>
                            <th class="pb-4 px-4">Metode</th>
                            <th class="pb-4 px-4 text-right">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {transactions.map((tx) => (
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="py-4 px-4 font-bold text-slate-900 text-sm">{tx.id}</td>
                                <td class="py-4 px-4 text-xs text-slate-500">{tx.date}</td>
                                <td class="py-4 px-4 text-sm font-medium text-slate-700">{tx.user}</td>
                                <td class="py-4 px-4">
                                    <span class="text-[9px] font-black px-2 py-0.5 rounded bg-slate-100 text-slate-500 uppercase">{tx.category}</span>
                                </td>
                                <td class="py-4 px-4 text-xs font-bold text-sky-600">{tx.method}</td>
                                <td class="py-4 px-4 text-right font-main font-black text-primary">Rp {tx.amount}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</AdminLayout>






