---
// File: src/pages/admin/bookings.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import BookingTable from "@features/admin/bookings/BookingTable.astro";
import { adminBookingService } from "@services/adminBookingService";

// Baca token dari cookies saat mode SSR
const token = Astro.cookies.get('token')?.value;

// Fetch data dari Backend via SSR
const [ruteData, charterData, rawFleets, driversData] = await Promise.all([
    adminBookingService.getTravelBookings(token),
    adminBookingService.getCharterBookings(token),
    adminBookingService.getMasterFleets(token),
    adminBookingService.getMasterDrivers(token)
]);

// Filter fleet (Elf pertama, lalu Luxio) dan mapping data
const fleetsData = rawFleets
    .filter(f => f.car_type?.toLowerCase().includes('elf') || f.car_type?.toLowerCase().includes('luxio'))
    .sort((a, b) => {
        const aType = a.car_type?.toLowerCase() || '';
        const bType = b.car_type?.toLowerCase() || '';
        if (aType.includes('elf') && !bType.includes('elf')) return -1;
        if (!aType.includes('elf') && bType.includes('elf')) return 1;
        return 0;
    });
---

<AdminLayout title="Manajemen Pemesanan">
    <div class="flex flex-col gap-12">
        
        <!-- Bagian Rute -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Tiket Perjalanan Rute</h2>
                    <p class="text-xs text-slate-400 font-secondary mt-1">Daftar pemesanan tiket antar kota rutin.</p>
                </div>
                <div class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-[10px] font-bold text-slate-400">
                    TOTAL: {ruteData.length} Antrean
                </div>
            </div>
            
            {/* @ts-ignore */}
            <BookingTable bookingType="RUTE" bookingData={ruteData} fleets={fleetsData} drivers={driversData} />
        </section>

        <!-- Bagian Booking/Charter -->
        <section>
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Booking Armada (Charter)</h2>
                    <p class="text-xs text-slate-400 font-secondary mt-1">Daftar pemesanan sewa satu unit mobil utuh.</p>
                </div>
                <div class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-[10px] font-bold text-slate-400">
                    TOTAL: {charterData.length} Antrean
                </div>
            </div>
            
            {/* @ts-ignore */}
            <BookingTable bookingType="CHARTER" bookingData={charterData} fleets={fleetsData} drivers={driversData} />
        </section>

    </div>
</AdminLayout>






