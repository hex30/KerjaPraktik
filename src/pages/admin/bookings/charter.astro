---
// File: src/pages/admin/bookings/charter.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import BookingTable from "@features/admin/bookings/BookingTable.astro";
import { adminBookingService } from "@services/adminBookingService";

const token = Astro.cookies.get('token')?.value;

const [charterData, rawFleets, driversData] = await Promise.all([
    adminBookingService.getCharterBookings(token),
    adminBookingService.getMasterFleets(token),
    adminBookingService.getMasterDrivers(token)
]);

const fleetsData = rawFleets
    .filter(f => f.car_type?.toLowerCase().includes('elf') || f.car_type?.toLowerCase().includes('luxio'))
    .sort((a, b) => {
        const aType = a.car_type?.toLowerCase() || '';
        const bType = b.car_type?.toLowerCase() || '';
        if (aType.includes('elf') && !bType.includes('elf')) return -1;
        if (!aType.includes('elf') && bType.includes('elf')) return 1;
        return 0;
    });

const activeBookings = charterData.filter((item: any) => {
    const isCash = item.payment_method === 'cash';
    const isConfirm = item.status?.toLowerCase() === 'menunggu_konfirmasi';
    const isPay = item.status?.toLowerCase() === 'menunggu_pembayaran';
    const hasPrice = !!item.price;
    return (isConfirm && !item.payment_proof_url && !isCash) || (isPay && !isCash) || (isCash && !hasPrice);
});
const validationBookings = charterData.filter((item: any) => {
    const isCash = item.payment_method === 'cash';
    const isConfirm = item.status?.toLowerCase() === 'menunggu_konfirmasi';
    const isPay = item.status?.toLowerCase() === 'menunggu_pembayaran';
    const hasPrice = !!item.price;
    return (isConfirm && !!item.payment_proof_url) || (isCash && hasPrice && (isConfirm || isPay));
});
const cancelledBookings = charterData.filter((item: any) => ['dibatalkan', 'ditolak', 'cancelled'].includes(item.status?.toLowerCase()));
const completedBookings = charterData.filter((item: any) => ['selesai', 'selesai_final'].includes(item.status?.toLowerCase()));

---

<AdminLayout title="Sewa Charter">
    <section class="mb-8">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Data Sewa Charter</h2>
                <p class="text-sm text-slate-500 font-secondary mt-1">Kelola pemesanan sewa satu unit armada utuh.</p>
            </div>
            <div class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-[10px] font-bold text-slate-400 shadow-sm">
                TOTAL: {charterData.length} Antrean
            </div>
        </div>
    </section>

    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
        <!-- Tabs Header -->
        <div class="flex border-b border-slate-100 bg-slate-50/50 p-2 gap-2 overflow-x-auto scrollbar-hide">
            <button class="tab-btn active px-6 py-3 rounded-2xl text-sm font-bold transition-all whitespace-nowrap bg-white text-primary shadow-sm border border-slate-100" data-target="tab-active">
                Antrean Aktif
                <span class="ml-2 px-2 py-0.5 bg-amber-100 text-amber-600 rounded-full text-[10px]">{activeBookings.length}</span>
            </button>
            <button class="tab-btn px-6 py-3 rounded-2xl text-sm font-bold text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-all whitespace-nowrap" data-target="tab-validation">
                Membutuhkan Validasi
                <span class="ml-2 px-2 py-0.5 bg-slate-200 text-slate-600 rounded-full text-[10px]">{validationBookings.length}</span>
            </button>
            <button class="tab-btn px-6 py-3 rounded-2xl text-sm font-bold text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-all whitespace-nowrap" data-target="tab-cancelled">
                Pesanan Dibatalkan
                <span class="ml-2 px-2 py-0.5 bg-slate-200 text-slate-600 rounded-full text-[10px]">{cancelledBookings.length}</span>
            </button>
            <button class="tab-btn px-6 py-3 rounded-2xl text-sm font-bold text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-all whitespace-nowrap" data-target="tab-completed">
                Riwayat Selesai
                <span class="ml-2 px-2 py-0.5 bg-slate-200 text-slate-600 rounded-full text-[10px]">{completedBookings.length}</span>
            </button>
        </div>

        <!-- Tabs Content -->
        <div class="p-6 md:p-8">
            <div id="tab-active" class="tab-content">
                {activeBookings.length === 0 ? (
                    <div class="text-center py-12">
                        <p class="text-slate-400 font-bold text-sm">Tidak ada antrean charter aktif saat ini.</p>
                    </div>
                ) : (
                    <BookingTable bookingType="CHARTER" bookingData={activeBookings} fleets={fleetsData} drivers={driversData} />
                )}
            </div>

            <div id="tab-validation" class="tab-content hidden">
                {validationBookings.length === 0 ? (
                    <div class="text-center py-12">
                        <p class="text-slate-400 font-bold text-sm">Tidak ada pesanan yang butuh validasi saat ini.</p>
                    </div>
                ) : (
                    <BookingTable bookingType="CHARTER" bookingData={validationBookings} fleets={fleetsData} drivers={driversData} />
                )}
            </div>

            <div id="tab-cancelled" class="tab-content hidden">
                {cancelledBookings.length === 0 ? (
                    <div class="text-center py-12">
                        <p class="text-slate-400 font-bold text-sm">Belum ada pesanan dibatalkan.</p>
                    </div>
                ) : (
                    <BookingTable bookingType="CHARTER" bookingData={cancelledBookings} fleets={fleetsData} drivers={driversData} />
                )}
            </div>

            <div id="tab-completed" class="tab-content hidden">
                {completedBookings.length === 0 ? (
                    <div class="text-center py-12">
                        <p class="text-slate-400 font-bold text-sm">Belum ada riwayat sewa selesai.</p>
                    </div>
                ) : (
                    <BookingTable bookingType="CHARTER" bookingData={completedBookings} fleets={fleetsData} drivers={driversData} />
                )}
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const setupTabs = () => {
            const btns = document.querySelectorAll('.tab-btn');
            const contents = document.querySelectorAll('.tab-content');

            btns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const target = btn.getAttribute('data-target');

                    // Reset all
                    btns.forEach(b => {
                        b.classList.remove('active', 'bg-white', 'text-primary', 'shadow-sm', 'border', 'border-slate-100');
                        b.classList.add('text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-700');
                        const badge = b.querySelector('span');
                        if(badge) {
                            badge.classList.remove('bg-amber-100', 'text-amber-600');
                            badge.classList.add('bg-slate-200', 'text-slate-600');
                        }
                    });

                    contents.forEach(c => c.classList.add('hidden'));

                    // Set active
                    btn.classList.add('active', 'bg-white', 'text-primary', 'shadow-sm', 'border', 'border-slate-100');
                    btn.classList.remove('text-slate-500', 'hover:bg-slate-100', 'hover:text-slate-700');
                    const badge = btn.querySelector('span');
                    if(badge) {
                        badge.classList.add('bg-amber-100', 'text-amber-600');
                        badge.classList.remove('bg-slate-200', 'text-slate-600');
                    }

                    const targetContent = document.getElementById(target as string);
                    if (targetContent) targetContent.classList.remove('hidden');
                });
            });
        };

        setupTabs();
        document.addEventListener('astro:page-load', setupTabs);
    });
</script>
