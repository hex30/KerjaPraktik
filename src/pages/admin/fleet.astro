---
// File: src/pages/admin/fleet.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import InputGroup from "@ui/InputGroup.astro";
import Badge from "@ui/Badge.astro";
import Button from "@ui/Button.astro";

const fleets = [
    { 
        id: "elf", 
        name: "Isuzu ELF Giga", 
        capacity: "19 Kursi", 
        description: "Cocok untuk rombongan menengah, nyaman dan tangguh.", 
        image: "/assets/images/contoh.jpg",
        status: "Tersedia"
    },
    { 
        id: "hiace", 
        name: "Toyota Hiace Commuter", 
        capacity: "15 Kursi", 
        description: "Eksekutif dan premium untuk perjalanan jarak jauh.", 
        image: "/assets/images/contoh.jpg",
        status: "Dalam Pemeliharaan"
    },
    { 
        id: "avanza", 
        name: "Toyota Avanza", 
        capacity: "6 Kursi", 
        description: "Pilihan ekonomis untuk perjalanan keluarga kecil.", 
        image: "/assets/images/contoh.jpg",
        status: "Sedang Disewa"
    },
];
---

<AdminLayout title="Manajemen Armada">
    <div class="flex flex-col gap-12">
        <!-- Section A: Fleet Management Grid -->
        <section>
            <header class="mb-8">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Daftar Armada Terdaftar</h2>
                <p class="text-sm text-slate-500 mt-1 font-secondary">Monitor status operasional dan edit data unit kendaraan Anda.</p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fleet-grid">
                {fleets.map((fleet, index) => (
                    <div class:list={["bg-white border border-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex flex-col h-full w-full fleet-card", index > 0 ? "hidden md:flex extra-fleet" : "flex"]} 
                         data-id={fleet.id} 
                         data-name={fleet.name} 
                         data-capacity={fleet.capacity} 
                         data-description={fleet.description} 
                         data-status={fleet.status}
                         data-image={fleet.image}>
                        
                        <figure class="relative h-48 overflow-hidden bg-slate-200">
                            <div class="absolute top-4 left-4 z-10">
                                <Badge variant="sky">{fleet.capacity}</Badge>
                            </div>
                            
                            <!-- Action Icons Overlay -->
                            <div class="absolute top-4 right-4 z-10 flex gap-2">
                                <button class="delete-fleet-btn w-10 h-10 bg-white/90 backdrop-blur-md text-red-500 rounded-full flex items-center justify-center shadow-sm hover:bg-red-500 hover:text-white transition-all transform hover:scale-110 active:scale-95">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                </button>
                                <button class="edit-fleet-btn w-10 h-10 bg-white/90 backdrop-blur-md text-primary rounded-full flex items-center justify-center shadow-sm hover:bg-primary hover:text-white transition-all transform hover:scale-110 active:scale-95">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                </button>
                            </div>

                            <img
                                src={fleet.image}
                                alt={fleet.name}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            />
                        </figure>

                        <div class="p-6 flex flex-col flex-grow">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-lg font-black text-primary">{fleet.name}</h3>
                                <span class:list={["text-[10px] font-black uppercase px-2 py-0.5 rounded-md", 
                                    fleet.status === 'Tersedia' ? 'bg-green-100 text-green-600' : 
                                    fleet.status === 'Dalam Pemeliharaan' ? 'bg-amber-100 text-amber-600' : 'bg-slate-100 text-slate-600']}>
                                    {fleet.status}
                                </span>
                            </div>

                            <p class="font-secondary text-xs text-text-secondary leading-relaxed flex-grow">
                                {fleet.description}
                            </p>
                        </div>
                    </div>
                ))}
            </div>

            {fleets.length > 1 && (
                <div class="mt-8 flex md:hidden justify-center" id="toggle-container">
                    <button id="toggle-fleets-btn" class="flex w-full items-center justify-center gap-3 px-8 py-4 bg-slate-50 border-2 border-dashed border-slate-200 rounded-2xl text-slate-500 font-bold text-sm hover:border-primary hover:text-primary transition-all group">
                        <span id="toggle-text">Tampilkan Armada</span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transition-transform group-hover:translate-y-0.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                    </button>
                </div>
            )}
        </section>
        </section>

        <!-- Section B: Modern Add / Edit Fleet Form -->
        <section id="fleet-form-section" class="bg-white p-8 md:p-12 rounded-[2.5rem] border border-slate-100 shadow-sm scroll-mt-28">
            <div class="flex flex-col md:flex-row gap-12 items-start">
                <div class="w-full lg:w-2/5">
                    <header class="mb-8">
                        <h2 id="form-title" class="text-2xl font-black text-slate-900 tracking-tight transition-all duration-300">Tambah Armada Baru</h2>
                        <p id="form-desc" class="text-sm text-slate-400 mt-2 font-secondary leading-relaxed">
                            Lengkapi informasi unit kendaraan untuk ditampilkan pada sistem pemesanan pelanggan.
                        </p>
                    </header>
                    
                    <div class="hidden lg:block p-6 bg-primary/5 border border-primary/10 rounded-2xl">
                        <div class="flex items-center gap-3 mb-3 text-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                            <span class="font-bold text-sm">Informasi Desain</span>
                        </div>
                        <p class="text-xs text-slate-500 leading-relaxed font-secondary">
                            Gunakan gambar dengan aspek rasio 16:9 untuk hasil terbaik pada kartu tampilan pelanggan.
                        </p>
                    </div>
                </div>

                <form id="fleet-form" class="w-full lg:w-3/5 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <InputGroup label="Nama Armada" id="fleet_name" name="name" placeholder="Contoh: Toyota Hiace Premio" required={true} />
                    </div>
                    
                    <InputGroup label="Kapasitas" id="fleet_capacity" name="capacity" placeholder="Contoh: 15 Kursi" required={true} />
                    
                    <div class="flex flex-col gap-2 w-full">
                        <label for="fleet_image" class="font-secondary text-sm font-bold text-primary">Gambar Armada</label>
                        <input type="file" id="fleet_image" name="image" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-2.5 font-secondary text-xs text-text-secondary focus:outline-none focus:border-primary transition-all file:mr-4 file:py-1 file:px-3 file:rounded-full file:border-0 file:text-[10px] file:font-black file:bg-primary file:text-white hover:file:bg-primary/90" />
                    </div>

                    <div class="md:col-span-2 flex flex-col gap-2">
                        <label for="fleet_description" class="font-secondary text-sm font-bold text-primary">Deskripsi Teks</label>
                        <textarea id="fleet_description" name="description" rows="4" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all resize-none" placeholder="Jelaskan spesifikasi atau keunggulan unit ini..."></textarea>
                    </div>

                    <div class="md:col-span-2 flex flex-col gap-2">
                        <label for="fleet_status" class="font-secondary text-sm font-bold text-primary">Status Operasional</label>
                        <select id="fleet_status" name="status" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-4 py-3 font-secondary text-sm text-text-secondary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all cursor-pointer">
                            <option value="Tersedia">✅ Tersedia</option>
                            <option value="Dalam Pemeliharaan">🔧 Dalam Pemeliharaan</option>
                            <option value="Sedang Disewa">📅 Sedang Disewa</option>
                        </select>
                    </div>

                    <div class="md:col-span-2 pt-4 flex gap-4">
                        <Button type="submit" size="lg" class="flex-grow shadow-lg shadow-primary/20">
                            Simpan Data Armada
                        </Button>
                        <button type="reset" id="reset-form-btn" class="px-8 py-3 bg-slate-100 text-slate-500 font-bold text-sm rounded-xl hover:bg-slate-200 transition-all">
                            Reset
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>
</AdminLayout>

<script>
    const setupFleetLogic = () => {
        const editButtons = document.querySelectorAll('.edit-fleet-btn');
        const deleteButtons = document.querySelectorAll('.delete-fleet-btn');
        const toggleButton = document.getElementById('toggle-fleets-btn');
        const extraFleetCards = document.querySelectorAll('.extra-fleet');
        
        const form = document.getElementById('fleet-form') as HTMLFormElement;
        const formTitle = document.getElementById('form-title');
        const formDesc = document.getElementById('form-desc');
        const resetBtn = document.getElementById('reset-form-btn');
        const section = document.getElementById('fleet-form-section');

        // Inputs
        const inputName = document.getElementById('fleet_name') as HTMLInputElement;
        const inputCapacity = document.getElementById('fleet_capacity') as HTMLInputElement;
        const inputDescription = document.getElementById('fleet_description') as HTMLTextAreaElement;
        const selectStatus = document.getElementById('fleet_status') as HTMLSelectElement;

        // Toggle Grid Logic
        let isExpanded = false;
        if(toggleButton) {
            const toggleText = document.getElementById('toggle-text');
            const toggleIcon = toggleButton.querySelector('svg');

            toggleButton.addEventListener('click', () => {
                isExpanded = !isExpanded;
                extraFleetCards.forEach(fleet => {
                    if (isExpanded) {
                        fleet.classList.remove('hidden');
                        fleet.classList.add('animate-fade-in');
                    } else {
                        fleet.classList.add('hidden');
                        fleet.classList.remove('animate-fade-in');
                    }
                });
                
                if(toggleText && toggleIcon) {
                    if (isExpanded) {
                        toggleText.textContent = "Sembunyikan Armada";
                        toggleIcon.classList.add('rotate-180');
                    } else {
                        toggleText.textContent = "Tampilkan Sisa Armada";
                        toggleIcon.classList.remove('rotate-180');
                    }
                }
            });
        }

        // Delete Logic Simulation
        deleteButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const card = btn.closest('.fleet-card') as HTMLElement;
                if(!card) return;
                
                const name = card.dataset.name;
                if (confirm(`Apakah Anda yakin ingin menghapus armada ${name}?`)) {
                    card.style.transition = 'all 0.3s ease';
                    card.style.transform = 'scale(0.9)';
                    card.style.opacity = '0';
                    setTimeout(() => {
                        card.remove();
                    }, 300);
                }
            });
        });

        // Edit Logic
        editButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const card = btn.closest('.fleet-card') as HTMLElement;
                if (!card) return;

                const { name, capacity, description, status } = card.dataset;

                // Populate Form
                if (inputName) inputName.value = name || '';
                if (inputCapacity) inputCapacity.value = capacity || '';
                if (inputDescription) inputDescription.value = description || '';
                if (selectStatus) selectStatus.value = status || 'Tersedia';

                // Change UI State
                if (formTitle) formTitle.textContent = "Edit Data Armada";
                if (formDesc) formDesc.textContent = `Anda sedang memperbarui data untuk unit "${name}". Klik simpan untuk menerapkan perubahan.`;
                
                // Highlight form section
                if (section) {
                    section.classList.add('ring-4', 'ring-primary/20', 'ring-offset-0');
                    section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    
                    setTimeout(() => {
                        section.classList.remove('ring-4', 'ring-primary/20');
                    }, 2000);
                }
            });
        });

        resetBtn?.addEventListener('click', () => {
            if (formTitle) formTitle.textContent = "Tambah Armada Baru";
            if (formDesc) formDesc.textContent = "Lengkapi informasi unit kendaraan untuk ditampilkan pada sistem pemesanan pelanggan.";
        });
    };

    document.addEventListener('DOMContentLoaded', setupFleetLogic);
    document.addEventListener('astro:page-load', setupFleetLogic);
</script>

<style>
    .fleet-card {
        animation: fadeIn 0.5s ease-out forwards;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
