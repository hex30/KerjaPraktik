---
// File: src/pages/admin/finance/expenses.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import InputGroup from "@ui/InputGroup.astro";
import PaymentPreviewModal from "@features/admin/bookings/PaymentPreviewModal.astro";

// Data Keuangan Dinamis (Server-Side)
const token = Astro.cookies.get("token")?.value;
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:5000";
const headers = { 'Authorization': `Bearer ${token}` };

let driverExpenses = [];
let maintenanceLogs = [];
let transactions = [];

try {
    const [expRes, maintRes, txRes] = await Promise.all([
        fetch(`${API_BASE}/api/admin/cashflow/expenses?status=pending`, { headers }),
        fetch(`${API_BASE}/api/driver/maintenance-logs`, { headers }),
        fetch(`${API_BASE}/api/admin/cashflow/transactions?limit=200`, { headers })
    ]);
    
    if (expRes.ok) driverExpenses = (await expRes.json()).data || [];
    if (maintRes.ok) {
        const allMaint = (await maintRes.json()).data || [];
        maintenanceLogs = allMaint.filter((log: any) => log.status === 'pending');
    }
    if (txRes.ok) transactions = (await txRes.json()).data || [];
} catch(e) {
    console.error("Failed to load expenses data:", e);
}

// Filter only expenses from transactions history
const expenseHistory = transactions.filter((tx: any) => tx.type === 'expense');

const getProofUrl = (url: string) => {
    if (!url) return "";
    if (url.startsWith("http://") || url.startsWith("https://")) {
        if (url.includes("localhost:5000") && API_BASE !== "http://localhost:5000") {
            return url.replace("http://localhost:5000", API_BASE);
        }
        return url;
    }
    return `${API_BASE}${url.startsWith("/") ? "" : "/"}${url}`;
};
---

<AdminLayout title="Data Pengeluaran">
    <div class="flex flex-col gap-10">
        
        <!-- HEADER PAGE -->
        <header class="flex flex-col gap-1">
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Data Pengeluaran</h1>
            <p class="text-sm text-slate-400 font-medium">Kelola pengajuan biaya jalan supir, catat biaya kantor, dan pantau riwayat pengeluaran.</p>
        </header>

        <!-- SECTION 1: Verifikasi Pengeluaran Supir -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col gap-6">
            <div>
                <h2 class="text-xl font-black text-slate-900">Verifikasi Pengeluaran Supir</h2>
                <p class="text-xs text-slate-400 mt-1">ACC atau Tolak nota pengajuan biaya jalan (bensin, tol, parkir) oleh supir.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50 whitespace-nowrap">
                            <th class="pb-4 px-4">Supir</th>
                            <th class="pb-4 px-4">Item Pengeluaran</th>
                            <th class="pb-4 px-4">Jumlah</th>
                            <th class="pb-4 px-4">Nota</th>
                            <th class="pb-4 px-4 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {driverExpenses.length === 0 ? (
                            <tr class="text-center py-10">
                                <td colspan="5" class="py-10 text-slate-400 text-sm font-secondary">Tidak ada pengajuan pending dari supir.</td>
                            </tr>
                        ) : driverExpenses.map((exp: any) => (
                            <tr class="group hover:bg-slate-50/50 transition-colors whitespace-nowrap md:whitespace-normal">
                                <td class="py-5 px-4 font-bold text-slate-900 text-sm">{exp.driver_name}</td>
                                <td class="py-5 px-4 text-xs text-slate-600">
                                    {exp.category}
                                    <span class="block text-[10px] text-slate-400 mt-1">{new Date(exp.created_at).toLocaleDateString('id-ID')}</span>
                                </td>
                                <td class="py-5 px-4 font-main font-black text-slate-900">Rp {Number(exp.amount).toLocaleString('id-ID')}</td>
                                <td class="py-5 px-4">
                                    {exp.proof_image_url ? (
                                        <div class="flex flex-col items-center gap-1 group cursor-pointer" onclick={`window.openPaymentPreview('${exp.id.substring(0, 8).toUpperCase()}', '${getProofUrl(exp.proof_image_url)}')`}>
                                            <img src={getProofUrl(exp.proof_image_url)} alt="Nota" class="w-12 h-16 object-cover rounded-lg border border-slate-200 shadow-sm group-hover:scale-105 transition-transform duration-200" />
                                            <span class="text-[10px] font-bold text-primary underline whitespace-nowrap">Lihat Nota</span>
                                        </div>
                                    ) : (
                                        <span class="text-[10px] text-slate-400">-</span>
                                    )}
                                </td>
                                <td class="py-5 px-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button data-id={exp.id} class="acc-btn px-4 py-2 bg-emerald-500 text-white rounded-lg text-[10px] font-bold hover:bg-emerald-600 transition-all">ACC</button>
                                        <button data-id={exp.id} class="tolak-btn px-4 py-2 bg-rose-100 text-rose-600 rounded-lg text-[10px] font-bold hover:bg-rose-200 transition-all">Tolak</button>
                                    </div>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- SECTION 1B: Verifikasi Kerusakan & Servis Armada -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col gap-6">
            <div>
                <h2 class="text-xl font-black text-slate-900">Verifikasi Kerusakan & Servis Armada</h2>
                <p class="text-xs text-slate-400 mt-1">ACC atau Tolak pengajuan biaya perbaikan unit oleh supir.</p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50 whitespace-nowrap">
                            <th class="pb-4 px-4">Supir</th>
                            <th class="pb-4 px-4">Armada</th>
                            <th class="pb-4 px-4">Deskripsi Kerusakan</th>
                            <th class="pb-4 px-4">Estimasi Biaya</th>
                            <th class="pb-4 px-4">Nota / Bukti</th>
                            <th class="pb-4 px-4 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {maintenanceLogs.length === 0 ? (
                            <tr class="text-center py-10">
                                <td colspan="6" class="py-10 text-slate-400 text-sm font-secondary">Tidak ada pengajuan perbaikan dari supir.</td>
                            </tr>
                        ) : (
                            maintenanceLogs.map((log: any) => (
                                <tr class="group hover:bg-slate-50/50 transition-colors whitespace-nowrap md:whitespace-normal">
                                    <td class="py-5 px-4 font-bold text-slate-900 text-sm">{log.driver_name || 'Supir'}</td>
                                    <td class="py-5 px-4 text-xs text-slate-600">
                                        {log.car_type}
                                        <span class="block text-[10px] font-mono text-slate-400 mt-1">{log.plate_number}</span>
                                    </td>
                                    <td class="py-5 px-4 text-xs text-slate-600 max-w-xs truncate" title={log.description}>{log.description}</td>
                                    <td class="py-5 px-4 font-main font-black text-slate-900">Rp {Number(log.cost).toLocaleString('id-ID')}</td>
                                    <td class="py-5 px-4">
                                        {log.proof_image_url ? (
                                            <div class="flex flex-col items-center gap-1 group cursor-pointer" onclick={`window.openPaymentPreview('${log.id.substring(0, 8).toUpperCase()}', '${getProofUrl(log.proof_image_url)}')`}>
                                                <img src={getProofUrl(log.proof_image_url)} alt="Nota" class="w-12 h-16 object-cover rounded-lg border border-slate-200 shadow-sm group-hover:scale-105 transition-transform duration-200" />
                                                <span class="text-[10px] font-bold text-primary underline whitespace-nowrap">Lihat Nota</span>
                                            </div>
                                        ) : (
                                            <span class="text-[10px] text-slate-400">-</span>
                                        )}
                                    </td>
                                    <td class="py-5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <button data-id={log.id} class="acc-maint-btn px-4 py-2 bg-emerald-500 text-white rounded-lg text-[10px] font-bold hover:bg-emerald-600 transition-all">ACC</button>
                                            <button data-id={log.id} class="tolak-maint-btn px-4 py-2 bg-rose-100 text-rose-600 rounded-lg text-[10px] font-bold hover:bg-rose-200 transition-all">Tolak</button>
                                        </div>
                                    </td>
                                </tr>
                            ))
                        )}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- SECTION 2: Form Masukan Data Pengeluaran -->
        <section class="bg-white p-10 rounded-[2.5rem] border border-slate-100 shadow-sm scroll-mt-28">
            <header class="mb-10">
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Masukan Data Pengeluaran</h2>
                <p class="text-sm text-slate-400 mt-2 font-secondary">Pencatatan manual biaya perawatan unit, pajak kendaraan, dan operasional kantor.</p>
            </header>

            <form id="expense-form" class="flex flex-col gap-10">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                    <!-- Block 1: Utama -->
                    <div class="flex flex-col gap-6">
                        <div class="flex flex-col gap-2">
                            <label class="font-secondary text-sm font-bold text-primary">Jenis Pengeluaran</label>
                            <select name="type" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/10 transition-all">
                                <option value="Perawatan Kendaraan">🛠 Perawatan Kendaraan</option>
                                <option value="Pajak Kendaraan">📑 Pajak Kendaraan</option>
                                <option value="Pajak Izin Berusaha">🏢 Pajak Izin Berusaha</option>
                                <option value="Biaya Operasional Kantor">💼 Biaya Operasional Kantor</option>
                            </select>
                        </div>
                        <InputGroup label="Penanggung Jawab" id="expense_pic" name="pic" placeholder="Nama Lengkap..." required={true} />
                    </div>

                    <!-- Block 2: Nominal -->
                    <div class="flex flex-col gap-6">
                        <InputGroup label="Nominal (Rp)" id="expense_amount" name="amount" type="number" placeholder="Contoh: 150000" required={true} />
                        <InputGroup label="Tanggal Pengeluaran" id="expense_date" name="date" type="date" required={true} />
                    </div>

                    <!-- Block 3: Bukti & Keterangan -->
                    <div class="flex flex-col gap-6">
                        <InputGroup label="Keterangan Detail" id="expense_detail" name="detail" placeholder="Ganti oli rutin armada B 1234 XY" />
                        <div class="flex flex-col gap-2">
                            <label class="font-secondary text-sm font-bold text-primary">Upload Bukti/Nota (Opsional)</label>
                            <input type="file" name="proof" accept="image/*" class="w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-bold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 transition-all" />
                        </div>
                    </div>
                </div>

                <div class="flex justify-end pt-4 border-t border-slate-50">
                    <button type="submit" class="bg-primary text-white px-12 py-4 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl shadow-primary/20 hover:scale-105 active:scale-95 transition-all">
                        Simpan Pengeluaran
                    </button>
                </div>
            </form>
        </section>

        <!-- SECTION 3: Riwayat Pengeluaran -->
        <section class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col gap-6">
            <div class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6">
                <div>
                    <h2 class="text-xl font-black text-slate-900">Riwayat Pengeluaran</h2>
                    <p class="text-xs text-slate-400 mt-1">Daftar rekaman pengeluaran operasional perusahaan.</p>
                </div>
                
                <!-- Filter Section -->
                <div class="flex flex-wrap items-center gap-3">
                    <select id="exp-filter-category" class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer">
                        <option value="ALL">Semua Kategori</option>
                        <option value="perawatan_kendaraan">Perawatan Kendaraan</option>
                        <option value="pajak_kendaraan">Pajak Kendaraan</option>
                        <option value="pajak_izin_berusaha">Pajak Izin Berusaha</option>
                        <option value="biaya_operasional_kantor">Biaya Operasional Kantor</option>
                        <option value="biaya_perjalanan">Biaya Perjalanan</option>
                        <option value="lainnya">Lainnya</option>
                    </select>
                    <input type="date" id="exp-filter-date" class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-700 outline-none focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer">
                    <button type="button" id="exp-btn-apply" class="bg-[#044751] hover:bg-[#03363e] text-white px-5 py-2.5 rounded-xl font-black text-xs uppercase tracking-widest shadow-md shadow-primary/20 hover:scale-105 active:scale-95 transition-all">
                        Terapkan
                    </button>
                    <button type="button" id="exp-btn-reset" class="bg-rose-50 hover:bg-rose-100 text-rose-600 px-5 py-2.5 rounded-xl font-black text-xs uppercase tracking-widest transition-all">
                        Reset
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left min-w-[700px]">
                    <thead>
                        <tr class="text-slate-400 text-[10px] font-bold uppercase tracking-widest border-b border-slate-50 whitespace-nowrap">
                            <th class="pb-4 px-4">ID</th>
                            <th class="pb-4 px-4">Tanggal</th>
                            <th class="pb-4 px-4">Kategori</th>
                            <th class="pb-4 px-4">Keterangan</th>
                            <th class="pb-4 px-4 text-right">Jumlah</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {expenseHistory.length === 0 ? (
                            <tr class="text-center py-10">
                                <td colspan="5" class="py-10 text-slate-400 text-sm font-secondary">Belum ada riwayat pengeluaran.</td>
                            </tr>
                        ) : expenseHistory.map((tx: any, index: number) => {
                            let txCat = (tx.category || '').toLowerCase();
                            if (['fuel', 'toll', 'parking'].includes(txCat)) {
                                txCat = 'biaya_perjalanan';
                            } else if (txCat === 'driver_salary') {
                                txCat = 'biaya_operasional_kantor';
                            } else if (txCat === 'other') {
                                txCat = 'lainnya';
                            }
                            return (
                            <tr class={`group hover:bg-slate-50/50 transition-all duration-300 whitespace-nowrap md:whitespace-normal exp-row ${index >= 5 ? 'hidden opacity-0 max-h-0' : 'opacity-100'}`} data-category={txCat} data-date={tx.created_at || ''}>
                                <td class="py-4 px-4 font-bold text-slate-900 text-sm">#{tx.id.substring(0, 8).toUpperCase()}</td>
                                <td class="py-4 px-4 text-xs text-slate-500">{new Date(tx.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'})}</td>
                                <td class="py-4 px-4">
                                    <span class="text-[9px] font-black px-2 py-0.5 rounded bg-rose-50 text-rose-600 border border-rose-100 uppercase">{tx.category.replace('_', ' ')}</span>
                                </td>
                                <td class="py-4 px-4 text-sm font-medium text-slate-700 max-w-xs truncate" title={tx.description}>{tx.description || '-'}</td>
                                <td class="py-4 px-4 text-right font-main font-black text-rose-600">
                                    - Rp {Number(tx.amount).toLocaleString('id-ID')}
                                </td>
                            </tr>
                        )})}
                    </tbody>
                </table>
            </div>

            {expenseHistory.length > 5 && (
                <div class="mt-6 flex justify-center border-t border-slate-50 pt-6">
                    <button id="toggle-exp-expand" class="text-xs font-black uppercase tracking-widest text-primary bg-primary/5 px-8 py-3.5 rounded-xl hover:bg-primary hover:text-white active:scale-95 transition-all shadow-sm">
                        Lihat Seluruh Data Bulan Ini
                    </button>
                </div>
            )}
        </section>

        <PaymentPreviewModal />
    </div>
</AdminLayout>

<script>
    import { apiFetch } from '../../../services/api';
    const setupExpenseActions = () => {
        // Form submit handler
        const form = document.getElementById('expense-form') as HTMLFormElement;
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
                const originalText = submitBtn.textContent;
                submitBtn.textContent = 'Menyimpan...';
                submitBtn.disabled = true;

                try {
                    const formData = new FormData(form);

                    const data = await apiFetch('/api/admin/cashflow/expense', {
                        method: 'POST',
                        body: formData
                    });

                    alert('Berhasil: ' + data.message);
                    form.reset();
                    window.location.reload();
                } catch (error: any) {
                    alert('Error: ' + error.message);
                } finally {
                    submitBtn.textContent = originalText;
                    submitBtn.disabled = false;
                }
            });
        }

        // Approval actions handler
        const handleApproval = async (id: string, status: 'approved' | 'rejected') => {
            if(!confirm(`Apakah Anda yakin ingin ${status === 'approved' ? 'MENYETUJUI' : 'MENOLAK'} pengeluaran ini?`)) return;

            try {
                await apiFetch(`/api/admin/cashflow/expenses/${id}/approve`, {
                    method: 'PUT',
                    body: JSON.stringify({ status })
                });

                alert('Status pengeluaran berhasil diperbarui.');
                window.location.reload();
            } catch (error: any) {
                alert('Error: ' + error.message);
            }
        };

        document.querySelectorAll('.acc-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLButtonElement).dataset.id as string;
                handleApproval(id, 'approved');
            });
        });

        document.querySelectorAll('.tolak-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLButtonElement).dataset.id as string;
                handleApproval(id, 'rejected');
            });
        });

        // Maintenance logs approval handler
        const handleMaintApproval = async (id: string, status: 'approved' | 'rejected') => {
            if(!confirm(`Apakah Anda yakin ingin ${status === 'approved' ? 'MENYETUJUI' : 'MENOLAK'} pengajuan perbaikan ini?`)) return;

            try {
                await apiFetch(`/api/driver/maintenance-logs/${id}/verify`, {
                    method: 'PUT',
                    body: JSON.stringify({ status })
                });

                alert('Status pengajuan perbaikan berhasil diperbarui.');
                window.location.reload();
            } catch (error: any) {
                alert('Error: ' + error.message);
            }
        };

        document.querySelectorAll('.acc-maint-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLButtonElement).dataset.id as string;
                handleMaintApproval(id, 'approved');
            });
        });

        document.querySelectorAll('.tolak-maint-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const id = (e.currentTarget as HTMLButtonElement).dataset.id as string;
                handleMaintApproval(id, 'rejected');
            });
        });

        // Expand/Collapse history
        const toggleBtn = document.getElementById("toggle-exp-expand");
        const rows = document.querySelectorAll(".exp-row");
        let isExpanded = false;

        if (toggleBtn) {
            toggleBtn.addEventListener("click", () => {
                isExpanded = !isExpanded;

                rows.forEach((row, index) => {
                    if (index >= 5) {
                        if (isExpanded) {
                            row.classList.remove("hidden");
                            setTimeout(() => {
                                row.classList.remove("opacity-0", "max-h-0");
                                row.classList.add("opacity-100");
                            }, 50);
                        } else {
                            row.classList.add("opacity-0", "max-h-0");
                            setTimeout(() => {
                                row.classList.add("hidden");
                            }, 300);
                        }
                    }
                });

                toggleBtn.textContent = isExpanded ? "Tutup Data Lengkap" : "Lihat Seluruh Data Bulan Ini";
            });
        }

        // Expense Filter Logic
        const btnApply = document.getElementById('exp-btn-apply');
        const btnReset = document.getElementById('exp-btn-reset');
        const selectCategory = document.getElementById('exp-filter-category') as HTMLSelectElement;
        const inputDate = document.getElementById('exp-filter-date') as HTMLInputElement;

        if (btnApply && btnReset) {
            btnApply.addEventListener('click', () => {
                const cat = selectCategory.value;
                const dt = inputDate.value;

                if (toggleBtn) toggleBtn.style.display = 'none';

                rows.forEach(row => {
                    const rowCat = row.getAttribute('data-category');
                    const rawDt = row.getAttribute('data-date');
                    
                    let match = true;
                    const normalizedCat = cat.replace(/_/g, ' ').toLowerCase();
                    const normalizedRowCat = (rowCat || '').replace(/_/g, ' ').toLowerCase();
                    
                    if (cat !== 'ALL' && !normalizedRowCat.includes(normalizedCat) && !normalizedCat.includes(normalizedRowCat)) match = false;
                    
                    if (dt && rawDt) {
                        try {
                            const d = new Date(rawDt);
                            const localRowDt = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
                            if (localRowDt !== dt) match = false;
                        } catch(e) {
                            if (!rawDt.includes(dt)) match = false;
                        }
                    } else if (dt && !rawDt) {
                        match = false;
                    }
                    
                    if (match) {
                        row.classList.remove('hidden', 'opacity-0', 'max-h-0');
                        row.classList.add('opacity-100');
                    } else {
                        row.classList.add('hidden', 'opacity-0', 'max-h-0');
                        row.classList.remove('opacity-100');
                    }
                });
            });

            btnReset.addEventListener('click', () => {
                selectCategory.value = 'ALL';
                inputDate.value = '';
                
                if (toggleBtn) {
                    toggleBtn.style.display = 'flex';
                    toggleBtn.textContent = "Lihat Seluruh Data Bulan Ini";
                    isExpanded = false;
                }
                
                rows.forEach((row, idx) => {
                    if (idx < 5) {
                        row.classList.remove('hidden', 'opacity-0', 'max-h-0');
                        row.classList.add('opacity-100');
                    } else {
                        row.classList.add('hidden', 'opacity-0', 'max-h-0');
                        row.classList.remove('opacity-100');
                    }
                });
            });
        }
    };

    setupExpenseActions();
    document.addEventListener("astro:page-load", setupExpenseActions);
</script>
