---
// File: src/pages/admin/users.astro
import AdminLayout from "@layouts/AdminLayout.astro";

// Mock Data
const users = [
    { id: "u1", name: "Febi Yulianti", email: "febi@example.com", phone: "08123456789", role: "customer" },
    { id: "u2", name: "Budi Santoso", email: "budi@example.com", phone: "08234567890", role: "customer" },
    { id: "u3", name: "Agus Setiawan", email: "agus@example.com", phone: "08345678901", role: "driver" },
    { id: "u4", name: "Iwan Fals", email: "iwan@example.com", phone: "08456789012", role: "driver" },
];

const currentRole = Astro.url.searchParams.get("role") || "customer";
---

<AdminLayout title="Kelola Pengguna & Driver">
    <div class="flex flex-col gap-10 font-main">
        <header>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Manajemen Akun</h2>
            <p class="text-sm text-slate-500 mt-1 font-secondary">Kelola daftar pengguna, supir, serta mutasi akses (Role Elevation) secara interaktif.</p>
        </header>

        <!-- Toggle View between Customer and Driver -->
        <div class="flex gap-4 border-b border-slate-100 pb-4">
            <button id="tab-customer" class="tab-btn px-6 py-2 rounded-full font-bold text-sm transition-all bg-primary text-white">Data Pengguna (Customer)</button>
            <button id="tab-driver" class="tab-btn px-6 py-2 rounded-full font-bold text-sm transition-all bg-slate-100 text-slate-500 hover:bg-slate-200">Data Supir (Driver)</button>
        </div>

        <!-- Grid Container -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="users-grid">
            {users.map(user => (
                <div 
                    class="user-card bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex flex-col justify-between transition-all hover:shadow-md animate-fade-in" 
                    data-id={user.id} 
                    data-role={user.role}
                    style={user.role === currentRole ? "" : "display: none;"}
                >
                    <div class="flex flex-col gap-4">
                        <div class="flex justify-between items-start">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-black text-primary text-lg">
                                    {user.name.charAt(0)}
                                </div>
                                <div class="flex flex-col">
                                    <span class="font-bold text-slate-900 leading-tight">{user.name}</span>
                                    <span class="text-xs text-slate-500 font-secondary">{user.phone}</span>
                                </div>
                            </div>
                            <!-- Elevasi Role Checkbox -->
                            <div class="flex items-center">
                                <label class="relative inline-flex items-center cursor-pointer group">
                                    <input type="checkbox" class="sr-only peer toggle-role-checkbox" checked={user.role === 'driver'} />
                                    <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary group-hover:ring-2 ring-primary/20"></div>
                                    <span class="ml-2 text-[10px] font-bold text-slate-400 uppercase">Jadikan Supir</span>
                                </label>
                            </div>
                        </div>

                        <div class="flex flex-col gap-3">
                            <div class="flex flex-col gap-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Email (Read-Only)</label>
                                <input type="email" value={user.email} readonly class="w-full bg-slate-50 border border-slate-100 rounded-lg px-3 py-2 text-sm text-slate-500 cursor-not-allowed" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Kata Sandi Baru</label>
                                <input type="password" placeholder="••••••••" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all" />
                            </div>
                            <div class="flex flex-col gap-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase">Role Akun</label>
                                <select class="role-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
                                    <option value="customer" selected={user.role === 'customer'}>Customer</option>
                                    <option value="driver" selected={user.role === 'driver'}>Driver</option>
                                    <option value="admin" selected={user.role === 'admin'}>Admin</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-4 border-t border-slate-100 flex justify-end">
                        <button class="px-4 py-2 bg-slate-100 hover:bg-primary hover:text-white text-slate-600 font-bold text-xs rounded-lg transition-all">Simpan Perubahan</button>
                    </div>
                </div>
            ))}
        </div>
    </div>
</AdminLayout>

<script>
    const setupUserManagement = () => {
        const tabCustomer = document.getElementById('tab-customer');
        const tabDriver = document.getElementById('tab-driver');
        const cards = document.querySelectorAll('.user-card');
        const checkboxes = document.querySelectorAll('.toggle-role-checkbox');
        const selects = document.querySelectorAll('.role-select');

        // URL Param matching
        const urlParams = new URLSearchParams(window.location.search);
        let activeTab = urlParams.get('role') === 'driver' ? 'driver' : 'customer';

        const updateTabUI = () => {
            if (activeTab === 'customer') {
                tabCustomer?.classList.replace('bg-slate-100', 'bg-primary');
                tabCustomer?.classList.replace('text-slate-500', 'text-white');
                tabDriver?.classList.replace('bg-primary', 'bg-slate-100');
                tabDriver?.classList.replace('text-white', 'text-slate-500');
            } else {
                tabDriver?.classList.replace('bg-slate-100', 'bg-primary');
                tabDriver?.classList.replace('text-slate-500', 'text-white');
                tabCustomer?.classList.replace('bg-primary', 'bg-slate-100');
                tabCustomer?.classList.replace('text-white', 'text-slate-500');
            }
            
            cards.forEach(card => {
                const c = card as HTMLElement;
                if (c.dataset.role === activeTab) {
                    c.style.display = '';
                    c.classList.add('animate-fade-in');
                } else {
                    c.style.display = 'none';
                    c.classList.remove('animate-fade-in');
                }
            });
        };

        // Init
        updateTabUI();

        tabCustomer?.addEventListener('click', () => {
            activeTab = 'customer';
            window.history.pushState({}, '', '?role=customer');
            updateTabUI();
        });

        tabDriver?.addEventListener('click', () => {
            activeTab = 'driver';
            window.history.pushState({}, '', '?role=driver');
            updateTabUI();
        });

        // Mutasi Role Logic (Checkbox)
        checkboxes.forEach((cb, index) => {
            cb.addEventListener('change', (e) => {
                const target = e.target as HTMLInputElement;
                const card = target.closest('.user-card') as HTMLElement;
                const select = selects[index] as HTMLSelectElement;
                
                const newRole = target.checked ? 'driver' : 'customer';
                card.dataset.role = newRole;
                select.value = newRole;

                // Animate removal
                card.classList.remove('animate-fade-in');
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                
                setTimeout(() => {
                    card.style.display = 'none';
                    card.style.opacity = '1';
                    card.style.transform = 'scale(1)';
                    // Re-filter grid
                    updateTabUI();
                }, 300);
            });
        });

        // Sync Select to Checkbox
        selects.forEach((select, index) => {
            select.addEventListener('change', (e) => {
                const target = e.target as HTMLSelectElement;
                const card = target.closest('.user-card') as HTMLElement;
                const checkbox = checkboxes[index] as HTMLInputElement;

                const newRole = target.value;
                card.dataset.role = newRole;
                
                if (newRole === 'driver') {
                    checkbox.checked = true;
                } else if (newRole === 'customer') {
                    checkbox.checked = false;
                }

                // If role changed from current tab view, hide it
                if (newRole !== activeTab) {
                    card.classList.remove('animate-fade-in');
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    
                    setTimeout(() => {
                        card.style.display = 'none';
                        card.style.opacity = '1';
                        card.style.transform = 'scale(1)';
                    }, 300);
                }
            });
        });
    };

    document.addEventListener('DOMContentLoaded', setupUserManagement);
    document.addEventListener('astro:page-load', setupUserManagement);
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px) scale(0.95); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>
