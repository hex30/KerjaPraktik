---
// File: src/pages/admin/users.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import { adminContentService } from "@services/adminContentService";

// Baca token dari cookies saat mode SSR
const token = Astro.cookies.get("token")?.value;

// Fetch data dari API Backend secara nyata
const users = await adminContentService.getUsersAdmin(token);

const currentRole = Astro.url.searchParams.get("role") || "customer";
---

<AdminLayout title="Kelola Pengguna & Driver">
    <div class="flex flex-col gap-10 font-main">
        <header>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">
                Manajemen Akun
            </h2>
            <p class="text-sm text-slate-500 mt-1 font-secondary">
                Kelola daftar pengguna, supir, serta mutasi akses (Role
                Elevation) secara interaktif.
            </p>
        </header>

        <!-- Grid Container -->
        <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            id="users-grid"
        >
            {
                users.map((user) => (
                    <div
                        class="user-card bg-white rounded-xl shadow-sm border border-slate-100 p-5 flex flex-col justify-between transition-all hover:shadow-md animate-fade-in"
                        data-id={user.id}
                        data-role={user.role}
                        style={
                            user.role === currentRole ? "" : "display: none;"
                        }
                    >
                        <div class="flex flex-col gap-4">
                            <div class="flex justify-between items-start">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center font-black text-primary text-lg">
                                        {user.name.charAt(0)}
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-slate-900 leading-tight">
                                            {user.name}
                                        </span>
                                        <span class="text-xs text-slate-500 font-secondary">
                                            {user.phone_number || "-"}
                                        </span>
                                    </div>
                                </div>
                                <button type="button" class="delete-user-btn text-rose-400 hover:text-rose-600 bg-rose-50 hover:bg-rose-100 p-2 rounded-lg transition-colors" title="Hapus Akun">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                </button>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex flex-col gap-1">
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">
                                        Email (Read-Only)
                                    </label>
                                    <input
                                        type="email"
                                        value={user.email}
                                        readonly
                                        class="w-full bg-slate-50 border border-slate-100 rounded-lg px-3 py-2 text-sm text-slate-500 cursor-not-allowed"
                                    />
                                </div>
                                <div class="flex flex-col gap-1">
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">
                                        Kata Sandi Baru
                                    </label>
                                    <input
                                        type="password"
                                        placeholder="••••••••"
                                        class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all"
                                    />
                                </div>
                                <div class="flex flex-col gap-1">
                                    <label class="text-[10px] font-bold text-slate-500 uppercase">
                                        Role Akun
                                    </label>
                                    <select class="role-select w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm font-bold text-slate-700 focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary transition-all">
                                        <option
                                            value="customer"
                                            selected={user.role === "customer"}
                                        >
                                            Customer
                                        </option>
                                        <option
                                            value="driver"
                                            selected={user.role === "driver"}
                                        >
                                            Driver
                                        </option>
                                        <option
                                            value="admin"
                                            selected={user.role === "admin"}
                                        >
                                            Admin
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 pt-4 border-t border-slate-100 flex justify-end">
                            <button class="save-role-btn px-4 py-2 bg-slate-100 hover:bg-primary hover:text-white text-slate-600 font-bold text-xs rounded-lg transition-all">
                                Simpan Perubahan
                            </button>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Dynamic Alert/Confirm Modal -->
    <div
        id="dynamic-modal"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/40 backdrop-blur-sm transition-opacity duration-300 opacity-0"
    >
        <div
            id="dynamic-modal-inner"
            class="bg-white p-6 rounded-2xl shadow-2xl border border-slate-100 max-w-sm w-full text-center flex flex-col items-center gap-4 mx-4 transform scale-95 transition-transform duration-300"
        >
            <div
                id="dynamic-modal-icon-container"
                class="w-14 h-14 rounded-full flex items-center justify-center shadow-sm border bg-amber-50 text-amber-500 border-amber-100"
            >
                <div id="dynamic-modal-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
            </div>
            <div>
                <h4 id="dynamic-modal-title" class="font-bold text-lg text-primary mb-1">Konfirmasi</h4>
                <p
                    id="dynamic-modal-message"
                    class="text-sm text-slate-500 font-secondary leading-relaxed"
                >
                    Apakah anda yakin?
                </p>
            </div>
            <div class="flex gap-3 w-full mt-2" id="dynamic-modal-actions">
                <button
                    type="button"
                    id="dynamic-modal-cancel"
                    class="flex-1 py-2.5 px-4 bg-slate-100 text-slate-600 font-bold rounded-xl text-sm hover:bg-slate-200 transition-colors"
                >
                    Batal
                </button>
                <button
                    type="button"
                    id="dynamic-modal-confirm"
                    class="flex-1 py-2.5 px-4 bg-primary text-white font-bold rounded-xl text-sm hover:bg-opacity-90 transition-colors shadow-md shadow-primary/20"
                >
                    Ya, Yakin
                </button>
            </div>
        </div>
    </div>
</AdminLayout>

<script>
    import { adminContentService } from "@services/adminContentService";

    const setupUserManagement = () => {
        const cards = document.querySelectorAll(".user-card");

        // URL Param matching
        const urlParams = new URLSearchParams(window.location.search);
        let activeTab =
            urlParams.get("role") === "driver" ? "driver" : "customer";

        const updateTabUI = () => {
            cards.forEach((card) => {
                const c = card as HTMLElement;
                if (c.dataset.role === activeTab) {
                    c.style.display = "";
                    c.classList.add("animate-fade-in");
                } else {
                    c.style.display = "none";
                    c.classList.remove("animate-fade-in");
                }
            });
        };

        // Init
        updateTabUI();

        // Mutasi Role Logic (Tombol Simpan Perubahan)
        const saveBtns = document.querySelectorAll(".save-role-btn");
        // Dynamic Modal Handling
        let currentModalConfirmAction: null | (() => void) = null;
        let hideTimeout: ReturnType<typeof setTimeout> | null = null;
        
        const modal = document.getElementById("dynamic-modal");
        const modalInner = document.getElementById("dynamic-modal-inner");
        const modalIconContainer = document.getElementById("dynamic-modal-icon-container");
        const modalIcon = document.getElementById("dynamic-modal-icon");
        const modalTitle = document.getElementById("dynamic-modal-title");
        const modalMessage = document.getElementById("dynamic-modal-message");
        const modalActions = document.getElementById("dynamic-modal-actions");
        const modalBtnCancel = document.getElementById("dynamic-modal-cancel");
        const modalBtnConfirm = document.getElementById("dynamic-modal-confirm");

        const modalStyles = {
            warning: { bg: 'bg-amber-50', text: 'text-amber-500', border: 'border-amber-100', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>' },
            error: { bg: 'bg-rose-50', text: 'text-rose-500', border: 'border-rose-100', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>' },
            success: { bg: 'bg-emerald-50', text: 'text-emerald-500', border: 'border-emerald-100', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>' }
        };

        const showModal = (type: 'warning'|'error'|'success', title: string, message: string, onConfirm?: () => void) => {
            if (!modal || !modalInner || !modalIcon || !modalIconContainer || !modalTitle || !modalMessage || !modalActions || !modalBtnCancel || !modalBtnConfirm) return;
            
            if (hideTimeout) {
                clearTimeout(hideTimeout);
                hideTimeout = null;
            }

            const style = modalStyles[type];
            modalIconContainer.className = `w-14 h-14 rounded-full flex items-center justify-center shadow-sm border ${style.bg} ${style.text} ${style.border}`;
            modalIcon.innerHTML = style.icon;
            modalTitle.textContent = title;
            modalMessage.textContent = message;

            if (onConfirm) {
                // Konfirmasi Mode
                modalBtnCancel.style.display = 'block';
                modalBtnConfirm.textContent = "Ya, Yakin";
                currentModalConfirmAction = onConfirm;
            } else {
                // Alert Mode
                modalBtnCancel.style.display = 'none';
                modalBtnConfirm.textContent = "Tutup";
                currentModalConfirmAction = null;
            }

            modal.classList.remove("hidden");
            modal.classList.add("flex");
            void modal.offsetWidth; // Reflow
            modal.classList.remove("opacity-0");
            modalInner.classList.remove("scale-95");
        };

        const hideModal = () => {
            if (!modal || !modalInner) return;
            modal.classList.add("opacity-0");
            modalInner.classList.add("scale-95");
            hideTimeout = setTimeout(() => {
                modal.classList.remove("flex");
                modal.classList.add("hidden");
            }, 300);
        };

        if (modalBtnCancel && modalBtnConfirm) {
            modalBtnCancel.addEventListener("click", () => {
                hideModal();
                currentModalConfirmAction = null;
            });
            modalBtnConfirm.addEventListener("click", () => {
                hideModal();
                if (currentModalConfirmAction) {
                    currentModalConfirmAction();
                    currentModalConfirmAction = null;
                }
            });
        }

        saveBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.target as HTMLElement;
                const card = target.closest(".user-card") as HTMLElement;
                const select = card.querySelector(
                    ".role-select",
                ) as HTMLSelectElement;
                const id = card.dataset.id;

                if (!id) return;

                const newRole = select.value;
                const passwordInput = card.querySelector(
                    'input[type="password"]',
                ) as HTMLInputElement;
                const newPassword =
                    passwordInput && passwordInput.value
                        ? passwordInput.value
                        : undefined;

                const doSave = async () => {
                    try {
                        target.textContent = "Menyimpan...";
                        target.setAttribute("disabled", "true");

                        await adminContentService.updateUserRole(
                            id,
                            newRole,
                            newPassword,
                        );

                        const msg = newPassword 
                            ? `Peran pengguna telah diubah menjadi ${newRole} dan kata sandi baru telah diatur.`
                            : `Peran pengguna telah diubah menjadi ${newRole}.`;
                        showModal("success", "Berhasil Tersimpan", msg);

                        if (passwordInput) passwordInput.value = "";
                        card.dataset.role = newRole;

                        // If role changed from current tab view, hide it
                        if (newRole !== activeTab) {
                            card.classList.remove("animate-fade-in");
                            card.style.opacity = "0";
                            card.style.transform = "scale(0.95)";

                            setTimeout(() => {
                                card.style.display = "none";
                                card.style.opacity = "1";
                                card.style.transform = "scale(1)";
                            }, 300);
                        }
                    } catch (error: any) {
                        showModal("error", "Gagal Menyimpan", error.message || "Gagal menyimpan perubahan ke server.");
                    } finally {
                        target.textContent = "Simpan Perubahan";
                        target.removeAttribute("disabled");
                    }
                };

                // Tampilkan Modal Konfirmasi
                showModal("warning", "Konfirmasi Perubahan", "Apakah Anda yakin ingin merubah role atau password pengguna ini?", doSave);
            });
        });

        // Delete Logic
        const deleteBtns = document.querySelectorAll(".delete-user-btn");
        deleteBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const target = e.currentTarget as HTMLElement;
                const card = target.closest(".user-card") as HTMLElement;
                const id = card.dataset.id;
                const name = card.querySelector(".font-bold")?.textContent?.trim();

                if (!id) return;

                const doDelete = () => {
                    target.setAttribute("disabled", "true");
                    target.innerHTML = `<svg class="animate-spin h-4 w-4 text-rose-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

                    adminContentService.deleteUser(id)
                        .then(() => {
                            showModal("success", "Berhasil Dihapus", `Akun pengguna ${name || ''} telah dihapus.`);
                            setTimeout(() => window.location.reload(), 1500);
                        })
                        .catch((error: any) => {
                            showModal("error", "Gagal Menghapus", error.message || "Terjadi kesalahan saat menghapus akun pengguna.");
                            target.removeAttribute("disabled");
                            target.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`;
                        });
                };

                showModal("error", "Konfirmasi Hapus", `Apakah Anda yakin ingin menghapus akun ${name || 'ini'} secara permanen? Aksi ini tidak dapat dibatalkan.`, doDelete);
            });
        });
    };

    document.addEventListener("DOMContentLoaded", setupUserManagement);
    document.addEventListener("astro:page-load", setupUserManagement);
</script>

<style>
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>
