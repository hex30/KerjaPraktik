---
// File: src/pages/admin/content.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import Button from "../../components/ui/Button.astro";
import InputGroup from "../../components/ui/InputGroup.astro";
import PromoManager from "../../components/features/admin/content/PromoManager.astro";
import DestinationManager from "../../components/features/admin/content/DestinationManager.astro";

// Mock Current Content State
const currentPromo = {
    discount: "20%",
    tagline: "Liburan Keluarga Lebih Hemat",
    isActive: true
};
---

<AdminLayout title="Kelola Konten Dinamis">
    <div class="flex flex-col gap-12">
        <!-- Unified Promo Manager -->
        <PromoManager />

        <div class="grid grid-cols-1 gap-10">
            <!-- Preview Konten -->
            <section class="flex flex-col gap-6">
                <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest px-2">Preview Tampilan Banner</h2>
                
                <div class="bg-slate-900 rounded-[2.5rem] p-12 text-white relative overflow-hidden aspect-video lg:aspect-[21/9] flex flex-col justify-center gap-6 shadow-2xl">
                    <div class="absolute inset-0 bg-gradient-to-r from-primary to-transparent opacity-60"></div>
                    <div class="relative z-10 max-w-2xl">
                        <span class="bg-sky-500 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-[0.2em]">Penawaran Spesial</span>
                        <h1 class="text-5xl md:text-7xl font-black mt-6 leading-tight tracking-tighter">
                            Diskon <span class="text-sky-400">{currentPromo.discount}</span><br />
                            {currentPromo.tagline}
                        </h1>
                        <div class="mt-8 flex gap-4">
                            <div class="px-8 py-4 bg-white text-primary rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl">Pesan Sekarang</div>
                        </div>
                    </div>
                    <div class="absolute bottom-10 right-12 opacity-10 rotate-12 scale-150">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-64 h-64"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" /></svg>
                    </div>
                </div>

                <div class="bg-amber-50 border border-amber-100 p-8 rounded-[2rem] flex gap-6 items-center">
                    <div class="p-3 bg-amber-100 text-amber-600 rounded-2xl">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
                    </div>
                    <div>
                        <p class="text-base font-black text-amber-900">Catatan Sinkronisasi Admin</p>
                        <p class="text-sm text-amber-700 font-secondary mt-1 leading-relaxed">Perubahan konten akan langsung terlihat oleh seluruh pengguna website setelah Anda menekan tombol simpan.</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</AdminLayout>






