---
// File: src/pages/admin/index.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import StatCard from "../../components/admin/ui/StatCard.astro";

// Data Dummy Dashboard
const stats = [
    {
        title: "Pendapatan Hari Ini",
        value: "Rp 4.500.000",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        trend: { value: "12%", isUp: true },
        color: "emerald" as const
    },
    {
        title: "Jumlah Pengguna",
        value: "1,240",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
        trend: { value: "5%", isUp: true },
        color: "sky" as const
    },
    {
        title: "Total Supir",
        value: "18",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.375 0 11-7.5 0 3.75 3.375 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
        color: "amber" as const
    }
];

const bookingStats = [
    {
        title: "Pemesanan Hari Ini",
        value: "42",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>`,
        color: "primary" as const
    },
    {
        title: "Pemesanan Bulan Ini",
        value: "1,120",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
        trend: { value: "8%", isUp: true },
        color: "primary" as const
    }
];
---

<AdminLayout title="Dashboard Overview">
    <div class="flex flex-col gap-10">
        <!-- Main Stats -->
        <section>
            <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">Ringkasan Utama</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {stats.map(stat => (
                    <StatCard {...stat} />
                ))}
            </div>
        </section>

        <!-- Booking Stats -->
        <section>
            <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">Aktivitas Pemesanan</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {bookingStats.map(stat => (
                    <StatCard {...stat} />
                ))}
            </div>
        </section>

        <!-- Quick Actions / Info -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-100 p-8 flex flex-col gap-6">
                <h3 class="text-xl font-bold text-slate-900">Statistik Pendapatan Bulanan</h3>
                <div class="h-64 bg-slate-50 rounded-xl flex items-center justify-center border border-dashed border-slate-200">
                    <p class="text-slate-400 font-medium italic">[ Grafik Pendapatan Placeholder ]</p>
                </div>
            </div>
            
            <div class="bg-primary rounded-2xl p-8 text-white flex flex-col justify-between relative overflow-hidden group">
                <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
                
                <div class="relative z-10">
                    <h3 class="text-xl font-bold mb-2">Pesan Admin</h3>
                    <p class="text-white/80 text-sm leading-relaxed">Jangan lupa untuk memverifikasi harga pada riwayat pemesanan yang masih pending.</p>
                </div>

                <a href="/admin/pemesanan" class="mt-8 bg-white text-primary px-6 py-3 rounded-xl text-sm font-bold w-fit hover:scale-105 active:scale-95 transition-all">
                    Lihat Antrean
                </a>
            </div>
        </div>
    </div>
</AdminLayout>
