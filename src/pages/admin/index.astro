---
// File: src/pages/admin/index.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import StatCard from "@features/admin/dashboard/StatCard.astro";
import Badge from "@ui/Badge.astro";

import { adminDashboardService } from "@services/adminDashboardService";

// Baca token dari cookies saat mode SSR
const token = Astro.cookies.get('token')?.value;

// Fetch data secara riil dari Backend via SSR
const metrics = await adminDashboardService.getDashboardMetrics(token);
const approvalDriverData = await adminDashboardService.getDepartureRequests(token);
const assignedFleets = await adminDashboardService.getActiveFleets(token);

// Map metrics ke komponen StatCard
const stats = [
    {
        title: "Pemesanan Hari Ini",
        value: String(metrics.total_bookings_today),
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>`,
        color: "primary" as const
    },
    {
        title: "Jumlah Pengguna",
        value: String(metrics.total_users),
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`,
        color: "sky" as const
    },
    {
        title: "Total Supir",
        value: String(metrics.total_drivers),
        icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.375 0 11-7.5 0 3.75 3.375 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
        color: "amber" as const
    }
];
---

<AdminLayout title="Dashboard Overview">
    <div class="flex flex-col gap-10 font-main">
        <!-- Main Stats -->
        <section>
            <h2 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-6">Ringkasan Operasional</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {stats.map(stat => (
                    <StatCard {...stat} />
                ))}
            </div>
        </section>

        <!-- Modul Baru: Kartu Permintaan Persetujuan Driver (Task 8.2) -->
        <section id="approval-section" class="flex flex-col gap-6">
            <h2 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Permintaan Persetujuan Driver</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6" id="approval-grid">
                {approvalDriverData.map(req => (
                    <div class="approval-card bg-white rounded-xl border border-slate-200 p-6 flex flex-col gap-5 shadow-sm hover:shadow-md transition-all duration-300" data-id={req.id}>
                        <div class="flex items-center justify-between border-b border-dashed border-slate-100 pb-4">
                            <div class="flex flex-col">
                                <span class="text-[10px] font-bold text-slate-400 uppercase">Jadwal Keberangkatan</span>
                                <span class="text-sm font-black text-primary">{req.date}</span>
                            </div>
                            <Badge variant={req.type === 'RUTE' ? 'sky' : 'warning'} class="px-3 py-1 text-[9px]">{req.type}</Badge>
                        </div>
                        
                        <div class="grid grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1">
                                <span class="text-[9px] font-bold text-slate-400 uppercase block">Rute / Tujuan</span>
                                <span class="text-xs font-bold text-slate-900">{req.path}</span>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[9px] font-bold text-slate-400 uppercase block">Unit Armada</span>
                                <span class="text-xs font-bold text-slate-900">{req.unit_name}</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100/50">
                                <span class="text-[9px] font-bold text-slate-400 uppercase block mb-1">Total Penumpang</span>
                                <span class="text-xs font-black text-primary">{req.pax} Orang</span>
                            </div>
                            <div class="bg-slate-50 p-3 rounded-xl border border-slate-100/50">
                                <span class="text-[9px] font-bold text-slate-400 uppercase block mb-1">Total Paket</span>
                                <span class="text-xs font-black text-primary">{req.packages} Item</span>
                            </div>
                        </div>

                        <div class="flex flex-col gap-2">
                            <span class="text-[9px] font-bold text-slate-400 uppercase block">Driver Diajukan</span>
                            <div class="flex gap-2">
                                <span class="px-2.5 py-1 bg-primary/10 text-primary text-[10px] font-black rounded-md">D1: {req.driver1}</span>
                                {req.driver2 && <span class="px-2.5 py-1 bg-slate-100 text-slate-600 text-[10px] font-black rounded-md">D2: {req.driver2}</span>}
                            </div>
                        </div>

                        <div class="mt-2 pt-4 border-t border-slate-50 flex items-center justify-between gap-3">
                            <button class="reject-btn flex-1 border border-rose-200 text-rose-600 hover:bg-rose-50 px-4 py-2 rounded-lg text-sm font-medium transition-colors">Tolak</button>
                            <button class="approve-btn flex-1 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-lg shadow-emerald-600/20">Menyetujui</button>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Daftar Armada Sedang Bertugas -->
        <section class="flex flex-col gap-6">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-900 tracking-tight">Daftar Armada Sedang Bertugas</h2>
                <span class="px-4 py-1.5 bg-slate-100 text-slate-500 text-[10px] font-black rounded-full uppercase tracking-widest">Live Status</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6" id="assigned-fleets-grid">
                {assignedFleets.map((fleet, index) => (
                    <div class:list={[
                        "bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm flex flex-col gap-6 relative overflow-hidden group hover:shadow-xl transition-all duration-500 fleet-card",
                        index >= 2 ? "hidden extra-fleet" : ""
                    ]}>
                        <!-- BG Accent -->
                        <div class:list={["absolute top-0 right-0 w-32 h-32 opacity-5 rounded-full -translate-y-1/2 translate-x-1/2", fleet.type === 'RUTE' ? 'bg-primary' : 'bg-secondary']}></div>
                        
                        <div class="flex items-center justify-between relative z-10">
                            <div class="flex flex-col gap-1">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{fleet.id}</span>
                                <h3 class="text-2xl font-black text-primary">{fleet.fleet_code || fleet.name}</h3>
                            </div>
                            <Badge variant={fleet.type === 'rute' || fleet.type === 'RUTE' ? 'sky' : 'warning'} class="px-4 py-1.5 text-[10px]">
                                {fleet.badge_label || fleet.type}
                            </Badge>
                        </div>

                        <div class="grid grid-cols-1 gap-4 relative z-10">
                            {fleet.type === 'rute' || fleet.type === 'RUTE' ? (
                                <>
                                    <div class="flex justify-between items-center py-3 border-b border-dashed border-slate-100">
                                        <span class="text-xs font-bold text-slate-400 uppercase">Rute Perjalanan</span>
                                        <span class="text-sm font-black text-slate-900">{fleet.route || fleet.details?.path || '-'}</span>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100/50">
                                            <span class="text-[9px] font-bold text-slate-400 uppercase block mb-1">Total Penumpang</span>
                                            <span class="text-sm font-black text-primary">{fleet.total_passengers ?? fleet.details?.pax ?? 0} Orang</span>
                                        </div>
                                        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100/50">
                                            <span class="text-[9px] font-bold text-slate-400 uppercase block mb-1">Total Paket</span>
                                            <span class="text-sm font-black text-primary">{fleet.total_packages ?? fleet.details?.packages ?? 0} Item</span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-2">
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Supir Bertugas</span>
                                        <div class="flex gap-2">
                                            {(fleet.drivers || fleet.details?.drivers || []).map(d => (
                                                <span class="px-3 py-1 bg-sky-50 text-sky-600 text-[10px] font-black rounded-lg">{d}</span>
                                            ))}
                                        </div>
                                    </div>
                                </>
                            ) : (
                                <>
                                    <div class="flex flex-col gap-1 py-3 border-b border-dashed border-slate-100">
                                        <span class="text-[8px] font-bold text-slate-400 uppercase">Pelanggan</span>
                                        <div class="flex justify-between items-end">
                                            <span class="text-sm font-black text-slate-900">{fleet.customer_name || fleet.details?.customer || '-'}</span>
                                            <span class="text-[10px] font-bold text-slate-500">{fleet.customer_phone || fleet.details?.phone || '-'}</span>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="flex flex-col gap-1">
                                            <span class="text-[8px] font-bold text-slate-400 uppercase">Lokasi Jemput</span>
                                            <p class="text-[10px] font-bold text-slate-600 line-clamp-1">{fleet.pickup_address || fleet.details?.pickup || '-'}</p>
                                        </div>
                                        <div class="flex flex-col gap-1">
                                            <span class="text-[8px] font-bold text-slate-400 uppercase">Destinasi</span>
                                            <p class="text-[10px] font-bold text-slate-600">{fleet.destination || fleet.details?.destination || '-'}</p>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-2 gap-4">
                                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100/50 text-center">
                                            <span class="text-[8px] font-bold text-slate-400 uppercase block mb-1">Pick Up</span>
                                            <span class="text-[10px] font-black text-slate-900">{fleet.pickup_date || fleet.details?.date_pickup || '-'}</span>
                                        </div>
                                        <div class="bg-slate-50 p-3 rounded-xl border border-slate-100/50 text-center">
                                            <span class="text-[8px] font-bold text-slate-400 uppercase block mb-1">Kembali</span>
                                            <span class="text-[10px] font-black text-slate-900">{fleet.return_date || fleet.details?.date_return || '-'}</span>
                                        </div>
                                    </div>
                                    <div class="flex justify-between items-center pt-2">
                                        <span class="text-[9px] font-bold text-slate-400 uppercase">Supir Bertugas</span>
                                        <span class="px-3 py-1 bg-amber-50 text-amber-600 text-[10px] font-black rounded-lg">{(fleet.drivers && fleet.drivers[0]) || fleet.details?.driver || '-'}</span>
                                    </div>
                                </>
                            )}
                        </div>

                        <!-- Revenue Footer -->
                        <div class="mt-4 pt-6 border-t border-slate-50 flex items-center justify-between relative z-10">
                            <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Estimated Revenue</span>
                            <span class="text-xl font-main font-black text-primary tracking-tight">
                                {new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(fleet.estimated_revenue || fleet.details?.revenue || 0)}
                            </span>
                        </div>
                    </div>
                ))}
            </div>
            <button id="toggle-fleet-btn" class="mx-auto mt-2 px-6 py-3 bg-slate-100 text-slate-600 rounded-full font-bold text-xs hover:bg-slate-200 transition-all cursor-pointer flex items-center gap-2">
                <span id="toggle-fleet-text">Lihat Semua Armada</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </button>
        </section>

        <!-- Quick Message -->
        <div class="bg-btn-linear rounded-[2.5rem] p-10 text-white flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden shadow-2xl shadow-primary/30">
             <div class="absolute top-0 left-0 w-full h-full opacity-10 pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')]"></div>
             <div class="relative z-10 flex flex-col gap-2 max-w-xl text-center md:text-left">
                 <h3 class="text-3xl font-black tracking-tight">Pusat Pesan Operasional</h3>
                 <p class="text-white/80 font-medium leading-relaxed">Pantau status armada dan pastikan semua supir telah melaporkan titik koordinat terakhir mereka setiap 3 jam sekali.</p>
             </div>
             <a href="/admin/bookings" class="relative z-10 bg-white text-primary px-10 py-5 rounded-2xl font-black text-sm uppercase tracking-widest shadow-xl hover:scale-105 active:scale-95 transition-all">
                Cek Antrean Detail
             </a>
        </div>
    </div>
</AdminLayout>

<script>
    const setupDashboardInteractions = () => {
        // Toggle Fleet Button Logic (8.1)
        const toggleFleetBtn = document.getElementById('toggle-fleet-btn');
        const toggleFleetText = document.getElementById('toggle-fleet-text');
        const extraFleets = document.querySelectorAll('.extra-fleet');

        if (extraFleets.length === 0 && toggleFleetBtn) {
            toggleFleetBtn.style.display = 'none'; // Hide if no extra fleets
        }

        toggleFleetBtn?.addEventListener('click', () => {
            const isHidden = extraFleets[0]?.classList.contains('hidden');
            
            extraFleets.forEach(fleet => {
                if (isHidden) {
                    fleet.classList.remove('hidden');
                    fleet.classList.add('animate-fade-in');
                } else {
                    fleet.classList.add('hidden');
                    fleet.classList.remove('animate-fade-in');
                }
            });

            if (toggleFleetText) {
                toggleFleetText.textContent = isHidden ? 'Sembunyikan Armada' : 'Lihat Semua Armada';
            }
        });

        // Approve Driver Logic (8.2)
        const approveBtns = document.querySelectorAll('.approve-btn');
        const rejectBtns = document.querySelectorAll('.reject-btn');
        const assignedFleetsGrid = document.getElementById('assigned-fleets-grid');

        approveBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                const card = target.closest('.approval-card') as HTMLElement;
                
                // Add fade out animation
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                card.style.transition = 'all 0.3s ease';

                setTimeout(() => {
                    // Extract data to build a new fleet card (Simulated visual move)
                    card.style.display = 'none';
                    
                    // In a real app, we'd trigger an API, then append the newly built HTML.
                    // For pure Front-End PRD, we just hide the approval card and could theoretically append a new node to assignedFleetsGrid.
                    alert('Driver disetujui! Memindahkan data ke Daftar Armada Bertugas...');
                    
                    // Optional: remove section if empty
                    const remainingCards = document.querySelectorAll('.approval-card[style*="display: none"]');
                    if(remainingCards.length === approveBtns.length) {
                        document.getElementById('approval-section')?.remove();
                    }
                }, 300);
            });
        });

        rejectBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                const card = target.closest('.approval-card') as HTMLElement;
                
                if(confirm("Tolak pengajuan driver ini?")) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    card.style.transition = 'all 0.3s ease';

                    setTimeout(() => {
                        card.remove();
                        const allCards = document.querySelectorAll('.approval-card');
                        if(allCards.length === 0) {
                            document.getElementById('approval-section')?.remove();
                        }
                    }, 300);
                }
            });
        });
    };

    document.addEventListener('DOMContentLoaded', setupDashboardInteractions);
    document.addEventListener('astro:page-load', setupDashboardInteractions);
</script>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
</style>






