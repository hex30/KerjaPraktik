---
// File: src/pages/admin/packages.astro
import AdminLayout from "@layouts/AdminLayout.astro";
import AdminBadge from "@ui/AdminBadge.astro";
import PackageRow from "@features/admin/bookings/PackageRow.astro";
import PaymentPreviewModal from "@features/admin/bookings/PaymentPreviewModal.astro";
import { adminBookingService } from "@services/adminBookingService";

// Baca token dari cookies saat mode SSR
const token = Astro.cookies.get('token')?.value;

// Fetch data paket dan armada dari Backend via SSR
const [packageData, rawFleets] = await Promise.all([
    adminBookingService.getPackageShipments(token),
    adminBookingService.getMasterFleets(token)
]);

// Filter fleet (Elf pertama, lalu Luxio) dan mapping data
const fleetsData = rawFleets
    .filter(f => f.type?.toLowerCase().includes('elf') || f.type?.toLowerCase().includes('luxio'))
    .sort((a, b) => {
        const aType = a.type?.toLowerCase() || '';
        const bType = b.type?.toLowerCase() || '';
        if (aType.includes('elf') && !bType.includes('elf')) return -1;
        if (!aType.includes('elf') && bType.includes('elf')) return 1;
        return 0;
    });

// PISAHKAN DATA BERDASARKAN KATEGORI
const activePackages = packageData.filter((item: any) => !['selesai', 'selesai_final', 'completed', 'dibatalkan', 'ditolak', 'cancelled'].includes(item.transaction_status?.toLowerCase()));
const completedPackages = packageData.filter((item: any) => ['selesai', 'selesai_final', 'completed'].includes(item.transaction_status?.toLowerCase()));
const cancelledPackages = packageData.filter((item: any) => ['dibatalkan', 'ditolak', 'cancelled'].includes(item.transaction_status?.toLowerCase()));
---

<AdminLayout title="Manajemen Paket">
    <section>
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-black text-slate-900 tracking-tight">Data Penitipan Paket</h2>
                <p class="text-sm text-slate-500 font-secondary mt-1">Kelola daftar kiriman barang kilat dari pelanggan.</p>
            </div>
        </div>

        <div class="flex flex-col gap-12 package-container">
            
            <!-- BAGIAN 1: ANTREAN AKTIF -->
            <div>
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-black text-slate-800 tracking-tight">Antrean Aktif</h3>
                    <span class="px-3 py-1 bg-primary/10 text-primary font-bold text-[10px] rounded-full">{activePackages.length} Paket</span>
                </div>
                
                {activePackages.length === 0 ? (
                    <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                        <p class="text-slate-400 font-bold text-sm">Tidak ada paket aktif saat ini.</p>
                    </div>
                ) : (
                    <div class="flex flex-col">
                        {activePackages.map((pkg: any) => (
                            <PackageRow pkg={pkg} fleetsData={fleetsData} />
                        ))}
                    </div>
                )}
            </div>

            <!-- BAGIAN 2: PAKET SELESAI -->
            <div>
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-500 block"></span>
                        Paket Selesai
                    </h3>
                    <span class="px-3 py-1 bg-emerald-50 text-emerald-600 font-bold text-[10px] rounded-full">{completedPackages.length} Riwayat</span>
                </div>

                {completedPackages.length === 0 ? (
                    <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                        <p class="text-slate-400 font-bold text-sm">Belum ada riwayat pengiriman selesai.</p>
                    </div>
                ) : (
                    <div class="flex flex-col">
                        {completedPackages.slice(0, 3).map((pkg: any) => (
                            <PackageRow pkg={pkg} fleetsData={fleetsData} />
                        ))}
                        
                        {completedPackages.length > 3 && (
                            <div class="mt-4">
                                <a href="/admin/history/completed?type=PACKAGE" class="block w-full py-4 text-center bg-emerald-50 hover:bg-emerald-100 text-emerald-600 text-xs font-bold uppercase tracking-widest rounded-xl transition-colors">
                                    Lihat Keseluruhan ({completedPackages.length} Data)
                                </a>
                            </div>
                        )}
                    </div>
                )}
            </div>

            <!-- BAGIAN 3: PAKET DIBATALKAN -->
            <div>
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-black text-slate-800 tracking-tight flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-rose-500 block"></span>
                        Paket Dibatalkan
                    </h3>
                    <span class="px-3 py-1 bg-rose-50 text-rose-600 font-bold text-[10px] rounded-full">{cancelledPackages.length} Riwayat</span>
                </div>

                {cancelledPackages.length === 0 ? (
                    <div class="bg-white border border-slate-100 rounded-3xl p-12 text-center shadow-sm">
                        <p class="text-slate-400 font-bold text-sm">Belum ada riwayat paket dibatalkan.</p>
                    </div>
                ) : (
                    <div class="flex flex-col">
                        {cancelledPackages.slice(0, 3).map((pkg: any) => (
                            <PackageRow pkg={pkg} fleetsData={fleetsData} />
                        ))}
                        
                        {cancelledPackages.length > 3 && (
                            <div class="mt-4">
                                <a href="/admin/history/cancelled?type=PACKAGE" class="block w-full py-4 text-center bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-bold uppercase tracking-widest rounded-xl transition-colors">
                                    Lihat Keseluruhan ({cancelledPackages.length} Data)
                                </a>
                            </div>
                        )}
                    </div>
                )}
            </div>

        </div>
    </section>

    <!-- Modal Pratinjau Bukti -->
    <PaymentPreviewModal />
</AdminLayout>

<script>
    import { apiFetch } from '../../services/api';

    const setupPackageAccordion = () => {
        const mainRows = document.querySelectorAll('.package-main-row');
        
        mainRows.forEach(row => {
            row.addEventListener('click', () => {
                const detailRow = row.nextElementSibling as HTMLElement;
                const chevron = row.querySelector('.chevron-icon');
                const isOpening = !detailRow.style.maxHeight;

                // Close all other rows
                mainRows.forEach(otherRow => {
                    const otherDetail = otherRow.nextElementSibling as HTMLElement;
                    const otherChevron = otherRow.querySelector('.chevron-icon');
                    if (otherRow !== row) {
                        otherDetail.style.maxHeight = '';
                        otherChevron?.classList.remove('rotate-180');
                        otherRow.parentElement?.classList.remove('active-card');
                    }
                });

                // Toggle current row
                if (isOpening) {
                    detailRow.style.maxHeight = detailRow.scrollHeight + 'px';
                    chevron?.classList.add('rotate-180');
                    row.parentElement?.classList.add('active-card');
                } else {
                    detailRow.style.maxHeight = '';
                    chevron?.classList.remove('rotate-180');
                    row.parentElement?.classList.remove('active-card');
                }
            });
        });
    };

    const setupActionForms = () => {
        const forms = document.querySelectorAll('.package-action-form');
        forms.forEach(form => {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formEl = form as HTMLFormElement;
                const packageId = formEl.dataset.packageId;
                const currentState = formEl.dataset.currentState;
                const formData = new FormData(formEl);
                const payload = Object.fromEntries(formData.entries());

                const btn = formEl.querySelector('button[type="submit"]');
                const originalText = btn?.textContent;
                if(btn) { btn.textContent = 'Memproses...'; btn.classList.add('opacity-50', 'pointer-events-none'); }

                try {
                    const token = localStorage.getItem('jwt_token') || localStorage.getItem('token');
                    
                    const headers = {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    };

                    if (currentState === 'isPickupList') {
                        // Selesaikan paket
                        await apiFetch(`/api/admin/master/package-shipments/${packageId}`, {
                            method: 'PUT',
                            headers,
                            body: JSON.stringify({ transaction_status: 'selesai' })
                        });
                        alert('Paket berhasil diselesaikan dan masuk ke riwayat!');
                    } else if (currentState === 'isProofUploaded') {
                        // Verifikasi pembayaran paket (ASUMSI BE ADA ENDPOINT INI)
                        await apiFetch(`/api/admin/master/package-shipments/${packageId}/verify`, {
                            method: 'PUT',
                            headers
                        });
                        alert('Pembayaran paket berhasil dikonfirmasi!');
                    } else if (currentState === 'isNew') {
                        // Tetapkan harga dan kirim tagihan
                        const endpoint = `/api/admin/master/package-shipments/${packageId}/assign`;
                        const priceRaw = payload.price as string;
                        const parsedPrice = priceRaw ? parseFloat(priceRaw.replace(/\./g, '')) : undefined;

                        const bodyData = {
                            fleet_id: payload.fleet_id || undefined,
                            price: parsedPrice
                        };

                        await apiFetch(endpoint, {
                            method: 'PUT',
                            headers,
                            body: JSON.stringify(bodyData)
                        });
                        alert('Tagihan berhasil dikirim ke Pelanggan!');
                    }

                    window.location.reload();

                } catch (error: any) {
                    console.error('Error submit form paket:', error);
                    alert(`Gagal: ${error.message} (Cek kembali Endpoint BE)`);
                    if(btn) { btn.textContent = originalText || 'Update Resi & Harga'; btn.classList.remove('opacity-50', 'pointer-events-none'); }
                }
            });
        });
    };

    setupPackageAccordion();
    setupActionForms();
    document.addEventListener('astro:page-load', () => {
        setupPackageAccordion();
        setupActionForms();
    });
</script>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    :global(.package-card) { box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06); }
    :global(.package-card.active-card) { box-shadow: 0 15px 25px -5px rgba(0, 0, 0, 0.05), 10px 0 25px -5px rgba(0, 0, 0, 0.05), -10px 0 25px -5px rgba(0, 0, 0, 0.05); z-index: 10; border-color: #e2e8f0; }
</style>






