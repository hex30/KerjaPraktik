---
// File: src/pages/driver/index.astro
import DriverLayout from "@layouts/DriverLayout.astro";

const manifest = [
    { name: "Fahri Ramdhani", seat: "5", pickup: "Dusun Benteng Hilir, Ciamis", dropoff: "Bangka, Kemang", phone: "081234567890" },
    { name: "Siti Aminah", seat: "12", pickup: "Sukajadi, Panawangan", dropoff: "Pool RTP Grogol", phone: "085211223344" },
];
---

<DriverLayout title="Manajemen Tugas">
    <div class="flex flex-col gap-10">
        <!-- Daily Tasks Grid -->
        <section class="flex flex-col gap-4">
            <h2 class="text-xl font-black text-slate-900 tracking-tight">Tugas Harian Saya</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {[
                    { id: "T-1001", route: "Ciamis ➔ Jakarta", fleet: "ELF Giga (E-1)", date: "20 Okt 2026", time: "08:00 WIB", passengers: 12 },
                    { id: "T-1002", route: "Jakarta ➔ Bandung", fleet: "Hiace Premio (H-2)", date: "21 Okt 2026", time: "14:00 WIB", passengers: 8 }
                ].map(task => (
                    <div class="task-card bg-white rounded-2xl border border-slate-100 shadow-sm p-6 flex flex-col gap-4 relative overflow-hidden group">
                        <div class="task-status-badge absolute top-5 right-5 text-[9px] font-black uppercase tracking-widest px-2.5 py-1 rounded-md bg-amber-100 text-amber-600">
                            Menunggu
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">ID Tugas: #{task.id}</span>
                            <h3 class="text-lg font-black text-slate-900">{task.route}</h3>
                        </div>
                        <div class="flex flex-col gap-3 mt-2">
                            <div class="flex items-center gap-3 text-sm text-slate-600 font-secondary">
                                <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg></div>
                                <span class="font-bold">{task.date} | {task.time}</span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-slate-600 font-secondary">
                                <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg></div>
                                <span class="font-bold">{task.passengers} Penumpang Manifest</span>
                            </div>
                            <div class="flex items-center gap-3 text-sm text-slate-600 font-secondary">
                                <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg></div>
                                <span class="font-bold">{task.fleet}</span>
                            </div>
                        </div>
                        <button class="cta-task-btn w-full mt-4 bg-primary text-white py-3.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all active:scale-95 shadow-lg shadow-primary/20">
                            Terima Tugas Ini
                        </button>
                    </div>
                ))}
            </div>
        </section>

        <!-- Manifest List -->
        <section class="flex flex-col gap-4 mt-4">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2 px-2">
                <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
                Daftar Penumpang Aktif ({manifest.length})
            </h3>

            {manifest.map((p) => (
                <div class="manifest-card bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden transition-all duration-300">
                    <div class="p-5 flex items-center justify-between cursor-pointer manifest-trigger">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full bg-slate-50 border border-slate-100 flex items-center justify-center font-black text-primary text-sm">
                                {p.seat}
                            </div>
                            <div class="flex flex-col">
                                <span class="text-sm font-black text-slate-800">{p.name}</span>
                                <span class="text-[10px] text-slate-400 font-bold uppercase">{p.phone}</span>
                            </div>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-300 transition-transform duration-300 chevron-icon" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    
                    <div class="expand-content max-h-0 overflow-hidden bg-slate-50/50 transition-all duration-500">
                        <div class="p-5 border-t border-slate-100 flex flex-col gap-4">
                            <div class="flex flex-col gap-1">
                                <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Titik Penjemputan</span>
                                <p class="text-xs text-slate-700 leading-relaxed font-bold">{p.pickup}</p>
                            </div>
                            <div class="flex flex-col gap-1">
                                <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Titik Penurunan</span>
                                <p class="text-xs text-slate-700 leading-relaxed font-bold">{p.dropoff}</p>
                            </div>
                            <div class="flex gap-2 pt-2">
                                <a href={`tel:${p.phone}`} class="flex-1 bg-emerald-500 text-white py-3 rounded-xl text-[10px] font-black uppercase text-center flex items-center justify-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 005.405 5.405l.773-1.548a1 1 0 011.06-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" /></svg>
                                    Hubungi
                                </a>
                                <button class="flex-1 bg-primary text-white py-3 rounded-xl text-[10px] font-black uppercase text-center">
                                    Lihat Maps
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </section>
    </div>
</DriverLayout>

<script>
    const setupDriverDashboard = () => {
        // Accordion Logic
        const triggers = document.querySelectorAll('.manifest-trigger');
        triggers.forEach(trigger => {
            trigger.addEventListener('click', () => {
                const parent = trigger.parentElement;
                const content = trigger.nextElementSibling as HTMLElement;
                const chevron = trigger.querySelector('.chevron-icon');
                
                if (content.style.maxHeight) {
                    content.style.maxHeight = '';
                    chevron?.classList.remove('rotate-180');
                } else {
                    document.querySelectorAll('.expand-content').forEach(c => (c as HTMLElement).style.maxHeight = '');
                    document.querySelectorAll('.chevron-icon').forEach(c => c.classList.remove('rotate-180'));
                    
                    content.style.maxHeight = content.scrollHeight + 'px';
                    chevron?.classList.add('rotate-180');
                }
            });
        });

        // Task CTA Multi-State Logic
        const taskBtns = document.querySelectorAll('.cta-task-btn');
        taskBtns.forEach(btn => {
            let state = 0; // 0: Menunggu, 1: Accepted, 2: Completed
            btn.addEventListener('click', () => {
                const badge = btn.parentElement?.querySelector('.task-status-badge');
                if (state === 0) {
                    state = 1;
                    btn.textContent = "Selesaikan Perjalanan";
                    btn.className = "cta-task-btn w-full mt-4 bg-green-500 text-white py-3.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all active:scale-95 shadow-lg shadow-green-500/20";
                    if (badge) {
                        badge.textContent = "Dalam Perjalanan";
                        badge.className = "task-status-badge absolute top-5 right-5 text-[9px] font-black uppercase tracking-widest px-2.5 py-1 rounded-md bg-green-100 text-green-600";
                    }
                } else if (state === 1) {
                    state = 2;
                    btn.textContent = "Tugas Selesai";
                    btn.className = "cta-task-btn w-full mt-4 bg-slate-100 text-slate-400 cursor-not-allowed py-3.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all";
                    if (badge) {
                        badge.textContent = "Selesai";
                        badge.className = "task-status-badge absolute top-5 right-5 text-[9px] font-black uppercase tracking-widest px-2.5 py-1 rounded-md bg-slate-100 text-slate-500";
                    }
                }
            });
        });
    }

    document.addEventListener('DOMContentLoaded', setupDriverDashboard);
    document.addEventListener('astro:page-load', setupDriverDashboard);
</script>
