---
// File: src/pages/driver/index.astro
import DriverLayout from "@layouts/DriverLayout.astro";
import DriverPageHeader from "@features/driver/shared/DriverPageHeader.astro";
import { driverService } from "@services/driverService";

const token = Astro.cookies.get('token')?.value;

// Ambil jadwal aktual dari BE
const schedules = await driverService.getSchedules(token);

// Format ke dalam daftar tugas (Tasks)
const passengerTasks: any[] = [];
const packageTasks: any[] = [];
const charterTasks: any[] = [];

const formatRupiah = (angka: number | string) => {
    return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        minimumFractionDigits: 0
    }).format(Number(angka) || 0);
};

const formatAddress = (addressData: any) => {
    if (!addressData) return [{ label: 'Detail', value: 'Sesuai Titik Tujuan/Penjemputan' }];
    
    let addr = addressData;
    if (typeof addressData === 'string') {
        try {
            addr = JSON.parse(addressData);
            if (typeof addr === 'string') addr = JSON.parse(addr);
        } catch (e) {
            return [{ label: 'Alamat Lengkap', value: addressData }];
        }
    }
    
    if (typeof addr === 'object' && addr !== null) {
        let parts = [];
        if (addr.dusun) parts.push({ label: 'Dusun', value: addr.dusun });
        if (addr.desa) parts.push({ label: 'Desa', value: addr.desa });
        if (addr.kecamatan) parts.push({ label: 'Kecamatan', value: addr.kecamatan });
        if (addr.rt_rw) parts.push({ label: 'RT/RW', value: addr.rt_rw });
        if (addr.patokan) parts.push({ label: 'Patokan', value: addr.patokan });
        
        return parts.length > 0 ? parts : [{ label: 'Alamat Lengkap', value: typeof addressData === 'string' ? addressData : JSON.stringify(addressData) }];
    }

    return [{ label: 'Alamat Lengkap', value: String(addressData) }];
};

schedules.forEach(schedule => {
    const routeName = schedule.origin && schedule.destination 
        ? `${schedule.origin} ➔ ${schedule.destination}`
        : 'Rute Tidak Diketahui';
        
    const dateFormatted = new Date(schedule.departure_time).toLocaleDateString('id-ID', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
    });

    if (schedule.isCharter) {
        let paymentStatus = 'BELUM LUNAS';
        let statusColor = 'bg-amber-50 text-amber-600';
        
        const isCash = schedule.payment_method?.toLowerCase() === 'cash';
        
        if (isCash) {
            // Untuk cash, hanya lunas jika status perjalanannya sudah selesai
            if (schedule.status === 'selesai' || schedule.status === 'selesai_final') {
                paymentStatus = 'SUDAH LUNAS';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        } else {
            // Untuk cashless, dianggap lunas/DP jika statusnya dibayar / jalan / selesai
            if (['dibayar', 'dalam_penjemputan', 'on_going', 'selesai', 'selesai_final'].includes(schedule.status)) {
                paymentStatus = 'SUDAH LUNAS / DP';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        }

        charterTasks.push({
            charter_id: schedule.id,
            route: `Charter: ${schedule.destination}`,
            date: dateFormatted,
            passenger_name: schedule.customer_name || 'Tidak Diketahui',
            initial: (schedule.customer_name ? schedule.customer_name.charAt(0).toUpperCase() : 'C'),
            phone: schedule.customer_phone,
            price: schedule.price || 0,
            status: schedule.status,
            payment_status: paymentStatus,
            payment_method: schedule.payment_method || 'QRIS/Transfer',
            statusColor: statusColor,
            plate_number: schedule.plate_number,
            car_type: schedule.car_type
        });
        return;
    }

    schedule.passengers?.forEach(p => {
        let paymentStatus = 'MENUNGGU';
        let statusColor = 'bg-amber-50 text-amber-600';
        
        const isCash = p.payment_method?.toLowerCase() === 'cash';
        
        if (isCash) {
            // Untuk cash, hanya lunas jika status perjalanannya sudah selesai (driver sudah tagih & upload bukti)
            if (p.booking_status === 'selesai' || p.booking_status === 'selesai_final') {
                paymentStatus = 'SUDAH LUNAS';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        } else {
            // Untuk cashless, lunas jika sudah dibayar oleh customer / dalam penjemputan / selesai
            if (['dibayar', 'dalam_penjemputan', 'dalam_perjalanan', 'selesai', 'selesai_final'].includes(p.booking_status)) {
                paymentStatus = 'SUDAH LUNAS';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        }

        passengerTasks.push({
            schedule_id: schedule.id,
            booking_id: p.booking_id,
            route: routeName,
            date: dateFormatted,
            baggage: 'Standar', 
            payment_status: paymentStatus,
            payment_method: p.payment_method || 'QRIS/Transfer',
            statusColor: statusColor,
            price: p.price || schedule.base_price,
            pickup_address: formatAddress(p.pickup_address),
            dropoff_address: formatAddress(p.dropoff_address),
            passenger_name: p.passenger_name || 'Tidak Diketahui',
            initial: (p.passenger_name ? p.passenger_name.charAt(0).toUpperCase() : 'U'),
            booking_status: p.booking_status,
            seat_number: p.seat_number
        });
    });

    schedule.packages?.forEach(pkg => {
        let paymentStatus = 'BELUM LUNAS';
        let statusColor = 'bg-amber-50 text-amber-600';
        
        const isCash = pkg.payment_method?.toLowerCase() === 'cash';
        
        if (isCash) {
            // Untuk cash, hanya lunas jika status paketnya sudah delivered
            if (pkg.status === 'delivered') {
                paymentStatus = 'SUDAH LUNAS';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        } else {
            // Untuk cashless, dianggap lunas jika status transaksi settlement/capture/dibayar/selesai/completed
            if (['settlement', 'capture', 'dibayar', 'selesai', 'completed'].includes(pkg.transaction_status?.toLowerCase()) || pkg.payment_method?.toLowerCase() === 'cashless') {
                paymentStatus = 'SUDAH LUNAS';
                statusColor = 'bg-emerald-50 text-emerald-600';
            } else {
                paymentStatus = 'BELUM LUNAS';
                statusColor = 'bg-amber-50 text-amber-600';
            }
        }

        packageTasks.push({
            schedule_id: schedule.id,
            package_id: pkg.package_id,
            route: routeName,
            date: dateFormatted,
            dimensions: `${pkg.weight || 0}kg (${pkg.dimension || 'Standar'})`,
            payment_status: paymentStatus,
            payment_method: pkg.payment_method || 'Cash',
            statusColor: statusColor,
            price: pkg.original_price || 0,
            sender_address: [{ label: 'Alamat Lengkap', value: 'Titik Asal / Pool' }],
            receiver_address: formatAddress(pkg.receiver_address),
            receiver_name: pkg.receiver_name || 'Tidak Diketahui',
            initial: (pkg.receiver_name ? pkg.receiver_name.charAt(0).toUpperCase() : 'P'),
            status: pkg.status
        });
    });
});

// Sort tasks: completed at the bottom
passengerTasks.sort((a, b) => {
    const aCompleted = a.booking_status === 'selesai';
    const bCompleted = b.booking_status === 'selesai';
    return (aCompleted === bCompleted) ? 0 : aCompleted ? 1 : -1;
});

packageTasks.sort((a, b) => {
    const aCompleted = a.status === 'delivered';
    const bCompleted = b.status === 'delivered';
    return (aCompleted === bCompleted) ? 0 : aCompleted ? 1 : -1;
});
---

<DriverLayout title="Manajemen Tugas">
    <div class="flex flex-col gap-10">
        <DriverPageHeader 
            title="Tugas Hari Ini"
            description="Daftar perjalanan, sewa charter, dan kiriman paket yang ditugaskan kepada Anda."
        />

        <!-- Section: Ringkasan Armada & Muatan Kargo -->
        {schedules.length > 0 && (
            <section class="flex flex-col gap-4">
                <h2 class="text-xl font-black text-slate-900 tracking-tight">Status Kapasitas Kargo Anda</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {schedules.map((schedule: any) => {
                        const routeStr = schedule.origin && schedule.destination
                            ? `${schedule.origin} ➔ ${schedule.destination}`
                            : 'Charter / Pengiriman Khusus';
                        const percent = Math.min(100, Math.round(((schedule.total_weight || 0) / (schedule.max_payload || 1450)) * 100));
                        const isOverloaded = (schedule.total_weight || 0) >= (schedule.max_payload || 1450);
                        const isNearLimit = (schedule.total_weight || 0) >= (schedule.max_payload || 1450) * 0.8;
                        
                        return (
                            <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col gap-3">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <h3 class="text-sm font-black text-slate-800 leading-tight">{routeStr}</h3>
                                        <span class="text-[10px] font-bold text-slate-400">
                                            {new Date(schedule.departure_time).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short' })}
                                        </span>
                                    </div>
                                    <span class="px-2 py-1 bg-slate-100 rounded text-xs font-bold text-slate-700">
                                        {schedule.plate_number || 'TBD'} ({schedule.car_type || 'TBD'})
                                    </span>
                                </div>
                                
                                <div class="space-y-1 mt-2">
                                    <div class="flex justify-between items-center text-[10px] font-bold">
                                        <span class="text-slate-400 uppercase tracking-widest">Beban Kargo Terpakai</span>
                                        <span class={isOverloaded ? "text-red-500 font-black" : (isNearLimit ? "text-amber-500 font-black" : "text-slate-600 font-bold")}>
                                            {schedule.total_weight || 0} / {schedule.max_payload || 1450} kg ({percent}%)
                                        </span>
                                    </div>
                                    <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                        <div 
                                            class:list={[
                                                "h-full rounded-full transition-all duration-500",
                                                isOverloaded ? "bg-red-500" : (isNearLimit ? "bg-amber-500" : "bg-[#044751]")
                                            ]}
                                            style={`width: ${percent}%`}
                                        ></div>
                                    </div>
                                    <div class="text-[9px] font-bold text-slate-400 text-right">
                                        Sisa Kapasitas: {Math.max(0, (schedule.max_payload || 1450) - (schedule.total_weight || 0))} kg
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </section>
        )}

        <!-- Section: Tugas Charter Hari Ini -->
        {charterTasks.length > 0 && (
        <section class="flex flex-col gap-4">
            <h2 class="text-xl font-black text-slate-900 tracking-tight">Tugas Charter Hari Ini</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                {charterTasks.map((task) => (
                    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col">
                        <!-- Header -->
                        <div class="p-6 border-b border-slate-100">
                            <div class="flex items-center gap-2 mb-3">
                                <div class="inline-flex items-center px-3 py-1 rounded-full bg-[#044751] text-white text-[10px] font-black uppercase tracking-widest">
                                    CHARTER
                                </div>
                                {task.status === 'selesai' && (
                                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest">
                                        SELESAI
                                    </div>
                                )}
                            </div>
                            <h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight">
                                {task.route}
                            </h3>
                        </div>
                        
                        <!-- Stats Grid -->
                        <div class="grid grid-cols-2 gap-4 p-6 border-b border-slate-100">
                            <div class="flex flex-col gap-1.5">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Tgl Berangkat</span>
                                <span class="text-sm font-bold text-slate-800">{task.date}</span>
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Armada</span>
                                <div class="inline-flex w-fit bg-slate-100 text-slate-700 px-2 py-1 rounded-md text-xs font-bold">
                                    {task.plate_number} ({task.car_type})
                                </div>
                            </div>
                            <div class="flex flex-col gap-1.5 mt-2">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Status Pemb.</span>
                                <div class={`inline-flex w-fit px-2 py-1 rounded-md text-xs font-black ${task.statusColor}`}>
                                    {task.payment_status}
                                </div>
                            </div>
                            <div class="flex flex-col gap-1.5 mt-2">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Harga Charter</span>
                                <span class="text-base font-black text-emerald-600">{formatRupiah(task.price)}</span>
                            </div>
                        </div>
                        
                        <!-- Data Details -->
                        <div class="p-6 hidden flex-col gap-5 mt-auto details-section">
                            <!-- Nama Pemesan -->
                            <div class="flex flex-col gap-1.5">
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nama Pemesan</span>
                                <div class="flex items-center gap-3 mt-1">
                                    <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-black text-xs shrink-0">
                                        {task.initial}
                                    </div>
                                    <span class="text-sm font-bold text-slate-800">{task.passenger_name} ({task.phone || '-'})</span>
                                </div>
                            </div>
                            
                            <!-- Form Aksi -->
                            <div class="mt-2 p-5 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col gap-4">
                                <div class="flex flex-col gap-1.5">
                                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Aksi Charter</label>
                                    <div class="relative">
                                        <select id={`select-charter-${task.charter_id}`} disabled={task.status === 'selesai'} class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-sm font-bold text-slate-800 outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                                            <option value="menunggu_penjemputan" selected={task.status === 'menunggu_penjemputan' || task.status === 'disetujui' || task.status === 'dibayar'}>Menunggu Penjemputan</option>
                                            <option value="dalam_penjemputan" selected={task.status === 'dalam_penjemputan'}>Sedang Menjemput</option>
                                            <option value="on_going" selected={task.status === 'on_going'}>Dalam Perjalanan</option>
                                            <option value="selesai" selected={task.status === 'selesai'}>Selesai / Sudah Sampai</option>
                                        </select>
                                        <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bukti Bayar Cash (Hanya muncul jika Cash dan status selesai dipilih) -->
                                {task.payment_method?.toLowerCase() === 'cash' && (
                                    <div id={`proof-charter-container-${task.charter_id}`} class="hidden flex-col gap-2">
                                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Foto Bukti Penagihan (Cash)</label>
                                        <div class="relative group cursor-pointer">
                                            <input type="file" accept="image/*" id={`file-charter-${task.charter_id}`} class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer">
                                            <div class="w-full py-4 border border-dashed border-slate-200 rounded-xl bg-white flex flex-col items-center justify-center gap-1 group-hover:border-primary transition-colors" id={`file-charter-preview-container-${task.charter_id}`}>
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                <span class="text-[10px] font-bold text-slate-400 text-center px-4" id={`file-charter-text-${task.charter_id}`}>Ambil Foto Bukti Penagihan</span>
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {task.status !== 'selesai' && (
                                    <button data-charter-id={task.charter_id} class="btn-save-charter w-full bg-[#044751] hover:bg-[#03363e] text-white py-3.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-md shadow-primary/20 active:scale-95">
                                        SIMPAN
                                    </button>
                                )}
                            </div>
                        </div>
                        
                        <!-- Toggle Button -->
                        {task.status !== 'selesai' && (
                            <button type="button" class="toggle-details-btn w-full py-3 flex justify-center items-center text-slate-300 hover:text-primary hover:bg-slate-50 transition-colors border-t border-slate-100 mt-auto">
                                <svg class="chevron-icon w-5 h-5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        )}
                    </div>
                ))}
            </div>
        </section>
        )}

        <!-- Section: Tugas Hari Ini (Penumpang) -->
        <section class="flex flex-col gap-4">
            <h2 class="text-xl font-black text-slate-900 tracking-tight">Tugas Hari Ini (Penumpang)</h2>
            
            {passengerTasks.length === 0 ? (
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-8 text-center">
                    <p class="text-sm font-bold text-slate-400">belum ada tugas yang dikirim admin untuk anda</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                    {passengerTasks.map((task) => (
                        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col">
                            <!-- Header -->
                            <div class="p-6 border-b border-slate-100">
                                <div class="flex items-center gap-2 mb-3">
                                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-[#044751] text-white text-[10px] font-black uppercase tracking-widest">
                                        RUTE
                                    </div>
                                    {task.booking_status === 'selesai' && (
                                        <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest">
                                            SELESAI
                                        </div>
                                    )}
                                </div>
                                <h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight">
                                    Travel Reguler: {task.route}
                                </h3>
                            </div>
                            
                            <!-- Stats Grid -->
                            <div class="grid grid-cols-2 gap-4 p-6 border-b border-slate-100">
                                <div class="flex flex-col gap-1.5">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Tgl Berangkat</span>
                                    <span class="text-sm font-bold text-slate-800">{task.date}</span>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Barang Bawaan</span>
                                    <div class="inline-flex w-fit bg-slate-100 text-slate-700 px-2 py-1 rounded-md text-xs font-bold">
                                        {task.baggage}
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5 mt-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Status Pembayaran</span>
                                    <div class={`inline-flex w-fit px-2 py-1 rounded-md text-xs font-black ${task.statusColor}`}>
                                        {task.payment_status}
                                    </div>
                                    <span class="text-[10px] font-bold text-slate-500 mt-0.5">Metode: {task.payment_method}</span>
                                </div>
                                <div class="flex flex-col gap-1.5 mt-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Harga Perjalanan</span>
                                    <span class="text-base font-black text-emerald-600">{formatRupiah(task.price)}</span>
                                </div>
                            </div>
                            
                            <!-- Data Details -->
                            <div class="p-6 hidden flex-col gap-5 mt-auto details-section">
                                <!-- Address Wrapper -->
                                <!-- Nama Penumpang & Kursi -->
                                <div class="flex flex-col md:flex-row justify-between gap-4 md:gap-6">
                                    <!-- Nama Penumpang -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nama Penumpang</span>
                                        <div class="flex items-center gap-3 mt-1">
                                            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-black text-xs shrink-0">
                                                {task.initial}
                                            </div>
                                            <span class="text-sm font-bold text-slate-800">{task.passenger_name}</span>
                                        </div>
                                    </div>
                                    
                                    <!-- No. Kursi -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">No. Kursi</span>
                                        <div class="inline-flex w-fit px-3 py-2 bg-slate-100 text-slate-700 rounded-md text-xs font-black mt-1">
                                            Kursi {task.seat_number || '-'}
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col md:flex-row justify-between gap-4 md:gap-6">
                                    <!-- Penjemputan -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Alamat Detail Penjemputan</span>
                                        <div class="flex flex-col gap-2 mt-1">
                                            {Array.isArray(task.pickup_address) ? task.pickup_address.map((item: any) => (
                                                <div class="flex flex-col">
                                                    <span class="text-xs font-bold text-slate-800">{item.label}</span>
                                                    <span class="text-xs font-normal text-slate-600">{item.value}</span>
                                                </div>
                                            )) : <span class="text-xs font-normal text-slate-600">{task.pickup_address}</span>}
                                        </div>
                                    </div>
                                    
                                    <!-- Tujuan -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Alamat Detail Tujuan</span>
                                        <div class="flex flex-col gap-2 mt-1">
                                            {Array.isArray(task.dropoff_address) ? task.dropoff_address.map((item: any) => (
                                                <div class="flex flex-col">
                                                    <span class="text-xs font-bold text-slate-800">{item.label}</span>
                                                    <span class="text-xs font-normal text-slate-600">{item.value}</span>
                                                </div>
                                            )) : <span class="text-xs font-normal text-slate-600">{task.dropoff_address}</span>}
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Form Aksi -->
                                <div class="mt-2 p-5 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Aksi Penjemputan</label>
                                        <div class="relative">
                                            <select id={`select-passenger-${task.booking_id}`} disabled={task.booking_status === 'selesai'} class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-sm font-bold text-slate-800 outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                                                <option value="dalam_penjemputan" selected={task.booking_status === 'dalam_penjemputan'}>Sedang Menjemput</option>
                                                <option value="dalam_perjalanan" selected={task.booking_status === 'dalam_perjalanan'}>Dalam Perjalanan</option>
                                                <option value="selesai" selected={task.booking_status === 'selesai'}>Sudah Sampai</option>
                                            </select>
                                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Bukti Bayar Cash (Hanya muncul jika Cash dan status selesai dipilih) -->
                                    {task.payment_method?.toLowerCase() === 'cash' && (
                                        <div id={`proof-container-${task.booking_id}`} class="hidden flex-col gap-2">
                                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Foto Bukti Penagihan (Cash)</label>
                                            <div class="relative group cursor-pointer">
                                                <input type="file" accept="image/*" id={`file-passenger-${task.booking_id}`} class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer">
                                                <div class="w-full py-4 border border-dashed border-slate-200 rounded-xl bg-white flex flex-col items-center justify-center gap-1 group-hover:border-primary transition-colors" id={`file-preview-container-${task.booking_id}`}>
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                    <span class="text-[10px] font-bold text-slate-400" id={`file-text-${task.booking_id}`}>Ambil Foto Bukti Penagihan</span>
                                                </div>
                                            </div>
                                        </div>
                                    )}
                                    {task.booking_status !== 'selesai' && (
                                        <button data-booking-id={task.booking_id} class="btn-save-passenger w-full bg-[#044751] hover:bg-[#03363e] text-white py-3.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-md shadow-primary/20 active:scale-95">
                                            SIMPAN
                                        </button>
                                    )}
                                </div>
                            </div>
                            
                            <!-- Toggle Button -->
                            {task.booking_status !== 'selesai' && (
                                <button type="button" class="toggle-details-btn w-full py-3 flex justify-center items-center text-slate-300 hover:text-primary hover:bg-slate-50 transition-colors border-t border-slate-100 mt-auto">
                                    <svg class="chevron-icon w-5 h-5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>
                            )}
                        </div>
                    ))}
                </div>
            )}
        </section>

        <!-- Section: Data Tugas Paket -->
        <section class="flex flex-col gap-4">
            <h2 class="text-xl font-black text-slate-900 tracking-tight">Tugas Paket Hari Ini</h2>
            
            {packageTasks.length === 0 ? (
                <div class="bg-slate-50 border border-slate-100 rounded-2xl p-8 text-center">
                    <p class="text-sm font-bold text-slate-400">belum ada tugas yang dikirim admin untuk anda</p>
                </div>
            ) : (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                    {packageTasks.map((task) => (
                        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden flex flex-col">
                            <!-- Header -->
                            <div class="p-6 border-b border-slate-100">
                                <div class="flex items-center gap-2 mb-3">
                                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-[#044751] text-white text-[10px] font-black uppercase tracking-widest">
                                        RUTE
                                    </div>
                                    {task.status === 'delivered' && (
                                        <div class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase tracking-widest">
                                            SELESAI
                                        </div>
                                    )}
                                </div>
                                <h3 class="text-xl font-black text-slate-900 tracking-tight leading-tight">
                                    Pengiriman Paket: {task.route}
                                </h3>
                            </div>
                            
                            <!-- Stats Grid -->
                            <div class="grid grid-cols-2 gap-4 p-6 border-b border-slate-100">
                                <div class="flex flex-col gap-1.5">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Tgl Berangkat</span>
                                    <span class="text-sm font-bold text-slate-800">{task.date}</span>
                                </div>
                                <div class="flex flex-col gap-1.5">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Dimensi Paket</span>
                                    <div class="inline-flex w-fit bg-slate-100 text-slate-700 px-2 py-1 rounded-md text-xs font-bold">
                                        {task.dimensions}
                                    </div>
                                </div>
                                <div class="flex flex-col gap-1.5 mt-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Status Pembayaran</span>
                                    <div class={`inline-flex w-fit px-2 py-1 rounded-md text-xs font-black ${task.statusColor}`}>
                                        {task.payment_status}
                                    </div>
                                    <span class="text-[10px] font-bold text-slate-500 mt-0.5">Metode: {task.payment_method}</span>
                                </div>
                                <div class="flex flex-col gap-1.5 mt-2">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Harga Pengiriman</span>
                                    <span class="text-base font-black text-emerald-600">{formatRupiah(task.price)}</span>
                                </div>
                            </div>
                            
                            <!-- Data Details -->
                            <div class="p-6 hidden flex-col gap-5 mt-auto details-section">
                                <!-- Address Wrapper -->
                                <div class="flex flex-col md:flex-row justify-between gap-4 md:gap-6">
                                    <!-- Penjemputan -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Alamat Detail Pengirim</span>
                                        <div class="flex flex-col gap-2 mt-1">
                                            {Array.isArray(task.sender_address) ? task.sender_address.map((item: any) => (
                                                <div class="flex flex-col">
                                                    <span class="text-xs font-bold text-slate-800">{item.label}</span>
                                                    <span class="text-xs font-normal text-slate-600">{item.value}</span>
                                                </div>
                                            )) : <span class="text-xs font-normal text-slate-600">{task.sender_address}</span>}
                                        </div>
                                    </div>
                                    
                                    <!-- Tujuan -->
                                    <div class="flex flex-col gap-1.5 w-full md:w-1/2">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Alamat Detail Penerima</span>
                                        <div class="flex flex-col gap-2 mt-1">
                                            {Array.isArray(task.receiver_address) ? task.receiver_address.map((item: any) => (
                                                <div class="flex flex-col">
                                                    <span class="text-xs font-bold text-slate-800">{item.label}</span>
                                                    <span class="text-xs font-normal text-slate-600">{item.value}</span>
                                                </div>
                                            )) : <span class="text-xs font-normal text-slate-600">{task.receiver_address}</span>}
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Nama Pengirim/Penerima -->
                                <div class="flex flex-col gap-1.5">
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Nama Penerima</span>
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-black text-xs shrink-0">
                                            {task.initial}
                                        </div>
                                        <span class="text-sm font-bold text-slate-800">{task.receiver_name}</span>
                                    </div>
                                </div>
                                
                                <!-- Form Aksi -->
                                <div class="mt-2 p-5 bg-slate-50 rounded-2xl border border-slate-100 flex flex-col gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Status Pengiriman</label>
                                        <div class="relative">
                                            <select id={`select-package-${task.package_id}`} disabled={task.status === 'delivered'} class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3.5 text-sm font-bold text-slate-800 outline-none focus:ring-2 focus:ring-primary appearance-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                                                <option value="menunggu_penjemputan" selected={task.status === 'menunggu_penjemputan' || task.status === 'received'}>Sedang Mengambil</option>
                                                <option value="on_transit" selected={task.status === 'on_transit'}>Dalam Perjalanan</option>
                                                <option value="delivered" selected={task.status === 'delivered'}>Sudah Diantar</option>
                                            </select>
                                            <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Bukti Bayar Cash (Hanya muncul jika Cash dan status delivered dipilih) -->
                                    {task.payment_method?.toLowerCase() === 'cash' && (
                                        <div id={`proof-package-container-${task.package_id}`} class="hidden flex-col gap-2">
                                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Foto Bukti Penagihan (Cash)</label>
                                            <div class="relative group cursor-pointer">
                                                <input type="file" accept="image/*" id={`file-package-${task.package_id}`} class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer">
                                                <div class="w-full py-4 border border-dashed border-slate-200 rounded-xl bg-white flex flex-col items-center justify-center gap-1 group-hover:border-primary transition-colors" id={`file-package-preview-container-${task.package_id}`}>
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                    <span class="text-[10px] font-bold text-slate-400 text-center px-4" id={`file-package-text-${task.package_id}`}>Ambil Foto Bukti Penagihan</span>
                                                </div>
                                            </div>
                                        </div>
                                    )}

                                    {task.status !== 'delivered' && (
                                        <button data-package-id={task.package_id} class="btn-save-package w-full bg-[#044751] hover:bg-[#03363e] text-white py-3.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all shadow-md shadow-primary/20 active:scale-95">
                                            SIMPAN
                                        </button>
                                    )}
                                </div>
                            </div>
                            
                            <!-- Toggle Button -->
                            {task.status !== 'delivered' && (
                                <button type="button" class="toggle-details-btn w-full py-3 flex justify-center items-center text-slate-300 hover:text-primary hover:bg-slate-50 transition-colors border-t border-slate-100 mt-auto">
                                    <svg class="chevron-icon w-5 h-5 transition-transform duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>
                            )}
                        </div>
                    ))}
                </div>
            )}
        </section>
    </div>
</DriverLayout>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleBtns = document.querySelectorAll(".toggle-details-btn");
        toggleBtns.forEach(btn => {
            btn.addEventListener("click", (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const card = button.closest(".bg-white");
                const details = card?.querySelector(".details-section");
                const icon = button.querySelector(".chevron-icon");
                
                if (details && icon) {
                    const isCurrentlyHidden = details.classList.contains("hidden");
                    
                    // Tutup semua card lain terlebih dahulu
                    document.querySelectorAll(".details-section").forEach(otherDetails => {
                        if (!otherDetails.classList.contains("hidden")) {
                            otherDetails.classList.add("hidden");
                            otherDetails.classList.remove("flex");
                        }
                    });
                    
                    document.querySelectorAll(".chevron-icon").forEach(otherIcon => {
                        otherIcon.classList.remove("rotate-180");
                    });
                    
                    // Jika card yang diklik sebelumnya tertutup, maka buka
                    if (isCurrentlyHidden) {
                        details.classList.remove("hidden");
                        details.classList.add("flex");
                        icon.classList.add("rotate-180");
                    }
                }
            });
        });
        
        // Menampilkan/menyembunyikan input foto penagihan cash secara dinamis
        const passengerSelects = document.querySelectorAll('select[id^="select-passenger-"]');
        passengerSelects.forEach(select => {
            select.addEventListener('change', (e) => {
                const selectEl = e.currentTarget as HTMLSelectElement;
                const bookingId = selectEl.id.replace('select-passenger-', '');
                const proofContainer = document.getElementById(`proof-container-${bookingId}`);
                if (proofContainer) {
                    if (selectEl.value === 'selesai') {
                        proofContainer.classList.remove('hidden');
                        proofContainer.classList.add('flex');
                        const fileInput = document.getElementById(`file-passenger-${bookingId}`) as HTMLInputElement;
                        if (fileInput) fileInput.required = true;
                    } else {
                        proofContainer.classList.add('hidden');
                        proofContainer.classList.remove('flex');
                        const fileInput = document.getElementById(`file-passenger-${bookingId}`) as HTMLInputElement;
                        if (fileInput) {
                            fileInput.required = false;
                            fileInput.value = '';
                        }
                        const textEl = document.getElementById(`file-text-${bookingId}`);
                        if (textEl) textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Menampilkan nama file yang dipilih
        const passengerFileInputs = document.querySelectorAll('input[id^="file-passenger-"]');
        passengerFileInputs.forEach(input => {
            input.addEventListener('change', (e) => {
                const inputEl = e.currentTarget as HTMLInputElement;
                const bookingId = inputEl.id.replace('file-passenger-', '');
                const textEl = document.getElementById(`file-text-${bookingId}`);
                if (textEl) {
                    if (inputEl.files && inputEl.files.length > 0) {
                        textEl.textContent = inputEl.files[0].name;
                    } else {
                        textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Handle Simpan Penumpang
        const savePassengerBtns = document.querySelectorAll('.btn-save-passenger');
        savePassengerBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const bookingId = button.getAttribute('data-booking-id');
                if (!bookingId) return;
                
                const selectEl = document.getElementById(`select-passenger-${bookingId}`) as HTMLSelectElement;
                if (!selectEl) return;
                
                const newStatus = selectEl.value;
                const originalText = button.innerHTML;
                
                // Cek jika cash dan status selesai, wajib upload foto
                const fileInput = document.getElementById(`file-passenger-${bookingId}`) as HTMLInputElement;
                if (newStatus === 'selesai' && fileInput) {
                    if (!fileInput.files || fileInput.files.length === 0) {
                        window.showFeedbackModal('warning', 'Peringatan', 'Untuk pembayaran Cash, bukti penagihan berupa foto wajib diunggah ketika perjalanan selesai!');
                        return;
                    }
                }
                
                button.disabled = true;
                button.innerHTML = '<span class="flex justify-center items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> MENYIMPAN...</span>';
                
                try {
                    const { apiFetch } = await import('@services/api');
                    
                    let options: any = {};
                    if (newStatus === 'selesai' && fileInput && fileInput.files && fileInput.files.length > 0) {
                        const formData = new FormData();
                        formData.append('status', newStatus);
                        formData.append('payment_proof', fileInput.files[0]);
                        options = {
                            method: 'PUT',
                            body: formData
                        };
                    } else {
                        options = {
                            method: 'PUT',
                            body: JSON.stringify({ status: newStatus })
                        };
                    }

                    const res = await apiFetch(`/api/driver/schedules/bookings/${bookingId}/status`, options);
                    
                    if (res && res.is_schedule_completed) {
                        window.showFeedbackModal('success', 'Tugas Selesai', 'Tugas anda telah berakhir, terimakasih atas kerja kerasnya!', window.location.href);
                    } else {
                        window.showFeedbackModal('success', 'Berhasil', 'Status penumpang berhasil diperbarui!', window.location.href);
                    }
                } catch (error: any) {
                    window.showFeedbackModal('error', 'Gagal', 'Gagal memperbarui status: ' + error.message);
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        });

        // Menampilkan/menyembunyikan input foto penagihan cash secara dinamis untuk paket
        const packageSelects = document.querySelectorAll('select[id^="select-package-"]');
        packageSelects.forEach(select => {
            select.addEventListener('change', (e) => {
                const selectEl = e.currentTarget as HTMLSelectElement;
                const packageId = selectEl.id.replace('select-package-', '');
                const proofContainer = document.getElementById(`proof-package-container-${packageId}`);
                if (proofContainer) {
                    if (selectEl.value === 'delivered') {
                        proofContainer.classList.remove('hidden');
                        proofContainer.classList.add('flex');
                        const fileInput = document.getElementById(`file-package-${packageId}`) as HTMLInputElement;
                        if (fileInput) fileInput.required = true;
                    } else {
                        proofContainer.classList.add('hidden');
                        proofContainer.classList.remove('flex');
                        const fileInput = document.getElementById(`file-package-${packageId}`) as HTMLInputElement;
                        if (fileInput) {
                            fileInput.required = false;
                            fileInput.value = '';
                        }
                        const textEl = document.getElementById(`file-package-text-${packageId}`);
                        if (textEl) textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Menampilkan nama file yang dipilih untuk paket
        const packageFileInputs = document.querySelectorAll('input[id^="file-package-"]');
        packageFileInputs.forEach(input => {
            input.addEventListener('change', (e) => {
                const inputEl = e.currentTarget as HTMLInputElement;
                const packageId = inputEl.id.replace('file-package-', '');
                const textEl = document.getElementById(`file-package-text-${packageId}`);
                if (textEl) {
                    if (inputEl.files && inputEl.files.length > 0) {
                        textEl.textContent = inputEl.files[0].name;
                    } else {
                        textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Handle Simpan Paket
        const savePackageBtns = document.querySelectorAll('.btn-save-package');
        savePackageBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const packageId = button.getAttribute('data-package-id');
                if (!packageId) return;
                
                const selectEl = document.getElementById(`select-package-${packageId}`) as HTMLSelectElement;
                if (!selectEl) return;
                
                const newStatus = selectEl.value;
                const originalText = button.innerHTML;
                
                // Cek jika cash dan status delivered, wajib upload foto
                const fileInput = document.getElementById(`file-package-${packageId}`) as HTMLInputElement;
                if (newStatus === 'delivered' && fileInput) {
                    if (!fileInput.files || fileInput.files.length === 0) {
                        window.showFeedbackModal('warning', 'Peringatan', 'Untuk pembayaran Cash, bukti penagihan berupa foto wajib diunggah ketika paket sudah diantar!');
                        return;
                    }
                }
                
                button.disabled = true;
                button.innerHTML = '<span class="flex justify-center items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> MENYIMPAN...</span>';
                
                try {
                    const { apiFetch } = await import('@services/api');
                    
                    let options: any = {};
                    if (newStatus === 'delivered' && fileInput && fileInput.files && fileInput.files.length > 0) {
                        const formData = new FormData();
                        formData.append('status', newStatus);
                        formData.append('payment_proof', fileInput.files[0]);
                        options = {
                            method: 'PUT',
                            body: formData
                        };
                    } else {
                        options = {
                            method: 'PUT',
                            body: JSON.stringify({ status: newStatus })
                        };
                    }

                    const res = await apiFetch(`/api/driver/schedules/packages/${packageId}/status`, options);
                    
                    if (res && res.is_schedule_completed) {
                        window.showFeedbackModal('success', 'Tugas Selesai', 'Tugas anda telah berakhir, terimakasih atas kerja kerasnya!', window.location.href);
                    } else {
                        window.showFeedbackModal('success', 'Berhasil', 'Status paket berhasil diperbarui!', window.location.href);
                    }
                } catch (error: any) {
                    window.showFeedbackModal('error', 'Gagal', 'Gagal memperbarui status paket: ' + error.message);
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        });

        // Menampilkan/menyembunyikan input foto penagihan cash secara dinamis untuk charter
        const charterSelects = document.querySelectorAll('select[id^="select-charter-"]');
        charterSelects.forEach(select => {
            select.addEventListener('change', (e) => {
                const selectEl = e.currentTarget as HTMLSelectElement;
                const charterId = selectEl.id.replace('select-charter-', '');
                const proofContainer = document.getElementById(`proof-charter-container-${charterId}`);
                if (proofContainer) {
                    if (selectEl.value === 'selesai') {
                        proofContainer.classList.remove('hidden');
                        proofContainer.classList.add('flex');
                        const fileInput = document.getElementById(`file-charter-${charterId}`) as HTMLInputElement;
                        if (fileInput) fileInput.required = true;
                    } else {
                        proofContainer.classList.add('hidden');
                        proofContainer.classList.remove('flex');
                        const fileInput = document.getElementById(`file-charter-${charterId}`) as HTMLInputElement;
                        if (fileInput) {
                            fileInput.required = false;
                            fileInput.value = '';
                        }
                        const textEl = document.getElementById(`file-charter-text-${charterId}`);
                        if (textEl) textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Menampilkan nama file yang dipilih untuk charter
        const charterFileInputs = document.querySelectorAll('input[id^="file-charter-"]');
        charterFileInputs.forEach(input => {
            input.addEventListener('change', (e) => {
                const inputEl = e.currentTarget as HTMLInputElement;
                const charterId = inputEl.id.replace('file-charter-', '');
                const textEl = document.getElementById(`file-charter-text-${charterId}`);
                if (textEl) {
                    if (inputEl.files && inputEl.files.length > 0) {
                        textEl.textContent = inputEl.files[0].name;
                    } else {
                        textEl.textContent = "Ambil Foto Bukti Penagihan";
                    }
                }
            });
        });

        // Handle Simpan Charter
        const saveCharterBtns = document.querySelectorAll('.btn-save-charter');
        saveCharterBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const button = e.currentTarget as HTMLButtonElement;
                const charterId = button.getAttribute('data-charter-id');
                if (!charterId) return;
                
                const selectEl = document.getElementById(`select-charter-${charterId}`) as HTMLSelectElement;
                if (!selectEl) return;
                
                const newStatus = selectEl.value;
                const originalText = button.innerHTML;
                
                // Cek jika cash dan status selesai, wajib upload foto
                const fileInput = document.getElementById(`file-charter-${charterId}`) as HTMLInputElement;
                if (newStatus === 'selesai' && fileInput) {
                    if (!fileInput.files || fileInput.files.length === 0) {
                        window.showFeedbackModal('warning', 'Peringatan', 'Untuk pembayaran Cash, bukti penagihan berupa foto wajib diunggah ketika sewa selesai!');
                        return;
                    }
                }
                
                button.disabled = true;
                button.innerHTML = '<span class="flex justify-center items-center gap-2"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> MENYIMPAN...</span>';
                
                try {
                    const { apiFetch } = await import('@services/api');
                    
                    let options: any = {};
                    if (newStatus === 'selesai' && fileInput && fileInput.files && fileInput.files.length > 0) {
                        const formData = new FormData();
                        formData.append('status', newStatus);
                        formData.append('payment_proof', fileInput.files[0]);
                        options = {
                            method: 'PUT',
                            body: formData
                        };
                    } else {
                        options = {
                            method: 'PUT',
                            body: JSON.stringify({ status: newStatus })
                        };
                    }

                    const res = await apiFetch(`/api/driver/schedules/charters/${charterId}/status`, options);
                    
                    window.showFeedbackModal('success', 'Berhasil', 'Status charter berhasil diperbarui!', window.location.href);
                } catch (error: any) {
                    window.showFeedbackModal('error', 'Gagal', 'Gagal memperbarui status charter: ' + error.message);
                } finally {
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        });
    });
</script>
