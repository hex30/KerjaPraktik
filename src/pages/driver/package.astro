---
// File: src/pages/driver/package.astro
import DriverLayout from "@layouts/DriverLayout.astro";
import Button from "@ui/Button.astro";

const activePackages = [
    { id: "PKG-7712", sender: "Budi", receiver: "Ani", destination: "Grogol, Jakarta", status: "WAITING" },
    { id: "PKG-8821", sender: "Siti", receiver: "Joko", destination: "Kemang, Jakarta", status: "IN_TRANSIT" },
];
---

<DriverLayout title="Pengantaran Paket">
    <div class="flex flex-col gap-8">
        <header class="px-2">
            <h2 class="text-xl font-black text-slate-800">Tugas Pengantaran Paket</h2>
            <p class="text-xs text-slate-400 mt-1 font-secondary">Update status paket yang Anda bawa secara real-time.</p>
        </header>

        <section class="flex flex-col gap-6">
            {activePackages.map((pkg) => (
                <div class="bg-white rounded-[2rem] border border-slate-100 shadow-sm overflow-hidden flex flex-col">
                    <div class="p-6 flex flex-col gap-4">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-black text-primary bg-primary/5 px-3 py-1 rounded-full uppercase">ID: #{pkg.id}</span>
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">{pkg.destination}</span>
                        </div>
                        
                        <div class="flex flex-col">
                            <h3 class="text-lg font-black text-slate-800">{pkg.sender} <span class="text-slate-300">➔</span> {pkg.receiver}</h3>
                        </div>

                        <!-- Timeline Stepper -->
                        <div class="flex items-center justify-between relative mt-4 px-2">
                            <div class="absolute h-[2px] bg-slate-100 w-[80%] left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 -z-10"></div>
                            
                            <div class="flex flex-col items-center gap-2">
                                <div class:list={["w-8 h-8 rounded-full border-4 flex items-center justify-center transition-all", pkg.status === 'WAITING' || pkg.status === 'IN_TRANSIT' || pkg.status === 'DELIVERED' ? 'bg-primary border-primary/20 text-white shadow-md' : 'bg-white border-slate-100 text-slate-300']}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" /></svg>
                                </div>
                                <span class="text-[8px] font-bold uppercase text-slate-400">Menunggu</span>
                            </div>

                            <div class="flex flex-col items-center gap-2">
                                <div class:list={["w-8 h-8 rounded-full border-4 flex items-center justify-center transition-all", pkg.status === 'IN_TRANSIT' || pkg.status === 'DELIVERED' ? 'bg-primary border-primary/20 text-white shadow-md' : 'bg-white border-slate-100 text-slate-300']}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" /><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05a2.5 2.5 0 014.9 0H19a1 1 0 001-1V10a1 1 0 00-.317-.743l-3-3A1 1 0 0016 6h-2z" /></svg>
                                </div>
                                <span class="text-[8px] font-bold uppercase text-slate-400">Jalan</span>
                            </div>

                            <div class="flex flex-col items-center gap-2">
                                <div class:list={["w-8 h-8 rounded-full border-4 flex items-center justify-center transition-all", pkg.status === 'DELIVERED' ? 'bg-emerald-500 border-emerald-100 text-white shadow-md' : 'bg-white border-slate-100 text-slate-300']}>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                                </div>
                                <span class="text-[8px] font-bold uppercase text-slate-400">Sampai</span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Area -->
                    <div class="bg-slate-50 p-6 flex flex-col gap-4 border-t border-slate-100">
                        {pkg.status === 'WAITING' && (
                            <Button class="w-full bg-primary" size="lg">Update: Dalam Perjalanan</Button>
                        )}
                        
                        {pkg.status === 'IN_TRANSIT' && (
                            <div class="flex flex-col gap-4 package-finish-area">
                                <div class="flex flex-col gap-2">
                                    <label class="text-[10px] font-black text-rose-500 uppercase flex items-center gap-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                                        Bukti Foto Penyerahan Wajib
                                    </label>
                                    <div class="relative group">
                                        <input type="file" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer proof-input">
                                        <div class="w-full py-6 border-2 border-dashed border-slate-200 rounded-2xl bg-white flex flex-col items-center justify-center gap-1 group-hover:border-primary transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-300 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                            <span class="text-[9px] font-bold text-slate-400 proof-status">Klik untuk Ambil Foto</span>
                                        </div>
                                    </div>
                                </div>
                                <Button class="w-full bg-emerald-500 hover:bg-emerald-600 finish-btn" size="lg" disabled>
                                    Selesaikan Pengantaran
                                </Button>
                            </div>
                        )}

                        {pkg.status === 'DELIVERED' && (
                            <div class="py-2 flex items-center justify-center gap-2 text-emerald-600 font-black text-xs uppercase tracking-widest">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                                Selesai
                            </div>
                        )}
                    </div>
                </div>
            ))}
        </section>
    </div>
</DriverLayout>

<script>
    const setupPackageProof = () => {
        const containers = document.querySelectorAll('.package-finish-area');
        
        containers.forEach(container => {
            const input = container.querySelector('.proof-input') as HTMLInputElement;
            const btn = container.querySelector('.finish-btn') as HTMLButtonElement;
            const statusText = container.querySelector('.proof-status');

            if (input && btn && statusText) {
                input.addEventListener('change', () => {
                    if (input.files && input.files.length > 0) {
                        btn.disabled = false;
                        statusText.textContent = 'Foto Berhasil Diambil: ' + input.files[0].name;
                        statusText.classList.remove('text-slate-400');
                        statusText.classList.add('text-emerald-600');
                    } else {
                        btn.disabled = true;
                        statusText.textContent = 'Klik untuk Ambil Foto';
                        statusText.classList.remove('text-emerald-600');
                        statusText.classList.add('text-slate-400');
                    }
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', setupPackageProof);
    document.addEventListener('astro:page-load', setupPackageProof);
</script>
