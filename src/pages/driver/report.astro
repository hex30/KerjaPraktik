---
// File: src/pages/driver/report.astro
import DriverLayout from "@layouts/DriverLayout.astro";
import DriverPageHeader from "@features/driver/shared/DriverPageHeader.astro";
import Button from "@ui/Button.astro";
import { driverService } from "@services/driverService";

const token = Astro.cookies.get('token')?.value;
const [schedules, allFleets] = await Promise.all([
    driverService.getSchedules(token),
    driverService.getFleets(token)
]);

// Map daftar armada untuk dropdown Laporan Kerusakan
const uniqueFleets = allFleets.map((f: any) => ({
    id: f.id,
    plate: f.plate_number,
    car: f.car_type
}));
---

<DriverLayout title="Laporan Operasional">
    <div class="flex flex-col gap-8">
        <DriverPageHeader 
            title="Laporan Operasional"
            description="Isi form di bawah ini untuk melaporkan biaya perjalanan atau kerusakan armada."
        />
        
        <!-- Section: Biaya Perjalanan -->
        <section class="flex flex-col gap-4">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest px-2 flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
                Input Biaya Perjalanan
            </h3>
            
            <form id="expense-form" class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex flex-col gap-5">
                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Jadwal Tugas</label>
                    <select name="schedule_id" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none truncate" required>
                        <option value="" disabled selected>Pilih Jadwal</option>
                        {schedules.map((schedule: any) => (
                            <option value={schedule.id}>
                                {schedule.origin ? `${schedule.origin} - ${schedule.destination}` : schedule.destination} ({new Date(schedule.departure_time).toLocaleDateString("id-ID", { day: "numeric", month: "short" })})
                            </option>
                        ))}
                    </select>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Kategori</label>
                    <select name="category" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none truncate" required>
                        <option value="fuel">Bahan Bakar (Fuel)</option>
                        <option value="toll">Tol</option>
                        <option value="parking">Parkir</option>
                        <option value="other">Lainnya</option>
                    </select>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Keterangan / Item</label>
                    <input type="text" name="description" placeholder="Contoh: Isi bensin di rest area KM 102..." class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none">
                </div>
                
                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Jumlah (IDR)</label>
                    <input type="number" name="amount" placeholder="0" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-black text-primary outline-none" required>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Foto Nota / Bukti</label>
                    <div class="relative group cursor-pointer">
                        <input type="file" name="proof_image" accept="image/*" id="proof_image_input" class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer" required>
                        <div class="w-full py-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 flex flex-col items-center justify-center gap-2 group-hover:border-primary transition-colors" id="proof_image_preview_container">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            <span class="text-[10px] font-bold text-slate-400" id="proof_image_text">Ambil Foto / Upload</span>
                        </div>
                    </div>
                </div>

                <Button type="submit" id="btn-submit-expense" class="w-full mt-2" size="lg">Kirim Laporan</Button>
            </form>
        </section>

        <!-- Section: Laporan Kerusakan -->
        <section class="flex flex-col gap-4">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest px-2 flex items-center gap-2">
                <div class="w-1.5 h-1.5 rounded-full bg-rose-500"></div>
                Laporan Kerusakan Armada
            </h3>
            
            <form id="maintenance-form" class="bg-white p-6 rounded-[2rem] border border-slate-100 shadow-sm flex flex-col gap-5">
                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Jadwal Tugas / Armada Terkait</label>
                    <select name="fleet_id" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none truncate" required>
                        <option value="" disabled selected>Pilih Armada</option>
                        {uniqueFleets.map((fleet: any) => (
                            <option value={fleet.id}>
                                {fleet.plate} - {fleet.car}
                            </option>
                        ))}
                    </select>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Tanggal Perbaikan (Service Date)</label>
                    <input type="date" name="service_date" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none" required>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Keterangan Perbaikan (Description)</label>
                    <textarea name="description" rows="3" placeholder="Contoh: Ganti oli mesin, perbaikan AC kurang dingin..." class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-medium focus:ring-1 focus:ring-primary outline-none resize-none" required></textarea>
                </div>
                
                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Biaya Perbaikan / Servis (IDR)</label>
                    <input type="number" name="cost" placeholder="0" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-3 text-sm font-black text-primary outline-none" required>
                </div>

                <div class="flex flex-col gap-2">
                    <label class="text-[10px] font-bold text-slate-500 uppercase">Foto Nota / Bukti Servis</label>
                    <div class="relative group cursor-pointer">
                        <input type="file" name="proof_image" accept="image/*" id="maint_proof_image_input" class="absolute inset-0 w-full h-full opacity-0 z-10 cursor-pointer" required>
                        <div class="w-full py-8 border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50 flex flex-col items-center justify-center gap-2 group-hover:border-primary transition-colors" id="maint_proof_image_preview_container">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-300 group-hover:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            <span class="text-[10px] font-bold text-slate-400" id="maint_proof_image_text">Ambil Foto / Upload Nota</span>
                        </div>
                    </div>
                </div>

                <Button type="submit" id="btn-submit-maint" class="w-full mt-2" size="lg">Laporkan Kendala</Button>
            </form>
        </section>
    </div>
</DriverLayout>

<script>
    import { apiFetch } from "../../services/api";

    const setupExpenseForm = () => {
        const form = document.getElementById("expense-form") as HTMLFormElement;
        const fileInput = document.getElementById("proof_image_input") as HTMLInputElement;
        const fileText = document.getElementById("proof_image_text");
        const btnSubmit = document.getElementById("btn-submit-expense") as HTMLButtonElement;

        if (fileInput && fileText) {
            fileInput.addEventListener("change", (e) => {
                const target = e.target as HTMLInputElement;
                if (target.files && target.files.length > 0) {
                    fileText.textContent = target.files[0].name;
                } else {
                    fileText.textContent = "Ambil Foto / Upload";
                }
            });
        }

        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const formData = new FormData(form);

                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = "Mengirim...";
                }

                try {
                    await apiFetch("/api/driver/expenses", {
                        method: "POST",
                        body: formData
                    });
                    
                    window.showFeedbackModal("success", "Berhasil", "Laporan pengeluaran berhasil dikirim!");
                    form.reset();
                    if (fileText) fileText.textContent = "Ambil Foto / Upload";
                } catch (error: any) {
                    window.showFeedbackModal("error", "Gagal", "Gagal mengirim laporan: " + error.message);
                } finally {
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = "Kirim Laporan";
                    }
                }
            });
        }
    };

    const setupMaintenanceForm = () => {
        const form = document.getElementById("maintenance-form") as HTMLFormElement;
        const fileInput = document.getElementById("maint_proof_image_input") as HTMLInputElement;
        const fileText = document.getElementById("maint_proof_image_text");
        const btnSubmit = document.getElementById("btn-submit-maint") as HTMLButtonElement;

        if (fileInput && fileText) {
            fileInput.addEventListener("change", (e) => {
                const target = e.target as HTMLInputElement;
                if (target.files && target.files.length > 0) {
                    fileText.textContent = target.files[0].name;
                } else {
                    fileText.textContent = "Ambil Foto / Upload Nota";
                }
            });
        }

        if (form) {
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                const formData = new FormData(form);

                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.innerHTML = "Mengirim...";
                }

                try {
                    await apiFetch("/api/driver/maintenance-logs", {
                        method: "POST",
                        body: formData
                    });
                    
                    window.showFeedbackModal("success", "Berhasil", "Laporan kerusakan armada berhasil dikirim!");
                    form.reset();
                    if (fileText) fileText.textContent = "Ambil Foto / Upload Nota";
                } catch (error: any) {
                    window.showFeedbackModal("error", "Gagal", "Gagal mengirim laporan: " + error.message);
                } finally {
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = "Laporkan Kendala";
                    }
                }
            });
        }
    };

    document.addEventListener("astro:page-load", () => {
        setupExpenseForm();
        setupMaintenanceForm();
    });
    setupExpenseForm();
    setupMaintenanceForm();
</script>
