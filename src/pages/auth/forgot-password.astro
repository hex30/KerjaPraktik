---
// File: src/pages/auth/forgot-password.astro
import Layout from "@layouts/MainLayout.astro";
import InputGroup from "@ui/InputGroup.astro";
import Button from "@ui/Button.astro";
import FeedbackModal from "@components/ui/FeedbackModal.astro";
---

<Layout title="Lupa Kata Sandi | Rini Trans Putri">
    <section
        class="min-h-screen bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 font-main"
    >
        <div
            class="max-w-5xl w-full bg-white rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row relative"
        >
            <!-- Left Side Image -->
            <div
                class="hidden md:flex md:w-1/2 relative bg-slate-900 items-center justify-center p-12 overflow-hidden group"
            >
                <img
                    src="/assets/images/contoh.jpg"
                    alt="Armada Mewah Rini Trans Putri"
                    class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-1000"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-br from-primary/90 via-primary/70 to-transparent"
                >
                </div>

                <div class="relative z-10 text-white text-left mt-auto">
                    <span
                        class="inline-block px-3 py-1 mb-4 rounded-full bg-sky-500/20 border border-sky-400/30 text-sky-300 text-xs font-bold uppercase tracking-widest backdrop-blur-sm"
                    >
                        Pemulihan Akun
                    </span>
                    <h2 class="text-4xl font-black mb-4 leading-tight">
                        Keamanan Akun Anda <br />
                        <span class="text-sky-400">Prioritas Kami.</span>
                    </h2>
                    <p
                        class="font-secondary text-sm text-slate-300 leading-relaxed max-w-sm"
                    >
                        Masukkan email terdaftar Anda dan kami akan mengirimkan instruksi untuk mengatur ulang kata sandi Anda.
                    </p>
                </div>
            </div>

            <!-- Right Side Form -->
            <div
                class="w-full md:w-1/2 p-8 sm:p-12 lg:p-16 relative flex flex-col justify-center"
            >
                <div id="form-forgot" class="auth-form block">
                    <header class="mb-8">
                        <h3 class="text-2xl font-black text-primary mb-2">Lupa Kata Sandi?</h3>
                        <p class="font-secondary text-sm text-text-secondary">Jangan khawatir, kami akan membantu memulihkan akun Anda.</p>
                    </header>
                    
                    <form class="flex flex-col gap-5">
                        <InputGroup label="Alamat Email" id="forgot_email" name="email" type="email" placeholder="nama@email.com" required={true} />
                        
                        <div class="flex items-center justify-between mt-1">
                            <a href="/auth/login" class="text-xs font-bold text-sky-500 hover:underline font-secondary">
                                Kembali ke Login
                            </a>
                        </div>

                        <Button type="submit" class="w-full mt-4" size="lg">
                            Kirim Tautan Reset
                        </Button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Umpan Balik (Global Component) -->
    <FeedbackModal />
</Layout>

<script>
    import { authService } from "@services/authService";

    const initForgotPassword = () => {
        const forgotForm = document.querySelector("#form-forgot form") as HTMLFormElement;
        if (forgotForm) {
            forgotForm.addEventListener("submit", async (e) => {
                e.preventDefault();

                const btnSubmit = forgotForm.querySelector('button[type="submit"]') as HTMLButtonElement;
                const originalText = btnSubmit ? btnSubmit.textContent : "Kirim Tautan Reset";
                
                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.textContent = "Mengirim...";
                }

                const emailInput = document.getElementById("forgot_email") as HTMLInputElement;
                const email = emailInput ? emailInput.value : "";

                try {
                    const response = await authService.forgotPassword(email);
                    
                    (window as any).showFeedbackModal(
                        'success',
                        'Permintaan Dikirim!',
                        response.message || 'Instruksi pemulihan telah dikirim jika email terdaftar.',
                        '/auth/login'
                    );

                    forgotForm.reset();
                } catch (err: any) {
                    console.error("Gagal mengirim email reset:", err);
                    (window as any).showFeedbackModal(
                        'error',
                        'Permintaan Gagal',
                        err.message || 'Gagal memproses permintaan pemulihan kata sandi.'
                    );
                } finally {
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.textContent = originalText;
                    }
                }
            });
        }
    };

    document.addEventListener("DOMContentLoaded", initForgotPassword);
    document.addEventListener("astro:page-load", initForgotPassword);
</script>
