---
// File: src/pages/auth/reset-password.astro
import Layout from "@layouts/MainLayout.astro";
import InputGroup from "@ui/InputGroup.astro";
import Button from "@ui/Button.astro";
import FeedbackModal from "@components/ui/FeedbackModal.astro";
---

<Layout title="Atur Ulang Kata Sandi | Rini Trans Putri">
    <section
        class="min-h-screen bg-slate-50 flex items-center justify-center py-12 px-4 sm:px-6 font-main"
    >
        <div
            class="max-w-5xl w-full bg-white rounded-[2.5rem] shadow-2xl overflow-hidden flex flex-col md:flex-row relative"
        >
            <!-- Left Side Image -->
            <div
                class="hidden md:flex md:w-1/2 relative bg-slate-900 items-center justify-center p-12 overflow-hidden group"
            >
                <img
                    src="/assets/images/contoh.jpg"
                    alt="Armada Mewah Rini Trans Putri"
                    class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-1000"
                />
                <div
                    class="absolute inset-0 bg-gradient-to-br from-primary/90 via-primary/70 to-transparent"
                >
                </div>

                <div class="relative z-10 text-white text-left mt-auto">
                    <span
                        class="inline-block px-3 py-1 mb-4 rounded-full bg-sky-500/20 border border-sky-400/30 text-sky-300 text-xs font-bold uppercase tracking-widest backdrop-blur-sm"
                    >
                        Pembaruan Sandi
                    </span>
                    <h2 class="text-4xl font-black mb-4 leading-tight">
                        Atur Ulang <br />
                        <span class="text-sky-400">Kata Sandi Anda.</span>
                    </h2>
                    <p
                        class="font-secondary text-sm text-slate-300 leading-relaxed max-w-sm"
                    >
                        Masukkan kata sandi baru Anda untuk memulihkan akses masuk ke sistem kami.
                    </p>
                </div>
            </div>

            <!-- Right Side Form -->
            <div
                class="w-full md:w-1/2 p-8 sm:p-12 lg:p-16 relative flex flex-col justify-center"
            >
                <div id="form-reset" class="auth-form block">
                    <header class="mb-8">
                        <h3 class="text-2xl font-black text-primary mb-2">Kata Sandi Baru</h3>
                        <p class="font-secondary text-sm text-text-secondary">Silakan buat kata sandi baru yang kuat dan mudah Anda ingat.</p>
                    </header>
                    
                    <!-- Token validation warning screen if token missing -->
                    <div id="token-error" class="hidden flex flex-col gap-4 text-center">
                        <div class="w-16 h-16 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-2 text-rose-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <h4 class="font-bold text-slate-800 text-lg">Token Tidak Valid</h4>
                        <p class="font-secondary text-sm text-slate-500 leading-relaxed">Tautan pemulihan kata sandi tidak valid atau telah kadaluarsa. Silakan lakukan permintaan pemulihan kembali.</p>
                        <a href="/auth/forgot-password" class="mt-4 px-6 py-2.5 bg-primary text-white rounded-xl text-sm font-bold shadow-md hover:shadow-lg transition-all inline-block w-max mx-auto">
                            Minta Tautan Baru
                        </a>
                    </div>

                    <form id="reset-password-form" class="flex flex-col gap-5">
                        <input type="hidden" name="token" id="reset_token" />
                        
                        <InputGroup label="Kata Sandi Baru" id="new_password" name="newPassword" type="password" placeholder="••••••••" required={true} />
                        <InputGroup label="Konfirmasi Kata Sandi" id="confirm_password" name="confirmPassword" type="password" placeholder="••••••••" required={true} />
                        
                        <div class="flex items-center justify-between mt-1">
                            <a href="/auth/login" class="text-xs font-bold text-sky-500 hover:underline font-secondary">
                                Kembali ke Login
                            </a>
                        </div>

                        <Button type="submit" class="w-full mt-4" size="lg">
                            Perbarui Kata Sandi
                        </Button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Umpan Balik (Global Component) -->
    <FeedbackModal />
</Layout>

<script>
    import { authService } from "@services/authService";

    const initResetPassword = () => {
        const formContainer = document.getElementById("reset-password-form");
        const errorContainer = document.getElementById("token-error");
        const tokenInput = document.getElementById("reset_token") as HTMLInputElement;

        // Ambil token dari query string
        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get("token");

        if (!token) {
            // Sembunyikan form dan tampilkan pesan error token
            formContainer?.classList.add("hidden");
            errorContainer?.classList.remove("hidden");
            return;
        }

        if (tokenInput) {
            tokenInput.value = token;
        }

        const resetForm = document.getElementById("reset-password-form") as HTMLFormElement;
        if (resetForm) {
            resetForm.addEventListener("submit", async (e) => {
                e.preventDefault();

                const btnSubmit = resetForm.querySelector('button[type="submit"]') as HTMLButtonElement;
                const originalText = btnSubmit ? btnSubmit.textContent : "Perbarui Kata Sandi";

                const newPasswordInput = document.getElementById("new_password") as HTMLInputElement;
                const confirmPasswordInput = document.getElementById("confirm_password") as HTMLInputElement;

                const newPassword = newPasswordInput ? newPasswordInput.value : "";
                const confirmPassword = confirmPasswordInput ? confirmPasswordInput.value : "";

                if (newPassword !== confirmPassword) {
                    return (window as any).showFeedbackModal(
                        'warning',
                        'Kata Sandi Berbeda',
                        'Konfirmasi kata sandi Anda tidak cocok dengan kata sandi baru. Harap periksa kembali.'
                    );
                }

                if (newPassword.length < 6) {
                    return (window as any).showFeedbackModal(
                        'warning',
                        'Kata Sandi Terlalu Pendek',
                        'Kata sandi baru minimal harus terdiri dari 6 karakter.'
                    );
                }

                if (btnSubmit) {
                    btnSubmit.disabled = true;
                    btnSubmit.textContent = "Memproses...";
                }

                try {
                    const payload = {
                        token: token,
                        newPassword: newPassword
                    };

                    const response = await authService.resetPassword(payload);

                    (window as any).showFeedbackModal(
                        'success',
                        'Kata Sandi Diperbarui!',
                        response.message || 'Kata sandi Anda telah berhasil diubah. Silakan login kembali.',
                        '/auth/login'
                    );

                    resetForm.reset();
                } catch (err: any) {
                    console.error("Gagal melakukan reset password:", err);
                    (window as any).showFeedbackModal(
                        'error',
                        'Reset Password Gagal',
                        err.message || 'Token pemulihan tidak valid atau sudah kadaluarsa.'
                    );
                } finally {
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.textContent = originalText;
                    }
                }
            });
        }
    };

    document.addEventListener("DOMContentLoaded", initResetPassword);
    document.addEventListener("astro:page-load", initResetPassword);
</script>
