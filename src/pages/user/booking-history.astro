---
// File: src/pages/user/booking-history.astro
import Layout from '@layouts/MainLayout.astro';
import OrderItem from '@features/user/OrderItem.astro';
import PaymentPopup from '@features/user/PaymentPopup.astro';
import { userService } from '@services/userService';

// Terapkan AuthGuard & ambil data secara SSR
const token = Astro.cookies.get('token')?.value || '';
const orderHistory = await userService.getUserHistory(token);

---

<Layout title="Riwayat Pesanan | Rini Trans Putri">
    
    <section class="py-12 bg-slate-50 min-h-screen font-main">
        <div class="max-w-5xl mx-auto px-6">
            
            <header class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-primary tracking-tight mb-2">Riwayat Pesanan</h1>
                    <p class="font-secondary text-sm text-text-secondary">Pantau status persetujuan tiket dan pengiriman paket Anda secara real-time.</p>
                </div>
                
                <div class="flex gap-2 bg-white p-1.5 rounded-xl border border-slate-200 w-max text-xs font-bold font-secondary shadow-xs" id="filter-buttons">
                    <button class="px-4 py-2 bg-primary text-white rounded-lg filter-btn" data-filter="all">Semua</button>
                    <button class="px-4 py-2 text-text-secondary hover:bg-slate-100 rounded-lg filter-btn" data-filter="menunggu">Menunggu</button>
                    <button class="px-4 py-2 text-text-secondary hover:bg-slate-100 rounded-lg filter-btn" data-filter="selesai">Selesai</button>
                </div>
            </header>

            {orderHistory.length === 0 ? (
                <div class="bg-white border border-slate-100 rounded-[1.5rem] p-12 text-center shadow-xs">
                    <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    </div>
                    <h3 class="text-lg font-bold text-slate-700 mb-2">Belum Ada Pesanan</h3>
                    <p class="text-slate-400 text-sm font-secondary">Anda belum pernah melakukan pemesanan tiket, charter, maupun paket. Yuk mulai perjalanan pertama Anda!</p>
                    <a href="/services" class="inline-block mt-6 px-6 py-2.5 bg-primary text-white rounded-xl text-sm font-bold shadow-md hover:shadow-lg transition-all">Pesan Sekarang</a>
                </div>
            ) : (
                <div class="flex flex-col gap-6" id="history-list">
                    {orderHistory.map((order) => (
                        <div class="history-item transition-all duration-300" data-status={order.status.toLowerCase()}>
                            <OrderItem order={order} />
                        </div>
                    ))}
                </div>
            )}

            <footer class="mt-12 text-center">
                <p class="font-secondary text-xs text-slate-400 leading-relaxed">
                    Pesanan Anda belum berubah status dalam 1x24 jam? <br />
                    Silakan hubungi admin via <a href="#" class="text-sky-500 font-bold hover:underline">WhatsApp CS Kami</a> untuk konfirmasi kilat.
                </p>
            </footer>

        </div>
    </section>

    <PaymentPopup />

</Layout>

<script>
    // Assign ke window object agar bisa dipanggil dari HTML onclick
    (window as any).selectPaymentMethod = async (orderId: string, type: string, method: string) => {
        try {
            const token = localStorage.getItem('jwt_token') || document.cookie.split('; ').find(row => row.startsWith('token='))?.split('=')[1];
            const endpoint = type === 'travel' 
                ? `/api/travel/bookings/${orderId}/payment-method`
                : `/api/charter/request/${orderId}/payment-method`;
            
            // Perbaiki host backend
            const beHost = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

            const res = await fetch(`${beHost}${endpoint}`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token && { 'Authorization': `Bearer ${token}` })
                },
                body: JSON.stringify({ payment_method: method })
            });

            if (res.ok) {
                if (method === 'cash') {
                    alert('Terima kasih banyak! Silakan bayarkan uang Anda saat sudah dijemput oleh driver.');
                }
                window.location.reload();
            } else {
                const data = await res.json();
                alert(`Gagal: ${data.message || 'Terjadi kesalahan'}`);
            }
        } catch (error) {
            console.error('Error selecting payment method:', error);
            alert('Gagal terhubung ke server');
        }
    };

    // --- FILTER LOGIC ---
    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.filter-btn');
        const items = document.querySelectorAll('.history-item');

        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update styling active button
                buttons.forEach(b => {
                    b.classList.remove('bg-primary', 'text-white');
                    b.classList.add('text-text-secondary', 'hover:bg-slate-100');
                });
                btn.classList.remove('text-text-secondary', 'hover:bg-slate-100');
                btn.classList.add('bg-primary', 'text-white');

                const filterValue = btn.getAttribute('data-filter');

                items.forEach(item => {
                    const status = item.getAttribute('data-status') || '';
                    if (filterValue === 'all') {
                        item.classList.remove('hidden');
                    } else if (filterValue === 'menunggu') {
                        if (status.includes('menunggu') || status === 'pending') {
                            item.classList.remove('hidden');
                        } else {
                            item.classList.add('hidden');
                        }
                    } else if (filterValue === 'selesai') {
                        if (status === 'selesai' || status === 'completed' || status === 'approved') {
                            item.classList.remove('hidden');
                        } else {
                            item.classList.add('hidden');
                        }
                    }
                });
            });
        });
    });
</script>






