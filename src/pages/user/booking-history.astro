---
// File: src/pages/user/booking-history.astro
import Layout from '@layouts/MainLayout.astro';
import OrderItem from '@features/user/OrderItem.astro';

// Mock data riwayat pesanan pelanggan untuk keperluan UI/UX Frontend
const orderHistory = [
    {
        id: "RTP-2026-001",
        date: "24 Mei 2026",
        type: "Perjalanan Rute",
        title: "Tasikmalaya → Jakarta Barat",
        details: "Penumpang: Fahri Ramdhani (1 Kursi) | Keberangkatan: 09:00 WIB",
        price: "250.000",
        status: "APPROVED", 
    },
    {
        id: "RTP-2026-002",
        date: "23 Mei 2026",
        type: "Booking Travel (Charter)",
        title: "Sewa Toyota Hiace Commuter",
        details: "Tujuan: Bandung (City Tour) | Tanggal: 30 Mei 2026",
        price: "1.500.000",
        status: "PENDING", 
    },
    {
        id: "RTP-2026-003",
        date: "20 Mei 2026",
        type: "Antar Paket",
        title: "Pengiriman Paket (12 Kg)",
        details: "Pengirim: Cikondang → Penerima: Sukamaju | Dimensi: Sedang",
        price: "85.000",
        status: "REJECTED", 
    }
];
---

<Layout title="Riwayat Pesanan | Rini Trans Putri">
    
    <section class="py-12 bg-slate-50 min-h-screen font-main">
        <div class="max-w-5xl mx-auto px-6">
            
            <header class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h1 class="text-3xl font-black text-primary tracking-tight mb-2">Riwayat Pesanan</h1>
                    <p class="font-secondary text-sm text-text-secondary">Pantau status persetujuan tiket dan pengiriman paket Anda secara real-time.</p>
                </div>
                
                <div class="flex gap-2 bg-white p-1.5 rounded-xl border border-slate-200 w-max text-xs font-bold font-secondary shadow-xs">
                    <button class="px-4 py-2 bg-primary text-white rounded-lg">Semua</button>
                    <button class="px-4 py-2 text-text-secondary hover:bg-slate-100 rounded-lg">Menunggu</button>
                    <button class="px-4 py-2 text-text-secondary hover:bg-slate-100 rounded-lg">Disetujui</button>
                </div>
            </header>

            <div class="flex flex-col gap-6">
                {orderHistory.map((order) => (
                    <OrderItem order={order} />
                ))}
            </div>

            <footer class="mt-12 text-center">
                <p class="font-secondary text-xs text-slate-400 leading-relaxed">
                    Pesanan Anda belum berubah status dalam 1x24 jam? <br />
                    Silakan hubungi admin via <a href="#" class="text-sky-500 font-bold hover:underline">WhatsApp CS Kami</a> untuk konfirmasi kilat.
                </p>
            </footer>

        </div>
    </section>

</UserLayout>






