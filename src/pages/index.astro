---
import Layout from "@layouts/MainLayout.astro";
import HeroSlider from "@features/home/HeroSlider.astro";
import FavoritDestination from "@features/home/FavoritDestination.astro";
import PromoSection from "@features/promotion/PromotionSection.astro";
import FeatureSection from "@features/home/FeatureSection.astro";
import FAQ from "@ui/FAQ.astro";
import { contentService } from "@services/contentService";

// dokumentasi: Inisialisasi variabel untuk menampung data dari Backend
let slidesData = undefined;
let destinationsData = undefined;
let promoData = undefined;

// dokumentasi: Mengambil data Banners (Hero Slider)
try {
  const bannersRes = await contentService.getBanners();
  if (bannersRes?.data && bannersRes.data.length > 0) {
     slidesData = bannersRes.data.map((b: any) => ({
        id: b.id,
        sub: b.subtitle || "INFO TERKINI",
        title: b.title || "Rini Trans Putri",
        desc: b.description || "",
        btnText: b.button_text || "Lihat Detail",
        btnLink: b.button_link || "#",
        bgImage: b.image_url || b.image
     }));
  }
} catch (e) {
  console.error("Gagal load banner:", e);
}

// dokumentasi: Mengambil data Destinasi
try {
  const destRes = await contentService.getDestinations();
  if (destRes?.data && destRes.data.length > 0) {
     destinationsData = destRes.data.map((d: any) => ({
        image: d.image_url || d.image,
        title: d.name || d.title,
        location: d.location || "Indonesia",
        description: d.description
     }));
  }
} catch (e) {
  console.error("Gagal load destinasi:", e);
}

// dokumentasi: Mengambil data Promosi (Ambil item pertama sebagai Highlight)
try {
  const promoRes = await contentService.getPromotions('home');
  if (promoRes?.data && promoRes.data.length > 0) {
     const p = promoRes.data[0];
     
     // Memecah tagline menjadi 3 baris sesuai instruksi desain awal
     const words = (p.tagline || p.title || "Promo Menarik Hari Ini").split(" ");
     const textRow1 = words.length > 0 ? words[0] : "Promo";
     const textRow2 = words.length > 1 ? words[1] : "Spesial";
     const textRow3 = words.length > 2 ? words.slice(2).join(" ") : "Rini Trans";

     // Parsing persentase diskon menjadi bilangan bulat (misal: 20.00 menjadi 20)
     const discountValue = Math.round(parseFloat(p.discount || p.discount_percentage || 0));

     promoData = {
        image: p.image_url || p.image || "/images/dummy-promo.jpg",
        discount: discountValue > 0 ? `${discountValue}% OFF` : `Diskon Rp ${Math.round(parseFloat(p.max_discount || 0))}`,
        noteTitle: p.badge_label || "INFO PROMO",
        noteDesc: p.subtitle || "Berlaku Syarat & Ketentuan",
        textRow1: textRow1,
        textDesc1: p.description || "Jangan lewatkan penawaran spesial ini khusus untuk Anda.",
        textRow2: textRow2,
        textRow3: textRow3,
        textDesc2: p.target_service !== 'all' ? `*Khusus layanan ${p.target_service}` : "Syarat dan ketentuan berlaku.",
        btnLink: "/services",
        btnText: "Pesan Sekarang"
     };
   } else {
     // Fallback jika tidak ada promo aktif
     promoData = {
        image: "/images/dummy-promo.jpg",
        discount: "AMAN dan MUDAH",
        noteTitle: "INFO LAYANAN",
        noteDesc: "Kenyamanan Perjalanan Anda",
        textRow1: "PERJALANAN",
        textRow2: "AMAN DAN",
        textRow3: "NYAMAN",
        textDesc1: "Kemudahan Dalam Setiap Pemesanan Layanan",
        textDesc2: "Sistem Terpadu PT. RINI TRANS PUTRI",
        btnLink: "/services",
        btnText: "Pesan Sekarang",
        isFallback: true
     };
   }
} catch (e) {
  console.error("Gagal load promo:", e);
  // Fallback on error
  promoData = {
    image: "/images/dummy-promo.jpg",
    discount: "AMAN dan MUDAH",
    noteTitle: "INFO LAYANAN",
    noteDesc: "Kenyamanan Perjalanan Anda",
    textRow1: "PERJALANAN",
    textRow2: "AMAN DAN",
    textRow3: "NYAMAN",
    textDesc1: "Kemudahan Dalam Setiap Pemesanan Layanan",
    textDesc2: "Sistem Terpadu PT. RINI TRANS PUTRI",
    btnLink: "/services",
    btnText: "Pesan Sekarang",
    isFallback: true
  };
}
---

<Layout title="Rini Trans Putri | Home">
    <main>
        <!-- dokumentasi: Data Binding ke Komponen UI (Jika undefine, komponen akan merender default dummy) -->
        <HeroSlider slides={slidesData} />
        <FavoritDestination destinations={destinationsData} />
        <PromoSection promoData={promoData} />
        
        <FeatureSection />
        <FAQ />
    </main>
</Layout>






