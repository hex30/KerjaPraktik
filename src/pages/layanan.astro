---
import UserLayout from "../layouts/MainLayout.astro";
import ServiceTabs from "../components/features/services/ServiceTabs.astro";
import FormRute from "../components/features/services/FormRute.astro";
import FormBooking from "../components/features/services/FormBooking.astro";
import FormPaket from "../components/features/services/FormPackage.astro";
---

<UserLayout title="Layanan | Rini Trans Putri">
    <section class="max-w-7xl mx-auto px-6 mt-8 font-main">
        <div
            class="relative w-full h-64 md:h-80 rounded-[2rem] overflow-hidden shadow-sm group"
        >
            <img
                src="/assets/images/contoh.jpg"
                alt="Promo Liburan Rini Trans Putri"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />

            <div
                class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/50 to-transparent flex flex-col justify-center px-8 md:px-16"
            >
                <span
                    class="inline-block bg-sky-500 text-white text-xs font-bold px-4 py-1.5 rounded-full w-max mb-4 uppercase tracking-wider"
                >
                    Penawaran Spesial
                </span>
                <h1
                    class="text-3xl md:text-5xl lg:text-6xl font-black text-white max-w-lg leading-tight tracking-tight"
                >
                    Diskon <span class="text-sky-400">20% </span>Liburan
                    Keluarga
                </h1>
            </div>
        </div>
    </section>

    <section class="max-w-7xl mx-auto px-6 mt-8 font-main"></section>

    <ServiceTabs />

    <section id="service-content" class="pb-24">
        <div id="view-rute" class="tab-content block">
            <FormRute />
        </div>

        <div id="view-booking" class="tab-content hidden">
            <FormBooking />
        </div>

        <div id="view-package" class="tab-content hidden">
            <FormPaket />
        </div>
    </section>

    <script>
        const initTabs = () => {
            const tabs = document.querySelectorAll(".nav-btn");
            const contents = document.querySelectorAll(".tab-content");

            // 1. FUNGSI UTAMA UNTUK MENGGANTI TAB
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    // Ambil nama target dari atribut data-view (misal: 'rute', 'booking', 'package')
                    const targetView = tab.getAttribute("data-view");

                    // Reset semua gaya tombol menjadi tidak aktif (abu-abu)
                    tabs.forEach((t) => {
                        t.classList.remove(
                            "bg-btn-linear",
                            "text-white",
                            "shadow-md",
                            "active",
                        );
                        t.classList.add("text-text-secondary");
                    });

                    // Beri gaya warna biru/linear pada tombol yang sedang diklik
                    tab.classList.add(
                        "bg-btn-linear",
                        "text-white",
                        "shadow-md",
                        "active",
                    );
                    tab.classList.remove("text-text-secondary");

                    // Sembunyikan semua konten form
                    contents.forEach((content) => {
                        content.classList.add("hidden");
                        content.classList.remove("block");
                    });

                    // Munculkan form yang sesuai dengan tombol yang diklik
                    const activeContent = document.getElementById(
                        `view-${targetView}`,
                    );
                    if (activeContent) {
                        activeContent.classList.remove("hidden");
                        activeContent.classList.add("block");
                    }
                });
            });

            // 2. FUNGSI AUTO-OPEN TAB BOOKING DARI URL
            const handleAutoOpenTab = () => {
                const hashTarget = window.location.hash; // Mengecek apakah ada #booking-component
                const params = new URLSearchParams(window.location.search);
                const adaTujuan = params.has("tujuan"); // Mengecek parameter ?tujuan=

                // Jika dari Destinasi (membawa hash atau parameter tujuan)
                if (hashTarget === "#booking-component" || adaTujuan) {
                    // Cari tombol tab yang data-view nya bernilai "booking"
                    const tabBooking = Array.from(tabs).find(
                        (t) => t.getAttribute("data-view") === "booking",
                    ) as HTMLElement;

                    if (tabBooking) {
                        // Klik tab secara terprogram agar konten booking terbuka
                        tabBooking.click();

                        // Optional: Karena form booking ada di dalam tab, pastikan browser menggulir layar
                        // tepat setelah tabnya terbuka
                        setTimeout(() => {
                            const targetElement =
                                document.getElementById("booking-component");
                            if (targetElement) {
                                targetElement.scrollIntoView({
                                    behavior: "smooth",
                                    block: "start",
                                });
                            }
                        }, 150); // Jeda sedikit lebih lama agar transisi tab selesai
                    }
                }
            };

            // Jalankan fungsi auto-open setelah event listener terpasang
            handleAutoOpenTab();
        };

        // Gunakan wrapper function agar kompatibel dengan Astro ViewTransitions
        document.addEventListener("DOMContentLoaded", initTabs);
        document.addEventListener("astro:page-load", initTabs);
    </script>
</UserLayout>
