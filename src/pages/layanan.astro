---
import UserLayout from '../layouts/userLayout.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import FormRute from '../components/FormRute.astro';
---

<UserLayout title="Layanan | Rini Trans Putri">
    
    <section class="max-w-7xl mx-auto px-6 mt-8 font-main">
        <div class="relative w-full h-64 md:h-80 rounded-[2rem] overflow-hidden shadow-sm group">
            <img 
                src="/assets/images/contoh.jpg" 
                alt="Promo Liburan Rini Trans Putri" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
            
            <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 via-slate-900/50 to-transparent flex flex-col justify-center px-8 md:px-16">
                <span class="inline-block bg-sky-500 text-white text-xs font-bold px-4 py-1.5 rounded-full w-max mb-4 uppercase tracking-wider">
                    Penawaran Spesial
                </span>
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-white max-w-lg leading-tight tracking-tight">
                    Diskon 20% Liburan Keluarga
                </h1>
            </div>
        </div>
    </section>

    <ServiceTabs />

    <section id="service-content" class="pb-24">
        <FormRute />
    </section>

</UserLayout>