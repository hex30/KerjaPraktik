---
// File: src/pages/layanan.astro
import Layout from "../layouts/MainLayout.astro";
import ServiceTabs from "../components/features/reservation/ServiceTabs.astro";
import FormRute from "../components/features/reservation/FormRute.astro";
import FormBooking from "../components/features/reservation/FormBooking.astro";
import FormPaket from "../components/features/reservation/FormPackage.astro";
import ServicePromo from "../components/features/reservation/ServicePromo.astro";
---

<Layout title="Layanan | Rini Trans Putri">
    <!-- Service Promotional Banner -->
    <ServicePromo 
        image="/assets/images/contoh.jpg"
        badge="Penawaran Spesial"
        title="Diskon"
        highlight="20% Liburan Keluarga"
    />

    <!-- Main Content Section -->
    <section class="max-w-7xl mx-auto px-6 mt-8 font-main">
        <ServiceTabs />

        <div id="service-content" class="pb-24 mt-8">
            <div id="view-rute" class="tab-content block animate-fade-in">
                <FormRute />
            </div>

            <div id="view-booking" class="tab-content hidden animate-fade-in">
                <FormBooking />
            </div>

            <div id="view-package" class="tab-content hidden animate-fade-in">
                <FormPaket />
            </div>
        </div>
    </section>
</Layout>

<style>
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<script>
    const initTabsAndRouting = () => {
        const tabs = document.querySelectorAll(".nav-btn");
        const contents = document.querySelectorAll(".tab-content");

        const switchTab = (targetView: string) => {
            tabs.forEach((t) => {
                t.classList.remove("bg-btn-linear", "text-white", "shadow-md", "active");
                t.classList.add("text-text-secondary");
            });

            const activeTab = document.querySelector(`[data-view="${targetView}"]`);
            if (activeTab) {
                activeTab.classList.add("bg-btn-linear", "text-white", "shadow-md", "active");
                activeTab.classList.remove("text-text-secondary");
            }

            contents.forEach((content) => {
                content.classList.add("hidden");
                content.classList.remove("block");
            });

            const activeContent = document.getElementById(`view-${targetView}`);
            if (activeContent) {
                activeContent.classList.remove("hidden");
                activeContent.classList.add("block");
            }
        };

        tabs.forEach((tab) => {
            tab.addEventListener("click", () => {
                const targetView = tab.getAttribute("data-view");
                if (targetView) switchTab(targetView);
            });
        });

        const handleAutoOpenTab = () => {
            const hashTarget = window.location.hash;
            const params = new URLSearchParams(window.location.search);
            
            if (hashTarget === "#booking-component" || params.has("tujuan")) {
                const tabBooking = document.getElementById("tab-btn-booking");
                if (tabBooking) tabBooking.click();
            }
        };

        handleAutoOpenTab();
    };

    document.addEventListener("DOMContentLoaded", initTabsAndRouting);
    document.addEventListener("astro:page-load", initTabsAndRouting);
</script>



