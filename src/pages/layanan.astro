---
import UserLayout from "../layouts/MainLayout.astro";
import ServiceTabs from "../components/features/services/ServiceTabs.astro";
import FormRute from "../components/features/services/FormRute.astro";
import FormBooking from "../components/features/services/FormBooking.astro";
import FormPaket from "../components/features/services/FormPackage.astro";
import ServicePromo from "../components/features/services/molecules/ServicePromo.astro";
---

<UserLayout title="Layanan | Rini Trans Putri">
    <ServicePromo 
        image="/assets/images/contoh.jpg"
        badge="Penawaran Spesial"
        title="Diskon"
        highlight="20% Liburan Keluarga"
    />

    <section class="max-w-7xl mx-auto px-6 mt-8 font-main"></section>

    <ServiceTabs />

    <section id="service-content" class="pb-24">
        <div id="view-rute" class="tab-content block">
            <FormRute />
        </div>

        <div id="view-booking" class="tab-content hidden">
            <FormBooking />
        </div>

        <div id="view-package" class="tab-content hidden">
            <FormPaket />
        </div>
    </section>

    <script>
        const initTabsAndRouting = () => {
            const tabs = document.querySelectorAll(".nav-btn");
            const contents = document.querySelectorAll(".tab-content");

            // ==========================================
            // 1. LOGIKA KLIK MANUAL (Kode Anda yang sudah ada)
            // ==========================================
            tabs.forEach((tab) => {
                tab.addEventListener("click", () => {
                    const targetView = tab.getAttribute("data-view");

                    tabs.forEach((t) => {
                        t.classList.remove(
                            "bg-btn-linear",
                            "text-white",
                            "shadow-md",
                            "active",
                        );
                        t.classList.add("text-text-secondary");
                    });

                    tab.classList.add(
                        "bg-btn-linear",
                        "text-white",
                        "shadow-md",
                        "active",
                    );
                    tab.classList.remove("text-text-secondary");

                    contents.forEach((content) => {
                        content.classList.add("hidden");
                        content.classList.remove("block");
                    });

                    const activeContent = document.getElementById(
                        `view-${targetView}`,
                    );
                    if (activeContent) {
                        activeContent.classList.remove("hidden");
                        activeContent.classList.add("block");
                    }
                });
            });

            // ==========================================
            // 2. LOGIKA AUTO-OPEN DARI URL (Wajib ditambahkan!)
            // ==========================================
            const handleAutoOpenTab = () => {
                const hashTarget = window.location.hash;
                const params = new URLSearchParams(window.location.search);
                const adaTujuan = params.has("tujuan");

                // Cek apakah URL meminta tab Booking (Charter)
                // Jika ada hash #booking-component ATAU membawa parameter ?tujuan=
                if (hashTarget === "#booking-component" || adaTujuan) {
                    // Cari tombol tab Booking menggunakan ID yang ada di ServiceTabs.astro
                    const tabBooking =
                        document.getElementById("tab-btn-booking");

                    if (tabBooking) {
                        // Simulasikan klik pada tombol tab tersebut
                        tabBooking.click();
                    }
                }
            };

            // Jalankan pengecekan URL segera setelah halaman dan skrip dimuat
            handleAutoOpenTab();
        };

        // Gunakan listener ganda agar aman dengan fitur SPA/ViewTransitions Astro
        document.addEventListener("DOMContentLoaded", initTabsAndRouting);
        document.addEventListener("astro:page-load", initTabsAndRouting);
    </script>
</UserLayout>
